// Classic FizzBuzz 1..20 — portable CLI-style Program (JS backend).
// Host I/O via globalThis.console (free `console` is not in scope).

let console = globalThis.console;

for (let i = 1; i <= 20; i = i + 1) {
  let line = "";
  if (i % 15 === 0) {
    line = "FizzBuzz";
  } else if (i % 3 === 0) {
    line = "Fizz";
  } else if (i % 5 === 0) {
    line = "Buzz";
  } else {
    line = String(i);
  }
  console.log(line);
}
