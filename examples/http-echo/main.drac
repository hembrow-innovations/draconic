// H17.01: pure Draconic native HTTP/1.1 echo server (no C host).
// Listens on 8080; each connection: accept → parse → 200 + path body → close.

let s = tcpListen(8080);
stdoutWrite("http-echo listening on 8080\n");
while (true) {
  let a = tcpAccept(s);
  let raw = tcpRead(a, 65536);
  let req = httpParseRequest(raw);
  let path = req.path;
  let resp = httpWriteResponse(200, "OK", "Content-Type: text/plain\r\n", path);
  tcpWrite(a, resp);
  closeTcp(a);
}
