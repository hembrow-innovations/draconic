\n1390:     let err = check(program).unwrap_err();\n1391:     assert!(\n1392:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1393:         \"unexpected: {}\",\n1394:         err.message\n1395:     );\n1396: }\n1397: \n1398: #[test]\n1399: fn unknown_shape_prop_compound_assign_errors() {\n1400:     let program = parse(\"let p: { x: number } = { x: 1 }; p.y += 1;\").unwrap();\n1401:     let err = check(program).unwrap_err();\n1402:     assert!(\n1403:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1404:         \"unexpected: {}\",\n1405:         err.message\n1406:     );\n1407: }\n1408: \n1409: #[test]\n1410: fn known_shape_prop_access_ok() {\n1411:     let program = parse(\"let p: { x: number } = { x: 1 }; let n: number = p.x; p.x = 2;\").unwrap();\n1412:     check(program).unwrap();\n1413: }\n1414: \n1415: #[test]\n1416: fn untyped_object_unknown_prop_stays_dynamic() {\n1417:     let program = parse(\"let p = { x: 1 }; p.y = 2; let n = p.y;\").unwrap();\n1418:     check(program).unwrap();\n1419: }\n1420: \n1421: #[test]\n1422: fn unknown_shape_prop_dynamic_ok_fixture_present() {\n1423:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n1424:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n1425:     assert!(\n1426:         ids.iter().any(|id| *id == \"types/unknown_shape_prop_dynamic_ok\"),\n1427:         \"missing types/unknown_shape_prop_dynamic_ok fixture, got {ids:?}\"\n1428:     );\n1429: }\n1430: \n1431: #[test]\n1432: fn unknown_shape_prop_dynamic_ok_runs() {\n1433:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n1434:     let fixture = fixtures\n1435:         .iter()\n1436:         .find(|f| f.id == \"types/unknown_shape_prop_dynamic_ok\")\n1437:         .expect(\"types/unknown_shape_prop_dynamic_ok\");\n1438:     assert!(!fixture.targets.is_empty());\n1439:     for r in run_fixture(fixture) {\n1440:         assert!(\n1441:             r.ok,\n1442:             \"{} @ {}: {}\",\n1443:             r.fixture_id,\n1444:             r.target.as_str(),\n1445:             r.message\n1446:         );\n1447:     }\n1448: }\n\n(End of file - total 1448 lines)\n</content>",
      "metadata": {
        "preview": "//! ROADMAP T01–T06: type annotations, object types, unions/intersections/narrowing, generics, native types, dual-worlds boundary.\n\nuse draconic_check::{check, BoundProgram, CheckedProgram, NativeType, Type};\nuse draconic_conformance::{fixtures_dir, load_fixtures, run_fixture};\nuse draconic_parser::parse;\n\nfn user_sym<'a>(bound: &'a BoundProgram, name: &str) -> &'a draconic_check::Symbol {\n    // Prefer the last declaration (user code; builtins use dummy spans at the front).\n    bound\n        .symbols()\n        .iter()\n        .filter(|s| s.name == name)\n        .last()\n        .unwrap_or_else(|| panic!(\"no symbol `{name}`\"))\n}\n\nfn type_of(checked: &CheckedProgram, name: &str) -> Type {\n    let s = user_sym(&checked.bound, name);\n    checked.type_of_symbol(s.id)\n}",
