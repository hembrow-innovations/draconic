w/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_private_nested_shadow.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/generator_return_throw.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_computed.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/generator_expr.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_non_simple_params.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/yield_expr.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_field_init_eval.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/functions/nested_capture.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/yield_star.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_residual_ii.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/functions/function_expr.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_static_fields.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/yield_resume.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/functions/default_params.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_super_assign_eval.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/generator_methods.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/functions/arrow.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_private_dstr.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/generator_for_of.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_private_add.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/basic_yield.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/classes/class_static.drac\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/generators/generator_return_throw.meta\n/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/fixtures/es/functions/decl_return_call.drac\n\n(Results are truncated: showing first 100 results. Consider using a more specific path or pattern.)",
