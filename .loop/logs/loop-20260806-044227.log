      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/tests/conformance/tests/types.rs</path>\n<type>file</type>\n<content>\n1: //! ROADMAP T01–T06: type annotations, object types, unions/intersections/narrowing, generics, native types, dual-worlds boundary.\n2: \n3: use draconic_check::{check, BoundProgram, CheckedProgram, NativeType, Type};\n4: use draconic_conformance::{fixtures_dir, load_fixtures, run_fixture};\n5: use draconic_parser::parse;\n6: \n7: fn user_sym<'a>(bound: &'a BoundProgram, name: &str) -> &'a draconic_check::Symbol {\n8:     // Prefer the last declaration (user code; builtins use dummy spans at the front).\n9:     bound\n10:         .symbols()\n11:         .iter()\n12:         .filter(|s| s.name == name)\n13:         .last()\n14:         .unwrap_or_else(|| panic!(\"no symbol `{name}`\"))\n15: }\n16: \n17: fn type_of(checked: &CheckedProgram, name: &str) -> Type {\n18:     let s = user_sym(&checked.bound, name);\n19:     checked.type_of_symbol(s.id)\n20: }\n21: \n22: #[test]\n23: fn annotations_erase_fixture_present() {\n24:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n25:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n26:     assert!(\n27:         ids.iter().any(|id| *id == \"types/annotations_erase\"),\n28:         \"missing types/annotations_erase fixture, got {ids:?}\"\n29:     );\n30: }\n31: \n32: #[test]\n33: fn annotations_erase_runs() {\n34:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n35:     let fixture = fixtures\n36:         .iter()\n37:         .find(|f| f.id == \"types/annotations_erase\")\n38:         .expect(\"types/annotations_erase\");\n39:     assert!(!fixture.targets.is_empty());\n40:     for r in run_fixture(fixture) {\n41:         assert!(\n42:             r.ok,\n43:             \"{} @ {}: {}\",\n44:             r.fixture_id,\n45:             r.target.as_str(),\n46:             r.message\n47:         );\n48:     }\n49: }\n50: \n51: #[test]\n52: fn let_annotation_sets_binding_type() {\n53:     let program = parse(\"let x: number = 1;\").unwrap();\n54:     let checked = check(program).unwrap();\n55:     assert_eq!(type_of(&checked, \"x\"), Type::Number);\n56: }\n57: \n58: #[test]\n59: fn let_annotation_rejects_mismatched_init() {\n60:     let program = parse(\"let x: number = \\\"no\\\";\").unwrap();\n61:     let err = check(program).unwrap_err();\n62:     assert!(\n63:         err.message.contains(\"not assignable\")\n64:             && err.message.contains(\"string\")\n65:             && err.message.contains(\"number\"),\n66:         \"unexpected: {}\",\n67:         err.message\n68:     );\n69: }\n70: \n71: #[test]\n72: fn let_annotation_rejects_mismatched_assign() {\n73:     let program = parse(\"let x: number = 1; x = \\\"no\\\";\").unwrap();\n74:     let err = check(program).unwrap_err();\n75:     assert!(\n76:         err.message.contains(\"string\") && err.message.contains(\"number\"),\n77:         \"unexpected: {}\",\n78:         err.message\n79:     );\n80: }\n81: \n82: #[test]\n83: fn const_annotation_ok() {\n84:     let program = parse(\"const s: string = \\\"ok\\\";\").unwrap();\n85:     let checked = check(program).unwrap();\n86:     assert_eq!(type_of(&checked, \"s\"), Type::String);\n87: }\n88: \n89: #[test]\n90: fn param_annotation_sets_param_type() {\n91:     let program = parse(\"function f(a: number) { let b: number = a; }\").unwrap();\n92:     let checked = check(program).unwrap();\n93:     assert_eq!(type_of(&checked, \"a\"), Type::Number);\n94:     assert_eq!(type_of(&checked, \"b\"), Type::Number);\n95: }\n96: \n97: #[test]\n98: fn param_default_must_match_annotation() {\n99:     let program = parse(\"function f(a: number = \\\"x\\\") { return a; }\").unwrap();\n100:     let err = check(program).unwrap_err();\n101:     assert!(\n102:         err.message.contains(\"not assignable\"),\n103:         \"unexpected: {}\",\n104:         err.message\n105:     );\n106: }\n107: \n108: #[test]\n109: fn return_type_rejects_mismatch() {\n110:     let program = parse(\"function f(): number { return \\\"x\\\"; }\").unwrap();\n111:     let err = check(program).unwrap_err();\n112:     assert!(\n113:         err.message.contains(\"not assignable\")\n114:             && err.message.contains(\"string\")\n115:             && err.message.contains(\"number\"),\n116:         \"unexpected: {}\",\n117:         err.message\n118:     );\n119: }\n120: \n121: #[test]\n122: fn return_type_accepts_match() {\n123:     let program = parse(\"function f(): number { return 1; }\").unwrap();\n124:     check(program).unwrap();\n125: }\n126: \n127: #[test]\n128: fn arrow_return_type_rejects_mismatch() {\n129:     let program = parse(\"let f = (x: number): string => x;\").unwrap();\n130:     let err = check(program).unwrap_err();\n131:     assert!(\n132:         err.message.contains(\"not assignable\"),\n133:         \"unexpected: {}\",\n134:         err.message\n135:     );\n136: }\n137: \n138: #[test]\n139: fn arrow_return_type_accepts_match() {\n140:     let program = parse(\"let f = (x: number): number => x;\").unwrap();\n141:     check(program).unwrap();\n142: }\n143: \n144: #[test]\n145: fn unknown_type_name_errors() {\n146:     let program = parse(\"let x: Widget = 1;\").unwrap();\n147:     let err = check(program).unwrap_err();\n148:     assert!(\n149:         err.message.contains(\"unknown type\") && err.message.contains(\"Widget\"),\n150:         \"unexpected: {}\",\n151:         err.message\n152:     );\n153: }\n154: \n155: #[test]\n156: fn bare_return_rejects_concrete_return_type() {\n157:     let program = parse(\"function f(): number { return; }\").unwrap();\n158:     let err = check(program).unwrap_err();\n159:     assert!(\n160:         err.message.contains(\"return\"),\n161:         \"unexpected: {}\",\n162:         err.message\n163:     );\n164: }\n165: \n166: #[test]\n167: fn parse_rejects_missing_type_name() {\n168:     let err = parse(\"let x: = 1;\").unwrap_err();\n169:     assert!(\n170:         err.message.contains(\"type name\") || err.message.contains(\"expected\"),\n171:         \"unexpected: {}\",\n172:         err.message\n173:     );\n174: }\n175: \n176: // --- T02: structural object types + type aliases ---\n177: \n178: #[test]\n179: fn object_type_ann_accepts_matching_literal() {\n180:     let program = parse(\"let p: { x: number; y: string } = { x: 1, y: \\\"a\\\" };\").unwrap();\n181:     let checked = check(program).unwrap();\n182:     assert!(matches!(type_of(&checked, \"p\"), Type::Shape(_)));\n183: }\n184: \n185: #[test]\n186: fn object_type_ann_rejects_missing_prop() {\n187:     let program = parse(\"let p: { x: number; y: number } = { x: 1 };\").unwrap();\n188:     let err = check(program).unwrap_err();\n189:     assert!(\n190:         err.message.contains(\"not assignable\"),\n191:         \"unexpected: {}\",\n192:         err.message\n193:     );\n194: }\n195: \n196: #[test]\n197: fn object_type_ann_rejects_wrong_prop_type() {\n198:     let program = parse(\"let p: { x: number } = { x: \\\"no\\\" };\").unwrap();\n199:     let err = check(program).unwrap_err();\n200:     assert!(\n201:         err.message.contains(\"not assignable\"),\n202:         \"unexpected: {}\",\n203:         err.message\n204:     );\n205: }\n206: \n207: #[test]\n208: fn structural_assign_extra_props_ok() {\n209:     let program = parse(\n210:         r#\"\n211:         let full: { x: number; y: number } = { x: 1, y: 2 };\n212:         let part: { x: number } = full;\n213:         \"#,\n214:     )\n215:     .unwrap();\n216:     check(program).unwrap();\n217: }\n218: \n219: #[test]\n220: fn structural_assign_missing_prop_errors() {\n221:     let program = parse(\n222:         r#\"\n223:         let part: { x: number } = { x: 1 };\n224:         let full: { x: number; y: number } = part;\n225:         \"#,\n226:     )\n227:     .unwrap();\n228:     let err = check(program).unwrap_err();\n229:     assert!(\n230:         err.message.contains(\"not assignable\"),\n231:         \"unexpected: {}\",\n232:         err.message\n233:     );\n234: }\n235: \n236: #[test]\n237: fn type_alias_object_ok() {\n238:     let program = parse(\n239:         r#\"\n240:         type Point = { x: number; y: number };\n241:         let p: Point = { x: 1, y: 2 };\n242:         \"#,\n243:     )\n244:     .unwrap();\n245:     let checked = check(program).unwrap();\n246:     assert!(matches!(type_of(&checked, \"p\"), Type::Shape(_)));\n247: }\n248: \n249: #[test]\n250: fn type_alias_rejects_mismatch() {\n251:     let program = parse(\n252:         r#\"\n253:         type Point = { x: number; y: number };\n254:         let p: Point = { x: 1 };\n255:         \"#,\n256:     )\n257:     .unwrap();\n258:     let err = check(program).unwrap_err();\n259:     assert!(\n260:         err.message.contains(\"not assignable\"),\n261:         \"unexpected: {}\",\n262:         err.message\n263:     );\n264: }\n265: \n266: #[test]\n267: fn type_alias_named_primitive() {\n268:     let program = parse(\n269:         r#\"\n270:         type Num = number;\n271:         let n: Num = 1;\n272:         let bad: Num = \"x\";\n273:         \"#,\n274:     )\n275:     .unwrap();\n276:     let err = check(program).unwrap_err();\n277:     assert!(\n278:         err.message.contains(\"not assignable\"),\n279:         \"unexpected: {}\",\n280:         err.message\n281:     );\n282: }\n283: \n284: #[test]\n285: fn member_access_uses_shape_prop_type() {\n286:     let program = parse(\n287:         r#\"\n288:         let p: { x: number } = { x: 1 };\n289:         let n: number = p.x;\n290:         let bad: string = p.x;\n291:         \"#,\n292:     )\n293:     .unwrap();\n294:     let err = check(program).unwrap_err();\n295:     assert!(\n296:         err.message.contains(\"not assignable\")\n297:             && err.message.contains(\"number\")\n298:             && err.message.contains(\"string\"),\n299:         \"unexpected: {}\",\n300:         err.message\n301:     );\n302: }\n303: \n304: #[test]\n305: fn object_types_erase_fixture_present() {\n306:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n307:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n308:     assert!(\n309:         ids.iter().any(|id| *id == \"types/object_types_erase\"),\n310:         \"missing types/object_types_erase fixture, got {ids:?}\"\n311:     );\n312: }\n313: \n314: #[test]\n315: fn object_types_erase_runs() {\n316:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n317:     let fixture = fixtures\n318:         .iter()\n319:         .find(|f| f.id == \"types/object_types_erase\")\n320:         .expect(\"types/object_types_erase\");\n321:     assert!(!fixture.targets.is_empty());\n322:     for r in run_fixture(fixture) {\n323:         assert!(\n324:             r.ok,\n325:             \"{} @ {}: {}\",\n326:             r.fixture_id,\n327:             r.target.as_str(),\n328:             r.message\n329:         );\n330:     }\n331: }\n332: \n333: #[test]\n334: fn duplicate_type_alias_errors() {\n335:     let program = parse(\"type A = number; type A = string;\").unwrap();\n336:     let err = check(program).unwrap_err();\n337:     assert!(\n338:         err.message.contains(\"duplicate type alias\"),\n339:         \"unexpected: {}\",\n340:         err.message\n341:     );\n342: }\n343: \n344: #[test]\n345: fn parse_object_type_and_alias() {\n346:     let program = parse(\"type P = { x: number, y: string }; let p: P = { x: 1, y: \\\"a\\\" };\")\n347:         .unwrap();\n348:     assert!(!program.body.is_empty());\n349:     check(program).unwrap();\n350: }\n351: \n352: // --- T03: unions, intersections, typeof narrowing ---\n353: \n354: #[test]\n355: fn union_accepts_each_member() {\n356:     let program = parse(\n357:         r#\"\n358:         let a: string | number = 1;\n359:         let b: string | number = \"hi\";\n360:         \"#,\n361:     )\n362:     .unwrap();\n363:     let checked = check(program).unwrap();\n364:     assert!(matches!(type_of(&checked, \"a\"), Type::Union(_)));\n365:     assert!(matches!(type_of(&checked, \"b\"), Type::Union(_)));\n366: }\n367: \n368: #[test]\n369: fn union_rejects_outside_member() {\n370:     let program = parse(r#\"let a: string | number = true;\"#).unwrap();\n371:     let err = check(program).unwrap_err();\n372:     assert!(\n373:         err.message.contains(\"not assignable\"),\n374:         \"unexpected: {}\",\n375:         err.message\n376:     );\n377: }\n378: \n379: #[test]\n380: fn union_member_not_assignable_to_single() {\n381:     let program = parse(\n382:         r#\"\n383:         let u: string | number = 1;\n384:         let n: number = u;\n385:         \"#,\n386:     )\n387:     .unwrap();\n388:     let err = check(program).unwrap_err();\n389:     assert!(\n390:         err.message.contains(\"not assignable\"),\n391:         \"unexpected: {}\",\n392:         err.message\n393:     );\n394: }\n395: \n396: #[test]\n397: fn type_alias_union() {\n398:     let program = parse(\n399:         r#\"\n400:         type StrOrNum = string | number;\n401:         let x: StrOrNum = \"a\";\n402:         let y: StrOrNum = false;\n403:         \"#,\n404:     )\n405:     .unwrap();\n406:     let err = check(program).unwrap_err();\n407:     assert!(\n408:         err.message.contains(\"not assignable\"),\n409:         \"unexpected: {}\",\n410:         err.message\n411:     );\n412: }\n413: \n414: #[test]\n415: fn intersection_object_merge() {\n416:     let program = parse(\n417:         r#\"\n418:         type A = { x: number };\n419:         type B = { y: string };\n420:         let o: A & B = { x: 1, y: \"a\" };\n421:         let n: number = o.x;\n422:         let s: string = o.y;\n423:         \"#,\n424:     )\n425:     .unwrap();\n426:     check(program).unwrap();\n427: }\n428: \n429: #[test]\n430: fn intersection_requires_all_props() {\n431:     let program = parse(\n432:         r#\"\n433:         type A = { x: number };\n434:         type B = { y: string };\n435:         let o: A & B = { x: 1 };\n436:         \"#,\n437:     )\n438:     .unwrap();\n439:     let err = check(program).unwrap_err();\n440:     assert!(\n441:         err.message.contains(\"not assignable\"),\n442:         \"unexpected: {}\",\n443:         err.message\n444:     );\n445: }\n446: \n447: #[test]\n448: fn intersection_assignable_to_each_part() {\n449:     let program = parse(\n450:         r#\"\n451:         type A = { x: number };\n452:         type B = { y: string };\n453:         let o: A & B = { x: 1, y: \"a\" };\n454:         let a: A = o;\n455:         let b: B = o;\n456:         \"#,\n457:     )\n458:     .unwrap();\n459:     check(program).unwrap();\n460: }\n461: \n462: #[test]\n463: fn typeof_narrow_string_branch() {\n464:     let program = parse(\n465:         r#\"\n466:         function f(x: string | number): string {\n467:           if (typeof x === \"string\") {\n468:             let s: string = x;\n469:             return s;\n470:           } else {\n471:             let n: number = x;\n472:             return \"n\";\n473:           }\n474:         }\n475:         \"#,\n476:     )\n477:     .unwrap();\n478:     check(program).unwrap();\n479: }\n480: \n481: #[test]\n482: fn typeof_narrow_rejects_wrong_branch() {\n483:     let program = parse(\n484:         r#\"\n485:         function f(x: string | number): number {\n486:           if (typeof x === \"string\") {\n487:             let n: number = x;\n488:             return n;\n489:           }\n490:           return 0;\n491:         }\n492:         \"#,\n493:     )\n494:     .unwrap();\n495:     let err = check(program).unwrap_err();\n496:     assert!(\n497:         err.message.contains(\"not assignable\"),\n498:         \"unexpected: {}\",\n499:         err.message\n500:     );\n501: }\n502: \n503: #[test]\n504: fn typeof_narrow_else_branch() {\n505:     let program = parse(\n506:         r#\"\n507:         function f(x: string | number): number {\n508:           if (typeof x === \"string\") {\n509:             return 0;\n510:           } else {\n511:             let n: number = x;\n512:             return n;\n513:           }\n514:         }\n515:         \"#,\n516:     )\n517:     .unwrap();\n518:     check(program).unwrap();\n519: }\n520: \n521: #[test]\n522: fn typeof_narrow_flipped_operands() {\n523:     let program = parse(\n524:         r#\"\n525:         function f(x: string | number): string {\n526:           if (\"string\" === typeof x) {\n527:             return x;\n528:           }\n529:           return \"n\";\n530:         }\n531:         \"#,\n532:     )\n533:     .unwrap();\n534:     check(program).unwrap();\n535: }\n536: \n537: #[test]\n538: fn union_erase_fixture_present() {\n539:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n540:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n541:     assert!(\n542:         ids.iter().any(|id| *id == \"types/union_intersection_erase\"),\n543:         \"missing types/union_intersection_erase fixture, got {ids:?}\"\n544:     );\n545: }\n546: \n547: #[test]\n548: fn union_erase_runs() {\n549:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n550:     let fixture = fixtures\n551:         .iter()\n552:         .find(|f| f.id == \"types/union_intersection_erase\")\n553:         .expect(\"types/union_intersection_erase\");\n554:     assert!(!fixture.targets.is_empty());\n555:     for r in run_fixture(fixture) {\n556:         assert!(\n557:             r.ok,\n558:             \"{} @ {}: {}\",\n559:             r.fixture_id,\n560:             r.target.as_str(),\n561:             r.message\n562:         );\n563:     }\n564: }\n565: \n566: #[test]\n567: fn parse_union_and_intersection() {\n568:     let program = parse(\"type T = string | number; type U = { a: number } & { b: string };\")\n569:         .unwrap();\n570:     assert!(!program.body.is_empty());\n571:     check(program).unwrap();\n572: }\n573: \n574: // --- T04: generics (functions, types) ---\n575: \n576: #[test]\n577: fn generic_type_alias_app() {\n578:     let program = parse(\n579:         r#\"\n580:         type Box<T> = { value: T };\n581:         let n: Box<number> = { value: 1 };\n582:         let s: Box<string> = { value: \"a\" };\n583:         \"#,\n584:     )\n585:     .unwrap();\n586:     let checked = check(program).unwrap();\n587:     assert!(matches!(type_of(&checked, \"n\"), Type::Shape(_)));\n588:     assert!(matches!(type_of(&checked, \"s\"), Type::Shape(_)));\n589: }\n590: \n591: #[test]\n592: fn generic_type_alias_rejects_wrong_arg() {\n593:     let program = parse(\n594:         r#\"\n595:         type Box<T> = { value: T };\n596:         let bad: Box<number> = { value: \"no\" };\n597:         \"#,\n598:     )\n599:     .unwrap();\n600:     let err = check(program).unwrap_err();\n601:     assert!(\n602:         err.message.contains(\"not assignable\"),\n603:         \"unexpected: {}\",\n604:         err.message\n605:     );\n606: }\n607: \n608: #[test]\n609: fn generic_type_alias_arity_error() {\n610:     let program = parse(\n611:         r#\"\n612:         type Box<T> = { value: T };\n613:         let bad: Box = { value: 1 };\n614:         \"#,\n615:     )\n616:     .unwrap();\n617:     let err = check(program).unwrap_err();\n618:     assert!(\n619:         err.message.contains(\"type argument\") || err.message.contains(\"generic\"),\n620:         \"unexpected: {}\",\n621:         err.message\n622:     );\n623: }\n624: \n625: #[test]\n626: fn generic_type_alias_two_params() {\n627:     let program = parse(\n628:         r#\"\n629:         type Pair<A, B> = { a: A; b: B };\n630:         let p: Pair<number, string> = { a: 1, b: \"x\" };\n631:         let n: number = p.a;\n632:         let s: string = p.b;\n633:         \"#,\n634:     )\n635:     .unwrap();\n636:     check(program).unwrap();\n637: }\n638: \n639: #[test]\n640: fn generic_function_identity_infers() {\n641:     let program = parse(\n642:         r#\"\n643:         function id<T>(x: T): T { return x; }\n644:         let n = id(1);\n645:         let s = id(\"hi\");\n646:         \"#,\n647:     )\n648:     .unwrap();\n649:     let checked = check(program).unwrap();\n650:     assert_eq!(type_of(&checked, \"n\"), Type::Number);\n651:     assert_eq!(type_of(&checked, \"s\"), Type::String);\n652: }\n653: \n654: #[test]\n655: fn generic_function_identity_rejects_mismatch() {\n656:     let program = parse(\n657:         r#\"\n658:         function id<T>(x: T): T { return x; }\n659:         let bad: string = id(1);\n660:         \"#,\n661:     )\n662:     .unwrap();\n663:     let err = check(program).unwrap_err();\n664:     assert!(\n665:         err.message.contains(\"not assignable\"),\n666:         \"unexpected: {}\",\n667:         err.message\n668:     );\n669: }\n670: \n671: #[test]\n672: fn generic_function_body_type_param() {\n673:     let program = parse(\n674:         r#\"\n675:         function id<T>(x: T): T {\n676:           let y: T = x;\n677:           return y;\n678:         }\n679:         \"#,\n680:     )\n681:     .unwrap();\n682:     check(program).unwrap();\n683: }\n684: \n685: #[test]\n686: fn generic_function_body_rejects_wrong_concrete() {\n687:     let program = parse(\n688:         r#\"\n689:         function id<T>(x: T): T {\n690:           let y: number = x;\n691:           return x;\n692:         }\n693:         \"#,\n694:     )\n695:     .unwrap();\n696:     let err = check(program).unwrap_err();\n697:     assert!(\n698:         err.message.contains(\"not assignable\"),\n699:         \"unexpected: {}\",\n700:         err.message\n701:     );\n702: }\n703: \n704: #[test]\n705: fn generic_function_two_params_same_t_ok() {\n706:     let program = parse(\n707:         r#\"\n708:         function both<T>(a: T, b: T): T { return a; }\n709:         let n = both(1, 2);\n710:         \"#,\n711:     )\n712:     .unwrap();\n713:     let checked = check(program).unwrap();\n714:     assert_eq!(type_of(&checked, \"n\"), Type::Number);\n715: }\n716: \n717: #[test]\n718: fn generic_function_two_params_same_t_conflict() {\n719:     let program = parse(\n720:         r#\"\n721:         function both<T>(a: T, b: T): T { return a; }\n722:         let bad = both(1, \"x\");\n723:         \"#,\n724:     )\n725:     .unwrap();\n726:     let err = check(program).unwrap_err();\n727:     assert!(\n728:         err.message.contains(\"not assignable\")\n729:             || err.message.contains(\"inferred\")\n730:             || err.message.contains(\"type parameter\"),\n731:         \"unexpected: {}\",\n732:         err.message\n733:     );\n734: }\n735: \n736: #[test]\n737: fn generic_box_via_function() {\n738:     let program = parse(\n739:         r#\"\n740:         type Box<T> = { value: T };\n741:         function box<T>(v: T): Box<T> {\n742:           return { value: v };\n743:         }\n744:         let b = box(42);\n745:         let n: number = b.value;\n746:         \"#,\n747:     )\n748:     .unwrap();\n749:     let checked = check(program).unwrap();\n750:     assert_eq!(type_of(&checked, \"n\"), Type::Number);\n751:     assert!(matches!(type_of(&checked, \"b\"), Type::Shape(_)));\n752: }\n753: \n754: #[test]\n755: fn generics_erase_fixture_present() {\n756:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n757:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n758:     assert!(\n759:         ids.iter().any(|id| *id == \"types/generics_erase\"),\n760:         \"missing types/generics_erase fixture, got {ids:?}\"\n761:     );\n762: }\n763: \n764: #[test]\n765: fn generics_erase_runs() {\n766:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n767:     let fixture = fixtures\n768:         .iter()\n769:         .find(|f| f.id == \"types/generics_erase\")\n770:         .expect(\"types/generics_erase\");\n771:     assert!(!fixture.targets.is_empty());\n772:     for r in run_fixture(fixture) {\n773:         assert!(\n774:             r.ok,\n775:             \"{} @ {}: {}\",\n776:             r.fixture_id,\n777:             r.target.as_str(),\n778:             r.message\n779:         );\n780:     }\n781: }\n782: \n783: #[test]\n784: fn parse_generic_alias_and_fn() {\n785:     let program = parse(\n786:         r#\"\n787:         type Id<T> = T;\n788:         function f<T>(x: T): T { return x; }\n789:         let a: Id<number> = 1;\n790:         let b = f(a);\n791:         \"#,\n792:     )\n793:     .unwrap();\n794:     assert!(!program.body.is_empty());\n795:     let checked = check(program).unwrap();\n796:     assert_eq!(type_of(&checked, \"a\"), Type::Number);\n797:     assert_eq!(type_of(&checked, \"b\"), Type::Number);\n798: }\n799: \n800: // --- T05: native types in the type system ---\n801: \n802: #[test]\n803: fn native_types_erase_fixture_present() {\n804:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n805:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n806:     assert!(\n807:         ids.iter().any(|id| *id == \"types/native/native_types_erase\"),\n808:         \"missing types/native/native_types_erase fixture, got {ids:?}\"\n809:     );\n810: }\n811: \n812: #[test]\n813: fn native_types_erase_runs() {\n814:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n815:     let fixture = fixtures\n816:         .iter()\n817:         .find(|f| f.id == \"types/native/native_types_erase\")\n818:         .expect(\"types/native/native_types_erase\");\n819:     assert!(!fixture.targets.is_empty());\n820:     for r in run_fixture(fixture) {\n821:         assert!(\n822:             r.ok,\n823:             \"{} @ {}: {}\",\n824:             r.fixture_id,\n825:             r.target.as_str(),\n826:             r.message\n827:         );\n828:     }\n829: }\n830: \n831: #[test]\n832: fn i32_annotation_sets_binding_type() {\n833:     let program = parse(\"let x: i32 = 1;\").unwrap();\n834:     let checked = check(program).unwrap();\n835:     assert_eq!(type_of(&checked, \"x\"), Type::Native(NativeType::I32));\n836: }\n837: \n838: #[test]\n839: fn native_integer_and_float_names() {\n840:     let program = parse(\n841:         r#\"\n842:         let a: i8 = 1;\n843:         let b: i16 = 2;\n844:         let c: i32 = 3;\n845:         let d: i64 = 4;\n846:         let e: u8 = 5;\n847:         let f: u16 = 6;\n848:         let g: u32 = 7;\n849:         let h: u64 = 8;\n850:         let i: f32 = 1.5;\n851:         let j: f64 = 2.5;\n852:         \"#,\n853:     )\n854:     .unwrap();\n855:     let checked = check(program).unwrap();\n856:     assert_eq!(type_of(&checked, \"a\"), Type::Native(NativeType::I8));\n857:     assert_eq!(type_of(&checked, \"b\"), Type::Native(NativeType::I16));\n858:     assert_eq!(type_of(&checked, \"c\"), Type::Native(NativeType::I32));\n859:     assert_eq!(type_of(&checked, \"d\"), Type::Native(NativeType::I64));\n860:     assert_eq!(type_of(&checked, \"e\"), Type::Native(NativeType::U8));\n861:     assert_eq!(type_of(&checked, \"f\"), Type::Native(NativeType::U16));\n862:     assert_eq!(type_of(&checked, \"g\"), Type::Native(NativeType::U32));\n863:     assert_eq!(type_of(&checked, \"h\"), Type::Native(NativeType::U64));\n864:     assert_eq!(type_of(&checked, \"i\"), Type::Native(NativeType::F32));\n865:     assert_eq!(type_of(&checked, \"j\"), Type::Native(NativeType::F64));\n866: }\n867: \n868: #[test]\n869: fn native_rejects_mismatched_native_width() {\n870:     let program = parse(\"let x: i32 = 1; let y: i64 = x;\").unwrap();\n871:     let err = check(program).unwrap_err();\n872:     assert!(\n873:         err.message.contains(\"not assignable\")\n874:             && err.message.contains(\"i32\")\n875:             && err.message.contains(\"i64\"),\n876:         \"unexpected: {}\",\n877:         err.message\n878:     );\n879: }\n880: \n881: #[test]\n882: fn native_rejects_number_binding_to_i32() {\n883:     let program = parse(\"let n: number = 1; let x: i32 = n;\").unwrap();\n884:     let err = check(program).unwrap_err();\n885:     assert!(\n886:         err.message.contains(\"not assignable\")\n887:             && err.message.contains(\"number\")\n888:             && err.message.contains(\"i32\"),\n889:         \"unexpected: {}\",\n890:         err.message\n891:     );\n892: }\n893: \n894: #[test]\n895: fn native_rejects_i32_to_number() {\n896:     let program = parse(\"let x: i32 = 1; let n: number = x;\").unwrap();\n897:     let err = check(program).unwrap_err();\n898:     assert!(\n899:         err.message.contains(\"not assignable\")\n900:             && err.message.contains(\"i32\")\n901:             && err.message.contains(\"number\"),\n902:         \"unexpected: {}\",\n903:         err.message\n904:     );\n905: }\n906: \n907: #[test]\n908: fn native_param_and_return() {\n909:     let program = parse(\n910:         r#\"\n911:         function add(a: i32, b: i32): i32 {\n912:           return a + b;\n913:         }\n914:         let s: i32 = add(1, 2);\n915:         \"#,\n916:     )\n917:     .unwrap();\n918:     let checked = check(program).unwrap();\n919:     assert_eq!(type_of(&checked, \"a\"), Type::Native(NativeType::I32));\n920:     assert_eq!(type_of(&checked, \"b\"), Type::Native(NativeType::I32));\n921:     assert_eq!(type_of(&checked, \"s\"), Type::Native(NativeType::I32));\n922: }\n923: \n924: #[test]\n925: fn native_same_type_assign_and_arith() {\n926:     let program = parse(\n927:         r#\"\n928:         let x: i32 = 10;\n929:         x = 20;\n930:         let y: i32 = x + 1;\n931:         let z: i32 = x - y;\n932:         \"#,\n933:     )\n934:     .unwrap();\n935:     let checked = check(program).unwrap();\n936:     assert_eq!(type_of(&checked, \"x\"), Type::Native(NativeType::I32));\n937:     assert_eq!(type_of(&checked, \"y\"), Type::Native(NativeType::I32));\n938:     assert_eq!(type_of(&checked, \"z\"), Type::Native(NativeType::I32));\n939: }\n940: \n941: #[test]\n942: fn native_in_alias_and_object() {\n943:     let program = parse(\n944:         r#\"\n945:         type Point = { x: i32; y: i32 };\n946:         let x0: i32 = 1;\n947:         let y0: i32 = 2;\n948:         let p: Point = { x: x0, y: y0 };\n949:         let x: i32 = p.x;\n950:         \"#,\n951:     )\n952:     .unwrap();\n953:     let checked = check(program).unwrap();\n954:     assert!(matches!(type_of(&checked, \"p\"), Type::Shape(_)));\n955:     assert_eq!(type_of(&checked, \"x\"), Type::Native(NativeType::I32));\n956: }\n957: \n958: #[test]\n959: fn native_unary_minus_literal_ok() {\n960:     let program = parse(\"let x: i32 = -1;\").unwrap();\n961:     let checked = check(program).unwrap();\n962:     assert_eq!(type_of(&checked, \"x\"), Type::Native(NativeType::I32));\n963: }\n964: \n965: // --- T06: dual-worlds boundary (`as`) ---\n966: \n967: #[test]\n968: fn dual_boundary_as_fixture_present() {\n969:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n970:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n971:     assert!(\n972:         ids.iter().any(|id| *id == \"types/dual/boundary_as\"),\n973:         \"missing types/dual/boundary_as fixture, got {ids:?}\"\n974:     );\n975: }\n976: \n977: #[test]\n978: fn dual_boundary_as_runs() {\n979:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n980:     let fixture = fixtures\n981:         .iter()\n982:         .find(|f| f.id == \"types/dual/boundary_as\")\n983:         .expect(\"types/dual/boundary_as\");\n984:     assert!(!fixture.targets.is_empty());\n985:     for r in run_fixture(fixture) {\n986:         assert!(\n987:             r.ok,\n988:             \"{} @ {}: {}\",\n989:             r.fixture_id,\n990:             r.target.as_str(),\n991:             r.message\n992:         );\n993:     }\n994: }\n995: \n996: #[test]\n997: fn as_number_to_i32() {\n