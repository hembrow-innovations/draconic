      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-check/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Binder (scopes + symbol resolution) and Checker (TypeScript-inspired).\n2: //! Binder: ROADMAP B04. Checker: ROADMAP B05.\n3: \n4: use draconic_ast::{\n5:     Arg, ArrayElement, ArrayPatternElement, ArrowBody, BinaryOp, BindingKind, BindingPattern,\n6:     ClassElement, Expr, ObjectKey, ObjectPatternProp, ObjectProp, Param, Program, Stmt, TypeAnn,\n7:     UnaryOp,\n8: };\n9: use draconic_diagnostics::{Diagnostic, Span};\n10: use std::collections::HashMap;\n11: use std::fmt;\n12: \n13: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n14: pub struct SymbolId(pub u32);\n15: \n16: #[derive(Debug, Clone, PartialEq, Eq)]\n17: pub struct Symbol {\n18:     pub id: SymbolId,\n19:     pub name: String,\n20:     /// Span of the binding name at the declaration site.\n21:     pub span: Span,\n22:     pub kind: BindingKind,\n23:     /// `with` nesting depth when this binding was declared (0 = outside any `with`).\n24:     /// Used so identifier uses inside `with` only rewrite to Locals declared in the\n25:     /// innermost with body; outer names stay bare for Object Environment shadowing.\n26:     pub with_depth: u32,\n27: }\n28: \n29: /// Unboxed native / systems types (T05). Outside the JS value heap.\n30: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n31: pub enum NativeType {\n32:     I8,\n33:     I16,\n34:     I32,\n35:     I64,\n36:     U8,\n37:     U16,\n38:     U32,\n39:     U64,\n40:     F32,\n41:     F64,\n42:     /// Unboxed native boolean (N02); distinct from JS `boolean`.\n43:     Bool,\n44: }\n45: \n46: impl NativeType {\n47:     pub fn from_name(name: &str) -> Option<Self> {\n48:         Some(match name {\n49:             \"i8\" => Self::I8,\n50:             \"i16\" => Self::I16,\n51:             \"i32\" => Self::I32,\n52:             \"i64\" => Self::I64,\n53:             \"u8\" => Self::U8,\n54:             \"u16\" => Self::U16,\n55:             \"u32\" => Self::U32,\n56:             \"u64\" => Self::U64,\n57:             \"f32\" => Self::F32,\n58:             \"f64\" => Self::F64,\n59:             \"bool\" => Self::Bool,\n60:             _ => return None,\n61:         })\n62:     }\n63: \n64:     pub fn as_str(self) -> &'static str {\n65:         match self {\n66:             Self::I8 => \"i8\",\n67:             Self::I16 => \"i16\",\n68:             Self::I32 => \"i32\",\n69:             Self::I64 => \"i64\",\n70:             Self::U8 => \"u8\",\n71:             Self::U16 => \"u16\",\n72:             Self::U32 => \"u32\",\n73:             Self::U64 => \"u64\",\n74:             Self::F32 => \"f32\",\n75:             Self::F64 => \"f64\",\n76:             Self::Bool => \"bool\",\n77:         }\n78:     }\n79: \n80:     pub fn is_float(self) -> bool {\n81:         matches!(self, Self::F32 | Self::F64)\n82:     }\n83: \n84:     pub fn is_bool(self) -> bool {\n85:         matches!(self, Self::Bool)\n86:     }\n87: \n88:     /// Integer native types only (`i8`–`i64`, `u8`–`u64`).\n89:     pub fn is_int(self) -> bool {\n90:         !self.is_float() && !self.is_bool()\n91:     }\n92: \n93:     pub fn is_signed(self) -> bool {\n94:         matches!(self, Self::I8 | Self::I16 | Self::I32 | Self::I64)\n95:     }\n96: \n97:     pub fn bit_width(self) -> u32 {\n98:         match self {\n99:             Self::I8 | Self::U8 | Self::Bool => 8,\n100:             Self::I16 | Self::U16 => 16,\n101:             Self::I32 | Self::U32 | Self::F32 => 32,\n102:             Self::I64 | Self::U64 | Self::F64 => 64,\n103:         }\n104:     }\n105: }\n106: \n107: /// TypeScript-inspired types for the minimal Program surface.\n108: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n109: pub enum Type {\n110:     Number,\n111:     BigInt,\n112:     String,\n113:     Boolean,\n114:     Null,\n115:     /// Callable function value (declaration or expression).\n116:     Function,\n117:     /// Ordinary object value without a known shape.\n118:     Object,\n119:     /// Structural object type; index into the shape table on `CheckedProgram`.\n120:     Shape(u32),\n121:     /// Union type; index into the unions table on `CheckedProgram`.\n122:     Union(u32),\n123:     /// Intersection type; index into the intersections table on `CheckedProgram`.\n124:     Intersection(u32),\n125:     /// Open type parameter while checking a generic body (T04); unique id.\n126:     TypeParam(u32),\n127:     /// Generic function signature; index into the generic_fns table (T04).\n128:     GenericFn(u32),\n129:     /// Unboxed native type (`i32`, `f64`, …); T05.\n130:     Native(NativeType),\n131:     /// Pointer to a native scalar (`*i32`, …); N03.03.\n132:     Ptr(NativeType),\n133:     /// Flexible / unannotated (e.g. `let x;` with no initializer).\n134:     Any,\n135: }\n136: \n137: /// Generic function signature stored for call-site instantiation (T04).\n138: #[derive(Debug, Clone, PartialEq, Eq)]\n139: pub struct GenericFnSig {\n140:     pub type_params: Vec<String>,\n141:     pub param_types: Vec<Option<TypeAnn>>,\n142:     pub return_type: Option<TypeAnn>,\n143: }\n144: \n145: /// Resolved signature for a non-generic annotated function (T07.01).\n146: /// Recorded for call-site argument checking: arity and per-param assignability.\n147: /// Only built when the function has at least one annotated parameter, so\n148: /// untyped (E19-era) JS stays fully permissive.\n149: #[derive(Debug, Clone)]\n150: struct FnSig {\n151:     /// Resolved type per parameter; `None` = unannotated (permissive).\n152:     param_types: Vec<Option<Type>>,\n153:     /// Number of annotated parameters without a default or rest that must be supplied.\n154:     required: usize,\n155:     /// Whether the final parameter is a rest param (extra args allowed).\n156:     has_rest: bool,\n157: }\n158: \n159: /// Generic type alias body (T04).\n160: #[derive(Debug, Clone, PartialEq, Eq)]\n161: struct GenericAlias {\n162:     params: Vec<String>,\n163:     body: TypeAnn,\n164: }\n165: \n166: /// Property list for a structural object type (`Type::Shape`).\n167: #[derive(Debug, Clone, PartialEq, Eq)]\n168: pub struct ObjectShape {\n169:     pub props: Vec<(String, Type)>,\n170: }\n171: \n172: /// Members of a union type (`Type::Union`).\n173: #[derive(Debug, Clone, PartialEq, Eq)]\n174: pub struct UnionType {\n175:     pub members: Vec<Type>,\n176: }\n177: \n178: /// Members of an intersection type (`Type::Intersection`).\n179: #[derive(Debug, Clone, PartialEq, Eq)]\n180: pub struct IntersectionType {\n181:     pub members: Vec<Type>,\n182: }\n183: \n184: impl fmt::Display for Type {\n185:     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n186:         let s = match self {\n187:             Type::Number => \"number\",\n188:             Type::BigInt => \"bigint\",\n189:             Type::String => \"string\",\n190:             Type::Boolean => \"boolean\",\n191:             Type::Null => \"null\",\n192:             Type::Function => \"function\",\n193:             Type::Object => \"object\",\n194:             Type::Shape(_) => \"object\",\n195:             Type::Union(_) => \"union\",\n196:             Type::Intersection(_) => \"intersection\",\n197:             Type::TypeParam(_) => \"type parameter\",\n198:             Type::GenericFn(_) => \"function\",\n199:             Type::Native(n) => n.as_str(),\n200:             Type::Ptr(n) => {\n201:                 return write!(f, \"*{}\", n.as_str());\n202:             }\n203:             Type::Any => \"any\",\n204:         };\n205:         write!(f, \"{s}\")\n206:     }\n207: }\n208: \n209: /// Program after scope analysis and identifier resolution.\n210: #[derive(Debug)]\n211: pub struct BoundProgram {\n212:     pub program: Program,\n213:     symbols: Vec<Symbol>,\n214:     /// Use-site identifier span → declared symbol.\n215:     resolutions: HashMap<Span, SymbolId>,\n216: }\n217: \n218: impl BoundProgram {\n219:     pub fn symbols(&self) -> &[Symbol] {\n220:         &self.symbols\n221:     }\n222: \n223:     pub fn resolve(&self, use_span: Span) -> Option<SymbolId> {\n224:         self.resolutions.get(&use_span).copied()\n225:     }\n226: \n227:     pub fn symbol(&self, id: SymbolId) -> &Symbol {\n228:         &self.symbols[id.0 as usize]\n229:     }\n230: }\n231: \n232: /// Bound program with inferred / checked types.\n233: #[derive(Debug)]\n234: pub struct CheckedProgram {\n235:     pub bound: BoundProgram,\n236:     /// Declaration symbol → type.\n237:     symbol_types: Vec<Type>,\n238:     /// Expression span → type.\n239:     expr_types: HashMap<Span, Type>,\n240:     /// Structural object shapes referenced by `Type::Shape`.\n241:     shapes: Vec<ObjectShape>,\n242:     /// Union members referenced by `Type::Union`.\n243:     unions: Vec<UnionType>,\n244:     /// Intersection members referenced by `Type::Intersection`.\n245:     intersections: Vec<IntersectionType>,\n246:     /// Generic function signatures referenced by `Type::GenericFn`.\n247:     generic_fns: Vec<GenericFnSig>,\n248: }\n249: \n250: impl CheckedProgram {\n251:     pub fn type_of_symbol(&self, id: SymbolId) -> Type {\n252:         self.symbol_types[id.0 as usize]\n253:     }\n254: \n255:     pub fn type_of_expr(&self, span: Span) -> Option<Type> {\n256:         self.expr_types.get(&span).copied()\n257:     }\n258: \n259:     pub fn shapes(&self) -> &[ObjectShape] {\n260:         &self.shapes\n261:     }\n262: \n263:     pub fn unions(&self) -> &[UnionType] {\n264:         &self.unions\n265:     }\n266: \n267:     pub fn intersections(&self) -> &[IntersectionType] {\n268:         &self.intersections\n269:     }\n270: \n271:     pub fn generic_fns(&self) -> &[GenericFnSig] {\n272:         &self.generic_fns\n273:     }\n274: \n275:     /// Pretty-print a type, expanding structural shapes and unions/intersections.\n276:     pub fn format_type(&self, ty: Type) -> String {\n277:         format_type_full(ty, &self.shapes, &self.unions, &self.intersections)\n278:     }\n279: }\n280: \n281: fn format_type_full(\n282:     ty: Type,\n283:     shapes: &[ObjectShape],\n284:     unions: &[UnionType],\n285:     intersections: &[IntersectionType],\n286: ) -> String {\n287:     match ty {\n288:         Type::Shape(id) => {\n289:             let Some(shape) = shapes.get(id as usize) else {\n290:                 return \"object\".to_string();\n291:             };\n292:             let props: Vec<String> = shape\n293:                 .props\n294:                 .iter()\n295:                 .map(|(n, t)| {\n296:                     format!(\"{n}: {}\", format_type_full(*t, shapes, unions, intersections))\n297:                 })\n298:                 .collect();\n299:             format!(\"{{ {} }}\", props.join(\"; \"))\n300:         }\n301:         Type::Union(id) => {\n302:             let Some(u) = unions.get(id as usize) else {\n303:                 return \"union\".to_string();\n304:             };\n305:             u.members\n306:                 .iter()\n307:                 .map(|t| format_type_full(*t, shapes, unions, intersections))\n308:                 .collect::<Vec<_>>()\n309:                 .join(\" | \")\n310:         }\n311:         Type::Intersection(id) => {\n312:             let Some(i) = intersections.get(id as usize) else {\n313:                 return \"intersection\".to_string();\n314:             };\n315:             i.members\n316:                 .iter()\n317:                 .map(|t| format_type_full(*t, shapes, unions, intersections))\n318:                 .collect::<Vec<_>>()\n319:                 .join(\" & \")\n320:         }\n321:         Type::TypeParam(_) => \"type parameter\".to_string(),\n322:         Type::GenericFn(_) => \"function\".to_string(),\n323:         Type::Native(n) => n.as_str().to_string(),\n324:         other => other.to_string(),\n325:     }\n326: }\n327: \n328: /// Bind scopes and resolve identifiers for a minimal Program.\n329: pub fn bind(program: Program) -> Result<BoundProgram, Diagnostic> {\n330:     let mut binder = Binder::new();\n331:     binder.bind_program(program, false)\n332: }\n333: \n334: /// Bind under Module goal (E19.67): top-level functions are lexical, not var-like.\n335: pub fn bind_module(program: Program) -> Result<BoundProgram, Diagnostic> {\n336:     let mut binder = Binder::new();\n337:     binder.strict = true;\n338:     binder.bind_program(program, true)\n339: }\n340: \n341: pub fn check(program: Program) -> Result<CheckedProgram, Diagnostic> {\n342:     // Script goal: top-level `await` / `for await` rejected.\n343:     check_with_module_goal(program, false)\n344: }\n345: \n346: /// Check a Program under the Module goal (E19.28): top-level `await` and\n347: /// `for await` are allowed (async module). Nested non-async functions still\n348: /// reject `await`.\n349: pub fn check_module(program: Program) -> Result<CheckedProgram, Diagnostic> {\n350:     check_with_module_goal(program, true)\n351: }\n352: \n353: fn check_with_module_goal(\n354:     program: Program,\n355:     module_goal: bool,\n356: ) -> Result<CheckedProgram, Diagnostic> {\n357:     let bound = if module_goal {\n358:         bind_module(program)?\n359:     } else {\n360:         bind(program)?\n361:     };\n362:     let mut checker = Checker::new(&bound);\n363:     // Module evaluation may be async when the body uses top-level await.\n364:     checker.in_async = module_goal;\n365:     checker.check_program()?;\n366:     let symbol_types = checker.symbol_types;\n367:     let expr_types = checker.expr_types;\n368:     let shapes = checker.shapes;\n369:     let unions = checker.unions;\n370:     let intersections = checker.intersections;\n371:     let generic_fns = checker.generic_fns;\n372:     Ok(CheckedProgram {\n373:         bound,\n374:         symbol_types,\n375:         expr_types,\n376:         shapes,\n377:         unions,\n378:         intersections,\n379:         generic_fns,\n380:     })\n381: }\n382: \n383: /// Whether a labelled item is (or wraps) an iteration statement — needed for\n384: /// `continue label` validity (ECMA-262 LabelledStatement).\n385: fn is_iteration_labelled_item(stmt: &Stmt) -> bool {\n386:     match stmt {\n387:         Stmt::While { .. }\n388:         | Stmt::DoWhile { .. }\n389:         | Stmt::For { .. }\n390:         | Stmt::ForIn { .. }\n391:         | Stmt::ForOf { .. } => true,\n392:         Stmt::Labeled { body, .. } => is_iteration_labelled_item(body),\n393:         _ => false,\n394:     }\n395: }\n396: \n397: /// If any catch-parameter bound name appears in LexicallyDeclaredNames of the\n398: /// catch Block, return the conflicting name and its declaration span. Annex\n399: /// B.3.4 allows the same name in VarDeclaredNames (`var`); only lexical\n400: /// `let`/`const`/`class`/`function` at the top level of the catch block are rejected.\n401: fn catch_lexical_conflict(param: &BindingPattern, handler: &Stmt) -> Option<(String, Span)> {\n402:     let body: &[Stmt] = match handler {\n403:         Stmt::Block { body, .. } => body.as_slice(),\n404:         other => std::slice::from_ref(other),\n405:     };\n406:     let mut conflict = None;\n407:     param.for_each_ident(&mut |id| {\n408:         if conflict.is_some() {\n409:             return;\n410:         }\n411:         for stmt in body {\n412:             if let Some(span) = catch_stmt_lexical_name(stmt, &id.name) {\n413:                 conflict = Some((id.name.clone(), span));\n414:                 return;\n415:             }\n416:         }\n417:     });\n418:     conflict\n419: }\n420: \n421: fn catch_stmt_lexical_name(stmt: &Stmt, param: &str) -> Option<Span> {\n422:     let mut s = stmt;\n423:     while let Stmt::Labeled { body, .. } = s {\n424:         s = body;\n425:     }\n426:     match s {\n427:         Stmt::Let {\n428:             kind: BindingKind::Let | BindingKind::Const | BindingKind::Using | BindingKind::AwaitUsing,\n429:             binding,\n430:             ..\n431:         } => {\n432:             let mut found = None;\n433:             binding.for_each_ident(&mut |id| {\n434:                 if found.is_none() && id.name == param {\n435:                     found = Some(id.span);\n436:                 }\n437:             });\n438:             found\n439:         }\n440:         Stmt::ClassDeclaration { name, .. } | Stmt::FunctionDeclaration { name, .. }\n441:             if name.name == param =>\n442:         {\n443:             Some(name.span)\n444:         }\n445:         _ => None,\n446:     }\n447: }\n448: \n449: /// Lexical binding kind for statement-list early errors (E19.24 / Annex B.3.3).\n450: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n451: enum LexNameKind {\n452:     /// Plain `function` (not async/generator): sloppy mode may allow duplicates among these only.\n453:     PlainFunction,\n454:     Other,\n455: }\n456: \n457: fn peel_labels(stmt: &Stmt) -> &Stmt {\n458:     let mut s = stmt;\n459:     while let Stmt::Labeled { body, .. } = s {\n460:         s = body;\n461:     }\n462:     s\n463: }\n464: \n465: /// ECMA-262 IsSimpleParameterList: only BindingIdentifiers, no rest/defaults.\n466: fn is_simple_parameter_list(params: &[Param]) -> bool {\n467:     params.iter().all(|p| {\n468:         !p.rest && p.default.is_none() && matches!(p.binding, BindingPattern::Ident(_))\n469:     })\n470: }\n471: \n472: /// SuperCall in parameter defaults (E19.39 method early error).\n473: fn params_contain_super_call(params: &[Param]) -> bool {\n474:     params\n475:         .iter()\n476:         .any(|p| p.default.as_ref().is_some_and(expr_contains_super_call))\n477: }\n478: \n479: /// SuperCall or SuperProperty in formals (plain / async / generator functions).\n480: fn params_contain_super(params: &[Param]) -> bool {\n481:     params\n482:         .iter()\n483:         .any(|p| p.default.as_ref().is_some_and(expr_contains_super))\n484: }\n485: \n486: /// True when `expr` is (or chains from) an OptionalExpression (`?.`).\n487: fn expr_has_optional_chain(expr: &Expr) -> bool {\n488:     match expr {\n489:         Expr::MemberExpression {\n490:             object, optional, ..\n491:         } => *optional || expr_has_optional_chain(object),\n492:         Expr::Call {\n493:             callee, optional, ..\n494:         } => *optional || expr_has_optional_chain(callee),\n495:         Expr::Paren { expr: inner, .. } => expr_has_optional_chain(inner),\n496:         _ => false,\n497:     }\n498: }\n499: \n500: fn expr_contains_super_call(expr: &Expr) -> bool {\n501:     match expr {\n502:         Expr::Call { callee, args, .. } => {\n503:             matches!(callee.as_ref(), Expr::Super { .. })\n504:                 || expr_contains_super_call(callee)\n505:                 || args.iter().any(|a| match a {\n506:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super_call(e),\n507:                 })\n508:         }\n509:         Expr::ArrowFunction { body, params, .. } => {\n510:             params_contain_super_call(params)\n511:                 || match body {\n512:                     ArrowBody::Expr(e) => expr_contains_super_call(e),\n513:                     ArrowBody::Block(s) => stmt_contains_super_call(s),\n514:                 }\n515:         }\n516:         Expr::FunctionExpression { .. } | Expr::ClassExpression { .. } => false,\n517:         Expr::Paren { expr: inner, .. }\n518:         | Expr::Unary { arg: inner, .. }\n519:         | Expr::Update { arg: inner, .. }\n520:         | Expr::As { expr: inner, .. } => expr_contains_super_call(inner),\n521:         Expr::Binary { left, right, .. }\n522:         | Expr::Assign {\n523:             target: left,\n524:             value: right,\n525:             ..\n526:         } => expr_contains_super_call(left) || expr_contains_super_call(right),\n527:         Expr::Conditional {\n528:             test,\n529:             consequent,\n530:             alternate,\n531:             ..\n532:         } => {\n533:             expr_contains_super_call(test)\n534:                 || expr_contains_super_call(consequent)\n535:                 || expr_contains_super_call(alternate)\n536:         }\n537:         Expr::MemberExpression {\n538:             object, property, ..\n539:         } => expr_contains_super_call(object) || expr_contains_super_call(property),\n540:         Expr::New { callee, args, .. } => {\n541:             expr_contains_super_call(callee)\n542:                 || args.iter().any(|a| match a {\n543:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super_call(e),\n544:                 })\n545:         }\n546:         Expr::ArrayExpression { elements, .. } => elements.iter().any(|el| match el {\n547:             ArrayElement::Expr(e) | ArrayElement::Spread(e) => expr_contains_super_call(e),\n548:             ArrayElement::Elision => false,\n549:         }),\n550:         Expr::ObjectExpression { properties, .. } => properties.iter().any(|p| match p {\n551:             ObjectProp::Property { value, .. } => expr_contains_super_call(value),\n552:             ObjectProp::Spread { expr, .. } => expr_contains_super_call(expr),\n553:             ObjectProp::Accessor { .. } => false,\n554:         }),\n555:         _ => false,\n556:     }\n557: }\n558: \n559: /// SuperCall or SuperProperty (not nested in inner functions/classes).\n560: fn expr_contains_super(expr: &Expr) -> bool {\n561:     match expr {\n562:         Expr::Super { .. } => true,\n563:         Expr::Call { callee, args, .. } | Expr::New { callee, args, .. } => {\n564:             expr_contains_super(callee)\n565:                 || args.iter().any(|a| match a {\n566:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super(e),\n567:                 })\n568:         }\n569:         Expr::ArrowFunction { body, params, .. } => {\n570:             params_contain_super(params)\n571:                 || match body {\n572:                     ArrowBody::Expr(e) => expr_contains_super(e),\n573:                     ArrowBody::Block(s) => stmt_contains_super(s),\n574:                 }\n575:         }\n576:         // Nested function/class bodies are their own ContainsSuper roots.\n577:         Expr::FunctionExpression { .. } | Expr::ClassExpression { .. } => false,\n578:         Expr::Paren { expr: inner, .. }\n579:         | Expr::Unary { arg: inner, .. }\n580:         | Expr::Update { arg: inner, .. }\n581:         | Expr::As { expr: inner, .. } => expr_contains_super(inner),\n582:         Expr::Binary { left, right, .. }\n583:         | Expr::Assign {\n584:             target: left,\n585:             value: right,\n586:             ..\n587:         } => expr_contains_super(left) || expr_contains_super(right),\n588:         Expr::Conditional {\n589:             test,\n590:             consequent,\n591:             alternate,\n592:             ..\n593:         } => {\n594:             expr_contains_super(test)\n595:                 || expr_contains_super(consequent)\n596:                 || expr_contains_super(alternate)\n597:         }\n598:         Expr::MemberExpression {\n599:             object, property, ..\n600:         } => expr_contains_super(object) || expr_contains_super(property),\n601:         Expr::ArrayExpression { elements, .. } => elements.iter().any(|el| match el {\n602:             ArrayElement::Expr(e) | ArrayElement::Spread(e) => expr_contains_super(e),\n603:             ArrayElement::Elision => false,\n604:         }),\n605:         Expr::ObjectExpression { properties, .. } => properties.iter().any(|p| match p {\n606:             ObjectProp::Property { value, .. } => expr_contains_super(value),\n607:             ObjectProp::Spread { expr, .. } => expr_contains_super(expr),\n608:             ObjectProp::Accessor { .. } => false,\n609:         }),\n610:         _ => false,\n611:     }\n612: }\n613: \n614: fn stmt_contains_super(stmt: &Stmt) -> bool {\n615:     match stmt {\n616:         Stmt::Block { body, .. } => body.iter().any(stmt_contains_super),\n617:         Stmt::Expression { expr, .. } => expr_contains_super(expr),\n618:         Stmt::Return { argument, .. } => argument.as_ref().is_some_and(expr_contains_super),\n619:         Stmt::Throw { argument, .. } => expr_contains_super(argument),\n620:         Stmt::If {\n621:             test,\n622:             consequent,\n623:             alternate,\n624:             ..\n625:         } => {\n626:             expr_contains_super(test)\n627:                 || stmt_contains_super(consequent)\n628:                 || alternate.as_ref().is_some_and(|a| stmt_contains_super(a))\n629:         }\n630:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n631:             expr_contains_super(test) || stmt_contains_super(body)\n632:         }\n633:         Stmt::Let { init, .. } => init.as_ref().is_some_and(expr_contains_super),\n634:         // Nested function/class declarations are separate ContainsSuper roots.\n635:         Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => false,\n636:         _ => false,\n637:     }\n638: }\n639: \n640: fn stmt_contains_super_call(stmt: &Stmt) -> bool {\n641:     match stmt {\n642:         Stmt::Block { body, .. } => body.iter().any(stmt_contains_super_call),\n643:         Stmt::Expression { expr, .. } => expr_contains_super_call(expr),\n644:         Stmt::Return { argument, .. } => argument.as_ref().is_some_and(expr_contains_super_call),\n645:         Stmt::Throw { argument, .. } => expr_contains_super_call(argument),\n646:         Stmt::If {\n647:             test,\n648:             consequent,\n649:             alternate,\n650:             ..\n651:         } => {\n652:             expr_contains_super_call(test)\n653:                 || stmt_contains_super_call(consequent)\n654:                 || alternate.as_ref().is_some_and(|a| stmt_contains_super_call(a))\n655:         }\n656:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n657:             expr_contains_super_call(test) || stmt_contains_super_call(body)\n658:         }\n659:         Stmt::Let { init, .. } => init.as_ref().is_some_and(expr_contains_super_call),\n660:         _ => false,\n661:     }\n662: }\n663: \n664: /// `true` when `stmts` begins with a `\"use strict\"` directive prologue.\n665: fn stmt_list_has_use_strict(stmts: &[Stmt]) -> bool {\n666:     for stmt in stmts {\n667:         match stmt {\n668:             Stmt::Expression {\n669:                 expr: Expr::String(s),\n670:                 ..\n671:             } => {\n672:                 if s.value.to_string_lossy() == \"use strict\" {\n673:                     return true;\n674:                 }\n675:             }\n676:             _ => break,\n677:         }\n678:     }\n679:     false\n680: }\n681: \n682: fn body_has_use_strict(body: &Stmt) -> bool {\n683:     match body {\n684:         Stmt::Block { body, .. } => stmt_list_has_use_strict(body),\n685:         _ => false,\n686:     }\n687: }\n688: \n689: /// `true` for the literal `true` expression (used by T07.02 loop reachability).\n690: fn is_literal_true(expr: &Expr) -> bool {\n691:     matches!(expr, Expr::Boolean { value: true, .. })\n692: }\n693: \n694: /// Whether `stmt` — the body of a loop — contains an unlabeled `break` that would\n695: /// exit that loop, i.e. a `break` not shadowed by an inner loop or switch.\n696: fn loop_body_has_escaping_break(stmt: &Stmt) -> bool {\n697:     match stmt {\n698:         Stmt::Block { body, .. } => body.iter().any(loop_body_has_escaping_break),\n699:         Stmt::If {\n700:             consequent,\n701:             alternate,\n702:             ..\n703:         } => {\n704:             loop_body_has_escaping_break(consequent)\n705:                 || alternate.as_deref().is_some_and(loop_body_has_escaping_break)\n706:         }\n707:         Stmt::Try {\n708:             block,\n709:             handler,\n710:             finalizer,\n711:             ..\n712:         } => {\n713:             loop_body_has_escaping_break(block)\n714:                 || handler.as_deref().is_some_and(loop_body_has_escaping_break)\n715:                 || finalizer.as_deref().is_some_and(loop_body_has_escaping_break)\n716:         }\n717:         Stmt::Labeled { body, .. } => loop_body_has_escaping_break(body),\n718:         // A `break` inside these targets the inner construct, not the outer loop.\n719:         Stmt::While { .. }\n720:         | Stmt::DoWhile { .. }\n721:         | Stmt::For { .. }\n722:         | Stmt::ForIn { .. }\n723:         | Stmt::ForOf { .. }\n724:         | Stmt::Switch { .. } => false,\n725:         Stmt::Break { label, .. } => label.is_none(),\n726:         _ => false,\n727:     }\n728: }\n729: \n730: /// Whether control flow can never reach the end of `stmt` (always returns, throws,\n731: /// or loops forever). Conservative toward \"terminates\" to avoid false positives on\n732: /// valid code; used by the T07.02 missing-return check.\n733: fn stmt_cannot_fall_through(stmt: &Stmt) -> bool {\n734:     match stmt {\n735:         Stmt::Return { .. } | Stmt::Throw { .. } => true,\n736:         Stmt::Block { body, .. } => body.iter().any(stmt_cannot_fall_through),\n737:         Stmt::If {\n738:             consequent,\n739:             alternate,\n740:             ..\n741:         } => match alternate {\n742:             Some(alt) => {\n743:                 stmt_cannot_fall_through(consequent) && stmt_cannot_fall_through(alt)\n744:             }\n745:             None => false,\n746:         },\n747:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n748:             is_literal_true(test) && !loop_body_has_escaping_break(body)\n749:         }\n750:         Stmt::For { test, body, .. } => {\n751:             test.as_ref().is_none_or(is_literal_true) && !loop_body_has_escaping_break(body)\n752:         }\n753:         Stmt::Switch { cases, .. } => {\n754:             // A `default` must exist (a non-matching discriminant otherwise exits the\n755:             // switch) and the concatenated case bodies, in source order, must reach a\n756:             // terminating statement (case bodies fall through to the next case).\n757:             if !cases.iter().any(|c| c.test.is_none()) {\n758:                 return false;\n759:             }\n760:             cases.iter().any(|c| c.body.iter().any(stmt_cannot_fall_through))\n761:         }\n762:         _ => false,\n763:     }\n764: }\n765: \n766: fn stmt_span(stmt: &Stmt) -> Span {\n767:     match stmt {\n768:         Stmt::Expression { span, .. }\n769:         | Stmt::Let { span, .. }\n770:         | Stmt::Empty { span }\n771:         | Stmt::Block { span, .. }\n772:         | Stmt::If { span, .. }\n773:         | Stmt::While { span, .. }\n774:         | Stmt::DoWhile { span, .. }\n775:         | Stmt::For { span, .. }\n776:         | Stmt::ForIn { span, .. }\n777:         | Stmt::ForOf { span, .. }\n778:         | Stmt::Break { span, .. }\n779:         | Stmt::Continue { span, .. }\n780:         | Stmt::Labeled { span, .. }\n781:         | Stmt::Switch { span, .. }\n782:         | Stmt::FunctionDeclaration { span, .. }\n783:         | Stmt::ClassDeclaration { span, .. }\n784:         | Stmt::Return { span, .. }\n785:         | Stmt::Throw { span, .. }\n786:         | Stmt::Try { span, .. }\n787:         | Stmt::With { span, .. }\n788:         | Stmt::ImportDeclaration { span, .. }\n789:         | Stmt::ExportNamedDeclaration { span, .. }\n790:         | Stmt::ExportDefaultDeclaration { span, .. }\n791:         | Stmt::ExportAllDeclaration { span, .. }\n792:         | Stmt::TypeAlias { span, .. } => *span,\n793:     }\n794: }\n795: \n796: /// Peel covering parentheses (E19.60 cover IdentifierReference).\n797: fn peel_parens(expr: &Expr) -> &Expr {\n798:     let mut inner = expr;\n799:     while let Expr::Paren { expr, .. } = inner {\n800:         inner = expr.as_ref();\n801:     }\n802:     inner\n803: }\n804: \n805: /// The formal parameters of a function expression / arrow value (peeling parens),\n806: /// if `expr` denotes one. Used to record call signatures for function bindings (T07.01).\n807: fn fn_params_of_expr(expr: &Expr) -> Option<&[Param]> {\n808:     match peel_parens(expr) {\n809:         Expr::FunctionExpression { params, .. } | Expr::ArrowFunction { params, .. } => {\n810:             Some(params)\n811:         }\n812:         _ => None,\n813:     }\n814: }\n815: \n816: /// Peel parens; if the core is Ident `eval`/`arguments`, return (name, span). E19.49.\n817: fn strict_forbidden_assign_target(expr: &Expr) -> Option<(String, Span)> {\n818:     match peel_parens(expr) {\n819:         Expr::Ident(id) if id.name == \"eval\" || id.name == \"arguments\" => {\n820:             Some((id.name.clone(), id.span))\n821:         }\n822:         _ => None,\n823:     }\n824: }\n825: \n826: /// LexicallyDeclaredNames of a StatementList (not nested blocks).\n827: ///\n828: /// When `top_level` (Script / FunctionBody), hoistable `function`/`async`/`generator`\n829: /// declarations are **not** lexical (TopLevelLexicallyDeclaredNames); they are var-like.\n830: fn collect_lexically_declared_names<'a, I>(\n831:     stmts: I,\n832:     top_level: bool,\n833: ) -> Vec<(String, Span, LexNameKind)>\n834: where\n835:     I: IntoIterator<Item = &'a Stmt>,\n836: {\n837:     let mut out = Vec::new();\n838:     for stmt in stmts {\n839:         let s = peel_labels(stmt);\n840:         match s {\n841:             Stmt::Let {\n842:                 kind: BindingKind::Let | BindingKind::Const | BindingKind::Using | BindingKind::AwaitUsing,\n843:                 binding,\n844:                 ..\n845:             } => {\n846:                 binding.for_each_ident(&mut |id| {\n847:                     out.push((id.name.clone(), id.span, LexNameKind::Other));\n848:                 });\n849:             }\n850:             Stmt::ClassDeclaration { name, .. } => {\n851:                 out.push((name.name.clone(), name.span, LexNameKind::Other));\n852:             }\n853:             Stmt::FunctionDeclaration {\n854:                 name,\n855:                 is_async,\n856:                 is_generator,\n857:                 ..\n858:             } => {\n859:                 // Script/FunctionBody: hoistables are TopLevelVarDeclaredNames only.\n860:                 if top_level {\n861:                     continue;\n862:                 }\n863:                 let kind = if *is_async || *is_generator {\n864:                     LexNameKind::Other\n865:                 } else {\n866:                     LexNameKind::PlainFunction\n867:                 };\n868:                 out.push((name.name.clone(), name.span, kind));\n869:             }\n870:             _ => {}\n871:         }\n872:     }\n873:     out\n874: }\n875: \n876: /// VarDeclaredNames of a StatementList (walks nested statements; not function/class bodies).\n877: ///\n878: /// When `top_level`, direct hoistable function declarations are included\n879: /// (TopLevelVarDeclaredNames).\n880: fn collect_var_declared_names<'a, I>(stmts: I, top_level: bool) -> Vec<(String, Span)>\n881: where\n882:     I: IntoIterator<Item = &'a Stmt>,\n883: {\n884:     let mut out = Vec::new();\n885:     for stmt in stmts {\n886:         if top_level {\n887:             let s = peel_labels(stmt);\n888:             if let Stmt::FunctionDeclaration { name, .. } = s {\n889:                 out.push((name.name.clone(), name.span));\n890:             }\n891:         }\n892:         collect_var_declared_names_stmt(stmt, &mut out);\n893:     }\n894:     out\n895: }\n896: \n897: fn collect_var_declared_names_stmt(stmt: &Stmt, out: &mut Vec<(String, Span)>) {\n898:     match stmt {\n899:         Stmt::Labeled { body, .. } => collect_var_declared_names_stmt(body, out),\n900:         Stmt::Let {\n901:             kind: BindingKind::Var,\n902:             binding,\n903:             ..\n904:         } => {\n905:             binding.for_each_ident(&mut |id| {\n906:                 out.push((id.name.clone(), id.span));\n907:             });\n908:         }\n909:         Stmt::Block { body, .. } => {\n910:             for child in body {\n911:                 collect_var_declared_names_stmt(child, out);\n912:             }\n913:         }\n914:         Stmt::If {\n915:             consequent,\n916:             alternate,\n917:             ..\n918:         } => {\n919:             collect_var_declared_names_stmt(consequent, out);\n920:             if let Some(alt) = alternate {\n921:                 collect_var_declared_names_stmt(alt, out);\n922:             }\n923:         }\n924:         Stmt::While { body, .. } | Stmt::DoWhile { body, .. } | Stmt::With { body, .. } => {\n925:             collect_var_declared_names_stmt(body, out);\n926:         }\n927:         Stmt::For {\n928:             init, body, ..\n929:         } => {\n930:             if let Some(init) = init {\n931:                 collect_var_declared_names_stmt(init, out);\n932:             }\n933:             collect_var_declared_names_stmt(body, out);\n934:         }\n935:         Stmt::ForIn { left, body, .. } | Stmt::ForOf { left, body, .. } => {\n936:             collect_var_declared_names_stmt(left, out);\n937:             collect_var_declared_names_stmt(body, out);\n938:         }\n939:         Stmt::Switch { cases, .. } => {\n940:             for case in cases {\n941:                 for child in &case.body {\n942:                     collect_var_declared_names_stmt(child, out);\n943:                 }\n944:             }\n945:         }\n946:         Stmt::Try {\n947:             block,\n948:             handler,\n949:             finalizer,\n950:             ..\n951:         } => {\n952:             collect_var_declared_names_stmt(block, out);\n953:             if let Some(handler) = handler {\n954:                 collect_var_declared_names_stmt(handler, out);\n955:             }\n956:             if let Some(finalizer) = finalizer {\n957:                 collect_var_declared_names_stmt(finalizer, out);\n958:             }\n959:         }\n960:         Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => {}\n961:         _ => {}\n962:     }\n963: }\n964: \n965: /// Statement-list early errors (E19.24).\n966: ///\n967: /// - LexicallyDeclaredNames must not contain duplicates (Annex B: sloppy plain\n968: ///   `function` duplicates only are allowed — block/switch only).\n969: /// - LexicallyDeclaredNames ∩ VarDeclaredNames must be empty.\n970: ///\n971: /// `top_level`: Script or FunctionBody (TopLevel*DeclaredNames); otherwise Block/CaseBlock.\n972: fn check_statement_list_early_errors<'a, I>(\n973:     stmts: I,\n974:     strict: bool,\n975:     top_level: bool,\n976: ) -> Result<(), Diagnostic>\n977: where\n978:     I: IntoIterator<Item = &'a Stmt> + Clone,\n979: {\n980:     let lexical = collect_lexically_declared_names(stmts.clone(), top_level);\n981:     let mut seen: HashMap<String, LexNameKind> = HashMap::new();\n982:     for (name, span, kind) in &lexical {\n983:         if let Some(prev) = seen.get(name) {\n984:             let allow_sloppy_fn = !strict\n985:                 && !top_level\n986:                 && *prev == LexNameKind::PlainFunction\n987:                 && *kind == LexNameKind::PlainFunction;\n988:             if !allow_sloppy_fn {\n989:                 return Err(Diagnostic::new(\n990:                     format!(\"duplicate declaration of `{name}`\"),\n991:                     *span,\n992:                 ));\n993:             }\n994:         } else {\n995:             seen.insert(name.clone(), *kind);\n996:         }\n997:     }\n998:     let vars = collect_var_declared_names(stmts, top_level);\n999:     let mut var_names = HashMap::new();\n1000:     for (name, span) in vars {\n1001:         var_names.entry(name).or_insert(span);\n1002:     }\n1003:     for (name, span, _) in &lexical {\n1004:         if var_names.contains_key(name) {\n1005:             return Err(Diagnostic::new(\n1006:                 format!(\"duplicate declaration of `{name}`\"),\n1007:                 *span,\n1008:             ));\n1009:         }\n1010:     }\n1011:     Ok(())\n1012: }\n1013: \n1014: struct Binder {\n1015:     /// Scope stack (innermost last): name → symbol id.\n1016:     scopes: Vec<HashMap<String, SymbolId>>,\n1017:     /// Indices into `scopes` that are var environments (program + function).\n1018:     var_env_indices: Vec<usize>,\n1019:     /// Host globals (e.g. `Math`): resolve after lexical scopes so `let Math` can shadow.\n1020:     builtins: HashMap<String, SymbolId>,\n1021:     symbols: Vec<Symbol>,\n1022:     resolutions: HashMap<Span, SymbolId>,\n1023:     /// Nesting depth of enclosing `with` statements.\n1024:     with_depth: u32,\n1025:     /// Current strict-mode code (directive prologue / nested function body).\n1026:     strict: bool,\n1027:     /// SuperProperty allowed (class/object method or constructor). Arrows inherit; plain\n1028:     /// functions clear it. SuperCall is never allowed in arrows (E19.58).\n1029:     super_allowed: bool,\n1030: }\n1031: \n1032: impl Binder {\n1033:     fn new() -> Self {\n1034:         let mut binder = Self {\n1035:             scopes: vec![HashMap::new()],\n1036:             // Program/script body is a var environment.\n1037:             var_env_indices: vec![0],\n1038:             builtins: HashMap::new(),\n1039:             symbols: Vec::new(),\n1040:             resolutions: HashMap::new(),\n1041:             with_depth: 0,\n1042:             strict: false,\n1043:             super_allowed: false,\n1044:         };\n1045:         binder.install_builtin(\"Math\", BindingKind::Const);\n1046:         binder.install_builtin(\"Number\", BindingKind::Const);\n1047:         binder.install_builtin(\"NaN\", BindingKind::Const);\n1048:         binder.install_builtin(\"Infinity\", BindingKind::Const);\n1049:         binder.install_builtin(\"Symbol\", BindingKind::Const);\n1050:         binder.install_builtin(\"Promise\", BindingKind::Const);\n1051:         binder.install_builtin(\"Proxy\", BindingKind::Const);\n1052:         binder.install_builtin(\"Reflect\", BindingKind::Const);\n1053:         // E19.73: ShadowRealm constructor (host Node --harmony-shadow-realm)\n1054:         binder.install_builtin(\"ShadowRealm\", BindingKind::Const);\n1055:         // E15.01: global object basics\n1056:         binder.install_builtin(\"undefined\", BindingKind::Const);\n1057:         binder.install_builtin(\"globalThis\", BindingKind::Const);\n1058:         binder.install_builtin(\"Object\", BindingKind::Const);\n1059:         binder.install_builtin(\"Function\", BindingKind::Const);\n1060:         binder.install_builtin(\"Array\", BindingKind::Const);\n1061:         binder.install_builtin(\"String\", BindingKind::Const);\n1062:         binder.install_builtin(\"Boolean\", BindingKind::Const);\n1063:         // E15.02: Error constructors\n1064:         binder.install_builtin(\"Error\", BindingKind::Const);\n1065:         binder.install_builtin(\"TypeError\", BindingKind::Const);\n1066:         binder.install_builtin(\"RangeError\", BindingKind::Const);\n1067:         binder.install_builtin(\"ReferenceError\", BindingKind::Const);\n1068:         binder.install_builtin(\"SyntaxError\", BindingKind::Const);\n1069:         binder.install_builtin(\"URIError\", BindingKind::Const);\n1070:         binder.install_builtin(\"EvalError\", BindingKind::Const);\n1071:         binder.install_builtin(\"AggregateError\", BindingKind::Const);\n1072:         // E15.03: global number-parsing / predicate functions\n1073:         binder.install_builtin(\"parseInt\", BindingKind::Const);\n1074:         binder.install_builtin(\"parseFloat\", BindingKind::Const);\n1075:         binder.install_builtin(\"isNaN\", BindingKind::Const);\n1076:         binder.install_builtin(\"isFinite\", BindingKind::Const);\n1077:         // E15.04: URI encode/decode\n1078:         binder.install_builtin(\"encodeURI\", BindingKind::Const);\n1079:         binder.install_builtin(\"decodeURI\", BindingKind::Const);\n1080:         binder.install_builtin(\"encodeURIComponent\", BindingKind::Const);\n1081:         binder.install_builtin(\"decodeURIComponent\", BindingKind::Const);\n1082:         // E15.05: JSON\n1083:         binder.install_builtin(\"JSON\", BindingKind::Const);\n1084:         // E15.06: Date\n1085:         binder.install_builtin(\"Date\", BindingKind::Const);\n1086:         // E15.07: RegExp\n1087:         binder.install_builtin(\"RegExp\", BindingKind::Const);\n1088:         // E15.08: Map / Set\n1089:         binder.install_builtin(\"Map\", BindingKind::Const);\n1090:         binder.install_builtin(\"Set\", BindingKind::Const);\n1091:         // E15.09: WeakMap / WeakSet\n1092:         binder.install_builtin(\"WeakMap\", BindingKind::Const);\n1093:         binder.install_builtin(\"WeakSet\", BindingKind::Const);\n1094:         // E15.10: ArrayBuffer / DataView / TypedArrays\n1095:         binder.install_builtin(\"ArrayBuffer\", BindingKind::Const);\n1096:         binder.install_builtin(\"DataView\", BindingKind::Const);\n1097:         binder.install_builtin(\"Int8Array\", BindingKind::Const);\n1098:         binder.install_builtin(\"Uint8Array\", BindingKind::Const);\n1099:         binder.install_builtin(\"Uint8ClampedArray\", BindingKind::Const);\n1100:         binder.install_builtin(\"Int16Array\", BindingKind::Const);\n1101:         binder.install_builtin(\"Uint16Array\", BindingKind::Const);\n1102:         binder.install_builtin(\"Int32Array\", BindingKind::Const);\n1103:         binder.install_builtin(\"Uint32Array\", BindingKind::Const);\n1104:         binder.install_builtin(\"Float32Array\", BindingKind::Const);\n1105:         binder.install_builtin(\"Float64Array\", BindingKind::Const);\n1106:         binder.install_builtin(\"BigInt64Array\", BindingKind::Const);\n1107:         binder.install_builtin(\"BigUint64Array\", BindingKind::Const);\n1108:         // E16.01: direct eval\n1109:         binder.install_builtin(\"eval\", BindingKind::Const);\n1110:         // E18.01: Annex B escape / unescape\n1111:         binder.install_builtin(\"escape\", BindingKind::Const);\n1112:         binder.install_builtin(\"unescape\", BindingKind::Const);\n1113:         binder\n1114:     }\n1115: \n1116:     /// Register a host global. Not placed in lexical scopes so programs may shadow it.\n1117:     fn install_builtin(&mut self, name: &str, kind: BindingKind) {\n1118:         let id = SymbolId(self.symbols.len() as u32);\n1119:         self.symbols.push(Symbol {\n1120:             id,\n1121:             name: name.to_string(),\n1122:             span: Span::dummy(),\n1123:             kind,\n1124:             with_depth: 0,\n1125:         });\n1126:         self.builtins.insert(name.to_string(), id);\n1127:     }\n1128: \n1129:     fn bind_program(\n1130:         &mut self,\n1131:         program: Program,\n1132:         module_goal: bool,\n1133:     ) -> Result<BoundProgram, Diagnostic> {\n1134:         if stmt_list_has_use_strict(&program.body) {\n1135:             self.strict = true;\n1136:         }\n1137:         // E19.67: Module top-level uses Block-like LexicallyDeclaredNames (functions are\n1138:         // lexical). Script/FunctionBody use TopLevel*DeclaredNames (functions are var-like).\n1139:         let top_level = !module_goal;\n1140:         self.bind_stmt_list(&program.body, top_level)?;\n1141: \n1142:         Ok(BoundProgram {\n1143:             program,\n1144:             symbols: std::mem::take(&mut self.symbols),\n1145:             resolutions: std::mem::take(&mut self.resolutions),\n1146:         })\n1147:     }\n1148: \n1149:     /// Two-pass list bind: declare lexical bindings in this scope, then bind each statement.\n1150:     ///\n1151:     /// `top_level`: Script or FunctionBody (TopLevel*DeclaredNames early errors).\n1152:     /// Mod