      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-embed/src/fold.rs</path>\n<type>file</type>\n<content>\n1: //! Outer Program fold for N07 eval/Function (fold-at-emit).\n2: //!\n3: //! One interpreter / value domain for the eval subset. LLVM only prints the\n4: //! resulting observations.\n5: \n6: use std::collections::{HashMap, HashSet};\n7: \n8: use draconic_ast::{AssignOp, BinaryOp, UnaryOp};\n9: use draconic_diagnostics::{Diagnostic, Span};\n10: use draconic_ir::{Arg, AssignTarget, Expr, Local, LocalId, Module, Pattern, Stmt};\n11: \n12: use crate::{eval_function_call, eval_source_with_bindings, EmbedValue};\n13: \n14: /// Observable value for native stdout after fold-at-emit.\n15: #[derive(Debug, Clone, PartialEq)]\n16: pub enum Observation {\n17:     Number(f64),\n18:     String(String),\n19:     Bool(bool),\n20:     /// Callable (eval, Function, user/dyn fn) — prints as `function`.\n21:     Function,\n22: }\n23: \n24: /// Fold an IR module that uses `eval` / `Function`; return observation values\n25: /// for top-level user `let` bindings in declaration order.\n26: pub fn fold_eval_program(module: &Module) -> Result<Vec<Observation>, Diagnostic> {\n27:     try_fold(module).map_err(diag)\n28: }\n29: \n30: /// True when this module is the supported eval/Function subset.\n31: pub fn is_eval_fold_module(module: &Module) -> bool {\n32:     match try_fold(module) {\n33:         Ok(obs) => !obs.is_empty(),\n34:         Err(_) => false,\n35:     }\n36: }\n37: \n38: /// Runtime fold value: primitives are [`EmbedValue`]; callables / globalThis\n39: /// are fold-only tags (no cross-crate mapping).\n40: #[derive(Debug, Clone)]\n41: enum Value {\n42:     Prim(EmbedValue),\n43:     BuiltinEval,\n44:     BuiltinFunction,\n45:     GlobalThis,\n46:     UserFn(LocalId),\n47:     DynFn(DynFunction),\n48: }\n49: \n50: #[derive(Debug, Clone)]\n51: struct DynFunction {\n52:     params: Vec<String>,\n53:     body: String,\n54: }\n55: \n56: #[derive(Debug, Clone)]\n57: struct UserFunction {\n58:     params: Vec<LocalId>,\n59:     body: Vec<Stmt>,\n60: }\n61: \n62: struct Folder<'a> {\n63:     by_id: HashMap<LocalId, &'a Local>,\n64:     eval_id: Option<LocalId>,\n65:     env: HashMap<LocalId, Value>,\n66:     globals: HashMap<String, Value>,\n67:     user_fns: HashMap<LocalId, UserFunction>,\n68: }\n69: \n70: fn try_fold(module: &Module) -> Result<Vec<Observation>, String> {\n71:     let by_id: HashMap<LocalId, &Local> = module.locals.iter().map(|l| (l.id, l)).collect();\n72:     let eval_id = module.locals.iter().find(|l| l.name == \"eval\").map(|l| l.id);\n73:     let function_id = module\n74:         .locals\n75:         .iter()\n76:         .find(|l| l.name == \"Function\")\n77:         .map(|l| l.id);\n78:     let global_this_id = module\n79:         .locals\n80:         .iter()\n81:         .find(|l| l.name == \"globalThis\")\n82:         .map(|l| l.id);\n83: \n84:     let mut observe_ids = Vec::new();\n85:     let mut seen = HashSet::new();\n86:     for stmt in &module.body {\n87:         if let Stmt::Declare { local, .. } = stmt {\n88:             if seen.insert(*local) {\n89:                 if let Some(loc) = by_id.get(local) {\n90:                     if is_user_binding_name(&loc.name) {\n91:                         observe_ids.push(*local);\n92:                     }\n93:                 }\n94:             }\n95:         }\n96:     }\n97: \n98:     if observe_ids.is_empty() {\n99:         return Err(\"no observation locals\".into());\n100:     }\n101: \n102:     let mut folder = Folder {\n103:         by_id,\n104:         eval_id,\n105:         env: HashMap::new(),\n106:         globals: HashMap::new(),\n107:         user_fns: HashMap::new(),\n108:     };\n109: \n110:     if let Some(id) = eval_id {\n111:         folder.env.insert(id, Value::BuiltinEval);\n112:     }\n113:     if let Some(id) = function_id {\n114:         folder.env.insert(id, Value::BuiltinFunction);\n115:     }\n116:     if let Some(id) = global_this_id {\n117:         folder.env.insert(id, Value::GlobalThis);\n118:     }\n119:     if let Some(u) = module.locals.iter().find(|l| l.name == \"undefined\") {\n120:         folder.env.insert(u.id, Value::Prim(EmbedValue::Undefined));\n121:     }\n122: \n123:     for stmt in &module.body {\n124:         folder.exec_stmt(stmt)?;\n125:     }\n126: \n127:     let mut out = Vec::with_capacity(observe_ids.len());\n128:     for id in &observe_ids {\n129:         let v = folder\n130:             .env\n131:             .get(id)\n132:             .cloned()\n133:             .ok_or_else(|| format!(\"missing observation local {}\", id.0))?;\n134:         out.push(value_to_observation(v)?);\n135:     }\n136: \n137:     if !module_uses_eval_or_function(module, eval_id, function_id) {\n138:         return Err(\"module does not use eval/Function\".into());\n139:     }\n140:     Ok(out)\n141: }\n142: \n143: fn module_uses_eval_or_function(\n144:     module: &Module,\n145:     eval_id: Option<LocalId>,\n146:     function_id: Option<LocalId>,\n147: ) -> bool {\n148:     fn walk_stmt(s: &Stmt, eval_id: Option<LocalId>, function_id: Option<LocalId>) -> bool {\n149:         match s {\n150:             Stmt::Declare { init, .. } => init\n151:                 .as_ref()\n152:                 .is_some_and(|e| walk_expr(e, eval_id, function_id)),\n153:             Stmt::Expr { expr } | Stmt::Return { value: Some(expr) } => {\n154:                 walk_expr(expr, eval_id, function_id)\n155:             }\n156:             Stmt::Return { value: None } => false,\n157:             Stmt::Function { body, .. } | Stmt::Block { body } => {\n158:                 body.iter().any(|s| walk_stmt(s, eval_id, function_id))\n159:             }\n160:             _ => false,\n161:         }\n162:     }\n163:     fn walk_expr(e: &Expr, eval_id: Option<LocalId>, function_id: Option<LocalId>) -> bool {\n164:         match e {\n165:             Expr::Local { id, .. } => Some(*id) == eval_id || Some(*id) == function_id,\n166:             Expr::Unary { arg, .. } => walk_expr(arg, eval_id, function_id),\n167:             Expr::Binary { left, right, .. } => {\n168:                 walk_expr(left, eval_id, function_id) || walk_expr(right, eval_id, function_id)\n169:             }\n170:             Expr::Member {\n171:                 object, property, ..\n172:             } => walk_expr(object, eval_id, function_id) || walk_expr(property, eval_id, function_id),\n173:             Expr::Call { callee, args, .. } | Expr::New { callee, args, .. } => {\n174:                 if walk_expr(callee, eval_id, function_id) {\n175:                     return true;\n176:                 }\n177:                 args.iter().any(|a| match a {\n178:                     Arg::Expr(e) | Arg::Spread(e) => walk_expr(e, eval_id, function_id),\n179:                 })\n180:             }\n181:             Expr::Assign { target, value, .. } => {\n182:                 let t = match target {\n183:                     AssignTarget::Member {\n184:                         object, property, ..\n185:                     } => {\n186:                         walk_expr(object, eval_id, function_id)\n187:                             || walk_expr(property, eval_id, function_id)\n188:                     }\n189:                     _ => false,\n190:                 };\n191:                 t || walk_expr(value, eval_id, function_id)\n192:             }\n193:             _ => false,\n194:         }\n195:     }\n196:     module\n197:         .body\n198:         .iter()\n199:         .any(|s| walk_stmt(s, eval_id, function_id))\n200: }\n201: \n202: fn value_to_observation(v: Value) -> Result<Observation, String> {\n203:     match v {\n204:         Value::Prim(EmbedValue::Number(n)) => Ok(Observation::Number(n)),\n205:         Value::Prim(EmbedValue::String(s)) => Ok(Observation::String(s)),\n206:         Value::Prim(EmbedValue::Boolean(b)) => Ok(Observation::Bool(b)),\n207:         Value::Prim(EmbedValue::Undefined) => Ok(Observation::String(\"undefined\".into())),\n208:         Value::BuiltinEval\n209:         | Value::BuiltinFunction\n210:         | Value::UserFn(_)\n211:         | Value::DynFn(_) => Ok(Observation::Function),\n212:         other => Err(format!(\"cannot observe value {other:?}\")),\n213:     }\n214: }\n215: \n216: impl<'a> Folder<'a> {\n217:     fn exec_stmt(&mut self, stmt: &Stmt) -> Result<Option<Value>, String> {\n218:         match stmt {\n219:             Stmt::Declare { local, init, .. } => {\n220:                 let v = match init {\n221:                     Some(e) => self.eval_expr(e)?,\n222:                     None => Value::Prim(EmbedValue::Undefined),\n223:                 };\n224:                 self.env.insert(*local, v);\n225:                 Ok(None)\n226:             }\n227:             Stmt::Expr { expr } => {\n228:                 let _ = self.eval_expr(expr)?;\n229:                 Ok(None)\n230:             }\n231:             Stmt::Block { body } => {\n232:                 let mut ret = None;\n233:                 for s in body {\n234:                     if let Some(v) = self.exec_stmt(s)? {\n235:                         ret = Some(v);\n236:                         break;\n237:                     }\n238:                 }\n239:                 Ok(ret)\n240:             }\n241:             Stmt::Function {\n242:                 local,\n243:                 params,\n244:                 body,\n245:                 is_async,\n246:                 is_generator,\n247:             } => {\n248:                 if *is_async || *is_generator {\n249:                     return Err(\"async/generator functions not supported in eval fold\".into());\n250:                 }\n251:                 let mut param_ids = Vec::new();\n252:                 for p in params {\n253:                     let Pattern::Local(id) = &p.pattern else {\n254:                         return Err(\"only simple ident params in eval fold\".into());\n255:                     };\n256:                     param_ids.push(*id);\n257:                 }\n258:                 self.user_fns.insert(\n259:                     *local,\n260:                     UserFunction {\n261:                         params: param_ids,\n262:                         body: body.clone(),\n263:                     },\n264:                 );\n265:                 self.env.insert(*local, Value::UserFn(*local));\n266:                 Ok(None)\n267:             }\n268:             Stmt::Return { value } => {\n269:                 let v = match value {\n270:                     Some(e) => self.eval_expr(e)?,\n271:                     None => Value::Prim(EmbedValue::Undefined),\n272:                 };\n273:                 Ok(Some(v))\n274:             }\n275:             other => Err(format!(\"unsupported statement in eval fold: {other:?}\")),\n276:         }\n277:     }\n278: \n279:     fn eval_expr(&mut self, expr: &Expr) -> Result<Value, String> {\n280:         match expr {\n281:             Expr::Number { raw, .. } => Ok(Value::Prim(EmbedValue::Number(parse_number(raw)?))),\n282:             Expr::String { value, .. } => {\n283:                 Ok(Value::Prim(EmbedValue::String(value.to_string_lossy())))\n284:             }\n285:             Expr::Boolean { value, .. } => Ok(Value::Prim(EmbedValue::Boolean(*value))),\n286:             Expr::Null { .. } => Ok(Value::Prim(EmbedValue::Null)),\n287:             Expr::Local { id, .. } => self\n288:                 .env\n289:                 .get(id)\n290:                 .cloned()\n291:                 .ok_or_else(|| format!(\"unbound local %{}\", id.0)),\n292:             Expr::Unary {\n293:                 op: UnaryOp::TypeOf,\n294:                 arg,\n295:                 ..\n296:             } => {\n297:                 let v = self.eval_expr(arg)?;\n298:                 Ok(Value::Prim(EmbedValue::String(typeof_name(&v).into())))\n299:             }\n300:             Expr::Binary {\n301:                 left, op, right, ..\n302:             } => self.eval_binary(left, *op, right),\n303:             Expr::Member {\n304:                 object,\n305:                 property,\n306:                 computed,\n307:                 optional,\n308:                 ..\n309:             } => {\n310:                 if *optional || *computed {\n311:                     return Err(\"optional/computed member not supported in eval fold\".into());\n312:                 }\n313:                 let obj = self.eval_expr(object)?;\n314:                 let Expr::String { value, .. } = property.as_ref() else {\n315:                     return Err(\"member property must be string\".into());\n316:                 };\n317:                 let name = value.to_string_lossy();\n318:                 match obj {\n319:                     Value::GlobalThis => {\n320:                         if name == \"eval\" {\n321:                             return Ok(Value::BuiltinEval);\n322:                         }\n323:                         if name == \"Function\" {\n324:                             return Ok(Value::BuiltinFunction);\n325:                         }\n326:                         self.globals\n327:                             .get(&name)\n328:                             .cloned()\n329:                             .ok_or_else(|| format!(\"missing globalThis.{name}\"))\n330:                     }\n331:                     _ => Err(\"unsupported member object in eval fold\".into()),\n332:                 }\n333:             }\n334:             Expr::Assign {\n335:                 target,\n336:                 op: AssignOp::Eq,\n337:                 value,\n338:                 ..\n339:             } => {\n340:                 let v = self.eval_expr(value)?;\n341:                 match target {\n342:                     AssignTarget::Local(id) => {\n343:                         self.env.insert(*id, v.clone());\n344:                         Ok(v)\n345:                     }\n346:                     AssignTarget::Member {\n347:                         object,\n348:                         property,\n349:                         computed,\n350:                     } if !computed => {\n351:                         let obj = self.eval_expr(object)?;\n352:                         let Expr::String { value: prop, .. } = property.as_ref() else {\n353:                             return Err(\"assign member property must be string\".into());\n354:                         };\n355:                         let name = prop.to_string_lossy();\n356:                         if !matches!(obj, Value::GlobalThis) {\n357:                             return Err(\"only globalThis property assign supported\".into());\n358:                         }\n359:                         self.globals.insert(name, v.clone());\n360:                         Ok(v)\n361:                     }\n362:                     _ => Err(\"unsupported assign target in eval fold\".into()),\n363:                 }\n364:             }\n365:             Expr::New { callee, args, .. } => self.eval_call_or_new(callee, args, true),\n366:             Expr::Call {\n367:                 callee,\n368:                 args,\n369:                 optional,\n370:                 ..\n371:             } => {\n372:                 if *optional {\n373:                     return Err(\"optional call not supported\".into());\n374:                 }\n375:                 self.eval_call_or_new(callee, args, false)\n376:             }\n377:             other => Err(format!(\"unsupported expr in eval fold: {other:?}\")),\n378:         }\n379:     }\n380: \n381:     fn eval_binary(&mut self, left: &Expr, op: BinaryOp, right: &Expr) -> Result<Value, String> {\n382:         if op == BinaryOp::Comma {\n383:             let _ = self.eval_expr(left)?;\n384:             return self.eval_expr(right);\n385:         }\n386:         let l = self.eval_expr(left)?;\n387:         let r = self.eval_expr(right)?;\n388:         match op {\n389:             BinaryOp::EqEqEq | BinaryOp::EqEq => {\n390:                 Ok(Value::Prim(EmbedValue::Boolean(values_eq(&l, &r))))\n391:             }\n392:             BinaryOp::NotEqEq | BinaryOp::NotEq => {\n393:                 Ok(Value::Prim(EmbedValue::Boolean(!values_eq(&l, &r))))\n394:             }\n395:             _ => Err(format!(\"unsupported binary op in eval fold: {op:?}\")),\n396:         }\n397:     }\n398: \n399:     fn eval_call_or_new(\n400:         &mut self,\n401:         callee: &Expr,\n402:         args: &[Arg],\n403:         is_new: bool,\n404:     ) -> Result<Value, String> {\n405:         let direct_eval = matches!(callee, Expr::Local { id, .. } if Some(*id) == self.eval_id);\n406:         let callee_v = self.eval_expr(callee)?;\n407: \n408:         match callee_v {\n409:             Value::BuiltinEval => {\n410:                 if is_new {\n411:                     return Err(\"new eval not supported\".into());\n412:                 }\n413:                 self.call_eval(args, direct_eval)\n414:             }\n415:             Value::BuiltinFunction => self.call_function_ctor(args),\n416:             Value::UserFn(id) => {\n417:                 if is_new {\n418:                     return Err(\"new user fn not supported in eval fold\".into());\n419:                 }\n420:                 self.call_user_fn(id, args)\n421:             }\n422:             Value::DynFn(df) => {\n423:                 if is_new {\n424:                     return Err(\"new dyn fn not supported\".into());\n425:                 }\n426:                 self.call_dyn_fn(&df, args)\n427:             }\n428:             other => Err(format!(\"not callable: {other:?}\")),\n429:         }\n430:     }\n431: \n432:     fn call_eval(&mut self, args: &[Arg], direct: bool) -> Result<Value, String> {\n433:         if args.len() != 1 {\n434:             return Err(\"eval expects 1 argument\".into());\n435:         }\n436:         let Arg::Expr(arg) = &args[0] else {\n437:             return Err(\"spread not supported in eval\".into());\n438:         };\n439:         let Expr::String { value, .. } = arg else {\n440:             return Err(\"only constant-string eval supported\".into());\n441:         };\n442:         let src = value.to_string_lossy();\n443:         let bindings = if direct {\n444:             self.direct_eval_bindings()\n445:         } else {\n446:             self.indirect_eval_bindings()\n447:         };\n448:         let result = eval_source_with_bindings(&src, &bindings)\n449:             .map_err(|e| format!(\"embed eval failed for {src:?}: {e}\"))?;\n450:         Ok(Value::Prim(result))\n451:     }\n452: \n453:     fn direct_eval_bindings(&self) -> Vec<(String, EmbedValue)> {\n454:         let mut map: HashMap<String, EmbedValue> = HashMap::new();\n455:         for (k, v) in &self.globals {\n456:             if let Value::Prim(ev) = v {\n457:                 map.insert(k.clone(), ev.clone());\n458:             }\n459:         }\n460:         for (id, v) in &self.env {\n461:             let Some(loc) = self.by_id.get(id) else {\n462:                 continue;\n463:             };\n464:             if let Value::Prim(ev) = v {\n465:                 if is_user_binding_name(&loc.name) {\n466:                     map.insert(loc.name.clone(), ev.clone());\n467:                 }\n468:             }\n469:         }\n470:         map.into_iter().collect()\n471:     }\n472: \n473:     fn indirect_eval_bindings(&self) -> Vec<(String, EmbedValue)> {\n474:         let mut out = Vec::new();\n475:         for (k, v) in &self.globals {\n476:             if let Value::Prim(ev) = v {\n477:                 out.push((k.clone(), ev.clone()));\n478:             }\n479:         }\n480:         out\n481:     }\n482: \n483:     fn call_function_ctor(&mut self, args: &[Arg]) -> Result<Value, String> {\n484:         let df = parse_function_ctor_args(args)?;\n485:         Ok(Value::DynFn(df))\n486:     }\n487: \n488:     fn call_dyn_fn(&mut self, df: &DynFunction, args: &[Arg]) -> Result<Value, String> {\n489:         let arg_vals = const_arg_values(args)?;\n490:         let param_refs: Vec<&str> = df.params.iter().map(|s| s.as_str()).collect();\n491:         let result = eval_function_call(&param_refs, &df.body, &arg_vals)\n492:             .map_err(|e| format!(\"embed Function call failed: {e}\"))?;\n493:         Ok(Value::Prim(result))\n494:     }\n495: \n496:     fn call_user_fn(&mut self, id: LocalId, args: &[Arg]) -> Result<Value, String> {\n497:         let uf = self\n498:             .user_fns\n499:             .get(&id)\n500:             .cloned()\n501:             .ok_or_else(|| format!(\"missing user fn {}\", id.0))?;\n502:         if !args.is_empty() {\n503:             return Err(\"user fn args not supported in eval fold subset\".into());\n504:         }\n505:         let mut shadowed = Vec::new();\n506:         let mut body_locals = HashSet::new();\n507:         collect_decl_locals(&uf.body, &mut body_locals);\n508:         for lid in &body_locals {\n509:             shadowed.push((*lid, self.env.get(lid).cloned()));\n510:         }\n511:         for pid in &uf.params {\n512:             shadowed.push((*pid, self.env.get(pid).cloned()));\n513:             self.env\n514:                 .insert(*pid, Value::Prim(EmbedValue::Undefined));\n515:         }\n516: \n517:         let mut ret = Value::Prim(EmbedValue::Undefined);\n518:         for stmt in &uf.body {\n519:             if let Some(v) = self.exec_stmt(stmt)? {\n520:                 ret = v;\n521:                 break;\n522:             }\n523:         }\n524: \n525:         for (lid, prev) in shadowed {\n526:             match prev {\n527:                 Some(v) => {\n528:                     self.env.insert(lid, v);\n529:                 }\n530:                 None => {\n531:                     self.env.remove(&lid);\n532:                 }\n533:             }\n534:         }\n535:         Ok(ret)\n536:     }\n537: }\n538: \n539: fn collect_decl_locals(body: &[Stmt], out: &mut HashSet<LocalId>) {\n540:     for s in body {\n541:         match s {\n542:             Stmt::Declare { local, .. } => {\n543:                 out.insert(*local);\n544:             }\n545:             Stmt::Block { body } => collect_decl_locals(body, out),\n546:             _ => {}\n547:         }\n548:     }\n549: }\n550: \n551: fn is_user_binding_name(name: &str) -> bool {\n552:     !matches!(\n553:         name,\n554:         \"Math\"\n555:             | \"Number\"\n556:             | \"NaN\"\n557:             | \"Infinity\"\n558:             | \"Symbol\"\n559:             | \"Promise\"\n560:             | \"Proxy\"\n561:             | \"Reflect\"\n562:             | \"undefined\"\n563:             | \"globalThis\"\n564:             | \"Object\"\n565:             | \"Function\"\n566:             | \"Array\"\n567:             | \"String\"\n568:             | \"Boolean\"\n569:             | \"Error\"\n570:             | \"TypeError\"\n571:             | \"RangeError\"\n572:             | \"ReferenceError\"\n573:             | \"SyntaxError\"\n574:             | \"URIError\"\n575:             | \"EvalError\"\n576:             | \"AggregateError\"\n577:             | \"parseInt\"\n578:             | \"parseFloat\"\n579:             | \"isNaN\"\n580:             | \"isFinite\"\n581:             | \"encodeURI\"\n582:             | \"decodeURI\"\n583:             | \"encodeURIComponent\"\n584:             | \"decodeURIComponent\"\n585:             | \"JSON\"\n586:             | \"Date\"\n587:             | \"RegExp\"\n588:             | \"Map\"\n589:             | \"Set\"\n590:             | \"WeakMap\"\n591:             | \"WeakSet\"\n592:             | \"ArrayBuffer\"\n593:             | \"DataView\"\n594:             | \"Int8Array\"\n595:             | \"Uint8Array\"\n596:             | \"Uint8ClampedArray\"\n597:             | \"Int16Array\"\n598:             | \"Uint16Array\"\n599:            