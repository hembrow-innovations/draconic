      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-ir/src/lib.rs</path>\n<type>file</type>\n<content>\n95:         id\n96:     }\n97: }\n98: \n99: /// Top-level IR unit both backends consume.\n100: #[derive(Debug, Clone, PartialEq)]\n101: pub struct Module {\n102:     pub locals: Vec<Local>,\n103:     pub body: Vec<Stmt>,\n104:     /// Original source span for each top-level `body` entry (same length as `body`).\n105:     /// Expanded lowerings (e.g. class → several stmts) share the originating AST span.\n106:     pub body_spans: Vec<Span>,\n107:     /// Structural object shapes referenced by `Type::Shape` (N03 native layouts).\n108:     pub shapes: Vec<ObjectShape>,\n109: }\n110: \n111: #[derive(Debug, Clone, PartialEq, Eq)]\n112: pub struct Local {\n113:     pub id: LocalId,\n114:     pub name: String,\n115:     pub ty: Type,\n116:     pub kind: BindingKind,\n117: }\n118: \n119: #[derive(Debug, Clone, PartialEq)]\n120: pub enum Stmt {\n121:     /// `let` / `const` name = init; or `let name;`\n122:     Declare {\n123:         local: LocalId,\n124:         init: Option<Expr>,\n125:         kind: BindingKind,\n126:     },\n127:     /// `let` / `const` `[a, b, ...rest] = init;` — `init` is `None` for for-in/of heads.\n128:     DeclareArrayPattern {\n129:         kind: BindingKind,\n130:         elements: Vec<ArrayPatternEl>,\n131:         init: Option<Expr>,\n132:     },\n133:     /// `let` / `const` `{ a, b: c, ...rest } = init;` — `init` is `None` for for-in/of heads.\n134:     DeclareObjectPattern {\n135:         kind: BindingKind,\n136:         properties: Vec<ObjectPatternEl>,\n137:         init: Option<Expr>,\n138:     },\n139:     /// Assignment-pattern / member LHS of `for (… in/of …)` without a declaration keyword.\n140:     AssignLeft {\n141:         target: AssignTarget,\n142:     },\n143:     Expr {\n144:         expr: Expr,\n145:     },\n146:     Block {\n147:         body: Vec<Stmt>,\n148:     },\n149:     If {\n150:         test: Expr,\n151:         consequent: Box<Stmt>,\n152:         alternate: Option<Box<Stmt>>,\n153:     },\n154:     While {\n155:         test: Expr,\n156:         body: Box<Stmt>,\n157:     },\n158:     DoWhile {\n159:         body: Box<Stmt>,\n160:         test: Expr,\n161:     },\n162:     For {\n163:         init: Option<Box<Stmt>>,\n164:         test: Option<Expr>,\n165:         update: Option<Expr>,\n166:         body: Box<Stmt>,\n167:     },\n168:     ForIn {\n169:         left: Box<Stmt>,\n170:         right: Expr,\n171:         body: Box<Stmt>,\n172:     },\n173:     ForOf {\n174:         left: Box<Stmt>,\n175:         right: Expr,\n176:         body: Box<Stmt>,\n177:         is_await: bool,\n178:     },\n179:     Break {\n180:         label: Option<String>,\n181:     },\n182:     Continue {\n183:         label: Option<String>,\n184:     },\n185:     Labeled {\n186:         label: String,\n187:         body: Box<Stmt>,\n188:     },\n189:     Switch {\n190:         discriminant: Expr,\n191:         cases: Vec<SwitchCase>,\n192:     },\n193:     /// `async? function *? name(params) { body }`\n194:     Function {\n195:         local: LocalId,\n196:         params: Vec<Param>,\n197:         body: Vec<Stmt>,\n198:         is_async: bool,\n199:         is_generator: bool,\n200:     },\n201:     /// `return;` or `return value;`\n202:     Return {\n203:         value: Option<Expr>,\n204:     },\n205:     /// `throw value;`\n206:     Throw {\n207:         value: Expr,\n208:     },\n209:     /// `try { … } catch (param?) { … }? finally { … }?`\n210:     Try {\n211:         block: Vec<Stmt>,\n212:         /// Catch parameter pattern when present (`e` / `[a]` / `{x}`).\n213:         handler_param: Option<Pattern>,\n214:         /// Catch body when a `catch` clause is present.\n215:         handler: Option<Vec<Stmt>>,\n216:         /// `finally` body when present.\n217:         finalizer: Option<Vec<Stmt>>,\n218:     },\n219:     /// `with (object) body` — non-str