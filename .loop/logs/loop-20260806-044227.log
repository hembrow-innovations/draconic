          "text": "//! One-shot Test262 probe: paths on stdin → pass/fail lines on stdout.\n//! Usage: cargo run -p draconic-test262 --bin probe < paths.txt\n\nuse std::io::{self, BufRead};\n\nuse draconic_test262::{resolve_suite_root, run_case, Status};\n\nfn main() {\n    let root = resolve_suite_root();\n    let stdin = io::stdin();\n    let mut pass = 0usize;\n    let mut fail = 0usize;\n    for line in stdin.lock().lines() {\n        let Ok(line) = line else { continue };\n        let rel = line.trim();\n        if rel.is_empty() || rel.starts_with('#') {\n            continue;\n        }\n        let r = run_case(&root, rel);\n        match r.status {\n            Status::Pass => {\n                pass += 1;\n                println!(\"PASS\\t{rel}\");\n            }\n            Status::Fail => {\n                fail += 1;\n                let msg = r.message.replace('\\n', \" \");\n                println!(\"FAIL\\t{rel}\\t{msg}\");\n            }\n            Status::Skip => {\n                println!(\"SKIP\\t{rel}\\t{}\", r.message);\n            }\n        }\n    }\n    eprintln!(\"# probe totals pass={pass} fail={fail}\");\n}",
