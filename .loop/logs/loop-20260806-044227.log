      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-check/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Binder (scopes + symbol resolution) and Checker (TypeScript-inspired).\n2: //! Binder: ROADMAP B04. Checker: ROADMAP B05.\n3: \n4: use draconic_ast::{\n5:     Arg, ArrayElement, ArrayPatternElement, ArrowBody, BinaryOp, BindingKind, BindingPattern,\n6:     ClassElement, Expr, ObjectKey, ObjectPatternProp, ObjectProp, Param, Program, Stmt, TypeAnn,\n7:     UnaryOp,\n8: };\n9: use draconic_diagnostics::{Diagnostic, Span};\n10: use std::collections::HashMap;\n11: use std::fmt;\n12: \n13: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n14: pub struct SymbolId(pub u32);\n15: \n16: #[derive(Debug, Clone, PartialEq, Eq)]\n17: pub struct Symbol {\n18:     pub id: SymbolId,\n19:     pub name: String,\n20:     /// Span of the binding name at the declaration site.\n21:     pub span: Span,\n22:     pub kind: BindingKind,\n23:     /// `with` nesting depth when this binding was declared (0 = outside any `with`).\n24:     /// Used so identifier uses inside `with` only rewrite to Locals declared in the\n25:     /// innermost with body; outer names stay bare for Object Environment shadowing.\n26:     pub with_depth: u32,\n27: }\n28: \n29: /// Unboxed native / systems types (T05). Outside the JS value heap.\n30: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n31: pub enum NativeType {\n32:     I8,\n33:     I16,\n34:     I32,\n35:     I64,\n36:     U8,\n37:     U16,\n38:     U32,\n39:     U64,\n40:     F32,\n41:     F64,\n42:     /// Unboxed native boolean (N02); distinct from JS `boolean`.\n43:     Bool,\n44: }\n45: \n46: impl NativeType {\n47:     pub fn from_name(name: &str) -> Option<Self> {\n48:         Some(match name {\n49:             \"i8\" => Self::I8,\n50:             \"i16\" => Self::I16,\n51:             \"i32\" => Self::I32,\n52:             \"i64\" => Self::I64,\n53:             \"u8\" => Self::U8,\n54:             \"u16\" => Self::U16,\n55:             \"u32\" => Self::U32,\n56:             \"u64\" => Self::U64,\n57:             \"f32\" => Self::F32,\n58:             \"f64\" => Self::F64,\n59:             \"bool\" => Self::Bool,\n60:             _ => return None,\n61:         })\n62:     }\n63: \n64:     pub fn as_str(self) -> &'static str {\n65:         match self {\n66:             Self::I8 => \"i8\",\n67:             Self::I16 => \"i16\",\n68:             Self::I32 => \"i32\",\n69:             Self::I64 => \"i64\",\n70:             Self::U8 => \"u8\",\n71:             Self::U16 => \"u16\",\n72:             Self::U32 => \"u32\",\n73:             Self::U64 => \"u64\",\n74:             Self::F32 => \"f32\",\n75:             Self::F64 => \"f64\",\n76:             Self::Bool => \"bool\",\n77:         }\n78:     }\n79: \n80:     pub fn is_float(self) -> bool {\n81:         matches!(self, Self::F32 | Self::F64)\n82:     }\n83: \n84:     pub fn is_bool(self) -> bool {\n85:         matches!(self, Self::Bool)\n86:     }\n87: \n88:     /// Integer native types only (`i8`–`i64`, `u8`–`u64`).\n89:     pub fn is_int(self) -> bool {\n90:         !self.is_float() && !self.is_bool()\n91:     }\n92: \n93:     pub fn is_signed(self) -> bool {\n94:         matches!(self, Self::I8 | Self::I16 | Self::I32 | Self::I64)\n95:     }\n96: \n97:     pub fn bit_width(self) -> u32 {\n98:         match self {\n99:             Self::I8 | Self::U8 | Self::Bool => 8,\n100:             Self::I16 | Self::U16 => 16,\n101:             Self::I32 | Self::U32 | Self::F32 => 32,\n102:             Self::I64 | Self::U64 | Self::F64 => 64,\n103:         }\n104:     }\n105: }\n106: \n107: /// TypeScript-inspired types for the minimal Program surface.\n108: #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]\n109: pub enum Type {\n110:     Number,\n111:     BigInt,\n112:     String,\n113:     Boolean,\n114:     Null,\n115:     /// Callable function value (declaration or expression).\n116:     Function,\n117:     /// Ordinary object value without a known shape.\n118:     Object,\n119:     /// Structural object type; index into the shape table on `CheckedProgram`.\n120:     Shape(u32),\n121:     /// Union type; index into the unions table on `CheckedProgram`.\n122:     Union(u32),\n123:     /// Intersection type; index into the intersections table on `CheckedProgram`.\n124:     Intersection(u32),\n125:     /// Open type parameter while checking a generic body (T04); unique id.\n126:     TypeParam(u32),\n127:     /// Generic function signature; index into the generic_fns table (T04).\n128:     GenericFn(u32),\n129:     /// Unboxed native type (`i32`, `f64`, …); T05.\n130:     Native(NativeType),\n131:     /// Pointer to a native scalar (`*i32`, …); N03.03.\n132:     Ptr(NativeType),\n133:     /// Flexible / unannotated (e.g. `let x;` with no initializer).\n134:     Any,\n135: }\n136: \n137: /// Generic function signature stored for call-site instantiation (T04).\n138: #[derive(Debug, Clone, PartialEq, Eq)]\n139: pub struct GenericFnSig {\n140:     pub type_params: Vec<String>,\n141:     pub param_types: Vec<Option<TypeAnn>>,\n142:     pub return_type: Option<TypeAnn>,\n143: }\n144: \n145: /// Resolved signature for a non-generic annotated function (T07.01).\n146: /// Recorded for call-site argument checking: arity and per-param assignability.\n147: /// Only built when the function has at least one annotated parameter, so\n148: /// untyped (E19-era) JS stays fully permissive.\n149: #[derive(Debug, Clone)]\n150: struct FnSig {\n151:     /// Resolved type per parameter; `None` = unannotated (permissive).\n152:     param_types: Vec<Option<Type>>,\n153:     /// Number of annotated parameters without a default or rest that must be supplied.\n154:     required: usize,\n155:     /// Whether the final parameter is a rest param (extra args allowed).\n156:     has_rest: bool,\n157: }\n158: \n159: /// Generic type alias body (T04).\n160: #[derive(Debug, Clone, PartialEq, Eq)]\n161: struct GenericAlias {\n162:     params: Vec<String>,\n163:     body: TypeAnn,\n164: }\n165: \n166: /// Property list for a structural object type (`Type::Shape`).\n167: #[derive(Debug, Clone, PartialEq, Eq)]\n168: pub struct ObjectShape {\n169:     pub props: Vec<(String, Type)>,\n170:     /// True when the shape came from an explicit type annotation (`{ x: number }`).\n171:     /// Only strict shapes reject access to unknown properties (T07.03); inferred\n172:     /// object-literal and tuple shapes stay permissive so untyped JS is dynamic.\n173:     pub strict: bool,\n174: }\n175: \n176: /// Members of a union type (`Type::Union`).\n177: #[derive(Debug, Clone, PartialEq, Eq)]\n178: pub struct UnionType {\n179:     pub members: Vec<Type>,\n180: }\n181: \n182: /// Members of an intersection type (`Type::Intersection`).\n183: #[derive(Debug, Clone, PartialEq, Eq)]\n184: pub struct IntersectionType {\n185:     pub members: Vec<Type>,\n186: }\n187: \n188: impl fmt::Display for Type {\n189:     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n190:         let s = match self {\n191:             Type::Number => \"number\",\n192:             Type::BigInt => \"bigint\",\n193:             Type::String => \"string\",\n194:             Type::Boolean => \"boolean\",\n195:             Type::Null => \"null\",\n196:             Type::Function => \"function\",\n197:             Type::Object => \"object\",\n198:             Type::Shape(_) => \"object\",\n199:             Type::Union(_) => \"union\",\n200:             Type::Intersection(_) => \"intersection\",\n201:             Type::TypeParam(_) => \"type parameter\",\n202:             Type::GenericFn(_) => \"function\",\n203:             Type::Native(n) => n.as_str(),\n204:             Type::Ptr(n) => {\n205:                 return write!(f, \"*{}\", n.as_str());\n206:             }\n207:             Type::Any => \"any\",\n208:         };\n209:         write!(f, \"{s}\")\n210:     }\n211: }\n212: \n213: /// Program after scope analysis and identifier resolution.\n214: #[derive(Debug)]\n215: pub struct BoundProgram {\n216:     pub program: Program,\n217:     symbols: Vec<Symbol>,\n218:     /// Use-site identifier span → declared symbol.\n219:     resolutions: HashMap<Span, SymbolId>,\n220: }\n221: \n222: impl BoundProgram {\n223:     pub fn symbols(&self) -> &[Symbol] {\n224:         &self.symbols\n225:     }\n226: \n227:     pub fn resolve(&self, use_span: Span) -> Option<SymbolId> {\n228:         self.resolutions.get(&use_span).copied()\n229:     }\n230: \n231:     pub fn symbol(&self, id: SymbolId) -> &Symbol {\n232:         &self.symbols[id.0 as usize]\n233:     }\n234: }\n235: \n236: /// Bound program with inferred / checked types.\n237: #[derive(Debug)]\n238: pub struct CheckedProgram {\n239:     pub bound: BoundProgram,\n240:     /// Declaration symbol → type.\n241:     symbol_types: Vec<Type>,\n242:     /// Expression span → type.\n243:     expr_types: HashMap<Span, Type>,\n244:     /// Structural object shapes referenced by `Type::Shape`.\n245:     shapes: Vec<ObjectShape>,\n246:     /// Union members referenced by `Type::Union`.\n247:     unions: Vec<UnionType>,\n248:     /// Intersection members referenced by `Type::Intersection`.\n249:     intersections: Vec<IntersectionType>,\n250:     /// Generic function signatures referenced by `Type::GenericFn`.\n251:     generic_fns: Vec<GenericFnSig>,\n252: }\n253: \n254: impl CheckedProgram {\n255:     pub fn type_of_symbol(&self, id: SymbolId) -> Type {\n256:         self.symbol_types[id.0 as usize]\n257:     }\n258: \n259:     pub fn type_of_expr(&self, span: Span) -> Option<Type> {\n260:         self.expr_types.get(&span).copied()\n261:     }\n262: \n263:     pub fn shapes(&self) -> &[ObjectShape] {\n264:         &self.shapes\n265:     }\n266: \n267:     pub fn unions(&self) -> &[UnionType] {\n268:         &self.unions\n269:     }\n270: \n271:     pub fn intersections(&self) -> &[IntersectionType] {\n272:         &self.intersections\n273:     }\n274: \n275:     pub fn generic_fns(&self) -> &[GenericFnSig] {\n276:         &self.generic_fns\n277:     }\n278: \n279:     /// Pretty-print a type, expanding structural shapes and unions/intersections.\n280:     pub fn format_type(&self, ty: Type) -> String {\n281:         format_type_full(ty, &self.shapes, &self.unions, &self.intersections)\n282:     }\n283: }\n284: \n285: fn format_type_full(\n286:     ty: Type,\n287:     shapes: &[ObjectShape],\n288:     unions: &[UnionType],\n289:     intersections: &[IntersectionType],\n290: ) -> String {\n291:     match ty {\n292:         Type::Shape(id) => {\n293:             let Some(shape) = shapes.get(id as usize) else {\n294:                 return \"object\".to_string();\n295:             };\n296:             let props: Vec<String> = shape\n297:                 .props\n298:                 .iter()\n299:                 .map(|(n, t)| {\n300:                     format!(\"{n}: {}\", format_type_full(*t, shapes, unions, intersections))\n301:                 })\n302:                 .collect();\n303:             format!(\"{{ {} }}\", props.join(\"; \"))\n304:         }\n305:         Type::Union(id) => {\n306:             let Some(u) = unions.get(id as usize) else {\n307:                 return \"union\".to_string();\n308:             };\n309:             u.members\n310:                 .iter()\n311:                 .map(|t| format_type_full(*t, shapes, unions, intersections))\n312:                 .collect::<Vec<_>>()\n313:                 .join(\" | \")\n314:         }\n315:         Type::Intersection(id) => {\n316:             let Some(i) = intersections.get(id as usize) else {\n317:                 return \"intersection\".to_string();\n318:             };\n319:             i.members\n320:                 .iter()\n321:                 .map(|t| format_type_full(*t, shapes, unions, intersections))\n322:                 .collect::<Vec<_>>()\n323:                 .join(\" & \")\n324:         }\n325:         Type::TypeParam(_) => \"type parameter\".to_string(),\n326:         Type::GenericFn(_) => \"function\".to_string(),\n327:         Type::Native(n) => n.as_str().to_string(),\n328:         other => other.to_string(),\n329:     }\n330: }\n331: \n332: /// Bind scopes and resolve identifiers for a minimal Program.\n333: pub fn bind(program: Program) -> Result<BoundProgram, Diagnostic> {\n334:     let mut binder = Binder::new();\n335:     binder.bind_program(program, false)\n336: }\n337: \n338: /// Bind under Module goal (E19.67): top-level functions are lexical, not var-like.\n339: pub fn bind_module(program: Program) -> Result<BoundProgram, Diagnostic> {\n340:     let mut binder = Binder::new();\n341:     binder.strict = true;\n342:     binder.bind_program(program, true)\n343: }\n344: \n345: pub fn check(program: Program) -> Result<CheckedProgram, Diagnostic> {\n346:     // Script goal: top-level `await` / `for await` rejected.\n347:     check_with_module_goal(program, false)\n348: }\n349: \n350: /// Check a Program under the Module goal (E19.28): top-level `await` and\n351: /// `for await` are allowed (async module). Nested non-async functions still\n352: /// reject `await`.\n353: pub fn check_module(program: Program) -> Result<CheckedProgram, Diagnostic> {\n354:     check_with_module_goal(program, true)\n355: }\n356: \n357: fn check_with_module_goal(\n358:     program: Program,\n359:     module_goal: bool,\n360: ) -> Result<CheckedProgram, Diagnostic> {\n361:     let bound = if module_goal {\n362:         bind_module(program)?\n363:     } else {\n364:         bind(program)?\n365:     };\n366:     let mut checker = Checker::new(&bound);\n367:     // Module evaluation may be async when the body uses top-level await.\n368:     checker.in_async = module_goal;\n369:     checker.check_program()?;\n370:     let symbol_types = checker.symbol_types;\n371:     let expr_types = checker.expr_types;\n372:     let shapes = checker.shapes;\n373:     let unions = checker.unions;\n374:     let intersections = checker.intersections;\n375:     let generic_fns = checker.generic_fns;\n376:     Ok(CheckedProgram {\n377:         bound,\n378:         symbol_types,\n379:         expr_types,\n380:         shapes,\n381:         unions,\n382:         intersections,\n383:         generic_fns,\n384:     })\n385: }\n386: \n387: /// Whether a labelled item is (or wraps) an iteration statement — needed for\n388: /// `continue label` validity (ECMA-262 LabelledStatement).\n389: fn is_iteration_labelled_item(stmt: &Stmt) -> bool {\n390:     match stmt {\n391:         Stmt::While { .. }\n392:         | Stmt::DoWhile { .. }\n393:         | Stmt::For { .. }\n394:         | Stmt::ForIn { .. }\n395:         | Stmt::ForOf { .. } => true,\n396:         Stmt::Labeled { body, .. } => is_iteration_labelled_item(body),\n397:         _ => false,\n398:     }\n399: }\n400: \n401: /// If any catch-parameter bound name appears in LexicallyDeclaredNames of the\n402: /// catch Block, return the conflicting name and its declaration span. Annex\n403: /// B.3.4 allows the same name in VarDeclaredNames (`var`); only lexical\n404: /// `let`/`const`/`class`/`function` at the top level of the catch block are rejected.\n405: fn catch_lexical_conflict(param: &BindingPattern, handler: &Stmt) -> Option<(String, Span)> {\n406:     let body: &[Stmt] = match handler {\n407:         Stmt::Block { body, .. } => body.as_slice(),\n408:         other => std::slice::from_ref(other),\n409:     };\n410:     let mut conflict = None;\n411:     param.for_each_ident(&mut |id| {\n412:         if conflict.is_some() {\n413:             return;\n414:         }\n415:         for stmt in body {\n416:             if let Some(span) = catch_stmt_lexical_name(stmt, &id.name) {\n417:                 conflict = Some((id.name.clone(), span));\n418:                 return;\n419:             }\n420:         }\n421:     });\n422:     conflict\n423: }\n424: \n425: fn catch_stmt_lexical_name(stmt: &Stmt, param: &str) -> Option<Span> {\n426:     let mut s = stmt;\n427:     while let Stmt::Labeled { body, .. } = s {\n428:         s = body;\n429:     }\n430:     match s {\n431:         Stmt::Let {\n432:             kind: BindingKind::Let | BindingKind::Const | BindingKind::Using | BindingKind::AwaitUsing,\n433:             binding,\n434:             ..\n435:         } => {\n436:             let mut found = None;\n437:             binding.for_each_ident(&mut |id| {\n438:                 if found.is_none() && id.name == param {\n439:                     found = Some(id.span);\n440:                 }\n441:             });\n442:             found\n443:         }\n444:         Stmt::ClassDeclaration { name, .. } | Stmt::FunctionDeclaration { name, .. }\n445:             if name.name == param =>\n446:         {\n447:             Some(name.span)\n448:         }\n449:         _ => None,\n450:     }\n451: }\n452: \n453: /// Lexical binding kind for statement-list early errors (E19.24 / Annex B.3.3).\n454: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n455: enum LexNameKind {\n456:     /// Plain `function` (not async/generator): sloppy mode may allow duplicates among these only.\n457:     PlainFunction,\n458:     Other,\n459: }\n460: \n461: fn peel_labels(stmt: &Stmt) -> &Stmt {\n462:     let mut s = stmt;\n463:     while let Stmt::Labeled { body, .. } = s {\n464:         s = body;\n465:     }\n466:     s\n467: }\n468: \n469: /// ECMA-262 IsSimpleParameterList: only BindingIdentifiers, no rest/defaults.\n470: fn is_simple_parameter_list(params: &[Param]) -> bool {\n471:     params.iter().all(|p| {\n472:         !p.rest && p.default.is_none() && matches!(p.binding, BindingPattern::Ident(_))\n473:     })\n474: }\n475: \n476: /// SuperCall in parameter defaults (E19.39 method early error).\n477: fn params_contain_super_call(params: &[Param]) -> bool {\n478:     params\n479:         .iter()\n480:         .any(|p| p.default.as_ref().is_some_and(expr_contains_super_call))\n481: }\n482: \n483: /// SuperCall or SuperProperty in formals (plain / async / generator functions).\n484: fn params_contain_super(params: &[Param]) -> bool {\n485:     params\n486:         .iter()\n487:         .any(|p| p.default.as_ref().is_some_and(expr_contains_super))\n488: }\n489: \n490: /// True when `expr` is (or chains from) an OptionalExpression (`?.`).\n491: fn expr_has_optional_chain(expr: &Expr) -> bool {\n492:     match expr {\n493:         Expr::MemberExpression {\n494:             object, optional, ..\n495:         } => *optional || expr_has_optional_chain(object),\n496:         Expr::Call {\n497:             callee, optional, ..\n498:         } => *optional || expr_has_optional_chain(callee),\n499:         Expr::Paren { expr: inner, .. } => expr_has_optional_chain(inner),\n500:         _ => false,\n501:     }\n502: }\n503: \n504: fn expr_contains_super_call(expr: &Expr) -> bool {\n505:     match expr {\n506:         Expr::Call { callee, args, .. } => {\n507:             matches!(callee.as_ref(), Expr::Super { .. })\n508:                 || expr_contains_super_call(callee)\n509:                 || args.iter().any(|a| match a {\n510:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super_call(e),\n511:                 })\n512:         }\n513:         Expr::ArrowFunction { body, params, .. } => {\n514:             params_contain_super_call(params)\n515:                 || match body {\n516:                     ArrowBody::Expr(e) => expr_contains_super_call(e),\n517:                     ArrowBody::Block(s) => stmt_contains_super_call(s),\n518:                 }\n519:         }\n520:         Expr::FunctionExpression { .. } | Expr::ClassExpression { .. } => false,\n521:         Expr::Paren { expr: inner, .. }\n522:         | Expr::Unary { arg: inner, .. }\n523:         | Expr::Update { arg: inner, .. }\n524:         | Expr::As { expr: inner, .. } => expr_contains_super_call(inner),\n525:         Expr::Binary { left, right, .. }\n526:         | Expr::Assign {\n527:             target: left,\n528:             value: right,\n529:             ..\n530:         } => expr_contains_super_call(left) || expr_contains_super_call(right),\n531:         Expr::Conditional {\n532:             test,\n533:             consequent,\n534:             alternate,\n535:             ..\n536:         } => {\n537:             expr_contains_super_call(test)\n538:                 || expr_contains_super_call(consequent)\n539:                 || expr_contains_super_call(alternate)\n540:         }\n541:         Expr::MemberExpression {\n542:             object, property, ..\n543:         } => expr_contains_super_call(object) || expr_contains_super_call(property),\n544:         Expr::New { callee, args, .. } => {\n545:             expr_contains_super_call(callee)\n546:                 || args.iter().any(|a| match a {\n547:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super_call(e),\n548:                 })\n549:         }\n550:         Expr::ArrayExpression { elements, .. } => elements.iter().any(|el| match el {\n551:             ArrayElement::Expr(e) | ArrayElement::Spread(e) => expr_contains_super_call(e),\n552:             ArrayElement::Elision => false,\n553:         }),\n554:         Expr::ObjectExpression { properties, .. } => properties.iter().any(|p| match p {\n555:             ObjectProp::Property { value, .. } => expr_contains_super_call(value),\n556:             ObjectProp::Spread { expr, .. } => expr_contains_super_call(expr),\n557:             ObjectProp::Accessor { .. } => false,\n558:         }),\n559:         _ => false,\n560:     }\n561: }\n562: \n563: /// SuperCall or SuperProperty (not nested in inner functions/classes).\n564: fn expr_contains_super(expr: &Expr) -> bool {\n565:     match expr {\n566:         Expr::Super { .. } => true,\n567:         Expr::Call { callee, args, .. } | Expr::New { callee, args, .. } => {\n568:             expr_contains_super(callee)\n569:                 || args.iter().any(|a| match a {\n570:                     Arg::Expr(e) | Arg::Spread(e) => expr_contains_super(e),\n571:                 })\n572:         }\n573:         Expr::ArrowFunction { body, params, .. } => {\n574:             params_contain_super(params)\n575:                 || match body {\n576:                     ArrowBody::Expr(e) => expr_contains_super(e),\n577:                     ArrowBody::Block(s) => stmt_contains_super(s),\n578:                 }\n579:         }\n580:         // Nested function/class bodies are their own ContainsSuper roots.\n581:         Expr::FunctionExpression { .. } | Expr::ClassExpression { .. } => false,\n582:         Expr::Paren { expr: inner, .. }\n583:         | Expr::Unary { arg: inner, .. }\n584:         | Expr::Update { arg: inner, .. }\n585:         | Expr::As { expr: inner, .. } => expr_contains_super(inner),\n586:         Expr::Binary { left, right, .. }\n587:         | Expr::Assign {\n588:             target: left,\n589:             value: right,\n590:             ..\n591:         } => expr_contains_super(left) || expr_contains_super(right),\n592:         Expr::Conditional {\n593:             test,\n594:             consequent,\n595:             alternate,\n596:             ..\n597:         } => {\n598:             expr_contains_super(test)\n599:                 || expr_contains_super(consequent)\n600:                 || expr_contains_super(alternate)\n601:         }\n602:         Expr::MemberExpression {\n603:             object, property, ..\n604:         } => expr_contains_super(object) || expr_contains_super(property),\n605:         Expr::ArrayExpression { elements, .. } => elements.iter().any(|el| match el {\n606:             ArrayElement::Expr(e) | ArrayElement::Spread(e) => expr_contains_super(e),\n607:             ArrayElement::Elision => false,\n608:         }),\n609:         Expr::ObjectExpression { properties, .. } => properties.iter().any(|p| match p {\n610:             ObjectProp::Property { value, .. } => expr_contains_super(value),\n611:             ObjectProp::Spread { expr, .. } => expr_contains_super(expr),\n612:             ObjectProp::Accessor { .. } => false,\n613:         }),\n614:         _ => false,\n615:     }\n616: }\n617: \n618: fn stmt_contains_super(stmt: &Stmt) -> bool {\n619:     match stmt {\n620:         Stmt::Block { body, .. } => body.iter().any(stmt_contains_super),\n621:         Stmt::Expression { expr, .. } => expr_contains_super(expr),\n622:         Stmt::Return { argument, .. } => argument.as_ref().is_some_and(expr_contains_super),\n623:         Stmt::Throw { argument, .. } => expr_contains_super(argument),\n624:         Stmt::If {\n625:             test,\n626:             consequent,\n627:             alternate,\n628:             ..\n629:         } => {\n630:             expr_contains_super(test)\n631:                 || stmt_contains_super(consequent)\n632:                 || alternate.as_ref().is_some_and(|a| stmt_contains_super(a))\n633:         }\n634:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n635:             expr_contains_super(test) || stmt_contains_super(body)\n636:         }\n637:         Stmt::Let { init, .. } => init.as_ref().is_some_and(expr_contains_super),\n638:         // Nested function/class declarations are separate ContainsSuper roots.\n639:         Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => false,\n640:         _ => false,\n641:     }\n642: }\n643: \n644: fn stmt_contains_super_call(stmt: &Stmt) -> bool {\n645:     match stmt {\n646:         Stmt::Block { body, .. } => body.iter().any(stmt_contains_super_call),\n647:         Stmt::Expression { expr, .. } => expr_contains_super_call(expr),\n648:         Stmt::Return { argument, .. } => argument.as_ref().is_some_and(expr_contains_super_call),\n649:         Stmt::Throw { argument, .. } => expr_contains_super_call(argument),\n650:         Stmt::If {\n651:             test,\n652:             consequent,\n653:             alternate,\n654:             ..\n655:         } => {\n656:             expr_contains_super_call(test)\n657:                 || stmt_contains_super_call(consequent)\n658:                 || alternate.as_ref().is_some_and(|a| stmt_contains_super_call(a))\n659:         }\n660:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n661:             expr_contains_super_call(test) || stmt_contains_super_call(body)\n662:         }\n663:         Stmt::Let { init, .. } => init.as_ref().is_some_and(expr_contains_super_call),\n664:         _ => false,\n665:     }\n666: }\n667: \n668: /// `true` when `stmts` begins with a `\"use strict\"` directive prologue.\n669: fn stmt_list_has_use_strict(stmts: &[Stmt]) -> bool {\n670:     for stmt in stmts {\n671:         match stmt {\n672:             Stmt::Expression {\n673:                 expr: Expr::String(s),\n674:                 ..\n675:             } => {\n676:                 if s.value.to_string_lossy() == \"use strict\" {\n677:                     return true;\n678:                 }\n679:             }\n680:             _ => break,\n681:         }\n682:     }\n683:     false\n684: }\n685: \n686: fn body_has_use_strict(body: &Stmt) -> bool {\n687:     match body {\n688:         Stmt::Block { body, .. } => stmt_list_has_use_strict(body),\n689:         _ => false,\n690:     }\n691: }\n692: \n693: /// `true` for the literal `true` expression (used by T07.02 loop reachability).\n694: fn is_literal_true(expr: &Expr) -> bool {\n695:     matches!(expr, Expr::Boolean { value: true, .. })\n696: }\n697: \n698: /// Whether `stmt` — the body of a loop — contains an unlabeled `break` that would\n699: /// exit that loop, i.e. a `break` not shadowed by an inner loop or switch.\n700: fn loop_body_has_escaping_break(stmt: &Stmt) -> bool {\n701:     match stmt {\n702:         Stmt::Block { body, .. } => body.iter().any(loop_body_has_escaping_break),\n703:         Stmt::If {\n704:             consequent,\n705:             alternate,\n706:             ..\n707:         } => {\n708:             loop_body_has_escaping_break(consequent)\n709:                 || alternate.as_deref().is_some_and(loop_body_has_escaping_break)\n710:         }\n711:         Stmt::Try {\n712:             block,\n713:             handler,\n714:             finalizer,\n715:             ..\n716:         } => {\n717:             loop_body_has_escaping_break(block)\n718:                 || handler.as_deref().is_some_and(loop_body_has_escaping_break)\n719:                 || finalizer.as_deref().is_some_and(loop_body_has_escaping_break)\n720:         }\n721:         Stmt::Labeled { body, .. } => loop_body_has_escaping_break(body),\n722:         // A `break` inside these targets the inner construct, not the outer loop.\n723:         Stmt::While { .. }\n724:         | Stmt::DoWhile { .. }\n725:         | Stmt::For { .. }\n726:         | Stmt::ForIn { .. }\n727:         | Stmt::ForOf { .. }\n728:         | Stmt::Switch { .. } => false,\n729:         Stmt::Break { label, .. } => label.is_none(),\n730:         _ => false,\n731:     }\n732: }\n733: \n734: /// Whether control flow can never reach the end of `stmt` (always returns, throws,\n735: /// or loops forever). Conservative toward \"terminates\" to avoid false positives on\n736: /// valid code; used by the T07.02 missing-return check.\n737: fn stmt_cannot_fall_through(stmt: &Stmt) -> bool {\n738:     match stmt {\n739:         Stmt::Return { .. } | Stmt::Throw { .. } => true,\n740:         Stmt::Block { body, .. } => body.iter().any(stmt_cannot_fall_through),\n741:         Stmt::If {\n742:             consequent,\n743:             alternate,\n744:             ..\n745:         } => match alternate {\n746:             Some(alt) => {\n747:                 stmt_cannot_fall_through(consequent) && stmt_cannot_fall_through(alt)\n748:             }\n749:             None => false,\n750:         },\n751:         Stmt::While { test, body, .. } | Stmt::DoWhile { test, body, .. } => {\n752:             is_literal_true(test) && !loop_body_has_escaping_break(body)\n753:         }\n754:         Stmt::For { test, body, .. } => {\n755:             test.as_ref().is_none_or(is_literal_true) && !loop_body_has_escaping_break(body)\n756:         }\n757:         Stmt::Switch { cases, .. } => {\n758:             // A `default` must exist (a non-matching discriminant otherwise exits the\n759:             // switch) and the concatenated case bodies, in source order, must reach a\n760:             // terminating statement (case bodies fall through to the next case).\n761:             if !cases.iter().any(|c| c.test.is_none()) {\n762:                 return false;\n763:             }\n764:             cases.iter().any(|c| c.body.iter().any(stmt_cannot_fall_through))\n765:         }\n766:         _ => false,\n767:     }\n768: }\n769: \n770: fn stmt_span(stmt: &Stmt) -> Span {\n771:     match stmt {\n772:         Stmt::Expression { span, .. }\n773:         | Stmt::Let { span, .. }\n774:         | Stmt::Empty { span }\n775:         | Stmt::Block { span, .. }\n776:         | Stmt::If { span, .. }\n777:         | Stmt::While { span, .. }\n778:         | Stmt::DoWhile { span, .. }\n779:         | Stmt::For { span, .. }\n780:         | Stmt::ForIn { span, .. }\n781:         | Stmt::ForOf { span, .. }\n782:         | Stmt::Break { span, .. }\n783:         | Stmt::Continue { span, .. }\n784:         | Stmt::Labeled { span, .. }\n785:         | Stmt::Switch { span, .. }\n786:         | Stmt::FunctionDeclaration { span, .. }\n787:         | Stmt::ClassDeclaration { span, .. }\n788:         | Stmt::Return { span, .. }\n789:         | Stmt::Throw { span, .. }\n790:         | Stmt::Try { span, .. }\n791:         | Stmt::With { span, .. }\n792:         | Stmt::ImportDeclaration { span, .. }\n793:         | Stmt::ExportNamedDeclaration { span, .. }\n794:         | Stmt::ExportDefaultDeclaration { span, .. }\n795:         | Stmt::ExportAllDeclaration { span, .. }\n796:         | Stmt::TypeAlias { span, .. } => *span,\n797:     }\n798: }\n799: \n800: /// Peel covering parentheses (E19.60 cover IdentifierReference).\n801: fn peel_parens(expr: &Expr) -> &Expr {\n802:     let mut inner = expr;\n803:     while let Expr::Paren { expr, .. } = inner {\n804:         inner = expr.as_ref();\n805:     }\n806:     inner\n807: }\n808: \n809: /// The formal parameters of a function expression / arrow value (peeling parens),\n810: /// if `expr` denotes one. Used to record call signatures for function bindings (T07.01).\n811: fn fn_params_of_expr(expr: &Expr) -> Option<&[Param]> {\n812:     match peel_parens(expr) {\n813:         Expr::FunctionExpression { params, .. } | Expr::ArrowFunction { params, .. } => {\n814:             Some(params)\n815:         }\n816:         _ => None,\n817:     }\n818: }\n819: \n820: /// Peel parens; if the core is Ident `eval`/`arguments`, return (name, span). E19.49.\n821: fn strict_forbidden_assign_target(expr: &Expr) -> Option<(String, Span)> {\n822:     match peel_parens(expr) {\n823:         Expr::Ident(id) if id.name == \"eval\" || id.name == \"arguments\" => {\n824:             Some((id.name.clone(), id.span))\n825:         }\n826:         _ => None,\n827:     }\n828: }\n829: \n830: /// LexicallyDeclaredNames of a StatementList (not nested blocks).\n831: ///\n832: /// When `top_level` (Script / FunctionBody), hoistable `function`/`async`/`generator`\n833: /// declarations are **not** lexical (TopLevelLexicallyDeclaredNames); they are var-like.\n834: fn collect_lexically_declared_names<'a, I>(\n835:     stmts: I,\n836:     top_level: bool,\n837: ) -> Vec<(String, Span, LexNameKind)>\n838: where\n839:     I: IntoIterator<Item = &'a Stmt>,\n840: {\n841:     let mut out = Vec::new();\n842:     for stmt in stmts {\n843:         let s = peel_labels(stmt);\n844:         match s {\n845:             Stmt::Let {\n846:                 kind: BindingKind::Let | BindingKind::Const | BindingKind::Using | BindingKind::AwaitUsing,\n847:                 binding,\n848:                 ..\n849:             } => {\n850:                 binding.for_each_ident(&mut |id| {\n851:                     out.push((id.name.clone(), id.span, LexNameKind::Other));\n852:                 });\n853:             }\n854:             Stmt::ClassDeclaration { name, .. } => {\n855:                 out.push((name.name.clone(), name.span, LexNameKind::Other));\n856:             }\n857:             Stmt::FunctionDeclaration {\n858:                 name,\n859:                 is_async,\n860:                 is_generator,\n861:                 ..\n862:             } => {\n863:                 // Script/FunctionBody: hoistables are TopLevelVarDeclaredNames only.\n864:                 if top_level {\n865:                     continue;\n866:                 }\n867:                 let kind = if *is_async || *is_generator {\n868:                     LexNameKind::Other\n869:                 } else {\n870:                     LexNameKind::PlainFunction\n871:                 };\n872:                 out.push((name.name.clone(), name.span, kind));\n873:             }\n874:             _ => {}\n875:         }\n876:     }\n877:     out\n878: }\n879: \n880: /// VarDeclaredNames of a StatementList (walks nested statements; not function/class bodies).\n881: ///\n882: /// When `top_level`, direct hoistable function declarations are included\n883: /// (TopLevelVarDeclaredNames).\n884: fn collect_var_declared_names<'a, I>(stmts: I, top_level: bool) -> Vec<(String, Span)>\n885: where\n886:     I: IntoIterator<Item = &'a Stmt>,\n887: {\n888:     let mut out = Vec::new();\n889:     for stmt in stmts {\n890:         if top_level {\n891:             let s = peel_labels(stmt);\n892:             if let Stmt::FunctionDeclaration { name, .. } = s {\n893:                 out.push((name.name.clone(), name.span));\n894:             }\n895:         }\n896:         collect_var_declared_names_stmt(stmt, &mut out);\n897:     }\n898:     out\n899: }\n900: \n901: fn collect_var_declared_names_stmt(stmt: &Stmt, out: &mut Vec<(String, Span)>) {\n902:     match stmt {\n903:         Stmt::Labeled { body, .. } => collect_var_declared_names_stmt(body, out),\n904:         Stmt::Let {\n905:             kind: BindingKind::Var,\n906:             binding,\n907:             ..\n908:         } => {\n909:             binding.for_each_ident(&mut |id| {\n910:                 out.push((id.name.clone(), id.span));\n911:             });\n912:         }\n913:         Stmt::Block { body, .. } => {\n914:             for child in body {\n915:                 collect_var_declared_names_stmt(child, out);\n916:             }\n917:         }\n918:         Stmt::If {\n919:             consequent,\n920:             alternate,\n921:             ..\n922:         } => {\n923:             collect_var_declared_names_stmt(consequent, out);\n924:             if let Some(alt) = alternate {\n925:                 collect_var_declared_names_stmt(alt, out);\n926:             }\n927:         }\n928:         Stmt::While { body, .. } | Stmt::DoWhile { body, .. } | Stmt::With { body, .. } => {\n929:             collect_var_declared_names_stmt(body, out);\n930:         }\n931:         Stmt::For {\n932:             init, body, ..\n933:         } => {\n934:             if let Some(init) = init {\n935:                 collect_var_declared_names_stmt(init, out);\n936:             }\n937:             collect_var_declared_names_stmt(body, out);\n938:         }\n939:         Stmt::ForIn { left, body, .. } | Stmt::ForOf { left, body, .. } => {\n940:             collect_var_declared_names_stmt(left, out);\n941:             collect_var_declared_names_stmt(body, out);\n942:         }\n943:         Stmt::Switch { cases, .. } => {\n944:             for case in cases {\n945:                 for child in &case.body {\n946:                     collect_var_declared_names_stmt(child, out);\n947:                 }\n948:             }\n949:         }\n950:         Stmt::Try {\n951:             block,\n952:             handler,\n953:             finalizer,\n954:             ..\n955:         } => {\n956:             collect_var_declared_names_stmt(block, out);\n957:             if let Some(handler) = handler {\n958:                 collect_var_declared_names_stmt(handler, out);\n959:             }\n960:             if let Some(finalizer) = finalizer {\n961:                 collect_var_declared_names_stmt(finalizer, out);\n962:             }\n963:         }\n964:         Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => {}\n965:         _ => {}\n966:     }\n967: }\n968: \n969: /// Statement-list early errors (E19.24).\n970: ///\n971: /// - LexicallyDeclaredNames must not contain duplicates (Annex B: sloppy plain\n972: ///   `function` duplicates only are allowed — block/switch only).\n973: /// - LexicallyDeclaredNames ∩ VarDeclaredNames must be empty.\n974: ///\n975: /// `top_level`: Script or FunctionBody (TopLevel*DeclaredNames); otherwise Block/CaseBlock.\n976: fn check_statement_list_early_errors<'a, I>(\n977:     stmts: I,\n978:     strict: bool,\n979:     top_level: bool,\n980: ) -> Result<(), Diagnostic>\n981: where\n982:     I: IntoIterator<Item = &'a Stmt> + Clone,\n983: {\n984:     let lexical = collect_lexically_declared_names(stmts.clone(), top_level);\n985:     let mut seen: HashMap<String, LexNameKind> = HashMap::new();\n986:     for (name, span, kind) in &lexical {\n987:         if let Some(prev) = seen.get(name) {\n988:             let allow_sloppy_fn = !strict\n989:                 && !top_level\n990:                 && *prev == LexNameKind::PlainFunction\n991:                 && *kind == LexNameKind::PlainFunction;\n992:             if !allow_sloppy_fn {\n993:                 return Err(Diagnostic::new(\n994:                     format!(\"duplicate declaration of `{name}`\"),\n995:                     *span,\n996:                 ));\n997:             }\n998:         } else {\n999:             seen.insert(name.clone(), *kind);\n1000:         }\n1001:     }\n1002:     let vars = collect_var_declared_names(stmts, top_level);\n1003:     let mut var_names = HashMap::new();\n1004:     for (name, span) in vars {\n1005:         var_names.entry(name).or_insert(span);\n1006:     }\n1007:     for (name, span, _) in &lexical {\n1008:         if var_names.contains_key(name) {\n1009:             return Err(Diagnostic::new(\n1010:                 format!(\"duplicate declaration of `{name}`\"),\n1011:                 *span,\n1012:             ));\n1013:         }\n1014:     }\n1015:     Ok(())\n1016: }\n1017: \n1018: struct Binder {\n1019:     /// Scope stack (innermost last): name → symbol id.\n1020:     scopes: Vec<HashMap<String, SymbolId>>,\n1021:     /// Indices into `scopes` that are var environments (program + function).\n1022:     var_env_indices: Vec<usize>,\n1023:     /// Host globals (e.g. `Math`): resolve after lexical scopes so `let Math` can shadow.\n1024:     builtins: HashMap<String, SymbolId>,\n1025:     symbols: Vec<Symbol>,\n1026:     resolutions: HashMap<Span, SymbolId>,\n1027:     /// Nesting depth of enclosing `with` statements.\n1028:     with_depth: u32,\n1029:     /// Current strict-mode code (directive prologue / nested function body).\n1030:     strict: bool,\n1031:     /// SuperProperty allowed (class/object method or constructor). Arrows inherit; plain\n1032:     /// functions clear it. SuperCall is never allowed in arrows (E19.58).\n1033:     super_allowed: bool,\n1034: }\n1035: \n1036: impl Binder {\n1037:     fn new() -> Self {\n1038:         let mut binder = Self {\n1039:             scopes: vec![HashMap::new()],\n1040:             // Program/script body is a var environment.\n1041:             var_env_indices: vec![0],\n1042:             builtins: HashMap::new(),\n1043:             symbols: Vec::new(),\n1044:             resolutions: HashMap::new(),\n1045:             with_depth: 0,\n1046:             strict: false,\n1047:             super_allowed: false,\n1048:         };\n1049:         binder.install_builtin(\"Math\", BindingKind::Const);\n1050:         binder.install_builtin(\"Number\", BindingKind::Const);\n1051:         binder.install_builtin(\"NaN\", BindingKind::Const);\n1052:         binder.install_builtin(\"Infinity\", BindingKind::Const);\n1053:         binder.install_builtin(\"Symbol\", BindingKind::Const);\n1054:         binder.install_builtin(\"Promise\", BindingKind::Const);\n1055:         binder.install_builtin(\"Proxy\", BindingKind::Const);\n1056:         binder.install_builtin(\"Reflect\", BindingKind::Const);\n1057:         // E19.73: ShadowRealm constructor (host Node --harmony-shadow-realm)\n1058:         binder.install_builtin(\"ShadowRealm\", BindingKind::Const);\n1059:         // E15.01: global object basics\n1060:         binder.install_builtin(\"undefined\", BindingKind::Const);\n1061:         binder.install_builtin(\"globalThis\", BindingKind::Const);\n1062:         binder.install_builtin(\"Object\", BindingKind::Const);\n1063:         binder.install_builtin(\"Function\", BindingKind::Const);\n1064:         binder.install_builtin(\"Array\", BindingKind::Const);\n1065:         binder.install_builtin(\"String\", BindingKind::Const);\n1066:         binder.install_builtin(\"Boolean\", BindingKind::Const);\n1067:         // E15.02: Error constructors\n1068:         binder.install_builtin(\"Error\", BindingKind::Const);\n1069:         binder.install_builtin(\"TypeError\", BindingKind::Const);\n1070:         binder.install_builtin(\"RangeError\", BindingKind::Const);\n1071:         binder.install_builtin(\"ReferenceError\", BindingKind::Const);\n1072:         binder.install_builtin(\"SyntaxError\", BindingKind::Const);\n1073:         binder.install_builtin(\"URIError\", BindingKind::Const);\n1074:         binder.install_builtin(\"EvalError\", BindingKind::Const);\n1075:         binder.install_builtin(\"AggregateError\", BindingKind::Const);\n1076:         // E15.03: global number-parsing / predicate functions\n1077:         binder.install_builtin(\"parseInt\", BindingKind::Const);\n1078:         binder.install_builtin(\"parseFloat\", BindingKind::Const);\n1079:         binder.install_builtin(\"isNaN\", BindingKind::Const);\n1080:         binder.install_builtin(\"isFinite\", BindingKind::Const);\n1081:         // E15.04: URI encode/decode\n1082:         binder.install_builtin(\"encodeURI\", BindingKind::Const);\n1083:         binder.install_builtin(\"decodeURI\", BindingKind::Const);\n1084:         binder.install_builtin(\"encodeURIComponent\", BindingKind::Const);\n1085:         binder.install_builtin(\"decodeURIComponent\", BindingKind::Const);\n1086:         // E15.05: JSON\n1087:         binder.install_builtin(\"JSON\", BindingKind::Const);\n1088:         // E15.06: Date\n1089:         binder.install_builtin(\"Date\", BindingKind::Const);\n1090:         // E15.07: RegExp\n1091:         binder.install_builtin(\"RegExp\", BindingKind::Const);\n1092:         // E15.08: Map / Set\n1093:         binder.install_builtin(\"Map\", BindingKind::Const);\n1094:         binder.install_builtin(\"Set\", BindingKind::Const);\n1095:         // E15.09: WeakMap / WeakSet\n1096:         binder.install_builtin(\"WeakMap\", BindingKind::Const);\n1097:         binder.install_builtin(\"WeakSet\", BindingKind::Const);\n1098:         // E15.10: ArrayBuffer / DataView / TypedArrays\n1099:         binder.install_builtin(\"ArrayBuffer\", BindingKind::Const);\n1100:         binder.install_builtin(\"DataView\", BindingKind::Const);\n1101:         binder.install_builtin(\"Int8Array\", BindingKind::Const);\n1102:         binder.install_builtin(\"Uint8Array\", BindingKind::Const);\n1103:         binder.install_builtin(\"Uint8ClampedArray\", BindingKind::Const);\n1104:         binder.install_builtin(\"Int16Array\", BindingKind::Const);\n1105:         binder.install_builtin(\"Uint16Array\", BindingKind::Const);\n1106:         binder.install_builtin(\"Int32Array\", BindingKind::Const);\n1107:         binder.install_builtin(\"Uint32Array\", BindingKind::Const);\n1108:         binder.install_builtin(\"Float32Array\", BindingKind::Const);\n1109:         binder.install_builtin(\"Float64Array\", BindingKind::Const);\n1110:         binder.install_builtin(\"BigInt64Array\", BindingKind::Const);\n1111:         binder.install_builtin(\"BigUint64Array\", BindingKind::Const);\n1112:         // E16.01: direct eval\n1113:         binder.install_builtin(\"eval\", BindingKind::Const);\n1114:         // E18.01: Annex B escape / unescape\n1115:         binder.install_builtin(\"escape\", BindingKind::Const);\n1116:         binder.install_builtin(\"unescape\", BindingKind::Const);\n1117:         binder\n1118:     }\n1119: \n1120:     /// Register a host global. Not placed in lexical scopes so programs may shadow it.\n1121:     fn install_builtin(&mut self, name: &str, kind: BindingKind) {\n1122:         let id = SymbolId(self.symbols.len() as u32);\n1123:         self.symbols.push(Symbol {\n1124:             id,\n1125:             name: name.to_string(),\n1126:             span: Span::dummy(),\n1127:             kind,\n1128:             with_depth: 0,\n1129:         });\n1130:         self.builtins.insert(name.to_string(), id);\n1131:     }\n1132: \n1133:     fn bind_program(\n1134:         &mut self,\n1135:         program: Program,\n1136:         module_goal: bool,\n1137:     ) -> Result<BoundProgram, Diagnostic> {\n1138:         if stmt_list_has_use_strict(&program.body) {\n1139:             self.strict = true;\n1140:         }\n1141:         // E19.67: Module top-level uses Block-like LexicallyDeclaredNames (functions are\n1142:         // lexical). Script/FunctionBody use TopLevel*DeclaredNames (functions are var-like).\n1143:         let top_level = !module_goal;\n1144:         self.bind_stmt_list(&program.body, top_level)?;\n1145: \n1146:         Ok(BoundProgram {\n1147:             program,\n1148:             symbols: std::mem::take(&mut self.symbols),\n1149:             resolutions: std::mem::take(&mut self.resolutions),\n1150:         })\n1151:     }\n1152: \n1153:     /// Two-pass list bind: declare lexical bindings in this scope, then bind each statement.\n1154:     ///\n1155:     /// `top_level`: Script or FunctionBody (TopLevel*DeclaredNames early errors).\n1156:     /// Module program body passes `false` so functions are lexical (E19.67).\n1157:     fn bind_stmt_list(&mut self, stmts: &[Stmt], top_level: bool) -> Result<(), Diagnostic> {\n1158:         // E19.24: LexicallyDeclaredNames / VarDeclaredNames early errors.\n1159:         check_statement_list_early_errors(stmts, self.strict, top_level)?;\n1160:         for stmt in stmts {\n1161:             self.declare_list_item(stmt)?;\n1162:         }\n1163:         for stmt in stmts {\n1164:             self.bind_stmt(stmt)?;\n1165:         }\n1166:         Ok(())\n1167:     }\n1168: \n1169:     /// Bind a function/method/arrow block body with FunctionBody (top-level) early errors.\n1170:     fn bind_function_body(&mut self, body: &Stmt) -> Result<(), Diagnostic> {\n1171:         // Body gets its own block scope (named FE / `let arguments` / nested `function`\n1172:         // can shadow). Param∩body-lexical conflicts are checked separately.\n1173:         match body {\n1174:             Stmt::Block { body, .. } => {\n1175:                 self.push_scope();\n1176:                 self.bind_stmt_list(body, true)?;\n1177:                 self.pop_scope();\n1178:                 Ok(())\n1179:             }\n1180:             other => self.bind_stmt(other),\n1181:         }\n1182:     }\n1183: \n1184:     /// E19.39: LexicallyDeclaredNames of FunctionBody must not intersect BoundNames of formals.\n1185:     fn check_params_body_lexical_conflict(\n1186:         &self,\n1187:         params: &[Param],\n1188:         body: &Stmt,\n1189:     ) -> Result<(), Diagnostic> {\n1190:         let mut param_names = std::collections::HashSet::new();\n1191:         for p in params {\n1192:             p.binding.for_each_ident(&mut |id| {\n1193:                 param_names.insert(id.name.clone());\n1194:             });\n1195:         }\n1196:         let stmts: &[Stmt] = match body {\n1197:             Stmt::Block { body, .. } => body.as_slice(),\n1198:             _ => return Ok(()),\n1199:         };\n1200:         // FunctionBody uses TopLevelLexicallyDeclaredNames (not hoistable functions).\n1201:         let lexical = collect_lexically_declared_names(stmts.iter(), true);\n1202:         for (name, span, _) in lexical {\n1203:             if param_names.contains(&name) {\n1204:                 return Err(Diagnostic::new(\n1205:                     format!(\"duplicate declaration of `{name}`\"),\n1206:                     span,\n1207:                 ));\n1208:             }\n1209:         }\n1210:         Ok(())\n1211:     }\n1212: \n1213:     /// Hoistable declarations for one statement-list item (Annex B.3.2 peels labels).\n1214:     fn declare_list_item(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n1215:         match stmt {\n1216:             Stmt::Let {\n1217:                 kind: BindingKind::Var,\n1218:                 binding,\n1219:                 ..\n1220:             } => self.declare_var_binding(binding),\n1221:             Stmt::Let { kind, binding, .. } => self.declare_binding(binding, *kind),\n1222:             Stmt::ClassDeclaration { name, .. } => {\n1223:                 self.declare(name.name.clone(), name.span, BindingKind::Function)?;\n1224:                 Ok(())\n1225:             }\n1226:             Stmt::FunctionDeclaration {\n1227:                 name,\n1228:                 is_async,\n1229:                 is_generator,\n1230:                 ..\n1231:             } => {\n1232:                 // Annex B.3.2: outer var-like binding already hosts this name — do not\n1233:                 // shadow with a block-local binding (IR + uses share the outer symbol).\n1234:                 if let Some(existing) = self.resolve_name(&name.name) {\n1235:                     let in_current = self\n1236:                         .scopes\n1237:                         .last()\n1238:                         .is_some_and(|s| s.contains_key(&name.name));\n1239:                     if !in_current\n1240:                         && matches!(\n1241:                             self.symbols[existing.0 as usize].kind,\n1242:                             BindingKind::Function | BindingKind::Var\n1243:                         )\n1244:                     {\n1245:                         self.declare_annex_b_function_span(name);\n1246:                         return Ok(());\n1247:                     }\n1248:                 }\n1249:                 // `var f` then `function f` in the same list: reuse var binding.\n1250:                 // Annex B / E19.24: sloppy duplicate plain FunctionDeclarations share binding.\n1251:                 let scope = self.scopes.last().expect(\"scope stack non-empty\");\n1252:                 if let Some(&existing) = scope.get(&name.name) {\n1253:                     let existing_kind = self.symbols[existing.0 as usize].kind;\n1254:                     if existing_kind == BindingKind::Var\n1255:                         || (!self.strict\n1256:                             && !*is_async\n1257:                             && !*is_generator\n1258:                             && existing_kind == BindingKind::Function)\n1259:                     {\n1260:                         self.declare_annex_b_function_span(name);\n1261:                         return Ok(());\n1262:                     }\n1263:                 }\n1264:                 self.declare(name.name.clone(), name.span, BindingKind::Function)?;\n1265:                 Ok(())\n1266:             }\n1267:             // Annex B.3.2: `label: function f() {}` hoists `f` in this list.\n1268:             Stmt::Labeled { body, .. } => self.declare_list_item(body),\n1269:             // Annex B.3.2: block-level `function` → enclosing var-like binding.\n1270:             // E18.14: also hoist nested `var` into the current var environment.\n1271:             Stmt::Block { body, .. } => {\n1272:                 for s in body {\n1273:                     self.declare_annex_b_block_functions(s)?;\n1274:                     self.hoist_vars_from_stmt(s)?;\n1275:                 }\n1276:                 Ok(())\n1277:             }\n1278:             // Annex B.3.4: bare `function` as if/else Statement clause.\n1279:             // Annex B.3.2: also hoist from block bodies (`if (c) { function f(){} }`).\n1280:             Stmt::If {\n1281:                 consequent,\n1282:                 alternate,\n1283:                 ..\n1284:             } => {\n1285:                 self.declare_if_function_clause(consequent)?;\n1286:                 if let Some(alt) = alternate {\n1287:                     self.declare_if_function_clause(alt)?;\n1288:                 }\n1289:                 self.declare_annex_b_block_functions(consequent)?;\n1290:                 if let Some(alt) = alternate {\n1291:                     self.declare_annex_b_block_functions(alt)?;\n1292:                 }\n1293:                 self.hoist_vars_from_stmt(consequent)?;\n1294:                 if let Some(alt) = alternate {\n1295:                     self.hoist_vars_from_stmt(alt)?;\n1296:                 }\n1297:                 Ok(())\n1298:             }\n1299:             Stmt::While { body, .. } | Stmt::DoWhile { body, .. } => {\n1300:                 self.declare_annex_b_block_functions(body)?;\n1301:                 self.hoist_vars_from_stmt(body)\n1302:             }\n1303:             Stmt::For { init, body, .. } => {\n1304:                 if let Some(init) = init {\n1305:                     self.declare_annex_b_block_functions(init)?;\n1306:                     self.hoist_vars_from_stmt(init)?;\n1307:                 }\n1308:                 self.declare_annex_b_block_functions(body)?;\n1309:                 self.hoist_vars_from_stmt(body)\n1310:             }\n1311:             Stmt::ForIn { body, left, .. } | Stmt::ForOf { body, left, .. } => {\n1312:                 self.declare_annex_b_block_functions(left)?;\n1313:                 self.hoist_vars_from_stmt(left)?;\n1314:                 self.declare_annex_b_block_functions(body)?;\n1315:                 self.hoist_vars_from_stmt(body)\n1316:             }\n1317:             Stmt::Try {\n1318:                 block,\n1319:                 handler,\n1320:                 finalizer,\n1321:                 ..\n1322:             } => {\n1323:                 self.declare_annex_b_block_functions(block)?;\n1324:                 self.hoist_vars_from_stmt(block)?;\n1325:                 if let Some(handler) = handler {\n1326:                     self.declare_annex_b_block_functions(handler)?;\n1327:                     self.hoist_vars_from_stmt(handler)?;\n1328:                 }\n1329:                 if let Some(finalizer) = finalizer {\n1330:                     self.declare_annex_b_block_functions(finalizer)?;\n1331:                     self.hoist_vars_from_stmt(finalizer)?;\n1332:                 }\n1333:                 Ok(())\n1334:             }\n1335:             _ => Ok(()),\n1336:         }\n1337:     }\n1338: \n1339:     /// Hoist `var` declarations from a nested statement into the current var environment.\n1340:     fn hoist_vars_from_stmt(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n1341:         let mut s = stmt;\n1342:         while let Stmt::Labeled { body, .. } = s {\n1343:             s = body;\n1344:         }\n1345:         match s {\n1346:             Stmt::Let {\n1347:                 kind: BindingKind::Var,\n1348:                 binding,\n1349:                 ..\n1350:             } => self.declare_var_binding(binding),\n1351:             Stmt::Block { body, .. } => {\n1352:                 for child in body {\n1353:                     self.hoist_vars_from_stmt(child)?;\n1354:                 }\n1355:                 Ok(())\n1356:             }\n1357:             Stmt::If {\n1358:                 consequent,\n1359:                 alternate,\n1360:                 ..\n1361:             } => {\n1362:                 self.hoist_vars_from_stmt(consequent)?;\n1363:                 if let Some(alt) = alternate {\n1364:                     self.hoist_vars_from_stmt(alt)?;\n1365:                 }\n1366:                 Ok(())\n1367:             }\n1368:             Stmt::While { body, .. } | Stmt::DoWhile { body, .. } => {\n1369:                 self.hoist_vars_from_stmt(body)\n1370:             }\n1371:             Stmt::For { init, body, .. } => {\n1372:                 if let Some(init) = init {\n1373:                     self.hoist_vars_from_stmt(init)?;\n1374:                 }\n1375:                 self.hoist_vars_from_stmt(body)\n1376:             }\n1377:             Stmt::ForIn { body, left, .. } | Stmt::ForOf { body, left, .. } => {\n1378:                 self.hoist_vars_from_stmt(left)?;\n1379:                 self.hoist_vars_from_stmt(body)\n1380:             }\n1381:             Stmt::Try {\n1382:                 block,\n1383:                 handler,\n1384:                 finalizer,\n1385:                 ..\n1386:             } => {\n1387:                 self.hoist_vars_from_stmt(block)?;\n1388:                 if let Some(handler) = handler {\n1389:                     self.hoist_vars_from_stmt(handler)?;\n1390:                 }\n1391:                 if let Some(finalizer) = finalizer {\n1392:                     self.hoist_vars_from_stmt(finalizer)?;\n1393:                 }\n1394:                 Ok(())\n1395:             }\n1396:             // Nested function bodies have their own var environment — do not hoist out.\n1397:             Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => Ok(()),\n1398:             _ => Ok(()),\n1399:         }\n1400:     }\n1401: \n1402:     fn declare_var_binding(&mut self, binding: &BindingPattern) -> 