_strict(&simple, body.clone());\n        assert!(\n            matches!(&simple_body[0], Stmt::Expr { expr: Expr::String { value, .. } } if value == \"use strict\"),\n            \"simple params: directive must be injected first: {simple_body:?}\"\n        );\n        let non_simple_body = with_use_strict(&non_simple, body.clone());\n        assert!(\n            !matches!(&non_simple_body[0], Stmt::Expr { expr: Expr::String { value, .. } } if value == \"use strict\"),\n            \"non-simple params: directive must be skipped (E19.87): {non_simple_body:?}\"\n        );\n    }\n\n    #[test]\n    fn class_method_default_param_emits_no_directive_in_method() {\n        // E19.87: a method with a default (non-simple) parameter list must not\n        // carry a \"use strict\" directive inside its own body (SyntaxError).\n        let module = lower_src(\"class C { m(a = 1) { return a; } }\");\n        let dump = dump_module(&module);\n        let method = dump\n            .lines()\n            .find(|l| l.contains(\"m\") && l.contains(\"= 1\") || l.contains(\"Function\"))\n            .map(|l| l.to_string())\n            .unwrap_or_else(|| dump.clone());\n        assert!(\n            !method.contains(\"\\\"use strict\\\"\") && !method.contains(\"'use strict'\"),\n            \"no directive inside non-simple-param method: {dump}\"\n        );\n    }\n}",
