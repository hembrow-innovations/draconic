70:     check(program).unwrap();\n1171: }\n1172: \n1173: #[test]\n1174: fn call_arrow_binding_arg_mismatch_errors() {\n1175:     let program = parse(r#\"let f = (a: number) => a; f(\"x\");\"#).unwrap();\n1176:     let err = check(program).unwrap_err();\n1177:     assert!(\n1178:         err.message.contains(\"not assignable\"),\n1179:         \"unexpected: {}\",\n1180:         err.message\n1181:     );\n1182: }\n1183: \n1184: #[test]\n1185: fn call_arrow_binding_arity_errors() {\n1186:     let program = parse(\"let f = (a: number, b: number) => a + b; f(1);\").unwrap();\n1187:     let err = check(program).unwrap_err();\n1188:     assert!(\n1189:         err.message.contains(\"at least 2\"),\n1190:         \"unexpected: {}\",\n1191:         err.message\n1192:     );\n1193: }\n1194: \n1195: #[test]\n1196: fn call_type_check_uses_annotated_params_only() {\n1197:     let program = parse(\"function f(a: number, b) { return a; } f(1); f(1, \\\"x\\\");\").unwrap();\n1198:     check(program).unwrap();\n1199: }\n1200: \n1201: #[test]\n1202: fn call_annotated_call_ok_fixture_present() {\n1203:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n1204:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n1205:     assert!(\n1206:         ids.iter().any(|id| *id == \"types/annotated_call_ok\"),\n1207:         \"missing types/annotated_call_ok fixture, got {ids:?}\"\n1208:     );\n1209: }\n1210: \n1211: #[test]\n1212: fn call_annotated_call_ok_runs() {\n1213:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n1214:     let fixture = fixtures\n1215:         .iter()\n1216:         .find(|f| f.id == \"types/annotated_call_ok\")\n1217:         .expect(\"types/annotated_call_ok\");\n1218:     assert!(!fixture.targets.is_empty());\n1219:     for r in run_fixture(fixture) {\n1220:         assert!(\n1221:             r.ok,\n1222:             \"{} @ {}: {}\",\n1223:             r.fixture_id,\n1224:             r.target.as_str(),\n1225:             r.message\n1226:         );\n1227:     }\n1228: }\n1229: \n1230: #[test]\n1231: fn call_reject_fixtures_run() {\n1232:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n1233:     for fixture in fixtures.iter().filter(|f| f.id.starts_with(\"types/reject\")) {\n1234:         assert!(\n1235:             !fixture.targets.is_empty(),\n1236:             \"{}: no targets\",\n1237:             fixture.id\n1238:         );\n1239:         for r in run_fixture(fixture) {\n1240:             assert!(\n1241:                 r.ok,\n1242:                 \"{} @ {}: {}\",\n1243:                 r.fixture_id,\n1244:                 r.target.as_str(),\n1245:                 r.message\n1246:             );\n1247:         }\n1248:     }\n1249: }\n1250: \n1251: // --- T07.03: unknown property on annotated shape ---\n1252: \n1253: #[test]\n1254: fn unknown_shape_prop_read_errors() {\n1255:     let program = parse(\"let p: { x: number } = { x: 1 }; p.y;\").unwrap();\n1256:     let err = check(program).unwrap_err();\n1257:     assert!(\n1258:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1259:         \"unexpected: {}\",\n1260:         err.message\n1261:     );\n1262: }\n1263: \n1264: #[test]\n1265: fn unknown_shape_prop_write_errors() {\n1266:     let program = parse(\"let p: { x: number } = { x: 1 }; p.y = 1;\").unwrap();\n1267:     let err = check(program).unwrap_err();\n1268:     assert!(\n1269:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1270:         \"unexpected: {}\",\n1271:         err.message\n1272:     );\n1273: }\n1274: \n1275: #[test]\n1276: fn unknown_shape_prop_update_errors() {\n1277:     let program = parse(\"let p: { x: number } = { x: 1 }; p.y++;\").unwrap();\n1278:     let err = check(program).unwrap_err();\n1279:     assert!(\n1280:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1281:         \"unexpected: {}\",\n1282:         err.message\n1283:     );\n1284: }\n1285: \n1286: #[test]\n1287: fn unknown_shape_prop_compound_assign_errors() {\n1288:     let program = parse(\"let p: { x: number } = { x: 1 }; p.y += 1;\").unwrap();\n1289:     let err = check(program).unwrap_err();\n1290:     assert!(\n1291:         err.message.contains(\"unknown property\") && err.message.contains(\"y\"),\n1292:         \"unexpected: {}\",\n1293:         err.message\n1294:     );\n1295: }\n1296: \n1297: #[test]\n1298: fn known_shape_prop_access_ok() {\n1299:     let program = parse(\"let p: { x: number } = { x: 1 }; let n: number = p.x; p.x = 2;\").unwrap();\n1300:     check(program).unwrap();\n1301: }\n1302: \n1303: #[test]\n1304: fn untyped_object_unknown_prop_stays_dynamic() {\n1305:     let program = parse(\"let p = { x: 1 }; p.y = 2; let n = p.y;\").unwrap();\n1306:     check(program).unwrap();\n1307: }\n1308: \n1309: #[test]\n1310: fn unknown_shape_prop_dynamic_ok_fixture_present() {\n1311:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load fixtures\");\n1312:     let ids: Vec<_> = fixtures.iter().map(|f| f.id.as_str()).collect();\n1313:     assert!(\n1314:         ids.iter().any(|id| *id == \"types/unknown_shape_prop_dynamic_ok\"),\n1315:         \"missing types/unknown_shape_prop_dynamic_ok fixture, got {ids:?}\"\n1316:     );\n1317: }\n1318: \n1319: #[test]\n1320: fn unknown_shape_prop_dynamic_ok_runs() {\n1321:     let fixtures = load_fixtures(&fixtures_dir()).expect(\"load\");\n1322:     let fixture = fixtures\n1323:         .iter()\n1324:         .find(|f| f.id == \"types/unknown_shape_prop_dynamic_ok\")\n1325:         .expect(\"types/unknown_shape_prop_dynamic_ok\");\n1326:     assert!(!fixture.targets.is_empty());\n1327:     for r in run_fixture(fixture) {\n1328:         assert!(\n1329:             r.ok,\n1330:             \"{} @ {}: {}\",\n1331:             r.fixture_id,\n1332:             r.target.as_str(),\n1333:             r.message\n1334:         );\n1335:     }\n1336: }\n\n(End of file - total 1336 lines)\n</content>",
      "metadata": {
        "preview": "//! ROADMAP T01–T06: type annotations, object types, unions/intersections/narrowing, generics, native types, dual-worlds boundary.\n\nuse draconic_check::{check, BoundProgram, CheckedProgram, NativeType, Type};\nuse draconic_conformance::{fixtures_dir, load_fixtures, run_fixture};\nuse draconic_parser::parse;\n\nfn user_sym<'a>(bound: &'a BoundProgram, name: &str) -> &'a draconic_check::Symbol {\n    // Prefer the last declaration (user code; builtins use dummy spans at the front).\n    bound\n        .symbols()\n        .iter()\n        .filter(|s| s.name == name)\n        .last()\n        .unwrap_or_else(|| panic!(\"no symbol `{name}`\"))\n}\n\nfn type_of(checked: &CheckedProgram, name: &str) -> Type {\n    let s = user_sym(&checked.bound, name);\n    checked.type_of_symbol(s.id)\n}",
