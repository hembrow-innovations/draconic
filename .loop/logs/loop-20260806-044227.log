\n        }\n        Stmt::LabelledStmt(LabelledStmt { body, .. }) => {\n            rewrite_stmt_dynamic_imports(body, ctx)?;\n        }\n        Stmt::BreakStmt(_) | Stmt::ContinueStmt(_) | Stmt::EmptyStmt(_) => {}\n        Stmt::FunctionDecl(FunctionDecl { body, params, .. })\n        | Stmt::ClassDecl(ClassDecl {\n            super_class,\n            body: class_body,\n            ..\n        })\n        | Stmt::ClassStaticBlock(ClassStaticBlock { stmts: class_body, .. }) => {\n            // super_class / class body handled below; function body stmts handled in\n            // the fallthrough arm via expr scanning? No — recurse into nested bodies.\n            let _ = body;\n            let _ = params;\n            let _ = super_class;\n            let _ = class_body;\n        }\n        Stmt::ExpressionStatement(..) => {}\n        _ => {}\n    }\n    Ok(())\n}\n/// Sentinel local name: export BindingName is a deferred module namespace\n/// (E19.84.02) — distinct shared object from the eager namespace.\nconst BINDING_DEFERRED_NAMESPACE: &str = \"\\0deferred-namespace\";"
