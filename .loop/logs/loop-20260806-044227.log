lossy());\n649:     }\n650:     let body = strs.pop().unwrap_or_default();\n651:     Ok(DynFunction {\n652:         params: strs,\n653:         body,\n654:     })\n655: }\n656: \n657: fn const_arg_values(args: &[Arg]) -> Result<Vec<EmbedValue>, String> {\n658:     let mut out = Vec::with_capacity(args.len());\n659:     for a in args {\n660:         let Arg::Expr(e) = a else {\n661:             return Err(\"spread args not supported\".into());\n662:         };\n663:         out.push(match e {\n664:             Expr::Number { raw, .. } => EmbedValue::Number(parse_number(raw)?),\n665:             Expr::String { value, .. } => EmbedValue::String(value.to_string_lossy()),\n666:             Expr::Boolean { value, .. } => EmbedValue::Boolean(*value),\n667:             Expr::Null { .. } => EmbedValue::Null,\n668:             _ => return Err(\"Function call args must be constant literals\".into()),\n669:         });\n670:     }\n671:     Ok(out)\n672: }\n673: \n674: fn parse_number(raw: &str) -> Result<f64, String> {\n675:     let s = raw.replace('_', \"\");\n676:     s.parse::<f64>()\n677:         .map_err(|_| format!(\"bad number literal: {raw}\"))\n678: }\n679: \n680: fn diag(message: impl Into<String>) -> Diagnostic {\n681:     Diagnostic::new(message, Span::dummy())\n682: }\n683: \n684: #[cfg(test)]\n685: mod tests {\n686:     use super::*;\n687:     use draconic_frontend::compile_source;\n688: \n689:     fn module_of(src: &str) -> Module {\n690:         compile_source(src).expect(\"compile\")\n691:     }\n692: \n693:     #[test]\n694:     fn fold_direct_eval_observations() {\n695:         let obs = fold_eval_program(&module_of(\n696:             r#\"\n697:             let t = typeof eval;\n698:             let g = globalThis.eval === eval;\n699:             let a = eval(\"1 + 2\");\n700:             let b = eval(\"typeof undefined\");\n701:             let c = eval(\"3 * 4\");\n702:             let d = eval(\"'hi'\");\n703:             \"#,\n704:         ))\n705:      