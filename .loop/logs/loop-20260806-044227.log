      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-backend-llvm/src/es_promise.rs</path>\n<type>file</type>\n<content>\n1: //! N06.03–N06.11: lower Promise + async/await (incl. async arrows) to Runtime ABI.\n2: \n3: use std::collections::{HashMap, HashSet};\n4: use std::fmt::Write as _;\n5: \n6: use draconic_ast::{BinaryOp, UnaryOp};\n7: use draconic_diagnostics::{Diagnostic, Span};\n8: use draconic_ir::{\n9:     Arg, ArrayElement, AssignTarget, Expr, IrType as Type, Local, LocalId, Module, Param, Pattern,\n10:     Stmt,\n11: };\n12: use draconic_runtime::abi::{\n13:     llvm_declares, ARRAY_GET, ARRAY_LEN, ARRAY_NEW, ARRAY_SET, ES_PROMISE_DECLARES, GC_INIT,\n14:     JOB_DRAIN, OBJECT_GET, PRINT_I64, PRINT_STR, PROMISE_ALL, PROMISE_ALL_SETTLED, PROMISE_ANY,\n15:     PROMISE_AWAIT, PROMISE_CONSTRUCT, PROMISE_FINALLY, PROMISE_NEW, PROMISE_RACE, PROMISE_REJECT,\n16:     PROMISE_RESOLVE, PROMISE_THEN,\n17: };\n18: \n19: /// True when this module is the supported Promise/async subset (E12.01–E12.09 / N06.03–N06.11).\n20: pub(crate) fn is_es_promise_module(module: &Module) -> bool {\n21:     match try_classify(module) {\n22:         Ok(info) => info.uses_promise,\n23:         Err(_) => false,\n24:     }\n25: }\n26: \n27: pub(crate) fn emit_es_promise(module: &Module) -> Result<String, Diagnostic> {\n28:     let info = try_classify(module).map_err(diag)?;\n29:     if !info.uses_promise {\n30:         return Err(diag(\"internal: not a Promise module\"));\n31:     }\n32:     let mut em = Emitter::new(module, info);\n33:     em.emit_module()?;\n34:     Ok(em.finish())\n35: }\n36: \n37: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n38: enum SlotKind {\n39:     Number,\n40:     String,\n41:     Object,\n42: }\n43: \n44: struct ModuleInfo {\n45:     uses_promise: bool,\n46:     promise_id: Option<LocalId>,\n47:     /// Top-level user locals to allocate / print (source order).\n48:     user_locals: Vec<(LocalId, SlotKind)>,\n49: }\n50: \n51: fn try_classify(module: &Module) -> Result<ModuleInfo, String> {\n52:     let by_id: HashMap<LocalId, &Local> = module.locals.iter().map(|l| (l.id, l)).collect();\n53:     let promise_id = module\n54:         .locals\n55:         .iter()\n56:         .find(|l| l.name == \"Promise\")\n57:         .map(|l| l.id);\n58: \n59:     let mut user_ids = HashSet::new();\n60:     collect_top_level_decl_ids(&module.body, &mut user_ids);\n61: \n62:     let mut user_locals = Vec::new();\n63:     let mut seen = HashSet::new();\n64:     for stmt in &module.body {\n65:         if let Stmt::Declare { local, .. } = stmt {\n66:             if !seen.insert(*local) {\n67:                 continue;\n68:             }\n69:             if !user_ids.contains(local) {\n70:                 continue;\n71:             }\n72:             let Some(loc) = by_id.get(local) else {\n73:                 continue;\n74:             };\n75:             // Skip nested function param / arguments bindings that appear as declares.\n76:             if loc.name == \"arguments\" {\n77:                 continue;\n78:             }\n79:             let kind = match loc.ty {\n80:                 Type::Number => SlotKind::Number,\n81:                 Type::String => SlotKind::String,\n82:                 Type::Object | Type::Any | Type::Function => SlotKind::Object,\n83:                 _ => return Err(format!(\"unsupported local type for `{}`\", loc.name)),\n84:             };\n85:             user_locals.push((*local, kind));\n86:         }\n87:     }\n88: \n89:     // Async function declarations bind a function local without a `Declare`.\n90:     for stmt in &module.body {\n91:         if let Stmt::Function { local, is_async, .. } = stmt {\n92:             if !*is_async {\n93:                 return Err(\"only async function declarations supported in Promise path\".into());\n94:             }\n95:             if seen.insert(*local) {\n96:                 user_locals.push((*local, SlotKind::Object));\n97:             }\n98:         }\n99:     }\n100: \n101:     let mut uses_promise = false;\n102:     for stmt in &module.body {\n103:         check_stmt(stmt, promise_id, &mut uses_promise)?;\n104:     }\n105: \n106:     Ok(ModuleInfo {\n107:         uses_promise,\n108:         promise_id,\n109:         user_locals,\n110:     })\n111: }\n112: \n113: fn check_simple_params(params: &[Param]) -> Result<(), String> {\n114:     for p in params {\n115:         if p.rest || p.default.is_some() {\n116:             return Err(\"rest/default params not supported\".into());\n117:         }\n118:         if !matches!(p.pattern, Pattern::Local(_)) {\n119:             return Err(\"only simple params supported\".into());\n120:         }\n121:     }\n122:     Ok(())\n123: }\n124: \n125: fn collect_top_level_decl_ids(body: &[Stmt], out: &mut HashSet<LocalId>) {\n126:     for stmt in body {\n127:         match stmt {\n128:             Stmt::Declare { local, .. } => {\n129:                 out.insert(*local);\n130:             }\n131:             Stmt::Expr { .. } => {}\n132:             Stmt::Block { body } => collect_top_level_decl_ids(body, out),\n133:             _ => {}\n134:         }\n135:     }\n136: }\n137: \n138: fn check_stmt(stmt: &Stmt, promise_id: Option<LocalId>, uses: &mut bool) -> Result<(), String> {\n139:     match stmt {\n140:         Stmt::Declare { init, .. } => {\n141:             if let Some(e) = init {\n142:                 check_expr(e, promise_id, uses)?;\n143:             }\n144:             Ok(())\n145:         }\n146:         Stmt::Expr { expr } => check_expr(expr, promise_id, uses),\n147:         Stmt::Return { value } => {\n148:             if let Some(e) = value {\n149:                 check_expr(e, promise_id, uses)?;\n150:             }\n151:             Ok(())\n152:         }\n153:         Stmt::Throw { value } => check_expr(value, promise_id, uses),\n154:         Stmt::Block { body } => {\n155:             for s in body {\n156:                 check_stmt(s, promise_id, uses)?;\n157:             }\n158:             Ok(())\n159:         }\n160:         Stmt::Function {\n161:             params,\n162:             body,\n163:             is_async,\n164:             is_generator,\n165:             ..\n166:         } => {\n167:             if !*is_async || *is_generator {\n168:                 return Err(\"only async function declarations supported in Promise path\".into());\n169:             }\n170:             check_simple_params(params)?;\n171:             *uses = true;\n172:             for s in body {\n173:                 check_stmt(s, promise_id, uses)?;\n174:             }\n175:             Ok(())\n176:         }\n177:         other => Err(format!(\"unsupported statement in Promise path: {other:?}\")),\n178:     }\n179: }\n180: \n181: fn check_expr(expr: &Expr, promise_id: Option<LocalId>, uses: &mut bool) -> Result<(), String> {\n182:     match expr {\n183:         Expr::Local { .. }\n184:         | Expr::Number { .. }\n185:         | Expr::String { .. }\n186:         | Expr::Boolean { .. }\n187:         | Expr::Null { .. } => Ok(()),\n188:         Expr::Unary { op, arg, .. } => {\n189:             match op {\n190:                 UnaryOp::TypeOf | UnaryOp::Minus | UnaryOp::Plus | UnaryOp::Not => {}\n191:                 UnaryOp::Await => {\n192:                     *uses = true;\n193:                 }\n194:                 _ => return Err(format!(\"unsupported unary {op:?}\")),\n195:             }\n196:             check_expr(arg, promise_id, uses)\n197:         }\n198:         Expr::Binary { left, op, right, .. } => {\n199:             match op {\n200:                 BinaryOp::Add\n201:                 | BinaryOp::Sub\n202:                 | BinaryOp::Mul\n203:                 | BinaryOp::Div\n204:                 | BinaryOp::Rem => {}\n205:                 _ => return Err(format!(\"unsupported binary {op:?}\")),\n206:             }\n207:             check_expr(left, promise_id, uses)?;\n208:             check_expr(right, promise_id, uses)\n209:         }\n210:         Expr::Assign { target, value, .. } => {\n211:             match target {\n212:                 AssignTarget::Local(_) => {}\n213:                 _ => return Err(\"only local assignment supported in Promise path\".into()),\n214:             }\n215:             check_expr(value, promise_id, uses)\n216:         }\n217:         Expr::Call { callee, args, optional, .. } => {\n218:             if *optional {\n219:                 return Err(\"optional call not supported\".into());\n220:             }\n221:             check_expr(callee, promise_id, uses)?;\n222:             for a in args {\n223:                 match a {\n224:                     Arg::Expr(e) => check_expr(e, promise_id, uses)?,\n225:                     Arg::Spread(_) => return Err(\"spread args not supported\".into()),\n226:                 }\n227:             }\n228:             Ok(())\n229:         }\n230:         Expr::New { callee, args, .. } => {\n231:             if let Expr::Local { id, .. } = callee.as_ref() {\n232:                 if Some(*id) == promise_id {\n233:                     *uses = true;\n234:                 } else {\n235:                     return Err(\"only `new Promise` supported\".into());\n236:                 }\n237:             } else {\n238:                 return Err(\"only `new Promise` supported\".into());\n239:             }\n240:             for a in args {\n241:                 match a {\n242:                     Arg::Expr(e) => check_expr(e, promise_id, uses)?,\n243:                     Arg::Spread(_) => return Err(\"spread args not supported\".into()),\n244:                 }\n245:             }\n246:             Ok(())\n247:         }\n248:         Expr::Member {\n249:             object,\n250:             property,\n251:             computed,\n252:             optional,\n253:             ..\n254:         } => {\n255:             if *optional {\n256:                 return Err(\"optional member not supported in Promise path\".into());\n257:             }\n258:             check_expr(object, promise_id, uses)?;\n259:             if *computed {\n260:                 check_expr(property, promise_id, uses)?;\n261:                 return Ok(());\n262:             }\n263:             let Expr::String { value, .. } = property.as_ref() else {\n264:                 return Err(\"only string property keys supported\".into());\n265:             };\n266:             let prop = value.to_string_lossy();\n267:             match prop.as_ref() {\n268:                 \"then\" | \"catch\" | \"finally\" => {\n269:                     *uses = true;\n270:                     Ok(())\n271:                 }\n272:                 \"length\" | \"status\" | \"value\" | \"reason\" | \"name\" | \"errors\" => Ok(()),\n273:                 \"resolve\" | \"reject\" | \"all\" | \"race\" | \"allSettled\" | \"any\" => {\n274:                     if let Expr::Local { id, .. } = object.as_ref() {\n275:                         if Some(*id) == promise_id {\n276:                             *uses = true;\n277:                             return Ok(());\n278:                         }\n279:                     }\n280:                     Err(\n281:                         \"only Promise.resolve / Promise.reject / Promise.all / Promise.race / Promise.allSettled / Promise.any supported\"\n282:                             .into(),\n283:                     )\n284:                 }\n285:                 _ => Err(format!(\"unsupported property `{}` in Promise path\", prop)),\n286:             }\n287:         }\n288:         Expr::Array { elements, .. } => {\n289:             for el in elements {\n290:                 match el {\n291:                     ArrayElement::Expr(e) => check_expr(e, promise_id, uses)?,\n292:                     ArrayElement::Spread(_) => {\n293:                         return Err(\"spread in array not supported in Promise path\".into());\n294:                     }\n295:                     ArrayElement::Elision => {}\n296:                 }\n297:             }\n298:             Ok(())\n299:         }\n300:         Expr::Function {\n301:             name,\n302:             params,\n303:             body,\n304:             is_async,\n305:             is_generator,\n306:             ..\n307:         } => {\n308:             if *is_generator {\n309:                 return Err(\"generator functions not supported in Promise path\".into());\n310:             }\n311:             if *is_async {\n312:                 *uses = true;\n313:             }\n314:             if name.is_some() {\n315:                 return Err(\"named function expressions not supported\".into());\n316:             }\n317:             check_simple_params(params)?;\n318:             for s in body {\n319:                 check_stmt(s, promise_id, uses)?;\n320:             }\n321:             Ok(())\n322:         }\n323:         other => Err(format!(\"unsupported expr in Promise path: {other:?}\")),\n324:     }\n325: }\n326: \n327: struct Emitter<'a> {\n328:     module: &'a Module,\n329:     info: ModuleInfo,\n330:     out: String,\n331:     body: String,\n332:     tmp: u32,\n333:     next_fn: u32,\n334:     /// local id → alloca ptr name (`%lN`)\n335:     allocas: HashMap<LocalId, String>,\n336:     /// string constants: content → global name\n337:     str_globals: HashMap<String, String>,\n338:     /// emitted helper function IR (appended before main)\n339:     helpers: String,\n340:     /// While lowering an executor: param local → (settle_fn_ssa, cap_ssa)\n341:     executor_params: HashMap<LocalId, (String, String)>,\n342:     /// While lowering a reaction: param local → value ssa (ptr)\n343:     reaction_params: HashMap<LocalId, String>,\n344:     /// Capture slots passed as reaction `data` (env of alloca ptrs, or single).\n345:     reaction_captures: Vec<LocalId>,\n346:     /// Known async function locals → LLVM function name (0-arg, returns Promise ptr).\n347:     async_fns: HashMap<LocalId, String>,\n348: }\n349: \n350: impl<'a> Emitter<'a> {\n351:     fn new(module: &'a Module, info: ModuleInfo) -> Self {\n352:         Self {\n353:             module,\n354:             info,\n355:             out: String::new(),\n356:             body: String::new(),\n357:             tmp: 0,\n358:             next_fn: 0,\n359:             allocas: HashMap::new(),\n360:             str_globals: HashMap::new(),\n361:             helpers: String::new(),\n362:             executor_params: HashMap::new(),\n363:             reaction_params: HashMap::new(),\n364:             reaction_captures: Vec::new(),\n365:             async_fns: HashMap::new(),\n366:         }\n367:     }\n368: \n369:     fn finish(self) -> String {\n370:         self.out\n371:     }\n372: \n373:     fn fresh(&mut self) -> String {\n374:         let n = self.tmp;\n375:         self.tmp += 1;\n376:         format!(\"%t{n}\")\n377:     }\n378: \n379:     fn fresh_fn(&mut self, prefix: &str) -> String {\n380:         let n = self.next_fn;\n381:         self.next_fn += 1;\n382:         format!(\"d_{prefix}_{n}\")\n383:     }\n384: \n385:     fn emit_module(&mut self) -> Result<(), Diagnostic> {\n386:         writeln!(\n387:             self.out,\n388:             \"; Draconic LLVM backend (N06.03–N06.11 Promise/async via Runtime ABI)\"\n389:         )\n390:         .ok();\n391:         writeln!(self.out, \"{}\", llvm_declares(ES_PROMISE_DECLARES)).ok();\n392:         writeln!(self.out).ok();\n393: \n394:         // Pre-scan string constants from typeof etc. by emitting body into buffer first.\n395:         self.body.clear();\n396:         self.tmp = 0;\n397: \n398:         for (id, kind) in self.info.user_locals.clone() {\n399:             let ptr = format!(\"%l{}\", id.0);\n400:             self.allocas.insert(id, ptr.clone());\n401:             match kind {\n402:                 SlotKind::Number => {\n403:                     writeln!(self.body, \"  {ptr} = alloca i64, align 8\").ok();\n404:                     writeln!(self.body, \"  store i64 0, ptr {ptr}\").ok();\n405:                 }\n406:                 SlotKind::String | SlotKind::Object => {\n407:                     writeln!(self.body, \"  {ptr} = alloca ptr, align 8\").ok();\n408:                     writeln!(self.body, \"  store ptr null, ptr {ptr}\").ok();\n409:                 }\n410:             }\n411:         }\n412: \n413:         for stmt in &self.module.body {\n414:             self.emit_stmt(stmt)?;\n415:         }\n416: \n417:         // Drain microtasks before observing locals.\n418:         writeln!(self.body, \"  {}\", JOB_DRAIN.call(\"\")).ok();\n419: \n420:         for (id, kind) in self.info.user_locals.clone() {\n421:             let ptr = self.allocas.get(&id).cloned().unwrap();\n422:             match kind {\n423:                 SlotKind::Number => {\n424:                     let v = self.fresh();\n425:                     writeln!(self.body, \"  {v} = load i64, ptr {ptr}\").ok();\n426:                     writeln!(self.body, \"  {}\", PRINT_I64.call(&format!(\"i64 {v}\"))).ok();\n427:                 }\n428:                 SlotKind::String => {\n429:                     let v = self.fresh();\n430:                     writeln!(self.body, \"  {v} = load ptr, ptr {ptr}\").ok();\n431:                     writeln!(self.body, \"  {}\", PRINT_STR.call(&format!(\"ptr {v}\"))).ok();\n432:                 }\n433:                 SlotKind::Object => {\n434:                     // Promise objects are not printed (observation is via number/string side effects).\n435:                 }\n436:             }\n437:         }\n438: \n439:         // String globals\n440:         for (content, gname) in self.str_globals.clone() {\n441:             let n = content.len() + 1;\n442:             let esc = escape_llvm_string(&content);\n443:             writeln!(\n444:                 self.out,\n445:                 \"@{gname} = private unnamed_addr constant [{n} x i8] c\\\"{esc}\\\\00\\\", align 1\"\n446:             )\n447:             .ok();\n448:         }\n449:         if !self.str_globals.is_empty() {\n450:             writeln!(self.out).ok();\n451:         }\n452: \n453:         // Helpers (executors + reactions)\n454:         self.out.push_str(&self.helpers);\n455:         if !self.helpers.is_empty() {\n456:             writeln!(self.out).ok();\n457:         }\n458: \n459:         writeln!(self.out, \"define i32 @main() {{\").ok();\n460:         writeln!(self.out, \"entry:\").ok();\n461:         writeln!(self.out, \"  {}\", GC_INIT.call(\"\")).ok();\n462:         self.out.push_str(&self.body);\n463:         writeln!(self.out, \"  ret i32 0\").ok();\n464:         writeln!(self.out, \"}}\").ok();\n465:         Ok(())\n466:     }\n467: \n468:     fn emit_stmt(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n469:         match stmt {\n470:             Stmt::Declare { local, init, .. } => {\n471:                 if let Some(e) = init {\n472:                     let v = self.emit_expr(e)?;\n473:                     self.store_local(*local, &v)?;\n474:                 }\n475:                 Ok(())\n476:             }\n477:             Stmt::Expr { expr } => {\n478:                 let _ = self.emit_expr(expr)?;\n479:                 Ok(())\n480:             }\n481:             Stmt::Return { value } => {\n482:                 // Only valid inside reaction helpers — handled separately.\n483:                 let _ = value;\n484:                 Err(diag(\"return at top level not supported\"))\n485:             }\n486:             Stmt::Block { body } => {\n487:                 for s in body {\n488:                     self.emit_stmt(s)?;\n489:                 }\n490:                 Ok(())\n491:             }\n492:             Stmt::Function {\n493:                 local,\n494:                 params,\n495:                 body,\n496:                 is_async,\n497:                 is_generator,\n498:             } => {\n499:                 if !*is_async || *is_generator {\n500:                     return Err(diag(\"only async function declarations supported\"));\n501:                 }\n502:                 let fn_name = self.emit_async_fn(params, body)?;\n503:                 self.async_fns.insert(*local, fn_name.clone());\n504:                 let t = self.fresh();\n505:                 writeln!(self.body, \"  {t} = bitcast ptr @{fn_name} to ptr\").ok();\n506:                 self.store_local(*local, &t)?;\n507:                 Ok(())\n508:             }\n509:             _ => Err(diag(\"unsupported statement\")),\n510:         }\n511:     }\n512: \n513:     fn store_local(&mut self, id: LocalId, value_ptr_or_num: &str) -> Result<(), Diagnostic> {\n514:         let Some(kind) = self.slot_kind(id) else {\n515:             // Nested param / unknown — ignore stores to non-top-level when not in reaction.\n516:             if let Some(ptr) = self.allocas.get(&id).cloned() {\n517:                 writeln!(self.body, \"  store ptr {value_ptr_or_num}, ptr {ptr}\").ok();\n518:                 return Ok(());\n519:             }\n520:             return Ok(());\n521:         };\n522:         let ptr = self\n523:             .allocas\n524:             .get(&id)\n525:             .cloned()\n526:             .ok_or_else(|| diag(\"missing alloca\"))?;\n527:         match kind {\n528:             SlotKind::Number => {\n529:                 let n = self.fresh();\n530:                 writeln!(\n531:                     self.body,\n532:                     \"  {n} = ptrtoint ptr {value_ptr_or_num} to i64\"\n533:                 )\n534:                 .ok();\n535:                 writeln!(self.body, \"  store i64 {n}, ptr {ptr}\").ok();\n536:             }\n537:             SlotKind::String | SlotKind::Object => {\n538:                 writeln!(\n539:                     self.body,\n540:                     \"  store ptr {value_ptr_or_num}, ptr {ptr}\"\n541:                 )\n542:                 .ok();\n543:             }\n544:         }\n545:         Ok(())\n546:     }\n547: \n548:     fn store_local_in(\n549:         &mut self,\n550:         buf: &mut String,\n551:         id: LocalId,\n552:         value_ptr: &str,\n553:     ) -> Result<(), Diagnostic> {\n554:         let Some(kind) = self.slot_kind(id) else {\n555:             return Ok(());\n556:         };\n557:         // Capture allocas live in main; reaction env (`%data`) holds pointers to them.\n558:         let slot = self.reaction_capture_slot(id, buf)?;\n559:         match kind {\n560:             SlotKind::Number => {\n561:                 let n = format!(\"%n{}\", self.tmp);\n562:                 self.tmp += 1;\n563:                 writeln!(buf, \"  {n} = ptrtoint ptr {value_ptr} to i64\").ok();\n564:                 writeln!(buf, \"  store i64 {n}, ptr {slot}\").ok();\n565:             }\n566:             SlotKind::String | SlotKind::Object => {\n567:                 writeln!(buf, \"  store ptr {value_ptr}, ptr {slot}\").ok();\n568:             }\n569:         }\n570:         Ok(())\n571:     }\n572: \n573:     /// Resolve the alloca ptr for a captured local inside a reaction (`%data` env).\n574:     fn reaction_capture_slot(\n575:         &mut self,\n576:         id: LocalId,\n577:         buf: &mut String,\n578:     ) -> Result<String, Diagnostic> {\n579:         let Some(pos) = self.reaction_captures.iter().position(|c| *c == id) else {\n580:             return Err(diag(\"capture not in reaction env\"));\n581:         };\n582:         if self.reaction_captures.len() == 1 {\n583:             return Ok(\"%data\".into());\n584:         }\n585:         let gep = format!(\"%envp{}\", self.tmp);\n586:         self.tmp += 1;\n587:         let slot = format!(\"%slot{}\", self.tmp);\n588:         self.tmp += 1;\n589:         let n = self.reaction_captures.len();\n590:         writeln!(\n591:             buf,\n592:             \"  {gep} = getelementptr inbounds [{n} x ptr], ptr %data, i64 0, i64 {pos}\"\n593:         )\n594:         .ok();\n595:         writeln!(buf, \"  {slot} = load ptr, ptr {gep}\").ok();\n596:         Ok(slot)\n597:     }\n598: \n599:     fn slot_kind(&self, id: LocalId) -> Option<SlotKind> {\n600:         self.info\n601:             .user_locals\n602:             .iter()\n603:             .find(|(i, _)| *i == id)\n604:             .map(|(_, k)| *k)\n605:     }\n606: \n607:     fn emit_expr(&mut self, expr: &Expr) -> Result<String, Diagnostic> {\n608:         match expr {\n609:             Expr::Number { raw, .. } => {\n610:                 let n: i64 = parse_number(raw)?;\n611:                 let t = self.fresh();\n612:                 writeln!(self.body, \"  {t} = inttoptr i64 {n} to ptr\").ok();\n613:                 Ok(t)\n614:             }\n615:             Expr::String { value, .. } => self.string_const(&value.to_string_lossy()),\n616:             Expr::Local { id, .. } => self.load_local(*id),\n617:             Expr::Unary { op, arg, .. } => match op {\n618:                 UnaryOp::TypeOf => self.emit_typeof(arg),\n619:                 UnaryOp::Minus => {\n620:                     let a = self.emit_expr(arg)?;\n621:                     let n = self.fresh();\n622:                     let m = self.fresh();\n623:                     let r = self.fresh();\n624:                     writeln!(self.body, \"  {n} = ptrtoint ptr {a} to i64\").ok();\n625:                     writeln!(self.body, \"  {m} = sub i64 0, {n}\").ok();\n626:                     writeln!(self.body, \"  {r} = inttoptr i64 {m} to ptr\").ok();\n627:                     Ok(r)\n628:                 }\n629:                 UnaryOp::Plus => self.emit_expr(arg),\n630:                 UnaryOp::Await => Err(diag(\"await only valid inside async function body\")),\n631:                 _ => Err(diag(\"unsupported unary\")),\n632:             },\n633:             Expr::Binary { left, op, right, .. } => {\n634:                 let l = self.emit_expr(left)?;\n635:                 let r = self.emit_expr(right)?;\n636:                 let ln = self.fresh();\n637:                 let rn = self.fresh();\n638:                 let out = self.fresh();\n639:                 let res = self.fresh();\n640:                 writeln!(self.body, \"  {ln} = ptrtoint ptr {l} to i64\").ok();\n641:                 writeln!(self.body, \"  {rn} = ptrtoint ptr {r} to i64\").ok();\n642:                 let inst = match op {\n643:                     BinaryOp::Add => \"add\",\n644:                     BinaryOp::Sub => \"sub\",\n645:                     BinaryOp::Mul => \"mul\",\n646:                     BinaryOp::Div => \"sdiv\",\n647:                     BinaryOp::Rem => \"srem\",\n648:                     _ => return Err(diag(\"unsupported binary\")),\n649:                 };\n650:                 writeln!(self.body, \"  {out} = {inst} i64 {ln}, {rn}\").ok();\n651:                 writeln!(self.body, \"  {res} = inttoptr i64 {out} to ptr\").ok();\n652:                 Ok(res)\n653:             }\n654:             Expr::Assign { target, value, .. } => {\n655:                 let v = self.emit_expr(value)?;\n656:                 match target {\n657:                     AssignTarget::Local(id) => {\n658:                         self.store_local(*id, &v)?;\n659:                         Ok(v)\n660:                     }\n661:                     _ => Err(diag(\"unsupported assign target\")),\n662:                 }\n663:             }\n664:             Expr::New { callee, args, .. } => self.emit_new_promise(callee, args),\n665:             Expr::Call { callee, args, .. } => self.emit_call(callee, args),\n666:             Expr::Array { elements, .. } => self.emit_array(elements),\n667:             Expr::Member {\n668:                 object,\n669:                 property,\n670:                 computed,\n671:                 optional,\n672:                 ..\n673:             } => {\n674:                 if *optional {\n675:                     return Err(diag(\"optional member not supported\"));\n676:                 }\n677:                 self.emit_member(object, property, *computed)\n678:             }\n679:             Expr::Function {\n680:                 name,\n681:                 params,\n682:                 body,\n683:                 is_async,\n684:                 is_generator,\n685:                 ..\n686:             } => {\n687:                 if name.is_some() {\n688:                     return Err(diag(\"named function expressions not supported\"));\n689:                 }\n690:                 if *is_generator {\n691:                     return Err(diag(\"generator functions not supported\"));\n692:                 }\n693:                 if *is_async {\n694:                     let fn_name = self.emit_async_fn(params, body)?;\n695:                     let t = self.fresh();\n696:                     writeln!(self.body, \"  {t} = bitcast ptr @{fn_name} to ptr\").ok();\n697:                     return Ok(t);\n698:                 }\n699:                 Err(diag(\"bare function expr not supported at value position\"))\n700:             }\n701:             _ => Err(diag(\"unsupported expression\")),\n702:         }\n703:     }\n704: \n705:     fn emit_array(&mut self, elements: &[ArrayElement]) -> Result<String, Diagnostic> {\n706:         let n = elements.len();\n707:         let arr = self.fresh();\n708:         writeln!(\n709:             self.body,\n710:             \"  {}\",\n711:             ARRAY_NEW.call_to(&arr, &format!(\"i64 {n}\"))\n712:         )\n713:         .ok();\n714:         for (i, el) in elements.iter().enumerate() {\n715:             let ArrayElement::Expr(e) = el else {\n716:                 return Err(diag(\"spread array elements not supported\"));\n717:             };\n718:             let v = self.emit_expr(e)?;\n719:             writeln!(\n720:                 self.body,\n721:                 \"  {}\",\n722:                 ARRAY_SET.call(&format!(\"ptr {arr}, i64 {i}, ptr {v}\"))\n723:             )\n724:             .ok();\n725:         }\n726:         Ok(arr)\n727:     }\n728: \n729:     fn emit_member(\n730:         &mut self,\n731:         object: &Expr,\n732:         property: &Expr,\n733:         computed: bool,\n734:     ) -> Result<String, Diagnostic> {\n735:         if computed {\n736:             let obj = self.emit_expr(object)?;\n737:             let idx_ptr = self.emit_expr(property)?;\n738:             let idx = self.fresh();\n739:             let t = self.fresh();\n740:             writeln!(self.body, \"  {idx} = ptrtoint ptr {idx_ptr} to i64\").ok();\n741:             writeln!(\n742:                 self.body,\n743:                 \"  {}\",\n744:                 ARRAY_GET.call_to(&t, &format!(\"ptr {obj}, i64 {idx}\"))\n745:             )\n746:             .ok();\n747:             return Ok(t);\n748:         }\n749:         let Expr::String { value, .. } = property else {\n750:             return Err(diag(\"only string property keys supported\"));\n751:         };\n752:         let prop = value.to_string_lossy();\n753:         if prop == \"length\" {\n754:             let obj = self.emit_expr(object)?;\n755:             let n = self.fresh();\n756:             let t = self.fresh();\n757:             writeln!(\n758:                 self.body,\n759:                 \"  {}\",\n760:                 ARRAY_LEN.call_to(&n, &format!(\"ptr {obj}\"))\n761:             )\n762:             .ok();\n763:             writeln!(self.body, \"  {t} = inttoptr i64 {n} to ptr\").ok();\n764:             return Ok(t);\n765:         }\n766:         if prop == \"status\"\n767:             || prop == \"value\"\n768:             || prop == \"reason\"\n769:             || prop == \"name\"\n770:             || prop == \"errors\"\n771:         {\n772:             let obj = self.emit_expr(object)?;\n773:             let key = self.string_const(&prop)?;\n774:             let t = self.fresh();\n775:             writeln!(\n776:                 self.body,\n777:                 \"  {}\",\n778:                 OBJECT_GET.call_to(&t, &format!(\"ptr {obj}, ptr {key}\"))\n779:             )\n780:             .ok();\n781:             return Ok(t);\n782:         }\n783:         Err(diag(format!(\"unsupported member `{}`\", prop)))\n784:     }\n785: \n786:     fn load_local(&mut self, id: LocalId) -> Result<String, Diagnostic> {\n787:         if let Some((settle, cap)) = self.executor_params.get(&id).cloned() {\n788:             // Calling resolve/reject is handled in emit_call; loading as value is unsupported.\n789:             let _ = (settle, cap);\n790:             return Err(diag(\"cannot use resolve/reject as values\"));\n791:         }\n792:         if let Some(v) = self.reaction_params.get(&id).cloned() {\n793:             return Ok(v);\n794:         }\n795:         let Some(kind) = self.slot_kind(id) else {\n796:             // Unknown local (e.g. unused) → null\n797:             let t = self.fresh();\n798:             writeln!(self.body, \"  {t} = inttoptr i64 0 to ptr\").ok();\n799:             return Ok(t);\n800:         };\n801:         let ptr = self\n802:             .allocas\n803:             .get(&id)\n804:             .cloned()\n805:             .ok_or_else(|| diag(\"missing alloca\"))?;\n806:         match kind {\n807:             SlotKind::Number => {\n808:                 let n = self.fresh();\n809:                 let t = self.fresh();\n810:                 writeln!(self.body, \"  {n} = load i64, ptr {ptr}\").ok();\n811:                 writeln!(self.body, \"  {t} = inttoptr i64 {n} to ptr\").ok();\n812:                 Ok(t)\n813:             }\n814:             SlotKind::String | SlotKind::Object => {\n815:                 let t = self.fresh();\n816:                 writeln!(self.body, \"  {t} = load ptr, ptr {ptr}\").ok();\n817:                 Ok(t)\n818:             }\n819:         }\n820:     }\n821: \n822:     fn emit_typeof(&mut self, arg: &Expr) -> Result<String, Diagnostic> {\n823:         // typeof Promise → \"function\"\n824:         if let Expr::Local { id, .. } = arg {\n825:             if Some(*id) == self.info.promise_id {\n826:                 return self.string_const(\"function\");\n827:             }\n828:         }\n829:         // typeof Promise.resolve / Promise.reject / p.then|catch|finally → \"function\"\n830:         if let Expr::Member {\n831:             object,\n832:             property,\n833:             computed,\n834:             optional,\n835:             ..\n836:         } = arg\n837:         {\n838:             if !*optional && !*computed {\n839:                 if let Expr::String { value, .. } = property.as_ref() {\n840:                     let prop = value.to_string_lossy();\n841:                     match prop.as_ref() {\n842:                         \"resolve\" | \"reject\" | \"all\" | \"race\" | \"allSettled\" | \"any\" => {\n843:                             if let Expr::Local { id, .. } = object.as_ref() {\n844:                                 if Some(*id) == self.info.promise_id {\n845:                                     return self.string_const(\"function\");\n846:                                 }\n847:                             }\n848:                         }\n849:                         \"then\" | \"catch\" | \"finally\" => {\n850:                             let _ = self.emit_expr(object)?;\n851:                             return self.string_const(\"function\");\n852:                         }\n853:                         _ => {}\n854:                     }\n855:                 }\n856:             }\n857:         }\n858:         // typeof promise object → \"object\"\n859:         let _ = self.emit_expr(arg)?;\n860:         self.string_const(\"object\")\n861:     }\n862: \n863:     fn string_const(&mut self, s: &str) -> Result<String, Diagnostic> {\n864:         let gname = if let Some(g) = self.str_globals.get(s) {\n865:             g.clone()\n866:         } else {\n867:             let g = format!(\".str.{}\", self.str_globals.len());\n868:             self.str_globals.insert(s.to_string(), g.clone());\n869:             g\n870:         };\n871:         let t = self.fresh();\n872:         let n = s.len() + 1;\n873:         writeln!(\n874:             self.body,\n875:             \"  {t} = getelementptr inbounds [{n} x i8], ptr @{gname}, i64 0, i64 0\"\n876:         )\n877:         .ok();\n878:         Ok(t)\n879:     }\n880: \n881:     fn emit_new_promise(\n882:         &mut self,\n883:         callee: &Expr,\n884:         args: &[Arg],\n885:     ) -> Result<String, Diagnostic> {\n886:         let Expr::Local { id, .. } = callee else {\n887:             return Err(diag(\"new callee must be Promise\"));\n888:         };\n889:         if Some(*id) != self.info.promise_id {\n890:             return Err(diag(\"only new Promise supported\"));\n891:         }\n892:         if args.len() != 1 {\n893:             return Err(diag(\"Promise constructor expects 1 argument\"));\n894:         }\n895:         let Arg::Expr(exec_expr) = &args[0] else {\n896:             return Err(diag(\"spread not supported\"));\n897:         };\n898:         let Expr::Function { params, body, .. } = exec_expr else {\n899:             return Err(diag(\"Promise executor must be a function expression\"));\n900:         };\n901:         let fn_name = self.emit_executor_fn(params, body)?;\n902:         let t = self.fresh();\n903:         writeln!(\n904:             self.body,\n905:             \"  {}\",\n906:             PROMISE_CONSTRUCT.call_to(&t, &format!(\"ptr @{fn_name}, ptr null\"))\n907:         )\n908:         .ok();\n909:         Ok(t)\n910:     }\n911: \n912:     fn emit_call(&mut self, callee: &Expr, args: &[Arg]) -> Result<String, Diagnostic> {\n913:         // resolve(value) / reject(reason) inside executor\n914:         if let Expr::Local { id, .. } = callee {\n915:             if let Some((settle, cap)) = self.executor_params.get(id).cloned() {\n916:                 if args.len() != 1 {\n917:                     return Err(diag(\"resolve/reject expect 1 arg\"));\n918:                 }\n919:                 let Arg::Expr(vexpr) = &args[0] else {\n920:                     return Err(diag(\"spread not supported\"));\n921:                 };\n922:                 let v = self.emit_expr(vexpr)?;\n923:                 writeln!(\n924:                     self.body,\n925:                     \"  call void {settle}(ptr {cap}, ptr {v})\"\n926:                 )\n927:                 .ok();\n928:                 let t = self.fresh();\n929:                 writeln!(self.body, \"  {t} = inttoptr i64 0 to ptr\").ok();\n930:                 return Ok(t);\n931:             }\n932:             // User async function call (0+ simple args; N06.10–N06.11).\n933:             let mut arg_ssas = Vec::with_capacity(args.len());\n934:             for a in args {\n935:                 let Arg::Expr(e) = a else {\n936:                     return Err(diag(\"spread args not supported\"));\n937:                 };\n938:                 arg_ssas.push(self.emit_expr(e)?);\n939:             }\n940:             let arg_list = format_ptr_args(&arg_ssas);\n941:             if let Some(name) = self.async_fns.get(id).cloned() {\n942:                 let t = self.fresh();\n943:                 writeln!(self.body, \"  {t} = call ptr @{name}({arg_list})\").ok();\n944:                 return Ok(t);\n945:             }\n946:             if matches!(self.slot_kind(*id), Some(SlotKind::Object)) {\n947:                 let fp = self.load_local(*id)?;\n948:                 let t = self.fresh();\n949:                 writeln!(self.body, \"  {t} = call ptr {fp}({arg_list})\").ok();\n950:                 return Ok(t);\n951:             }\n952:         }\n953: \n954:         // Promise.resolve(v) / Promise.reject(v) / promise.then / promise.catch\n955:         if let Expr::Member {\n956:             object,\n957:             property,\n958:             computed,\n959:             optional,\n960:             ..\n961:         } = callee\n962:         {\n963:             if *optional || *computed {\n964:                 return Err(diag(\"unsupported member call\"));\n965:             }\n966:             let Expr::String { value, .. } = property.as_ref() else {\n967:                 return Err(diag(\"only string property calls supported\"));\n968:             };\n969:             let prop = value.to_string_lossy();\n970:             match prop.as_ref() {\n971:                 \"resolve\" | \"reject\" => {\n972:                     return self.emit_promise_static(object, prop.as_ref(), args);\n973:                 }\n974:                 \"all\" => {\n975:                     return self.emit_promise_all(object, args);\n976:                 }\n977:                 \"race\" => {\n978:                     return self.emit_promise_race(object, args);\n979:                 }\n980:                 \"allSettled\" => {\n981:                     return self.emit_promise_all_settled(object, args);\n982:                 }\n983:                 \"any\" => {\n984:                     return self.emit_promise_any(object, args);\n985:                 }\n986:                 \"then\" => {\n987:                     let p = self.emit_expr(object)?;\n988:                     let mut on_ful = \"null\".to_string();\n989:                     let mut ful_data = \"null\".to_string();\n990:                     let mut on_rej = \"null\".to_string();\n991:                     let mut rej_data = \"null\".to_string();\n992:                     if let Some(Arg::Expr(f0)) = args.first() {\n993:                         if let Expr::Function { params, body, .. } = f0 {\n994:                             let (name, data) = self.emit_reaction_fn(params, body)?;\n995:                             on_ful = format!(\"@{name}\");\n996:                             ful_data = data;\n997:                         } else {\n998:                             return Err(diag(\"then callback must be function expression\"));\n999:                         }\n1000:                     }\n1001:                     if let Some(Arg::Expr(f1)) = args.get(1) {\n1002:                         if let Expr::Function { params, body, .. } = f1 {\n1003:                             let (name, data) = self.emit_reaction_fn(params, body)?;\n1004:                             on_rej = format!(\"@{name}\");\n1005:                             rej_data = data;\n1006:                         } else {\n1007:                             return Err(diag(\"then callback must be function expression\"));\n1008:                         }\n1009:                     }\n1010:                     let t = self.fresh();\n1011:                     writeln!(\n1012:                         self.body,\n1013:                         \"  {}\",\n1014:                         PROMISE_THEN.call_to(\n1015:                             &t,\n1016:                             &format!(\n1017:                                 \"ptr {p}, ptr {on_ful}, ptr {ful_data}, ptr {on_rej}, ptr {rej_data}\"\n1018:                             )\n1019:                         )\n1020:                     )\n1021:                     .ok();\n1022:                     return Ok(t);\n1023:                 }\n1024:                 \"catch\" => {\n1025:                     // p.catch(onRejected) ≡ p.then(undefined, onRejected)\n1026:                     if args.len() != 1 {\n1027:                         return Err(diag(\"catch expects 1 argument\"));\n1028:                     }\n1029:                     let p = self.emit_expr(object)?;\n1030:                     let Arg::Expr(f0) = &args[0] else {\n1031:                         return Err(diag(\"spread not supported\"));\n1032:                     };\n1033:                     let Expr::Function { params, body, .. } = f0 else {\n1034:                         return Err(diag(\"catch callback must be function expression\"));\n1035:                     };\n1036:                     let (name, data) = self.emit_reaction_fn(params, body)?;\n1037:                     let t = self.fresh();\n1038:                     writeln!(\n1039:                         self.body,\n1040:                         \"  {}\",\n1041:                         PROMISE_THEN.call_to(\n1042:                             &t,\n1043:                             &format!(\"ptr {p}, ptr null, ptr null, ptr @{name}, ptr {data}\")\n1044:                         )\n1045:                     )\n1046:                     .ok();\n1047:                     return Ok(t);\n1048:                 }\n1049:                 \"finally\" => {\n1050:                     if args.len() != 1 {\n1051:                         return Err(diag(\"finally expects 1 argument\"));\n1052:                     }\n1053:                     let p = self.emit_expr(object)?;\n1054:                     let Arg::Expr(f0) = &args[0] else {\n1055:                         return Err(diag(\"spread not supported\"));\n1056:                     };\n1057:                     let Expr::Function { params, body, .. } = f0 else {\n1058:                         return Err(diag(\"finally callback must be function expression\"));\n1059:                     };\n1060:                     let (name, data) = self.emit_reaction_fn(params, body)?;\n1061:                     let t = self.fresh();\n1062:                     writeln!(\n1063:                         self.body,\n1064:                         \"  {}\",\n1065:                         PROMISE_FINALLY.call_to(&t, &format!(\"ptr {p}, ptr @{name}, ptr {data}\"))\n1066:                     )\n1067:                     .ok();\n1068:                     return Ok(t);\n1069:                 }\n1070:                 _ => return Err(diag(format!(\"unsupported method `{prop}`\"))),\n1071:             }\n1072:         }\n1073: \n1074:         Err(diag(\"unsupported call\"))\n1075:     }\n1076: \n1077:     fn emit_promise_static(\n1078:         &mut self,\n1079:         object: &Expr,\n1080:         which: &str,\n1081:         args: &[Arg],\n1082:     ) -> Result<String, Diagnostic> {\n1083:         let Expr::Local { id, .. } = object else {\n1084:             return Err(diag(\"static Promise methods require Promise receiver\"));\n1085:         };\n1086:         if Some(*id) != self.info.promise_id {\n1087:             return Err(diag(\"only Promise.resolve / Promise.reject supported\"));\n1088:         }\n1089:         if args.len() != 1 {\n1090:             return Err(diag(format!(\"Promise.{which} expects 1 argument\")));\n1091:         }\n1092:         let Arg::Expr(vexpr) = &args[0] else {\n1093:             return Err(diag(\"spread not supported\"));\n1094:         };\n1095:         let v = self.emit_expr(vexpr)?;\n1096:         let p = self.fresh();\n1097:         writeln!(self.body, \"  {}\", PROMISE_NEW.call_to(&p, \"\")).ok();\n1098:         match which {\n1099:             \"resolve\" => {\n1100:                 writeln!(\n1101:                     self.body,\n1102:                     \"  {}\",\n1103:                     PROMISE_RESOLVE.call(&format!(\"ptr {p}, ptr {v}\"))\n1104:                 )\n1105:                 .ok();\n1106:             }\n1107:             \"reject\" => {\n1108:                 writeln!(\n1109:                     self.body,\n1110:                     \"  {}\",\n1111:                     PROMISE_REJECT.call(&format!(\"ptr {p}, ptr {v}\"))\n1112:                 )\n1113:                 .ok();\n1114:             }\n1115:             _ => return Err(diag(\"internal: bad Promise static\")),\n1116:         }\n1117:         Ok(p)\n1118:     }\n1119: \n1120:     fn emit_promise_all(\n1121:         &mut self,\n1122:         object: &Expr,\n1123:         args: &[Arg],\n1124:     ) -> Result<String, Diagnostic> {\n1125:         let Expr::Local { id, .. } = object else {\n1126:             return Err(diag(\"Promise.all requires Promise receiver\"));\n1127:         };\n1128:         if Some(*id) != self.info.promise_id {\n1129:             return Err(diag(\"only Promise.all supported\"));\n1130:         }\n1131:         if args.len() != 1 {\n1132:             return Err(diag(\"Promise.all expects 1 argument\"));\n1133:         }\n1134:         let Arg::Expr(vexpr) = &args[0] else {\n1135:             return Err(diag(\"spread not supported\"));\n1136:         };\n1137:         let arr = self.emit_expr(vexpr)?;\n1138:         let t = self.fresh();\n1139:         writeln!(\n1140:             self.body,\n1141:             \"  {}\",\n1142:             PROMISE_ALL.call_to(&t, &format!(\"ptr {arr}\"))\n1143:         )\n1144:         .ok();\n1145:         Ok(t)\n1146:     }\n1147: \n1148:     fn emit_promise_race(\n1149:         &mut self,\n1150:         object: &Expr,\n1151:         args: &[Arg],\n1152:     ) -> Result<String, Diagnostic> {\n1153:         let Expr::Local { id, .. } = object else {\n1154:             return Err(diag(\"Promise.race requires Promise receiver\"));\n1155:         };\n1156:         if Some(*id) != self.info.promise_id {\n1157:             return Err(diag(\"only Promise.race supported\"));\n1158:         }\n1159:         if args.len() != 1 {\n1160:             return Err(diag(\"Promise.race expects 1 argument\"));\n1161:         }\n1162:         let Arg::Expr(vexpr) = &args[0] else {\n1163:             return Err(diag(\"spread not supported\"));\n1164:         };\n1165:         let arr = self.emit_expr(vexpr)?;\n1166:         let t = self.fresh();\n1167:         writeln!(\n1168:             self.body,\n1169:             \"  {}\",\n1170:             PROMISE_RACE.call_to(&t, &format!(\"ptr {arr}\"))\n1171:         )\n1172:         .ok();\n1173:         Ok(t)\n1174:     }\n1175: \n1176:     fn emit_promise_all_settled(\n1177:         &mut self,\n1178:         object: &Expr,\n1179:         args: &[Arg],\n1180:     ) -> Result<String, Diagnostic> {\n1181:         let Expr::Local { id, .. } = object else {\n1182:             return Err(diag(\"Promise.allSettled requires Promise receiver\"));\n1183:        