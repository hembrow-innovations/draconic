      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/tests/test262/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Test262 staged harness (ROADMAP E19 / ADR 0007).\n2: //!\n3: //! js target only. Resolves the suite from `TEST262_ROOT` or\n4: //! `<workspace>/third_party/test262`. When the suite is absent, runs skip\n5: //! (CI stays green). When present, compiles each allowlisted test through the\n6: //! Draconic frontend → JS backend and executes under Node with a minimal\n7: //! `$ERROR` / `assert` shim.\n8: \n9: use std::fs;\n10: use std::path::{Path, PathBuf};\n11: use std::process::{Command, Stdio};\n12: \n13: use draconic_backend_js::emit_js;\n14: use draconic_frontend::{compile_path, compile_source, compile_source_module};\n15: use rayon::prelude::*;\n16: \n17: /// Outcome bucket for one allowlisted path.\n18: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n19: pub enum Status {\n20:     Pass,\n21:     Fail,\n22:     Skip,\n23: }\n24: \n25: impl Status {\n26:     pub fn as_str(self) -> &'static str {\n27:         match self {\n28:             Status::Pass => \"pass\",\n29:             Status::Fail => \"fail\",\n30:             Status::Skip => \"skip\",\n31:         }\n32:     }\n33: }\n34: \n35: /// One allowlist entry after a run attempt.\n36: #[derive(Debug, Clone)]\n37: pub struct CaseResult {\n38:     pub path: String,\n39:     pub status: Status,\n40:     pub message: String,\n41: }\n42: \n43: /// Aggregate of a harness run.\n44: #[derive(Debug, Clone)]\n45: pub struct Report {\n46:     pub suite_root: Option<PathBuf>,\n47:     pub suite_present: bool,\n48:     pub cases: Vec<CaseResult>,\n49: }\n50: \n51: impl Report {\n52:     pub fn counts(&self) -> (usize, usize, usize) {\n53:         let mut pass = 0;\n54:         let mut fail = 0;\n55:         let mut skip = 0;\n56:         for c in &self.cases {\n57:             match c.status {\n58:                 Status::Pass => pass += 1,\n59:                 Status::Fail => fail += 1,\n60:                 Status::Skip => skip += 1,\n61:             }\n62:         }\n63:         (pass, fail, skip)\n64:     }\n65: \n66:     /// Markdown baseline report (checked in or written under target/).\n67:     pub fn to_markdown(&self) -> String {\n68:         let (pass, fail, skip) = self.counts();\n69:         let mut out = String::new();\n70:         out.push_str(\"# Test262 baseline report\\n\\n\");\n71:         out.push_str(\"Staged roll-in (ADR 0007). Target: **js** only.\\n\");\n72:         out.push_str(\"Failures are report-only until triage promotes Roadmap rows.\\n\\n\");\n73:         match &self.suite_root {\n74:             Some(p) if self.suite_present => {\n75:                 out.push_str(&format!(\"- Suite root: `{}`\\n\", p.display()));\n76:                 out.push_str(\"- Suite: **present**\\n\");\n77:             }\n78:             Some(p) => {\n79:                 out.push_str(&format!(\"- Suite root (missing): `{}`\\n\", p.display()));\n80:                 out.push_str(\"- Suite: **absent** (all allowlist entries skipped)\\n\");\n81:             }\n82:             None => out.push_str(\"- Suite root: unresolved\\n\"),\n83:         }\n84:         out.push_str(&format!(\n85:             \"- Totals: pass={pass} fail={fail} skip={skip} (allowlist={})\\n\\n\",\n86:             self.cases.len()\n87:         ));\n88:         out.push_str(\"| Path | Status | Message |\\n\");\n89:         out.push_str(\"|------|--------|---------|\\n\");\n90:         for c in &self.cases {\n91:             let msg = c.message.replace('|', \"\\\\|\").replace('\\n', \" \");\n92:             out.push_str(&format!(\n93:                 \"| `{}` | {} | {} |\\n\",\n94:                 c.path,\n95:                 c.status.as_str(),\n96:                 msg\n97:             ));\n98:         }\n99:         out.push('\\n');\n100:         out\n101:     }\n102: }\n103: \n104: /// Package root (`tests/test262`).\n105: pub fn package_root() -> PathBuf {\n106:     PathBuf::from(env!(\"CARGO_MANIFEST_DIR\"))\n107: }\n108: \n109: /// Workspace root (parent of `tests/`).\n110: pub fn workspace_root() -> PathBuf {\n111:     package_root()\n112:         .parent()\n113:         .and_then(|p| p.parent())\n114:         .map(Path::to_path_buf)\n115:         .expect(\"tests/test262 → workspace root\")\n116: }\n117: \n118: /// Resolve suite root: `TEST262_ROOT` env, else `<workspace>/third_party/test262`.\n119: pub fn resolve_suite_root() -> PathBuf {\n120:     if let Ok(p) = std::env::var(\"TEST262_ROOT\") {\n121:         let trimmed = p.trim();\n122:         if !trimmed.is_empty() {\n123:             return PathBuf::from(trimmed);\n124:         }\n125:     }\n126:     workspace_root().join(\"third_party\").join(\"test262\")\n127: }\n128: \n129: /// True when `root` looks like a usable test262 checkout (`test/` directory).\n130: pub fn suite_present(root: &Path) -> bool {\n131:     root.is_dir() && root.join(\"test\").is_dir()\n132: }\n133: \n134: /// Default allowlist path.\n135: pub fn allowlist_path() -> PathBuf {\n136:     package_root().join(\"allowlist.txt\")\n137: }\n138: \n139: /// Load relative test paths from allowlist (comments/blank lines ignored).\n140: pub fn load_allowlist(path: &Path) -> Result<Vec<String>, String> {\n141:     let text = fs::read_to_string(path)\n142:         .map_err(|e| format!(\"read allowlist {}: {e}\", path.display()))?;\n143:     let mut out = Vec::new();\n144:     for (i, line) in text.lines().enumerate() {\n145:         let line = line.trim();\n146:         if line.is_empty() || line.starts_with('#') {\n147:             continue;\n148:         }\n149:         if line.contains(\"..\") {\n150:             return Err(format!(\n151:                 \"allowlist line {}: path must not contain `..`: {line}\",\n152:                 i + 1\n153:             ));\n154:         }\n155:         out.push(line.to_string());\n156:     }\n157:     if out.is_empty() {\n158:         return Err(format!(\"allowlist empty: {}\", path.display()));\n159:     }\n160:     Ok(out)\n161: }\n162: \n163: /// Minimal Test262 harness symbols, parseable by Draconic.\n164: ///\n165: /// Real `harness/assert.js` is not compiled through the frontend (it uses\n166: /// patterns outside the current surface). This shim covers `$ERROR` and\n167: /// `assert.sameValue` / `assert.notSameValue` / `assert.throws` used by\n168: /// early language tests (incl. E19.07 BigInt mixed-type TypeError paths).\n169: pub const HARNESS_SHIM: &str = concat!(\n170:     r#\"\n171: function Test262Error(message) {\n172:   if (!(this instanceof Test262Error)) {\n173:     return new Test262Error(message);\n174:   }\n175:   this.message = message || \"\";\n176: }\n177: Test262Error.prototype.toString = function () {\n178:   return \"Test262Error: \" + this.message;\n179: };\n180: Test262Error.thrower = function (message) {\n181:   throw new Test262Error(message);\n182: };\n183: function $ERROR(message) {\n184:   throw new Test262Error(String(message));\n185: }\n186: function assert(mustBeTrue, message) {\n187:   if (mustBeTrue !== true) {\n188:     $ERROR(message || (\"Expected true but got \" + String(mustBeTrue)));\n189:   }\n190: }\n191: assert.sameValue = function(actual, expected, message) {\n192:   let same = actual === expected;\n193:   if (actual !== actual && expected !== expected) {\n194:     same = true;\n195:   }\n196:   if (same === false) {\n197:     $ERROR(message || (\"Expected SameValue, got \" + String(actual) + \" vs \" + String(expected)));\n198:   }\n199: };\n200: assert.notSameValue = function(actual, unexpected, message) {\n201:   let same = actual === unexpected;\n202:   if (actual !== actual && unexpected !== unexpected) {\n203:     same = true;\n204:   }\n205:   if (same === true) {\n206:     $ERROR(message || \"Unexpected SameValue match\");\n207:   }\n208: };\n209: assert.throws = function(expectedErrorConstructor, func, message) {\n210:   if (typeof func !== \"function\") {\n211:     $ERROR(\"assert.thr