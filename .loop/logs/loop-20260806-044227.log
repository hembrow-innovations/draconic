ignable, allowing number/boolean literals to fill native scalar fields.\n5113:     fn object_literal_contextually_assignable(\n5114:         &self,\n5115:         properties: &[ObjectProp],\n5116:         to_shape: &ObjectShape,\n5117:     ) -> bool {\n5118:         let mut by_name: HashMap<String, &Expr> = HashMap::new();\n5119:         for prop in properties {\n5120:             match prop {\n5121:                 ObjectProp::Property { key, value, .. } => {\n5122:                     let name = match key {\n5123:                         ObjectKey::Ident(id) => id.name.clone(),\n5124:                         ObjectKey::String(s) => s.value.to_string_lossy(),\n5125:                         ObjectKey::Computed(_) => return false,\n5126:                     };\n5127:                     by_name.insert(name, value);\n5128:                 }\n5129:                 ObjectProp::Accessor { .. } | ObjectProp::Spread { .. } => return false,\n5130:             }\n5131:         }\n5132:         to_shape.props.iter().all(|(name, want)| {\n5133:             let Some(val) = by_name.get(name) else {\n5134:                 return false;\n5135:             };\n5136:             self.expr_contextually_assignable_to(val, *want)\n5137:         })\n5138:     }\n5139: \n5140:     /// Array literal may assign to a tuple shape (`\"0\"`, `\"1\"`, …) by position (N03.02).\n5141:     fn array_literal_contextually_assignable(\n5142:         &self,\n5143:         elements: &[ArrayElement],\n5144:         to_shape: &ObjectShape,\n5145:     ) -> bool {\n5146:         if elements.len() != to_shape.props.len() {\n5147:             return false;\n5148:         }\n5149:         for (i, (name, want)) in to_shape.props.iter().enumerate() {\n5150:             if name != &i.to_string() {\n5151:                 return false;\n5152:             }\n5153:             let ArrayElement::Expr(val) = &elements[i] else {\n5154:                 return false;\n5155:             };\n5156:             if !self.expr_