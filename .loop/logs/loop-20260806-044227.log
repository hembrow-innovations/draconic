      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-backend-llvm/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! LLVM backend: IR → native (one lowerer; private adapters for supported subsets).\n2: \n3: mod es_eval;\n4: mod es_promise;\n5: mod native_ints;\n6: \n7: use std::path::{Path, PathBuf};\n8: use std::process::{Command, Stdio};\n9: \n10: use draconic_diagnostics::{Diagnostic, Span};\n11: use draconic_ir::Module;\n12: \n13: use es_eval::{emit_es_eval, is_es_eval_module};\n14: use es_promise::{emit_es_promise, is_es_promise_module};\n15: use native_ints::{emit_native_ints, is_native_int_module};\n16: \n17: /// Emit LLVM IR text for a shared IR module.\n18: ///\n19: /// Selects a private adapter for a supported subset, otherwise returns a hard\n20: /// diagnostic (no silent hello-stub success for arbitrary Programs):\n21: ///\n22: /// - **Native scalars/layouts** (`i8`–`i64`, `u8`–`u64`, `f32`/`f64`, `bool`,\n23: ///   native structs/arrays/pointers) — N01–N03\n24: /// - **Promise / async** (constructor basics through async/await and async\n25: ///   arrows) via Runtime Promise ABI — N06.03–N06.11\n26: /// - **eval / Function** (constant-string fold via Embed) — N07.02–N07.04\n27: /// - **Empty program** — B08 Runtime hello demo only (`main` calls\n28: ///   `draconic_rt_hello`)\n29: pub fn emit_llvm_ir(module: &Module) -> Result<String, Diagnostic> {\n30:     if is_native_int_module(module) {\n31:         return emit_native_ints(module);\n32:     }\n33:     if is_es_promise_module(module) {\n34:         return emit_es_promise(module);\n35:     }\n36:     if is_es_eval_module(module) {\n37:         return emit_es_eval(module);\n38:     }\n39:     if is_empty_program(module) {\n40:         return Ok(emit_empty_hello());\n41:     }\n42:     Err(unsupported_native_diagnostic())\n43: }\n44: \n45: fn is_empty_program(module: &Module) -> bool {\n46:     module.body.is_empty()\n47: }\n48: \n49: fn unsupported_native_diagnostic() -> Diagnostic {\n50:     Diagnostic::new(\n51:         \"native target: unsupported IR (no LLVM lowering for this program; \\\n52:          supported: native scalars/layouts, Promise/async subset, eval/Function fold, empty hello)\",\n53:         Span::dummy(),\n54:     )\n55: }\n56: \n57: /// B08 empty-program demo: link Runtime hello. Not used for non-empty unsupported IR.\n58: fn emit_empty_hello() -> String {\n59:     use draconic_runtime::abi::HELLO;\n60:     format!(\n61:         \"; Draconic LLVM backend empty program (B08 hello)\\n{}\\n\\ndefine i32 @main() {{\\nentry:\\n  {}\\n  ret i32 0\\n}}\\n\",\n62:         HELLO.declare(),\n63:         HELLO.call(\"\"),\n64:     )\n65: }\n66: \n67: /// Compile LLVM IR + Runtime C into a native executable via `clang`.\n68: pub fn build_native_binary(llvm_ir: &str, out_bin: &Path) -> Result<(), Diagnostic> {\n69:     let clang = find_clang().ok_or_else(|| {\n70:         Diagnostic::new(\n71:             \"clang not found (set CLANG or install a C toolchain)\",\n72:             Span::dummy(),\n73:         )\n74:     })?;\n75: \n76:     let work = work_dir(\"draconic-llvm-build\")?;\n77:     let ll_path = work.join(\"program.ll\");\n78:     std::fs::write(&ll_path, llvm_ir).map_err(|e| {\n79:         Diagnostic::new(format!(\"write LLVM IR failed: {e}\"), Span::dummy())\n80:     })?;\n81: \n82:     let rt_lib = draconic_runtime::build_runtime_static_lib(&work).map_err(|e| {\n83:         Diagnostic::new(format!(\"build runtime static lib failed: {e}\"), Span::dummy())\n84:     })?;\n85: \n86:     if let Some(parent) = out_bin.parent() {\n87:         std::fs::create_dir_all(parent).map_err(|e| {\n88:             Diagnostic::new(format!(\"create output dir failed: {e}\"), Span::dummy())\n89:         })?;\n90:     }\n91: \n92:     let output = Command::new(&clang)\n93:         .arg(&ll_path)\n94:         .arg(&rt_lib)\n95:         .arg(\"-o\")\n96:         .arg(out_bin)\n97:         .arg(\"-Wno-override-module\")\n98:         .stdout(Stdio::piped())\n99:         .stderr(Stdio::piped())\n100:         .output()\n101:         .map_err(|e| Diagnostic::new(format!(\"spawn clang failed: {e}\"), Span::dummy()))?;\n102: \n103:     if !output.status.success() {\n104:         let stderr = String::from_utf8_lossy(&output.stderr);\n105:         return Err(Diagnostic::new(\n106:             format!(\"clang failed: {stderr}\"),\n107:             Span::dummy(),\n108:         ));\n109:     }\n110:     Ok(())\n111: }\n112: \n113: fn find_clang() -> Option<PathBuf> {\n114:     if let Ok(p) = std::env::var(\"CLANG\") {\n115:         let p = PathBuf::from(p);\n116:         if p.is_file() {\n117:             return Some(p);\n118:         }\n119:     }\n120:     for candidate in [\n121:         \"clang\",\n122:         \"/usr/bin/clang\",\n123:         \"/opt/homebrew/opt/llvm@22/bin/clang\",\n124:         \"/opt/homebrew/opt/llvm/bin/clang\",\n125:     ] {\n126:         let ok = Command::new(candidate)\n127:             .arg(\"--version\")\n128:             .stdout(Stdio::null())\n129:             .stderr(Stdio::null())\n130:             .status()\n131:             .map(|s| s.success())\n132:             .unwrap_or(false);\n133:         if ok {\n134:             return Some(PathBuf::from(candidate));\n135:         }\n136:     }\n137:     None\n138: }\n139: \n140: fn work_dir(prefix: &str) -> Result<PathBuf, Diagnostic> {\n141:     use std::sync::atomic::{AtomicU64, Ordering};\n142:     static N: AtomicU64 = AtomicU64::new(0);\n143:     let mut dir = std::env::temp_dir();\n144:     dir.push(format!(\n145:         \"{prefix}-{}-{}-{}\",\n146:         std::process::id(),\n147:         std::time::SystemTime::now()\n148:             .duration_since(std::time::UNIX_EPOCH)\n149:             .map(|d| d.as_nanos())\n150:             .unwrap_or(0),\n151:         N.fetch_add(1, Ordering::Relaxed)\n152:     ));\n153:     std::fs::create_dir_all(&dir).map_err(|e| {\n154:         Diagnostic::new(format!(\"temp dir failed: {e}\"), Span::dummy())\n155:     })?;\n156:     Ok(dir)\n157: }\n158: \n159: #[cfg(test)]\n160: mod tests {\n161:     use super::*;\n162:     use draconic_frontend::compile_source;\n163: \n164:     fn module_of(src: &str) -> Module {\n165:         compile_source(src).expect(\"compile\")\n166:     }\n167: \n168:     #[test]\n169:     fn empty_program_emits_runtime_hello() {\n170:         let ir = emit_llvm_ir(&module_of(\"\")).expect(\"emit\");\n171:         assert!(\n172:             ir.contains(\"draconic_rt_hello\"),\n173:             \"IR must declare/call runtime hello:\\n{ir}\"\n174:         );\n175:         assert!(ir.contains(\"define i32 @main\"), \"IR must define main:\\n{ir}\");\n176:         assert!(\n177:             ir.contains(\"call void @draconic_rt_hello\"),\n178:             \"main must call hello:\\n{ir}\"\n179:         );\n180:         assert!(ir.contains(\"ret i32 0\"), \"main must return 0:\\n{ir}\");\n181:     }\n182: \n183:     #[test]\n184:     fn empty_native_binary_prints_hello() {\n185:         let ir = emit_llvm_ir(&module_of(\"\")).expect(\"emit\");\n186:         let dir = work_dir(\"draconic-llvm-test\").expect(\"workdir\");\n187:         let bin = dir.join(\"hello\");\n188:         build_native_binary(&ir, &bin).expect(\"build_native_binary\");\n189: \n190:         let output = Command::new(&bin).output().expect(\"run binary\");\n191:         assert!(\n192:             output.status.success(),\n193:             \"binary exit {:?}\\nstderr={}\",\n194:             output.status,\n195:             String::from_utf8_lossy(&output.stderr)\n196:         );\n197:         let stdout = String::from_utf8_lossy(&output.stdout);\n198:         assert_eq!(stdout, \"hello\\n\", \"stdout={stdout:?}\");\n199:     }\n200: \n201:     #[test]\n202:     fn unsupported_js_module_errors() {\n203:         let err = emit_llvm_ir(&module_of(\"let x = 1;\")).expect_err(\"must reject\");\n204:         let msg = err.to_string();\n205:         assert!(\n206:             msg.contains(\"unsupported\") || msg.contains(\"native target\"),\n207:             \"diagnostic should mention unsupported native IR:\\n{msg}\"\n208:         );\n209:         assert!(\n210:             !msg.contains(\"draconic_rt_hello\"),\n211:             \"error must not be a hello-stub success path:\\n{msg}\"\n212:         );\n213:     }\n214: \n215:     #[test]\n216:     fn native_ints_add_prints() {\n217:         let ir = emit_llvm_ir(&module_of(\n218:             r#\"\n219:             let a: i32 = 10;\n220:             let b: i32 = 3;\n221:             let sum: i32 = a + b;\n222:             \"#,\n223:         ))\n224:         .expect(\"emit\");\n225:         assert!(\n226:             !ir.contains(\"draconic_rt_hello\"),\n227:             \"native int program should not use hello stub:\\n{ir}\"\n228:         );\n229:         assert!(\n230:             ir.contains(\"draconic_rt_print_i64\"),\n231:             \"should print ints:\\n{ir}\"\n232:         );\n233:         let dir = work_dir(\"draconic-llvm-n01\").expect(\"workdir\");\n234:         let bin = dir.join(\"ints\");\n235:         build_native_binary(&ir, &bin).expect(\"build\");\n236:         let output = Command::new(&bin).output().expect(\"run\");\n237:         assert!(\n238:             output.status.success(),\n239:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n240:             output.status,\n241:             String::from_utf8_lossy(&output.stderr)\n242:         );\n243:         let stdout = String::from_utf8_lossy(&output.stdout);\n244:         assert_eq!(stdout, \"10\\n3\\n13\\n\", \"stdout={stdout:?}\\nir=\\n{ir}\");\n245:     }\n246: \n247:     #[test]\n248:     fn native_ints_function_call() {\n249:         let ir = emit_llvm_ir(&module_of(\n250:             r#\"\n251:             function add(x: i32, y: i32): i32 {\n252:               return x + y;\n253:             }\n254:             let s: i32 = add(20, 22);\n255:             \"#,\n256:         ))\n257:         .expect(\"emit\");\n258:         let dir = work_dir(\"draconic-llvm-n01-fn\").expect(\"workdir\");\n259:         let bin = dir.join(\"fn\");\n260:         build_native_binary(&ir, &bin).expect(\"build\");\n261:         let output = Command::new(&bin).output().expect(\"run\");\n262:         assert!(\n263:             output.status.success(),\n264:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n265:             output.status,\n266:             String::from_utf8_lossy(&output.stderr)\n267:         );\n268:         let stdout = String::from_utf8_lossy(&output.stdout);\n269:         assert_eq!(stdout, \"42\\n\", \"stdout={stdout:?}\\nir=\\n{ir}\");\n270:     }\n271: \n272:     #[test]\n273:     fn native_ints_wrapping_i8() {\n274:         let ir = emit_llvm_ir(&module_of(\n275:             r#\"\n276:             let a: i8 = 120;\n277:             let b: i8 = a + 10;\n278:             \"#,\n279:         ))\n280:         .expect(\"emit\");\n281:         let dir = work_dir(\"draconic-llvm-n01-wrap\").expect(\"workdir\");\n282:         let bin = dir.join(\"wrap\");\n283:         build_native_binary(&ir, &bin).expect(\"build\");\n284:         let output = Command::new(&bin).output().expect(\"run\");\n285:         assert!(output.status.success());\n286:         let stdout = String::from_utf8_lossy(&output.stdout);\n287:         // 120 + 10 = 130 → i8 wrap → -126\n288:         assert_eq!(stdout, \"120\\n-126\\n\", \"stdout={stdout:?}\");\n289:     }\n290: \n291:     #[test]\n292:     fn native_floats_add_prints() {\n293:         let ir = emit_llvm_ir(&module_of(\n294:             r#\"\n295:             let a: f64 = 10.5;\n296:             let b: f64 = 2.0;\n297:             let sum: f64 = a + b;\n298:             \"#,\n299:         ))\n300:         .expect(\"emit\");\n301:         assert!(\n302:             !ir.contains(\"draconic_rt_hello\"),\n303:             \"native float program should not use hello stub:\\n{ir}\"\n304:         );\n305:         assert!(\n306:             ir.contains(\"draconic_rt_print_f64\"),\n307:             \"should print floats:\\n{ir}\"\n308:         );\n309:         let dir = work_dir(\"draconic-llvm-n02\").expect(\"workdir\");\n310:         let bin = dir.join(\"floats\");\n311:         build_native_binary(&ir, &bin).expect(\"build\");\n312:         let output = Command::new(&bin).output().expect(\"run\");\n313:         assert!(\n314:             output.status.success(),\n315:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n316:             output.status,\n317:             String::from_utf8_lossy(&output.stderr)\n318:         );\n319:         let stdout = String::from_utf8_lossy(&output.stdout);\n320:         assert_eq!(stdout, \"10.5\\n2\\n12.5\\n\", \"stdout={stdout:?}\\nir=\\n{ir}\");\n321:     }\n322: \n323:     #[test]\n324:     fn native_bool_prints() {\n325:         let ir = emit_llvm_ir(&module_of(\n326:             r#\"\n327:             let t: bool = true;\n328:             let f: bool = false;\n329:             \"#,\n330:         ))\n331:         .expect(\"emit\");\n332:         let dir = work_dir(\"draconic-llvm-n02-bool\").expect(\"workdir\");\n333:         let bin = dir.join(\"bool\");\n334:         build_native_binary(&ir, &bin).expect(\"build\");\n335:         let output = Command::new(&bin).output().expect(\"run\");\n336:         assert!(output.status.success());\n337:         let stdout = String::from_utf8_lossy(&output.stdout);\n338:         assert_eq!(stdout, \"true\\nfalse\\n\", \"stdout={stdout:?}\\nir=\\n{ir}\");\n339:     }\n340: \n341:     #[test]\n342:     fn native_struct_field_read_prints() {\n343:         let ir = emit_llvm_ir(&module_of(\n344:             r#\"\n345:             type Point = { x: i32; y: i32 };\n346:             let p: Point = { x: 10, y: 20 };\n347:             let a: i32 = p.x;\n348:             let b: i32 = p.y;\n349:             \"#,\n350:         ))\n351:         .expect(\"emit\");\n352:         assert!(\n353:             !ir.contains(\"draconic_rt_hello\"),\n354:             \"native struct program should not use hello stub:\\n{ir}\"\n355:         );\n356:         assert!(\n357:             ir.contains(\"getelementptr\"),\n358:             \"should GEP struct fields:\\n{ir}\"\n359:         );\n360:         let dir = work_dir(\"draconic-llvm-n03-struct\").expect(\"workdir\");\n361:         let bin = dir.join(\"struct\");\n362:         build_native_binary(&ir, &bin).expect(\"build\");\n363:         let output = Command::new(&bin).output().expect(\"run\");\n364:         assert!(\n365:             output.status.success(),\n366:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n367:             output.status,\n368:             String::from_utf8_lossy(&output.stderr)\n369:         );\n370:         let stdout = String::from_utf8_lossy(&output.stdout);\n371:         assert_eq!(stdout, \"10\\n20\\n10\\n20\\n\", \"stdout={stdout:?}\\nir=\\n{ir}\");\n372:     }\n373: \n374:     #[test]\n375:     fn es_promise_basics_prints_after_drain() {\n376:         let ir = emit_llvm_ir(&module_of(\n377:             r#\"\n378:             let tf = typeof Promise;\n379:             let resolved = 0;\n380:             let rejected = 0;\n381:             let chained = 0;\n382:             let p = new Promise(function (resolve) {\n383:               resolve(42);\n384:             });\n385:             p.then(function (v) {\n386:               resolved = v;\n387:             });\n388:             let q = new Promise(function (_resolve, reject) {\n389:               reject(7);\n390:             });\n391:             q.then(\n392:               function () {\n393:                 rejected = -1;\n394:               },\n395:               function (e) {\n396:                 rejected = e;\n397:               }\n398:             );\n399:             new Promise(function (resolve) {\n400:               resolve(1);\n401:             }).then(function (v) {\n402:               return v + 1;\n403:             }).then(function (v) {\n404:               chained = v;\n405:             });\n406:             \"#,\n407:         ))\n408:         .expect(\"emit\");\n409:         assert!(\n410:             !ir.contains(\"draconic_rt_hello\"),\n411:             \"Promise basics must not use hello stub:\\n{ir}\"\n412:         );\n413:         assert!(\n414:             ir.contains(\"draconic_rt_promise_construct\"),\n415:             \"should construct via Runtime ABI:\\n{ir}\"\n416:         );\n417:         assert!(\n418:             ir.contains(\"draconic_rt_promise_then\"),\n419:             \"should then via Runtime ABI:\\n{ir}\"\n420:         );\n421:         assert!(\n422:             ir.contains(\"draconic_rt_job_drain\"),\n423:             \"should drain jobs before observe:\\n{ir}\"\n424:         );\n425:         let dir = work_dir(\"draconic-llvm-n06-promise\").expect(\"workdir\");\n426:         let bin = dir.join(\"promise\");\n427:         build_native_binary(&ir, &bin).expect(\"build\");\n428:         let output = Command::new(&bin).output().expect(\"run\");\n429:         assert!(\n430:             output.status.success(),\n431:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n432:             output.status,\n433:             String::from_utf8_lossy(&output.stderr)\n434:         );\n435:         let stdout = String::from_utf8_lossy(&output.stdout);\n436:         assert_eq!(\n437:             stdout, \"function\\n42\\n7\\n2\\n\",\n438:             \"stdout={stdout:?}\\nir=\\n{ir}\"\n439:         );\n440:     }\n441: \n442:     #[test]\n443:     fn es_promise_resolve_reject_catch_prints_after_drain() {\n444:         let ir = emit_llvm_ir(&module_of(\n445:             r#\"\n446:             let tResolve = typeof Promise.resolve;\n447:             let tReject = typeof Promise.reject;\n448:             let resolved = 0;\n449:             let rejected = 0;\n450:             let caught = 0;\n451:             let p = Promise.resolve(42);\n452:             p.then(function (v) {\n453:               resolved = v;\n454:             });\n455:             let q = Promise.reject(7);\n456:             q.then(\n457:               function () {\n458:                 rejected = -1;\n459:               },\n460:               function (e) {\n461:                 rejected = e;\n462:               }\n463:             );\n464:             let r = Promise.reject(9);\n465:             r.catch(function (e) {\n466:               caught = e;\n467:             });\n468:             \"#,\n469:         ))\n470:         .expect(\"emit\");\n471:         assert!(\n472:             !ir.contains(\"draconic_rt_hello\"),\n473:             \"Promise resolve/reject must not use hello stub:\\n{ir}\"\n474:         );\n475:         assert!(\n476:             ir.contains(\"draconic_rt_promise_new\"),\n477:             \"should allocate via Runtime ABI:\\n{ir}\"\n478:         );\n479:         assert!(\n480:             ir.contains(\"draconic_rt_promise_resolve\"),\n481:             \"should resolve via Runtime ABI:\\n{ir}\"\n482:         );\n483:         assert!(\n484:             ir.contains(\"draconic_rt_promise_reject\"),\n485:             \"should reject via Runtime ABI:\\n{ir}\"\n486:         );\n487:         assert!(\n488:             ir.contains(\"draconic_rt_promise_then\"),\n489:             \"should then/catch via Runtime ABI:\\n{ir}\"\n490:         );\n491:         assert!(\n492:             ir.contains(\"draconic_rt_job_drain\"),\n493:             \"should drain jobs before observe:\\n{ir}\"\n494:         );\n495:         let dir = work_dir(\"draconic-llvm-n06-promise-rr\").expect(\"workdir\");\n496:         let bin = dir.join(\"promise_rr\");\n497:         build_native_binary(&ir, &bin).expect(\"build\");\n498:         let output = Command::new(&bin).output().expect(\"run\");\n499:         assert!(\n500:             output.status.success(),\n501:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n502:             output.status,\n503:             String::from_utf8_lossy(&output.stderr)\n504:         );\n505:         let stdout = String::from_utf8_lossy(&output.stdout);\n506:         assert_eq!(\n507:             stdout, \"function\\nfunction\\n42\\n7\\n9\\n\",\n508:             \"stdout={stdout:?}\\nir=\\n{ir}\"\n509:         );\n510:     }\n511: \n512:     #[test]\n513:     fn es_promise_finally_prints_after_drain() {\n514:         let ir = emit_llvm_ir(&module_of(\n515:             r#\"\n516:             let tFinally = typeof Promise.resolve(1).finally;\n517:             let fulfilledSide = 0;\n518:             let rejectedSide = 0;\n519:             let resolved = 0;\n520:             let caught = 0;\n521:             let p = Promise.resolve(42);\n522:             p.finally(function () {\n523:               fulfilledSide = 1;\n524:             }).then(function (v) {\n525:               resolved = v;\n526:             });\n527:             let q = Promise.reject(7);\n528:             q.finally(function () {\n529:               rejectedSide = 1;\n530:             }).catch(function (e) {\n531:               caught = e;\n532:             });\n533:             \"#,\n534:         ))\n535:         .expect(\"emit\");\n536:         assert!(\n537:             !ir.contains(\"draconic_rt_hello\"),\n538:             \"Promise finally must not use hello stub:\\n{ir}\"\n539:         );\n540:         assert!(\n541:             ir.contains(\"draconic_rt_promise_finally\"),\n542:             \"should finally via Runtime ABI:\\n{ir}\"\n543:         );\n544:         assert!(\n545:             ir.contains(\"draconic_rt_promise_then\"),\n546:             \"should then/catch via Runtime ABI:\\n{ir}\"\n547:         );\n548:         assert!(\n549:             ir.contains(\"draconic_rt_job_drain\"),\n550:             \"should drain jobs before observe:\\n{ir}\"\n551:         );\n552:         let dir = work_dir(\"draconic-llvm-n06-promise-finally\").expect(\"workdir\");\n553:         let bin = dir.join(\"promise_finally\");\n554:         build_native_binary(&ir, &bin).expect(\"build\");\n555:         let output = Command::new(&bin).output().expect(\"run\");\n556:         assert!(\n557:             output.status.success(),\n558:             \"exit {:?}\\nstderr={}\\nir=\\n{ir}\",\n559:             output.status,\n560:             String::from_utf8_lossy(&output.stderr)\n561:         );\n562:         let stdout = String::from_utf8_lossy(&output.stdout);\n563:         assert_eq!(\n564:             stdout, \"function\\n1\\n1\\n42\\n7\\n\",\n565:             \"stdout={stdout:?}\\nir=\\n{ir}\"\n566:         );\n567:     }\n568: \n569:     #[test]\n570:     fn es_promise_all_prints_after_drain() {\n571:         let ir = emit_llvm_ir(&module_of(\n572:             r#\"\n573:             let tAll = typeof Promise.all;\n574:             let emptyLen = -1;\n575:             let allLen = -1;\n576:             let a0 = -1;\n577:             let a1 = -1;\n578:             let mixed0 = -1;\n579:             let mixed1 = -1;\n580:             let rejected = 0;\n581:             Promise.all([]).then(function (v) {\n582:               emptyLen = v.length;\n583:             });\n584:             Promise.all([Promise.resolve(10), Promise.resolve(20)]).then(function (v) {\n585:               allLen = v.length;\n586:               a0 = v[0];\n587:               a1 = v[1];\n588:             });\n589:             Promise.all([1, Promise.resolve(2)]).then(function (v) {\n590:               mixed0 = v[0];\n591:               mixed1 = v[1];\n592:             });\n593:             Promise.all([Promise.resolve(1), Promise.reject(7)]).then(\n594:               function () {\n595:                 rejected = -1;\n596:               },\n597:               function (e) {\n598:                 rejected = e;\n599:               }\n600:             );\n601:             \"#,\n602:         ))\n603:         .expect(\"emit\");\n604:         assert!(\n605:             !ir.contains(\"draconic_rt_hello\"),\n606:             \"Promise.all must not use hello stub:\\n{ir}\"\n607:         )