         )\n1252:                     .ok();\n1253:                     writeln!(self.body, \"  store {} {v}, ptr {gep}\", sc.llvm_ty()).ok();\n1254:                 }\n1255:                 Ok(())\n1256:             }\n1257:             Expr::Local { id, .. } => {\n1258:                 let src_ptr = self\n1259:                     .allocas\n1260:                     .get(id)\n1261:                     .cloned()\n1262:                     .ok_or_else(|| diag(\"internal: layout copy missing src alloca\"))?;\n1263:                 for (i, (_, sc)) in field_meta.iter().enumerate() {\n1264:                     let src_gep = self.fresh_tmp();\n1265:                     writeln!(\n1266:                         self.body,\n1267:                         \"  {src_gep} = getelementptr inbounds {layout_ty}, ptr {src_ptr}, i32 0, i32 {i}\"\n1268:                     )\n1269:                     .ok();\n1270:                     let v = self.fresh_tmp();\n1271:                     writeln!(self.body, \"  {v} = load {}, ptr {src_gep}\", sc.llvm_ty()).ok();\n1272:                     let dst_gep = self.fresh_tmp();\n1273:                     writeln!(\n1274:                         self.body,\n1275:                         \"  {dst_gep} = getelementptr inbounds {layout_ty}, ptr {dest_ptr}, i32 0, i32 {i}\"\n1276:                     )\n1277:                     .ok();\n1278:                     writeln!(self.body, \"  store {} {v}, ptr {dst_gep}\", sc.llvm_ty()).ok();\n1279:                 }\n1280:                 Ok(())\n1281:             }\n1282:             _ => Err(diag(\n1283:                 \"native layout: init must be object/array literal or layout local\",\n1284:             )),\n1285:         }\n1286:     }\n1287: \n1288:     fn emit_binary(\n1289:         &mut self,\n1290:         left: &Expr,\n1291:         op: BinaryOp,\n1292:         right: &Expr,\n1293:         ty: &Type,\n1294:         expect: Option<Scalar>,\n1295:     ) -> Result<String, Diagnostic> {\n1296:  