rom_stmt(s)?;\n1271:                 }\n1272:                 Ok(())\n1273:             }\n1274:             // Annex B.3.4: bare `function` as if/else Statement clause.\n1275:             // Annex B.3.2: also hoist from block bodies (`if (c) { function f(){} }`).\n1276:             Stmt::If {\n1277:                 consequent,\n1278:                 alternate,\n1279:                 ..\n1280:             } => {\n1281:                 self.declare_if_function_clause(consequent)?;\n1282:                 if let Some(alt) = alternate {\n1283:                     self.declare_if_function_clause(alt)?;\n1284:                 }\n1285:                 self.declare_annex_b_block_functions(consequent)?;\n1286:                 if let Some(alt) = alternate {\n1287:                     self.declare_annex_b_block_functions(alt)?;\n1288:                 }\n1289:                 self.hoist_vars_from_stmt(consequent)?;\n1290:                 if let Some(alt) = alternate {\n1291:                     self.hoist_vars_from_stmt(alt)?;\n1292:                 }\n1293:                 Ok(())\n1294:             }\n1295:             Stmt::While { body, .. } | Stmt::DoWhile { body, .. } => {\n1296:                 self.declare_annex_b_block_functions(body)?;\n1297:                 self.hoist_vars_from_stmt(body)\n1298:             }\n1299:             Stmt::For { init, body, .. } => {\n1300:                 if let Some(init) = init {\n1301:                     self.declare_annex_b_block_functions(init)?;\n1302:                     self.hoist_vars_from_stmt(init)?;\n1303:                 }\n1304:                 self.declare_annex_b_block_functions(body)?;\n1305:                 self.hoist_vars_from_stmt(body)\n1306:             }\n1307:             Stmt::ForIn { body, left, .. } | Stmt::ForOf { body, left, .. } => {\n1308:                 self.declare_annex_b_block_functions(left)?;\n1309:                 self.hoist_vars_from_stmt(left)?;\n1310:                 self.declare_annex_b_block_functions(body)?;\n1311:                 self.hoist_vars_from_stmt(body)\n1312:             }\n1313:             Stmt::Try {\n1314:                 block,\n1315:                 handler,\n1316:                 finalizer,\n1317:                 ..\n1318:             } => {\n1319:                 self.declare_annex_b_block_functions(block)?;\n1320:                 self.hoist_vars_from_stmt(block)?;\n1321:                 if let Some(handler) = handler {\n1322:                     self.declare_annex_b_block_functions(handler)?;\n1323:                     self.hoist_vars_from_stmt(handler)?;\n1324:                 }\n1325:                 if let Some(finalizer) = finalizer {\n1326:                     self.declare_annex_b_block_functions(finalizer)?;\n1327:                     self.hoist_vars_from_stmt(finalizer)?;\n1328:                 }\n1329:                 Ok(())\n1330:             }\n1331:             _ => Ok(()),\n1332:         }\n1333:     }\n1334: \n1335:     /// Hoist `var` declarations from a nested statement into the current var environment.\n1336:     fn hoist_vars_from_stmt(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n1337:         let mut s = stmt;\n1338:         while let Stmt::Labeled { body, .. } = s {\n1339:             s = body;\n1340:         }\n1341:         match s {\n1342:             Stmt::Let {\n1343:                 kind: BindingKind::Var,\n1344:                 binding,\n1345:                 ..\n1346:             } => self.declare_var_binding(binding),\n1347:             Stmt::Block { body, .. } => {\n1348:                 for child in body {\n1349:                     self.hoist_vars_from_stmt(child)?;\n1350:                 }\n1351:                 Ok(())\n1352:             }\n1353:             Stmt::If {\n1354:                 consequent,\n1355:                 alternate,\n1356:                 ..\n1357:             } => {\n1358:                 self.hoist_vars_from_stmt(consequent)?;\n1359:                 if let Some(alt) = alternate {\n1360:                     self.hoist_vars_from_stmt(alt)?;\n1361:                 }\n1362:                 Ok(())\n1363:             }\n1364:             Stmt::While { body, .. } | Stmt::DoWhile { body, .. } => {\n1365:                 self.hoist_vars_from_stmt(body)\n1366:             }\n1367:             Stmt::For { init, body, .. } => {\n1368:                 if let Some(init) = init {\n1369:                     self.hoist_vars_from_stmt(init)?;\n1370:                 }\n1371:                 self.hoist_vars_from_stmt(body)\n1372:             }\n1373:             Stmt::ForIn { body, left, .. } | Stmt::ForOf { body, left, .. } => {\n1374:                 self.hoist_vars_from_stmt(left)?;\n1375:                 self.hoist_vars_from_stmt(body)\n1376:             }\n1377:             Stmt::Try {\n1378:                 block,\n1379:                 handler,\n1380:                 finalizer,\n1381:                 ..\n1382:             } => {\n1383:                 self.hoist_vars_from_stmt(block)?;\n1384:                 if let Some(handler) = handler {\n1385:                     self.hoist_vars_from_stmt(handler)?;\n1386:                 }\n1387:                 if let Some(finalizer) = finalizer {\n1388:                     self.hoist_vars_from_stmt(finalizer)?;\n1389:                 }\n1390:                 Ok(())\n1391:             }\n1392:             // Nested function bodies have their own var environment — do not hoist out.\n1393:             Stmt::FunctionDeclaration { .. } | Stmt::ClassDeclaration { .. } => Ok(()),\n1394:             _ => Ok(()),\n1395:         }\n1396:     }\n1397: \n1398:     fn declare_var_binding(&mut self, binding: &BindingPattern) -> Result<(), Diagnostic> {\n1399:         let mut err = None;\n1400:         binding.for_each_ident(&mut |id| {\n1401:             if err.is_some() {\n1402:                 return;\n1403:             }\n1404:             if let Err(e) = self.declare_var(id.name.clone(), id.span) {\n1405:             