    "state": {
      "status": "completed",
      "input": {
        "filePath": "/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-embed/src/lib.rs"
      },
      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-embed/src/lib.rs</path>\n<type>file</type>\n<content>\n1: //! Embed: compiler-in-runtime for `eval` / `Function` (ROADMAP N07).\n2: //!\n3: //! N07.01: compile simple expression source strings through Frontend → IR and\n4: //! evaluate them with a minimal IR interpreter (completion value of the script).\n5: //! N07.03: evaluate `Function` bodies (`return expr`) with bound parameter values.\n6: //! N07.04: evaluate with injected name bindings (direct lexical / indirect global).\n7: //! Outer Program fold (N07.02–N07.04 native): [`fold_eval_program`].\n8: \n9: mod fold;\n10: \n11: pub use fold::{fold_eval_program, is_eval_fold_module, Observation};\n12: \n13: use std::collections::HashMap;\n14: use std::fmt::Write as _;\n15: \n16: use draconic_ast::{BinaryOp, UnaryOp};\n17: use draconic_diagnostics::{Diagnostic, Span};\n18: use draconic_frontend::compile_source;\n19: use draconic_ir::{Expr, LocalId, Module, Stmt};\n20: \n21: /// JS-ish value produced by Embed eval (N07.01 subset).\n22: #[derive(Debug, Clone, PartialEq)]\n23: pub enum EmbedValue {\n24:     Undefined,\n25:     Null,\n26:     Boolean(bool),\n27:     Number(f64),\n28:     String(String),\n29: }\n30: \n31: impl EmbedValue {\n32:     pub fn as_number(&self) -> Option<f64> {\n33:         match self {\n34:             EmbedValue::Number(n) => Some(*n),\n35:             _ => None,\n36:         }\n37:     }\n38: \n39:     pub fn as_str(&self) -> Option<&str> {\n40:         match self {\n41:             EmbedValue::String(s) => Some(s.as_str()),\n42:             _ => None,\n43:         }\n44:     }\n45: \n46:     pub fn typeof_name(&self) -> &'static str {\n47:         match self {\n48:             EmbedValue::Undefined => \"undefined\",\n49:             EmbedValue::Null => \"object\",\n50:             EmbedValue::Boolean(_) => \"boolean\",\n51:             EmbedValue::Number(_) => \"number\",\n52:             EmbedValue::String(_) => \"string\",\n53:         }\n54:     }\n55: }\n56: \n57: /// Compile `source` as a Script and return its completion value.\n58: ///\n59: /// N07.01 supports expression scripts built from literals, arithmetic, unary\n60: /// `+/-`, grouping, and `typeof` on the supported value set (incl. `undefined`).\n61: pub fn eval_source(source: &str) -> Result<EmbedValue, Diagnostic> {\n62:     let module = compile_source(source)?;\n63:     interpret_module(&module)\n64: }\n65: \n66: /// Like [`eval_source`], but prepends `let` bindings for free names (N07.04).\n67: ///\n68: /// Used for direct eval (caller lexical names) and indirect eval (global object\n69: /// properties). Each binding name must appear at most once (caller merges\n70: /// shadowing: lexical over global).\n71: pub fn eval_source_with_bindings(\n72:     source: &str,\n73:     bindings: &[(String, EmbedValue)],\n74: ) -> Result<EmbedValue, Diagnostic> {\n75:     if bindings.is_empty() {\n76:         return eval_source(source);\n77:     }\n78:     let mut seen = std::collections::HashSet::new();\n79:     for (name, _) in bindings {\n80:         if !seen.insert(name.as_str()) {\n81:             return Err(diag(format!(\n82:                 \"embed eval: duplicate binding name {name:?}\"\n83:             )));\n84:         }\n85:     }\n86:     let mut script = String::new();\n87:     for (name, val) in bindings {\n88:         validate_param_name(name)?;\n89:         write_let_binding(&mut script, name, val)?;\n90:     }\n91:     script.push_str(source);\n92:     eval_source(&script)\n93: }\n94: \n95: /// Evaluate a `Function` body with bound parameters (N07.03).\n96: ///\n97: /// `params` are simple identifier names; `body` is the function body source\n98: /// (typically a single `return <expr>;`). `args` are bound positionally; missing\n99: /// args become `undefined`. Extra args are ignored.\n100: pub fn eval_function_call(\n101:     params: &[&str],\n102:     body: &str,\n103:     args: &[EmbedValue],\n104: ) -> Result<EmbedValue, Diagnostic> {\n105:     let expr_src = function_body_completion_expr(body)?;\n106:     let mut bindings = Vec::with_capacity(params.len());\n107:     for (i, name) in params.iter().enumerate() {\n108:         validate_param_name(name)?;\n109:         let val = args.get(i).cloned().unwrap_or(EmbedValue::Undefined);\n110:         bindings.push(((*name).to_string(), val));\n111:     }\n112:     eval_source_with_bindings(&expr_src, &bindings)\n113: }\n114: \n115: fn function_body_completion_expr(body: &str) -> Result<String, Diagnostic> {\n116:     let t = body.trim();\n117:     // Single-statement `return <expr>;` (N07.03 fixture subset).\n118:     let rest = if let Some(r) = t.strip_prefix(\"return\") {\n119:         let r = r.trim_start();\n120:         if r.is_empty() {\n121:             return Ok(\"undefined\".into());\n122:         }\n123:         // `return` must be followed by expr or end; require boundary.\n124:         r\n125:     } else {\n126:         // Bare expression body (not used by fixtures, but harmless).\n127:         t\n128:     };\n129:     let rest = rest.trim_end_matches(';').trim();\n130:     if rest.is_empty() {\n131:         return Ok(\"undefined\".into());\n132:     }\n133:     Ok(rest.to_string())\n134: }\n135: \n136: fn validate_param_name(name: &str) -> Result<(), Diagnostic> {\n137:     let mut chars = name.chars();\n138:     let Some(first) = chars.next() else {\n139:         return Err(diag(\"embed Function: empty parameter name\"));\n140:     };\n141:     if !(first.is_ascii_alphabetic() || first == '_' || first == '$') {\n142:         return Err(diag(format!(\n143:             \"embed Function: invalid parameter name {name:?}\"\n144:         )));\n145:     }\n146:     for c in chars {\n147:         if !(c.is_ascii_alphanumeric() || c == '_' || c == '$') {\n148:             return Err(diag(format!(\n149:                 \"embed Function: invalid parameter name {name:?}\"\n150:             )));\n151:         }\n152:     }\n153:     Ok(())\n154: }\n155: \n156: fn write_let_binding(out: &mut String, name: &str, val: &EmbedValue) -> Result<(), Diagnostic> {\n157:     match val {\n158:         EmbedValue::Undefined => {\n159:             let _ = write!(out, \"let {name} = undefined; \");\n160:         }\n161:         EmbedValue::Null => {\n162:             let _ = write!(out, \"let {name} = null; \");\n163:         }\n164:         EmbedValue::Boolean(true) => {\n165:             let _ = write!(out, \"let {name} = true; \");\n166:         }\n167:         EmbedValue::Boolean(false) => {\n168:             let _ = write!(out, \"let {name} = false; \");\n169:         }\n170:         EmbedValue::Number(n) => {\n171:             if n.is_nan() {\n172:                 let _ = write!(out, \"let {name} = NaN; \");\n173:             } else if *n == f64::INFINITY {\n174:                 let _ = write!(out, \"let {name} = Infinity; \");\n175:             } else if *n == f64::NEG_INFINITY {\n176:                 let _ = write!(out, \"let {name} = -Infinity; \");\n177:             } else {\n178:                 let _ = write!(out, \"let {name} = {n}; \");\n179:             }\n180:         }\n181:         EmbedValue::String(s) => {\n182:             let _ = write!(out, \"let {name} = {}; \", js_string_literal(s));\n183:         }\n184:     }\n185:     Ok(())\n186: }\n187: \n188: fn js_string_literal(s: &str) -> String {\n189:     let mut out = String::from(\"\\\"\");\n190:     for c in s.chars() {\n191:         match c {\n192:             '\\\\' => out.push_str(\"\\\\\\\\\"),\n193:             '\"' => out.push_str(\"\\\\\\\"\"),\n194:             '\\n' => out.push_str(\"\\\\n\"),\n195:             '\\r' => out.push_str(\"\\\\r\"),\n196:             '\\t' => out.push_str(\"\\\\t\"),\n197:             c if c.is_control() => {\n198:                 let _ = write!(out, \"\\\\u{:04x}\", c as u32);\n199:             }\n200:             c => out.push(c),\n201:         }\n202:     }\n203:     out.push('\"');\n204:     out\n205: }\n206: \n207: fn interpret_module(module: &Module) -> Result<EmbedValue, Diagnostic> {\n208:     let mut env: HashMap<LocalId, EmbedValue> = HashMap::new();\n209:     for local in &module.locals {\n210:         if local.name == \"undefined\" {\n211:             env.insert(local.id, EmbedValue::Undefined);\n212:         }\n213:     }\n214:     let mut completion = EmbedValue::Undefined;\n215:     for stmt in &module.body {\n216:         completion = exec_stmt(stmt, &mut env, module)?;\n217:     }\n218:     Ok(completion)\n219: }\n220: \n221: fn exec_stmt(\n222:     stmt: &Stmt,\n223:     env: &mut HashMap<LocalId, EmbedValue>,\n224:     module: &Module,\n225: ) -> Result<EmbedValue, Diagnostic> {\n226:     match stmt {\n227:         Stmt::Expr { expr } => eval_expr(expr, env, module),\n228:         Stmt::Block { body } => {\n229:             let mut last = EmbedValue::Undefined;\n230:             for s in body {\n231:                 last = exec_stmt(s, env, module)?;\n232:             }\n233:             Ok(last)\n234:         }\n235:         Stmt::Declare { local, init, .. } => {\n236:             let v = match init {\n237:                 Some(e) => eval_expr(e, env, module)?,\n238:                 None => EmbedValue::Undefined,\n239:             };\n240:             env.insert(*local, v);\n241:             Ok(EmbedValue::Undefined)\n242:         }\n243:         other => Err(diag(format!(\n244:             \"embed eval does not support statement: {other:?}\"\n245:         ))),\n246:     }\n247: }\n248: \n249: fn eval_expr(\n250:     expr: &Expr,\n251:     env: &mut HashMap<LocalId, EmbedValue>,\n252:     module: &Module,\n253: ) -> Result<EmbedValue, Diagnostic> {\n254:     match expr {\n255:         Expr::Number { raw, .. } => {\n256:             let n = parse_number_raw(raw)?;\n257:             Ok(EmbedValue::Number(n))\n258:         }\n259:         Expr::String { value, .. } => Ok(EmbedValue::String(value.to_string_lossy())),\n260:         Expr::Boolean { value, .. } => Ok(EmbedValue::Boolean(*value)),\n261:         Expr::Null { .. } => Ok(EmbedValue::Null),\n262:         Expr::Local { id, .. } => {\n263:             if let Some(v) = env.get(id) {\n264:                 return Ok(v.clone());\n265:             }\n266:             if let Some(local) = module.locals.iter().find(|l| l.id == *id) {\n267:                 if local.name == \"undefined\" {\n268:                     return Ok(EmbedValue::Undefined);\n269:                 }\n270:             }\n271:             Err(diag(format!(\n272:                 \"embed eval: unbound local %{}\",\n273:                 id.0\n274:             )))\n275:         }\n276:         Expr::Unary { op, arg, .. } => {\n277:             let v = eval_expr(arg, env, module)?;\n278:             eval_unary(*op, v)\n279:         }\n280:         Expr::Binary {\n281:             left, op, right, ..\n282:         } => {\n283:             let l = eval_expr(left, env, module)?;\n284:             // Short-circuit not required for arithmetic subset; still evaluate both.\n285:             let r = eval_expr(right, env, module)?;\n286:             eval_binary(*op, l, r)\n287:         }\n288:         other => Err(diag(format!(\n289:             \"embed eval does not support expression: {other:?}\"\n290:         ))),\n291:     }\n292: }\n293: \n294: fn eval_unary(op: UnaryOp, v: EmbedValue) -> Result<EmbedValue, Diagnostic> {\n295:     match op {\n296:         UnaryOp::Plus => Ok(EmbedValue::Number(to_number(&v)?)),\n297:         UnaryOp::Minus => Ok(EmbedValue::Number(-to_number(&v)?)),\n298:         UnaryOp::TypeOf => Ok(EmbedValue::String(v.typeof_name().to_string())),\n299:         UnaryOp::Void => Ok(EmbedValue::Undefined),\n300:         UnaryOp::Not => Ok(EmbedValue::Boolean(!to_boolean(&v))),\n301:         other => Err(diag(format!(\n302:             \"embed eval does not support unary op: {other}\"\n303:         ))),\n304:     }\n305: }\n306: \n307: fn eval_binary(op: BinaryOp, left: EmbedValue, right: EmbedValue) -> Result<EmbedValue, Diagnostic> {\n308:     match op {\n309:         BinaryOp::Add => {\n310:             if matches!(left, EmbedValue::String(_)) || matches!(right, EmbedValue::String(_)) {\n311:                 Ok(EmbedValue::String(format!(\n312:                     \"{}{}\",\n313:                     to_string_js(&left),\n314:                     to_string_js(&right)\n315:                 )))\n316:             } else {\n317:                 Ok(EmbedValue::Number(to_number(&left)? + to_number(&right)?))\n318:             }\n319:         }\n320:         BinaryOp::Sub => Ok(EmbedValue::Number(to_number(&left)? - to_number(&right)?)),\n321:         BinaryOp::Mul => Ok(EmbedValue::Number(to_number(&left)? * to_number(&right)?)),\n322:         BinaryOp::Div => Ok(EmbedValue::Number(to_number(&left)? / to_number(&right)?)),\n323:         BinaryOp::Rem => Ok(EmbedValue::Number(to_number(&left)? % to_number(&right)?)),\n324:         BinaryOp::Comma => Ok(right),\n325:         other => Err(diag(format!(\n326:             \"embed eval does not support binary op: {other:?}\"\n327:         ))),\n328:     }\n329: }\n330: \n331: fn to_number(v: &EmbedValue) -> Result<f64, Diagnostic> {\n332:     match v {\n333:         EmbedValue::Number(n) => Ok(*n),\n334:         EmbedValue::Boolean(true) => Ok(1.0),\n335:         EmbedValue::Boolean(false) => Ok(0.0),\n336:         EmbedValue::Null => Ok(0.0),\n337:         EmbedValue::Undefined => Ok(f64::NAN),\n338:         EmbedValue::String(s) => {\n339:             let t = s.trim();\n340:             if t.is_empty() {\n341:                 return Ok(0.0);\n342:             }\n343:             t.parse::<f64>()\n344:                 .map_err(|_| diag(format!(\"embed eval: cannot convert string to number: {s:?}\")))\n345:         }\n346:     }\n347: }\n348: \n349: fn to_boolean(v: &EmbedValue) -> bool {\n350:     match v {\n351:         EmbedValue::Undefined | EmbedValue::Null => false,\n352:         EmbedValue::Boolean(b) => *b,\n353:         EmbedValue::Number(n) => *n != 0.0 && !n.is_nan(),\n354:         EmbedValue::String(s) => !s.is_empty(),\n355:     }\n356: }\n357: \n358: fn to_string_js(v: &EmbedValue) -> String {\n359:     match v {\n360:         EmbedValue::Undefined => \"undefined\".into(),\n361:         EmbedValue::Null => \"null\".into(),\n362:         EmbedValue::Boolean(b) => b.to_string(),\n363:         EmbedValue::Number(n) => {\n364:             if n.is_nan() {\n365:                 \"NaN\".into()\n366:             } else if *n == f64::INFINITY {\n367:                 \"Infinity\".into()\n368:             } else if *n == f64::NEG_INFINITY {\n369:                 \"-Infinity\".into()\n370:             } else if *n == 0.0 {\n371:                 \"0\".into()\n372:             } else {\n373:                 // Prefer integer form when exact.\n374:                 if n.fract() == 0.0 && n.abs() < 1e21 {\n375:                     format!(\"{}\", *n as i64)\n376:                 } else {\n377:                     n.to_string()\n378:                 }\n379:             }\n380:         }\n381:         EmbedValue::String(s) => s.clone(),\n382:     }\n383: }\n384: \n385: fn parse_number_raw(raw: &str) -> Result<f64, Diagnostic> {\n386:     let s = raw.replace('_', \"\");\n387:     if let Some(hex) = s\n388:         .strip_prefix(\"0x\")\n389:         .or_else(|| s.strip_prefix(\"0X\"))\n390:     {\n391:         return i64::from_str_radix(hex, 16)\n392:             .map(|n| n as f64)\n393:             .map_err(|_| diag(format!(\"embed eval: bad hex number: {raw}\")));\n394:     }\n395:     if let Some(bin) = s\n396:         .strip_prefix(\"0b\")\n397:         .or_else(|| s.strip_prefix(\"0B\"))\n398:     {\n399:         return i64::from_str_radix(bin, 2)\n400:             .map(|n| n as f64)\n401:             .map_err(|_| diag(format!(\"embed eval: bad binary number: {raw}\")));\n402:     }\n403:     if let Some(oct) = s\n404:         .strip_prefix(\"0o\")\n405:         .or_else(|| s.strip_prefix(\"0O\"))\n406:     {\n407:         return i64::from_str_radix(oct, 8)\n408:             .map(|n| n as f64)\n409:             .map_err(|_| diag(format!(\"embed eval: bad octal number: {raw}\")));\n410:     }\n411:     s.parse::<f64>()\n412:         .map_err(|_| diag(format!(\"embed eval: bad number: {raw}\")))\n413: }\n414: \n415: fn diag(message: impl Into<String>) -> Diagnostic {\n416:     Diagnostic::new(message, Span::dummy())\n417: }\n418: \n419: #[cfg(test)]\n420: mod tests {\n421:     use super::*;\n422: \n423:     #[test]\n424:     fn eval_number_literal() {\n425:         let v = eval_source(\"42\").unwrap();\n426:         assert_eq!(v, EmbedValue::Number(42.0));\n427:     }\n428: \n429:     #[test]\n430:     fn eval_arithmetic_add() {\n431:         let v = eval_source(\"1 + 2\").unwrap();\n432:         assert_eq!(v, EmbedValue::Number(3.0));\n433:     }\n434: \n435:     #[test]\n436:     fn eval_arithmetic_mul_div_rem_sub() {\n437:         assert_eq!(eval_source(\"3 * 4\").unwrap(), EmbedValue::Number(12.0));\n438:         assert_eq!(eval_source(\"10 - 3\").unwrap(), EmbedValue::Number(7.0));\n439:         assert_eq!(eval_source(\"20 / 4\").unwrap(), EmbedValue::Number(5.0));\n440:         assert_eq!(eval_source(\"10 % 3\").unwrap(), EmbedValue::Number(1.0));\n441:     }\n442: \n443:     #[test]\n444:     fn eval_unary_plus_minus_grouping() {\n445:         assert_eq!(eval_source(\"-3\").unwrap(), EmbedValue::Number(-3.0));\n446:         assert_eq!(eval_source(\"+5\").unwrap(), EmbedValue::Number(5.0));\n447:         assert_eq!(eval_source(\"(1 + 2) * 3\").unwrap(), EmbedValue::Number(9.0));\n448:     }\n449: \n450:     #[test]\n451:     fn eval_string_literal() {\n452:         let v = eval_source(\"'hi'\").unwrap();\n453:         assert_eq!(v, EmbedValue::String(\"hi\".into()));\n454:     }\n455: \n456:     #[test]\n457:     fn eval_typeof_undefined() {\n458:         let v = eval_source(\"typeof undefined\").unwrap();\n459:         assert_eq!(v, EmbedValue::String(\"undefined\".into()));\n460:     }\n461: \n462:     #[test]\n463:     fn eval_typeof_number() {\n464:         let v = eval_source(\"typeof 1\").unwrap();\n465:         assert_eq!(v, EmbedValue::String(\"number\".into()));\n466:     }\n467: \n468:     #[test]\n469:     fn eval_direct_eval_expression_cases() {\n470:         // Mirrors tests/conformance/fixtures/es/eval/direct_eval.drac string args.\n471:         assert_eq!(eval_source(\"1 + 2\").unwrap(), EmbedValue::Number(3.0));\n472:         assert_eq!(\n473:             eval_source(\"typeof undefined\").unwrap(),\n474:             EmbedValue::String(\"undefined\".into())\n475:         );\n476:         assert_eq!(eval_source(\"3 * 4\").unwrap(), EmbedValue::Number(12.0));\n477:         assert_eq!(\n478:             eval_source(\"'hi'\").unwrap(),\n479:             EmbedValue::String(\"hi\".into())\n480:         );\n481:     }\n482: \n483:     #[test]\n484:     fn eval_completion_value_is_last_expr() {\n485:         let v = eval_source(\"1 + 2; 3 * 4\").unwrap();\n486:         assert_eq!(v, EmbedValue::Number(12.0));\n487:     }\n488: \n489:     #[test]\n490:     fn eval_string_concat() {\n491:         let v = eval_source(\"'a' + 'b'\").unwrap();\n492:         assert_eq!(v, EmbedValue::String(\"ab\".into()));\n493:     }\n494: \n495:     #[test]\n496:     fn eval_rejects_unsupported_construct() {\n497:         let err = eval_source(\"function f() {}\").unwrap_err();\n498:         let msg = err.to_string();\n499:         assert!(\n500:             msg.contains(\"embed eval does not support\") || msg.contains(\"function\"),\n501:             \"msg={msg}\"\n502:         );\n503:     }\n504: \n505:     #[test]\n506:     fn eval_function_call_return_add() {\n507:         let v = eval_function_call(\n508:             &[\"a\", \"b\"],\n509:             \"return a + b\",\n510:             &[EmbedValue::Number(1.0), EmbedValue::Number(2.0)],\n511:         )\n512:   