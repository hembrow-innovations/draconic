        "content": "// E19.87 regression: class methods / accessors / constructors with non-simple\n// parameter lists (default / rest / destructured) must not emit a \"use strict\"\n// directive inside the non-simple parameter list (Node SyntaxError), and the\n// class code must stay strict (class-builder IIFE is strict). E19.82 injected\n// the directive into every class body via with_use_strict.\n\nfunction assert(cond, label) {\n  if (cond !== true) {\n    throw new Error(\"class_non_simple_params: \" + label);\n  }\n}\n\n// 1) Instance method with default param: binds default; detached call is strict\n//    (this not coerced to the global object).\nclass M {\n  m(a = 23) {\n    return [a, this === undefined];\n  }\n}\nlet m = M.prototype.m();\nassert(m[0] === 23, \"method default param\");\nassert(m[1] === true, \"method detached this undefined (strict)\");\n\n// 2) Static generator method with default + rest params.\nclass G {\n  static *gen(a = 1, ...rest) {\n    yield a;\n    yield* rest;\n  }\n}\nlet g = G.gen(undefined, 5, 6);\nassert(g.next().value === 1, \"gen default param\");\nassert(g.next().value === 5, \"gen rest 1\");\nassert(g.next().value === 6, \"gen rest 2\");\nassert(g.next().done === true, \"gen done\");\n\n// 3) Constructor with default + destructured params.\nclass C {\n  constructor(x = 10, { y } = { y: 20 }) {\n    this.x = x;\n    this.y = y;\n  }\n}\nlet c = new C();\nassert(c.x === 10, \"ctor default param\");\nassert(c.y === 20, \"ctor destructured default param\");\n\n// 4) Setter with destructured param (non-simple accessor parameter list).\nclass S {\n  constructor() {\n    this.stored = null;\n  }\n  set point([x, y]) {\n    this.stored = x + \":\" + y;\n  }\n}\nlet s = new S();\ns.point = [1, 2];\nassert(s.stored === \"1:2\", \"setter destructured param\");\n\n// 5) Static async method with default param: detached call stays strict.\nclass A {\n  static async a(x = 3) {\n    return [x, this === undefined];\n  }\n}\nA.a().then((r) => {\n  assert(r[0] === 3, \"async method default param\");\n  assert(r[1] === true, \"async method detached this undefined (strict)\");\n});\n"
      },
