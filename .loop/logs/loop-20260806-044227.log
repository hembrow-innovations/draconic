i = self.fresh();\n444:         writeln!(self.body, \"  {li} = fptosi double {l} to i32\").ok();\n445:         let ri = self.fresh();\n446:         writeln!(self.body, \"  {ri} = fptosi double {r} to i32\").ok();\n447:         match op {\n448:             BinaryOp::BitAnd | BinaryOp::BitOr | BinaryOp::BitXor => {\n449:                 let inst = match op {\n450:                     BinaryOp::BitAnd => \"and\",\n451:                     BinaryOp::BitOr => \"or\",\n452:                     BinaryOp::BitXor => \"xor\",\n453:                     _ => unreachable!(),\n454:                 };\n455:                 let n = self.fresh();\n456:                 writeln!(self.body, \"  {n} = {inst} i32 {li}, {ri}\").ok();\n457:                 let t = self.fresh();\n458:                 writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n459:                 Ok(t)\n460:             }\n461:             BinaryOp::Shl | BinaryOp::Shr | BinaryOp::UShr => {\n462:                 let shift = self.fresh();\n463:                 writeln!(self.body, \"  {shift} = and i32 {ri}, 31\").ok();\n464:                 let n = self.fresh();\n465:                 match op {\n466:                     BinaryOp::Shl => {\n467:                         writeln!(self.body, \"  {n} = shl i32 {li}, {shift}\").ok();\n468:                         let t = self.fresh();\n469:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n470:                         Ok(t)\n471:                     }\n472:                     BinaryOp::Shr => {\n473:                         writeln!(self.body, \"  {n} = ashr i32 {li}, {shift}\").ok();\n474:                         let t = self.fresh();\n475:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n476:                         Ok(t)\n477:                     }\n478:                     BinaryOp::UShr => {\n479:                         writeln!(self.body, \"  {n} = lshr i32 {li}, {shift}\")