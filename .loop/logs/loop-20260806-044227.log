      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-backend-llvm/src/es_expr.rs</path>\n<type>file</type>\n<content>\n1: //! N08.01: emit native observations for ES expression Programs\n2: //! (E01.01 arithmetic, E01.02 comparison, E01.03 logical, E01.04.01 bitwise).\n3: \n4: use std::collections::HashMap;\n5: use std::fmt::Write as _;\n6: \n7: use draconic_ast::{BinaryOp, UnaryOp};\n8: use draconic_diagnostics::{Diagnostic, Span};\n9: use draconic_ir::{Expr, IrType as Type, Local, LocalId, Module, Stmt};\n10: use draconic_runtime::abi::{llvm_declares, ES_EXPR_DECLARES, PRINT_BOOL, PRINT_F64};\n11: \n12: /// True when this module is a supported ES expression subset (E01.01–E01.04.01 / N08.01.*):\n13: /// top-level `let` declares over JS numbers and/or booleans with arithmetic, unary `+`/`-`/`!`/`~`,\n14: /// comparison (`<` `<=` `>` `>=`), equality (`==` `!=` `===` `!==`), logical (`&&` `||`),\n15: /// bitwise (`&` `|` `^` `<<` `>>` `>>>`), grouping, and local refs. Value-preserving `&&`/`||`\n16: /// on numbers is included.\n17: pub(crate) fn is_es_expr_module(module: &Module) -> bool {\n18:     classify(module).is_some()\n19: }\n20: \n21: pub(crate) fn emit_es_expr(module: &Module) -> Result<String, Diagnostic> {\n22:     let user = classify(module).ok_or_else(|| diag(\"internal: not an es_expr module\"))?;\n23:     let mut em = Emitter::new(module);\n24:     em.emit_module(&user.user_locals)?;\n25:     Ok(em.finish())\n26: }\n27: \n28: #[derive(Clone, Copy, PartialEq, Eq)]\n29: enum SlotTy {\n30:     Number,\n31:     Boolean,\n32: }\n33: \n34: /// Top-level user locals in declaration order (observation order).\n35: struct ModuleInfo {\n36:     user_locals: Vec<(LocalId, SlotTy)>,\n37: }\n38: \n39: fn classify(module: &Module) -> Option<ModuleInfo> {\n40:     let by_id: HashMap<LocalId, &Local> = module.locals.iter().map(|l| (l.id, l)).collect();\n41:     let mut user_locals = Vec::new();\n42:     for stmt in &module.body {\n43:         let Stmt::Declare {\n44:             local,\n45:             init: Some(init),\n46:             ..\n47:         } = stmt\n48:         else {\n49:             return None;\n50:         };\n51:         let loc = by_id.get(local)?;\n52:         let slot = match loc.ty {\n53:             Type::Number => {\n54:                 if !expr_is_number_subset(init, &by_id) {\n55:                     return None;\n56:                 }\n57:                 SlotTy::Number\n58:             }\n59:             Type::Boolean => {\n60:                 if !expr_is_boolean_subset(init, &by_id) {\n61:                     return None;\n62:                 }\n63:                 SlotTy::Boolean\n64:             }\n65:             _ => return None,\n66:         };\n67:         user_locals.push((*local, slot));\n68:     }\n69:     if user_locals.is_empty() {\n70:         return None;\n71:     }\n72:     Some(ModuleInfo { user_locals })\n73: }\n74: \n75: fn expr_is_number_subset(expr: &Expr, by_id: &HashMap<LocalId, &Local>) -> bool {\n76:     match expr {\n77:         Expr::Number { ty, .. } => *ty == Type::Number,\n78:         Expr::Local { id, ty } => {\n79:             *ty == Type::Number && by_id.get(id).is_some_and(|l| l.ty == Type::Number)\n80:         }\n81:         Expr::Unary { op, arg, ty } => {\n82:             *ty == Type::Number\n83:                 && matches!(op, UnaryOp::Minus | UnaryOp::Plus | UnaryOp::BitNot)\n84:                 && expr_is_number_subset(arg, by_id)\n85:         }\n86:         Expr::Binary {\n87:             left,\n88:             op,\n89:             right,\n90:             ty,\n91:         } => {\n92:             *ty == Type::Number\n93:                 && matches!(\n94:                     op,\n95:                     BinaryOp::Add\n96:                         | BinaryOp::Sub\n97:                         | BinaryOp::Mul\n98:                         | BinaryOp::Div\n99:                         | BinaryOp::Rem\n100:                         | BinaryOp::And\n101:                         | BinaryOp::Or\n102:                         | BinaryOp::BitAnd\n103:                         | BinaryOp::BitOr\n104:                         | BinaryOp::BitXor\n105:                         | BinaryOp::Shl\n106:                         | BinaryOp::Shr\n107:                         | BinaryOp::UShr\n108:                 )\n109:                 && expr_is_number_subset(left, by_id)\n110:                 && expr_is_number_subset(right, by_id)\n111:         }\n112:         _ => false,\n113:     }\n114: }\n115: \n116: fn expr_is_boolean_subset(expr: &Expr, by_id: &HashMap<LocalId, &Local>) -> bool {\n117:     match expr {\n118:         Expr::Boolean { ty, .. } => *ty == Type::Boolean,\n119:         Expr::Local { id, ty } => {\n120:             *ty == Type::Boolean && by_id.get(id).is_some_and(|l| l.ty == Type::Boolean)\n121:         }\n122:         Expr::Unary { op, arg, ty } => {\n123:             *ty == Type::Boolean && matches!(op, UnaryOp::Not) && expr_is_boolean_subset(arg, by_id)\n124:         }\n125:         Expr::Binary {\n126:             left,\n127:             op,\n128:             right,\n129:             ty,\n130:         } => {\n131:             if *ty != Type::Boolean {\n132:                 return false;\n133:             }\n134:             match op {\n135:                 BinaryOp::Lt | BinaryOp::LtEq | BinaryOp::Gt | BinaryOp::GtEq => {\n136:                     expr_is_number_subset(left, by_id) && expr_is_number_subset(right, by_id)\n137:                 }\n138:                 BinaryOp::EqEq | BinaryOp::NotEq | BinaryOp::EqEqEq | BinaryOp::NotEqEq => {\n139:                     (expr_is_number_subset(left, by_id) && expr_is_number_subset(right, by_id))\n140:                         || (expr_is_boolean_subset(left, by_id)\n141:                             && expr_is_boolean_subset(right, by_id))\n142:                 }\n143:                 BinaryOp::And | BinaryOp::Or => {\n144:                     expr_is_boolean_subset(left, by_id) && expr_is_boolean_subset(right, by_id)\n145:                 }\n146:                 _ => false,\n147:             }\n148:         }\n149:         _ => false,\n150:     }\n151: }\n152: \n153: struct Emitter<'a> {\n154:     module: &'a Module,\n155:     /// local id → (alloca ptr name, slot type)\n156:     allocas: HashMap<LocalId, (String, SlotTy)>,\n157:     out: String,\n158:     body: String,\n159:     tmp: u32,\n160: }\n161: \n162: impl<'a> Emitter<'a> {\n163:     fn new(module: &'a Module) -> Self {\n164:         Self {\n165:             module,\n166:             allocas: HashMap::new(),\n167:             out: String::new(),\n168:             body: String::new(),\n169:             tmp: 0,\n170:         }\n171:     }\n172: \n173:     fn fresh(&mut self) -> String {\n174:         let n = self.tmp;\n175:         self.tmp += 1;\n176:         format!(\"%t{n}\")\n177:     }\n178: \n179:     fn emit_module(&mut self, user: &[(LocalId, SlotTy)]) -> Result<(), Diagnostic> {\n180:         writeln!(\n181:             self.out,\n182:             \"; Draconic LLVM backend (N08.01 ES expressions via Runtime ABI)\"\n183:         )\n184:         .ok();\n185:         writeln!(self.out, \"{}\", llvm_declares(ES_EXPR_DECLARES)).ok();\n186:         writeln!(self.out).ok();\n187: \n188:         for (id, slot) in user {\n189:             let ptr = format!(\"%l{}\", id.0);\n190:             self.allocas.insert(*id, (ptr.clone(), *slot));\n191:             match slot {\n192:                 SlotTy::Number => {\n193:                     writeln!(self.body, \"  {ptr} = alloca double, align 8\").ok();\n194:                 }\n195:                 SlotTy::Boolean => {\n196:                     writeln!(self.body, \"  {ptr} = alloca i1, align 1\").ok();\n197:                 }\n198:             }\n199:         }\n200: \n201:         for stmt in &self.module.body {\n202:             let Stmt::Declare { local, init, .. } = stmt else {\n203:                 return Err(diag(\"internal: non-declare in es_expr module\"));\n204:             };\n205:             let Some(init) = init else {\n206:                 return Err(diag(\"internal: declare without init in es_expr module\"));\n207:             };\n208:             let (ptr, slot) = self\n209:                 .allocas\n210:                 .get(local)\n211:                 .cloned()\n212:                 .ok_or_else(|| diag(\"internal: missing alloca\"))?;\n213:             match slot {\n214:                 SlotTy::Number => {\n215:                     let v = self.emit_number_expr(init)?;\n216:                     writeln!(self.body, \"  store double {v}, ptr {ptr}\").ok();\n217:                 }\n218:                 SlotTy::Boolean => {\n219:                     let v = self.emit_bool_expr(init)?;\n220:                     writeln!(self.body, \"  store i1 {v}, ptr {ptr}\").ok();\n221:                 }\n222:             }\n223:         }\n224: \n225:         // Print top-level user locals in declaration order.\n226:         for (id, slot) in user {\n227:             let (ptr, _) = self\n228:                 .allocas\n229:                 .get(id)\n230:                 .cloned()\n231:                 .ok_or_else(|| diag(\"internal: print missing alloca\"))?;\n232:             match slot {\n233:                 SlotTy::Number => {\n234:                     let v = self.fresh();\n235:                     writeln!(self.body, \"  {v} = load double, ptr {ptr}\").ok();\n236:                     writeln!(self.body, \"  {}\", PRINT_F64.call(&format!(\"double {v}\"))).ok();\n237:                 }\n238:                 SlotTy::Boolean => {\n239:                     let v = self.fresh();\n240:                     writeln!(self.body, \"  {v} = load i1, ptr {ptr}\").ok();\n241:                     let ext = self.fresh();\n242:                     writeln!(self.body, \"  {ext} = zext i1 {v} to i8\").ok();\n243:                     writeln!(self.body, \"  {}\", PRINT_BOOL.call(&format!(\"i8 {ext}\"))).ok();\n244:                 }\n245:             }\n246:         }\n247: \n248:         writeln!(self.out, \"define i32 @main() {{\").ok();\n249:         writeln!(self.out, \"entry:\").ok();\n250:         write!(self.out, \"{}\", self.body).ok();\n251:         writeln!(self.out, \"  ret i32 0\").ok();\n252:         writeln!(self.out, \"}}\").ok();\n253:         Ok(())\n254:     }\n255: \n256:     fn emit_number_expr(&mut self, expr: &Expr) -> Result<String, Diagnostic> {\n257:         match expr {\n258:             Expr::Number { raw, .. } => Ok(format_number_const(raw)?),\n259:             Expr::Local { id, .. } => {\n260:                 let (ptr, slot) = self\n261:                     .allocas\n262:                     .get(id)\n263:                     .cloned()\n264:                     .ok_or_else(|| diag(format!(\"internal: unallocated local %{}\", id.0)))?;\n265:                 if slot != SlotTy::Number {\n266:                     return Err(diag(\"internal: expected number local\"));\n267:                 }\n268:                 let t = self.fresh();\n269:                 writeln!(self.body, \"  {t} = load double, ptr {ptr}\").ok();\n270:                 Ok(t)\n271:             }\n272:             Expr::Unary { op, arg, .. } => {\n273:                 let a = self.emit_number_expr(arg)?;\n274:                 match op {\n275:                     UnaryOp::Plus => Ok(a),\n276:                     UnaryOp::Minus => {\n277:                         let t = self.fresh();\n278:                         writeln!(self.body, \"  {t} = fneg double {a}\").ok();\n279:                         Ok(t)\n280:                     }\n281:                     // JS `~`: ToInt32 then bitwise not; result as Number.\n282:                     UnaryOp::BitNot => {\n283:                         let i = self.fresh();\n284:                         writeln!(self.body, \"  {i} = fptosi double {a} to i32\").ok();\n285:                         let n = self.fresh();\n286:                         writeln!(self.body, \"  {n} = xor i32 {i}, -1\").ok();\n287:                         let t = self.fresh();\n288:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n289:                         Ok(t)\n290:                     }\n291:                     _ => Err(diag(\"internal: non-arithmetic unary in es_expr module\")),\n292:                 }\n293:             }\n294:             Expr::Binary {\n295:                 left, op, right, ..\n296:             } => {\n297:                 let l = self.emit_number_expr(left)?;\n298:                 let r = self.emit_number_expr(right)?;\n299:                 match op {\n300:                     BinaryOp::Add | BinaryOp::Sub | BinaryOp::Mul | BinaryOp::Div | BinaryOp::Rem => {\n301:                         let inst = match op {\n302:                             BinaryOp::Add => \"fadd\",\n303:                             BinaryOp::Sub => \"fsub\",\n304:                             BinaryOp::Mul => \"fmul\",\n305:                             BinaryOp::Div => \"fdiv\",\n306:                             BinaryOp::Rem => \"frem\",\n307:                             _ => unreachable!(),\n308:                         };\n309:                         let t = self.fresh();\n310:                         writeln!(self.body, \"  {t} = {inst} double {l}, {r}\").ok();\n311:                         Ok(t)\n312:                     }\n313:                     // Value-preserving JS && / || on numbers (ToBoolean via nonzero).\n314:                     BinaryOp::And | BinaryOp::Or => {\n315:                         let truthy = self.fresh();\n316:                         // +0/-0/NaN are falsy; `one` is ordered-and-unequal.\n317:                         writeln!(self.body, \"  {truthy} = fcmp one double {l}, 0.00000000000000000e+00\")\n318:                             .ok();\n319:                         let t = self.fresh();\n320:                         match op {\n321:               