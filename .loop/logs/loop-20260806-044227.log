      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-backend-llvm/src/native_ints.rs</path>\n<type>file</type>\n<content>\n1: //! N01–N03.03: lower pure native scalar/layout/pointer Programs to LLVM IR.\n2: \n3: use std::collections::{HashMap, HashSet};\n4: use std::fmt::Write as _;\n5: \n6: use draconic_ast::{AssignOp, BinaryOp, UnaryOp, UpdateOp};\n7: use draconic_diagnostics::{Diagnostic, Span};\n8: use draconic_ir::{\n9:     Arg, ArrayElement, AssignTarget, Expr, IrType as Type, Local, LocalId, Module, NativeType,\n10:     ObjectProp, ObjectPropKey, ObjectShape, Param, Pattern, Stmt, UpdateTarget,\n11: };\n12: use draconic_runtime::abi::{\n13:     llvm_declares, PRINT_BOOL, PRINT_F64, PRINT_I64, PRINT_U64, NATIVE_INT_DECLARES,\n14: };\n15: \n16: /// LLVM IR type spelling for a semantic native type (backend-owned mapping).\n17: fn llvm_ty(n: NativeType) -> &'static str {\n18:     match n {\n19:         NativeType::I8 | NativeType::U8 => \"i8\",\n20:         NativeType::I16 | NativeType::U16 => \"i16\",\n21:         NativeType::I32 | NativeType::U32 => \"i32\",\n22:         NativeType::I64 | NativeType::U64 => \"i64\",\n23:         NativeType::F32 => \"float\",\n24:         NativeType::F64 => \"double\",\n25:         NativeType::Bool => \"i1\",\n26:     }\n27: }\n28: \n29: /// Unboxed scalar lowered by this backend (native int/float/`bool`).\n30: #[derive(Debug, Clone, Copy, PartialEq, Eq)]\n31: struct Scalar(NativeType);\n32: \n33: impl Scalar {\n34:     fn llvm_ty(self) -> &'static str {\n35:         llvm_ty(self.0)\n36:     }\n37: \n38:     fn align(self) -> u32 {\n39:         if self.0.is_bool() {\n40:             1\n41:         } else {\n42:             (self.0.bit_width() / 8).max(1)\n43:         }\n44:     }\n45: \n46:     fn is_float(self) -> bool {\n47:         self.0.is_float()\n48:     }\n49: \n50:     fn is_int(self) -> bool {\n51:         self.0.is_int()\n52:     }\n53: \n54:     fn is_bool(self) -> bool {\n55:         self.0.is_bool()\n56:     }\n57: \n58:     fn native(self) -> NativeType {\n59:         self.0\n60:     }\n61: \n62:     fn zero_const(self) -> &'static str {\n63:         if self.0.is_float() {\n64:             \"0.000000e+00\"\n65:         } else {\n66:             \"0\"\n67:         }\n68:     }\n69: }\n70: \n71: fn scalar_of_type(ty: Type) -> Option<Scalar> {\n72:     match ty {\n73:         Type::Native(n) => Some(Scalar(n)),\n74:         // Comparison / logical results are JS `boolean` in the checker; lower as i1\n75:         // when already inside a native-scalar module.\n76:         Type::Boolean => Some(Scalar(NativeType::Bool)),\n77:         _ => None,\n78:     }\n79: }\n80: \n81: /// True when `shape` is a native layout: every field is a native scalar.\n82: fn shape_is_native_layout(shape: &ObjectShape) -> bool {\n83:     !shape.props.is_empty()\n84:         && shape\n85:             .props\n86:             .iter()\n87:             .all(|(_, t)| matches!(t, Type::Native(_)))\n88: }\n89: \n90: fn native_layout_of<'a>(module: &'a Module, ty: Type) -> Option<&'a ObjectShape> {\n91:     match ty {\n92:         Type::Shape(id) => {\n93:             let shape = module.shapes.get(id as usize)?;\n94:             if shape_is_native_layout(shape) {\n95:                 Some(shape)\n96:             } else {\n97:                 None\n98:             }\n99:         }\n100:         _ => None,\n101:     }\n102: }\n103: \n104: fn llvm_layout_ty(shape: &ObjectShape) -> String {\n105:     let mut s = String::from(\"{ \");\n106:     for (i, (_, t)) in shape.props.iter().enumerate() {\n107:         if i > 0 {\n108:             s.push_str(\", \");\n109:         }\n110:         let Type::Native(n) = *t else {\n111:             unreachable!(\"native layout fields are Native\");\n112:         };\n113:         s.push_str(llvm_ty(n));\n114:     }\n115:     s.push_str(\" }\");\n116:     s\n117: }\n118: \n119: fn layout_align(shape: &ObjectShape) -> u32 {\n120:     shape\n121:         .props\n122:         .iter()\n123:         .filter_map(|(_, t)| scalar_of_type(*t).map(|s| s.align()))\n124:         .max()\n125:         .unwrap_or(1)\n126: }\n127: \n128: /// True when every **user-declared** local is a native scalar (`i*`/`u*`/`f*`/`bool`),\n129: /// a **native layout** shape (all-native fields), a **native pointer** (`*T`),\n130: /// or a **function declaration** binding, and the module has at least one native\n131: /// scalar, layout, or pointer local (N01–N03.03 surface).\n132: ///\n133: /// Arrow / function-expression bindings are excluded so T05 erase fixtures that\n134: /// mix natives with callable values stay on the B08 hello stub. JS `boolean`\n135: /// locals alone also do not qualify. Globals (Object/Function builtins) ignored.\n136: pub(crate) fn is_native_int_module(module: &Module) -> bool {\n137:     let mut user = HashSet::new();\n138:     collect_user_local_ids(&module.body, &mut user);\n139:     if user.is_empty() {\n140:         return false;\n141:     }\n142:     let fn_decl_locals = function_decl_local_ids(&module.body);\n143:     let by_id: HashMap<LocalId, &Local> = module.locals.iter().map(|l| (l.id, l)).collect();\n144:     let mut has_native = false;\n145:     for id in user {\n146:         let Some(local) = by_id.get(&id) else {\n147:             return false;\n148:         };\n149:         match local.ty {\n150:             Type::Native(_) => has_native = true,\n151:             Type::Ptr(_) => has_native = true,\n152:             Type::Shape(_) if native_layout_of(module, local.ty).is_some() => has_native = true,\n153:             Type::Function if fn_decl_locals.contains(&id) => {}\n154:             _ => return false,\n155:         }\n156:     }\n157:     has_native\n158: }\n159: \n160: fn function_decl_local_ids(body: &[Stmt]) -> HashSet<LocalId> {\n161:     let mut out = HashSet::new();\n162:     for stmt in body {\n163:         match stmt {\n164:             Stmt::Function { local, body, .. } => {\n165:                 out.insert(*local);\n166:                 out.extend(function_decl_local_ids(body));\n167:             }\n168:             Stmt::Block { body } => out.extend(function_decl_local_ids(body)),\n169:             Stmt::If {\n170:                 consequent,\n171:                 alternate,\n172:                 ..\n173:             } => {\n174:                 out.extend(function_decl_local_ids_stmt(consequent));\n175:                 if let Some(a) = alternate {\n176:                     out.extend(function_decl_local_ids_stmt(a));\n177:                 }\n178:             }\n179:             Stmt::While { body, .. }\n180:             | Stmt::DoWhile { body, .. }\n181:             | Stmt::Labeled { body, .. } => {\n182:                 out.extend(function_decl_local_ids_stmt(body));\n183:             }\n184:             Stmt::For { init, body, .. } => {\n185:                 if let Some(i) = init {\n186:                     out.extend(function_decl_local_ids_stmt(i));\n187:                 }\n188:                 out.extend(function_decl_local_ids_stmt(body));\n189:             }\n190:             _ => {}\n191:         }\n192:     }\n193:     out\n194: }\n195: \n196: fn function_decl_local_ids_stmt(stmt: &Stmt) -> HashSet<LocalId> {\n197:     function_decl_local_ids(std::slice::from_ref(stmt))\n198: }\n199: \n200: fn collect_user_local_ids(body: &[Stmt], out: &mut HashSet<LocalId>) {\n201:     for stmt in body {\n202:         collect_user_local_ids_stmt(stmt, out);\n203:     }\n204: }\n205: \n206: fn collect_user_local_ids_stmt(stmt: &Stmt, out: &mut HashSet<LocalId>) {\n207:     match stmt {\n208:         Stmt::Declare { local, .. } => {\n209:             out.insert(*local);\n210:         }\n211:         Stmt::Function {\n212:             local,\n213:             params,\n214:             body,\n215:             ..\n216:         } => {\n217:             out.insert(*local);\n218:             for p in params {\n219:                 collect_pattern_locals(&p.pattern, out);\n220:             }\n221:             collect_user_local_ids(body, out);\n222:         }\n223:         Stmt::Block { body } => collect_user_local_ids(body, out),\n224:         Stmt::If {\n225:             consequent,\n226:             alternate,\n227:             ..\n228:         } => {\n229:             collect_user_local_ids_stmt(consequent, out);\n230:             if let Some(a) = alternate {\n231:                 collect_user_local_ids_stmt(a, out);\n232:             }\n233:         }\n234:         Stmt::While { body, .. } | Stmt::DoWhile { body, .. } | Stmt::Labeled { body, .. } => {\n235:             collect_user_local_ids_stmt(body, out);\n236:         }\n237:         Stmt::For {\n238:             init,\n239:             body,\n240:             ..\n241:         } => {\n242:             if let Some(i) = init {\n243:                 collect_user_local_ids_stmt(i, out);\n244:             }\n245:             collect_user_local_ids_stmt(body, out);\n246:         }\n247:         _ => {}\n248:     }\n249: }\n250: \n251: fn collect_pattern_locals(pat: &Pattern, out: &mut HashSet<LocalId>) {\n252:     match pat {\n253:         Pattern::Local(id) => {\n254:             out.insert(*id);\n255:         }\n256:         Pattern::Name(_) | Pattern::Member { .. } => {}\n257:         Pattern::Array(els) => {\n258:             for el in els {\n259:                 match el {\n260:                     draconic_ir::ArrayPatternEl::Elision => {}\n261:                     draconic_ir::ArrayPatternEl::Pattern { binding, .. } => {\n262:                         collect_pattern_locals(binding, out);\n263:                     }\n264:                     draconic_ir::ArrayPatternEl::Rest(binding) => {\n265:                         collect_pattern_locals(binding, out);\n266:                     }\n267:                 }\n268:             }\n269:         }\n270:         Pattern::Object(props) => {\n271:             for p in props {\n272:                 match p {\n273:                     draconic_ir::ObjectPatternEl::Prop { binding, .. } => {\n274:                         collect_pattern_locals(binding, out);\n275:                     }\n276:                     draconic_ir::ObjectPatternEl::Rest(binding) => {\n277:                         collect_pattern_locals(binding, out);\n278:                     }\n279:                 }\n280:             }\n281:         }\n282:     }\n283: }\n284: \n285: pub(crate) fn emit_native_ints(module: &Module) -> Result<String, Diagnostic> {\n286:     let mut em = Emitter::new(module);\n287:     em.emit_module()?;\n288:     Ok(em.finish())\n289: }\n290: \n291: struct Emitter<'a> {\n292:     module: &'a Module,\n293:     locals: HashMap<LocalId, &'a Local>,\n294:     /// Alloca pointer SSA name per local: `%l{id}`\n295:     allocas: HashMap<LocalId, String>,\n296:     /// Function IR local → LLVM function name\n297:     fn_names: HashMap<LocalId, String>,\n298:     /// Function param locals (no alloca; SSA param name)\n299:     params: HashMap<LocalId, (String, Scalar)>,\n300:     out: String,\n301:     body: String,\n302:     tmp: u32,\n303:     label: u32,\n304:     /// Top-level native scalar locals to print at end of main (declare order).\n305:     print_order: Vec<LocalId>,\n306: }\n307: \n308: impl<'a> Emitter<'a> {\n309:     fn new(module: &'a Module) -> Self {\n310:         let locals: HashMap<LocalId, &'a Local> =\n311:             module.locals.iter().map(|l| (l.id, l)).collect();\n312:         let mut fn_names = HashMap::new();\n313:         for stmt in &module.body {\n314:             if let Stmt::Function { local, .. } = stmt {\n315:                 let name = locals\n316:                     .get(local)\n317:                     .map(|l| l.name.as_str())\n318:                     .unwrap_or(\"fn\");\n319:                 let safe: String = name\n320:                     .chars()\n321:                     .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })\n322:                     .collect();\n323:                 fn_names.insert(*local, format!(\"d_{safe}_{}\", local.0));\n324:             }\n325:         }\n326:         Self {\n327:             module,\n328:             locals,\n329:             allocas: HashMap::new(),\n330:             fn_names,\n331:             params: HashMap::new(),\n332:             out: String::new(),\n333:             body: String::new(),\n334:             tmp: 0,\n335:             label: 0,\n336:             print_order: Vec::new(),\n337:         }\n338:     }\n339: \n340:     fn finish(self) -> String {\n341:         self.out\n342:     }\n343: \n344:     fn emit_module(&mut self) -> Result<(), Diagnostic> {\n345:         writeln!(\n346:             self.out,\n347:             \"; Draconic LLVM backend (N01–N03.03 native scalars/layouts/pointers)\"\n348:         )\n349:         .ok();\n350:         writeln!(self.out, \"{}\", llvm_declares(NATIVE_INT_DECLARES)).ok();\n351:         writeln!(self.out).ok();\n352: \n353:         // Emit nested function definitions first.\n354:         for stmt in &self.module.body {\n355:             if let Stmt::Function {\n356:                 local,\n357:                 params,\n358:                 body,\n359:                 is_async,\n360:                 is_generator,\n361:             } = stmt\n362:             {\n363:                 if *is_async || *is_generator {\n364:                     return Err(diag(\"native scalars: async/generator functions not supported\"));\n365:                 }\n366:                 self.emit_function(*local, params, body)?;\n367:             }\n368:         }\n369: \n370:         // main\n371:         self.body.clear();\n372:         self.tmp = 0;\n373:         self.label = 0;\n374:         self.params.clear();\n375:         self.allocas.clear();\n376:         self.print_order.clear();\n377: \n378:         writeln!(self.out, \"define i32 @main() {{\").ok();\n379:         writeln!(self.out, \"entry:\").ok();\n380: \n381:         // Pre-declare allocas for all non-function, non-param top-level locals.\n382:         for local in &self.module.locals {\n383:             if matches!(local.ty, Type::Function) {\n384:                 continue;\n385:             }\n386:             if let Some(sc) = scalar_of_type(local.ty) {\n387:                 let ptr = format!(\"%l{}\", local.id.0);\n388:                 self.allocas.insert(local.id, ptr.clone());\n389:                 writeln!(\n390:                     self.out,\n391:                     \"  {ptr} = alloca {}, align {}\",\n392:                     sc.llvm_ty(),\n393:                     sc.align()\n394:                 )\n395:                 .ok();\n396:             } else if matches!(local.ty, Type::Ptr(_)) {\n397:                 let ptr = format!(\"%l{}\", local.id.0);\n398:                 self.allocas.insert(local.id, ptr.clone());\n399:                 writeln!(self.out, \"  {ptr} = alloca ptr, align 8\").ok();\n400:             } else if let Some(shape) = native_layout_of(self.module, local.ty) {\n401:                 let ptr = format!(\"%l{}\", local.id.0);\n402:                 self.allocas.insert(local.id, ptr.clone());\n403:                 writeln!(\n404:                     self.out,\n405:                     \"  {ptr} = alloca {}, align {}\",\n406:                     llvm_layout_ty(shape),\n407:                     layout_align(shape)\n408:                 )\n409:                 .ok();\n410:             }\n411:         }\n412: \n413:         for stmt in &self.module.body {\n414:             if matches!(stmt, Stmt::Function { .. }) {\n415:                 continue;\n416:             }\n417:             self.emit_stmt(stmt)?;\n418:         }\n419: \n420:         // Print top-level native int declares in source order.\n421:         for id in self.print_order.clone() {\n422:             self.emit_print_local(id)?;\n423:         }\n424: \n425:         writeln!(self.out, \"{}\", self.body).ok();\n426:         writeln!(self.out, \"  ret i32 0\").ok();\n427:         writeln!(self.out, \"}}\").ok();\n428:         Ok(())\n429:     }\n430: \n431:     fn emit_function(\n432:         &mut self,\n433:         local: LocalId,\n434:         params: &[Param],\n435:         body: &[Stmt],\n436:     ) -> Result<(), Diagnostic> {\n437:         let fn_name = self\n438:             .fn_names\n439:             .get(&local)\n440:             .cloned()\n441:             .ok_or_else(|| diag(\"internal: missing function name\"))?;\n442: \n443:         let mut param_tys = Vec::new();\n444:         let mut param_ids = Vec::new();\n445:         for p in params {\n446:             if p.rest || p.default.is_some() {\n447:                 return Err(diag(\"native scalars: rest/default params not supported\"));\n448:             }\n449:             let Pattern::Local(id) = &p.pattern else {\n450:                 return Err(diag(\"native scalars: only simple ident params supported\"));\n451:             };\n452:             let ty = self.local_scalar(*id)?;\n453:             param_tys.push(ty);\n454:             param_ids.push(*id);\n455:         }\n456: \n457:         // Infer return type from first Return with a value, else i32.\n458:         let ret_ty = infer_return_scalar(body).unwrap_or(Scalar(NativeType::I32));\n459: \n460:         let mut sig = String::new();\n461:         write!(sig, \"define {} @{fn_name}(\", ret_ty.llvm_ty()).ok();\n462:         for (i, (id, ty)) in param_ids.iter().zip(param_tys.iter()).enumerate() {\n463:             if i > 0 {\n464:                 sig.push_str(\", \");\n465:             }\n466:             write!(sig, \"{} %p{}\", ty.llvm_ty(), id.0).ok();\n467:         }\n468:         sig.push(')');\n469: \n470:         // Save main state.\n471:         let saved_body = std::mem::take(&mut self.body);\n472:         let saved_tmp = self.tmp;\n473:         let saved_label = self.label;\n474:         let saved_params = std::mem::take(&mut self.params);\n475:         let saved_allocas = std::mem::take(&mut self.allocas);\n476:         let saved_print = std::mem::take(&mut self.print_order);\n477: \n478:         self.tmp = 0;\n479:         self.label = 0;\n480:         self.params.clear();\n481:         self.allocas.clear();\n482: \n483:         for (id, ty) in param_ids.iter().zip(param_tys.iter()) {\n484:             self.params.insert(*id, (format!(\"%p{}\", id.0), *ty));\n485:         }\n486: \n487:         // Allocas for locals declared inside the function (and copy params to allocas for mutability).\n488:         let mut pre = String::new();\n489:         for (id, ty) in param_ids.iter().zip(param_tys.iter()) {\n490:             let ptr = format!(\"%l{}\", id.0);\n491:             self.allocas.insert(*id, ptr.clone());\n492:             writeln!(\n493:                 pre,\n494:                 \"  {ptr} = alloca {}, align {}\",\n495:                 ty.llvm_ty(),\n496:                 ty.align()\n497:             )\n498:             .ok();\n499:             writeln!(\n500:                 pre,\n501:                 \"  store {} %p{}, ptr {ptr}\",\n502:                 ty.llvm_ty(),\n503:                 id.0\n504:             )\n505:             .ok();\n506:             // Params are also addressable via alloca now.\n507:             self.params.remove(id);\n508:         }\n509: \n510:         // Collect locals used in body that aren't params.\n511:         let mut body_locals = Vec::new();\n512:         collect_declared_locals(body, &mut body_locals);\n513:         for id in body_locals {\n514:             if self.allocas.contains_key(&id) {\n515:                 continue;\n516:             }\n517:             let ptr = format!(\"%l{}\", id.0);\n518:             self.allocas.insert(id, ptr.clone());\n519:             if let Ok(ty) = self.local_scalar(id) {\n520:                 writeln!(\n521:                     pre,\n522:                     \"  {ptr} = alloca {}, align {}\",\n523:                     ty.llvm_ty(),\n524:                     ty.align()\n525:                 )\n526:                 .ok();\n527:             } else if self\n528:                 .locals\n529:                 .get(&id)\n530:                 .is_some_and(|l| matches!(l.ty, Type::Ptr(_)))\n531:             {\n532:                 writeln!(pre, \"  {ptr} = alloca ptr, align 8\").ok();\n533:             } else if let Some(shape) = self.local_layout(id) {\n534:                 writeln!(\n535:                     pre,\n536:                     \"  {ptr} = alloca {}, align {}\",\n537:                     llvm_layout_ty(shape),\n538:                     layout_align(shape)\n539:                 )\n540:                 .ok();\n541:             } else {\n542:                 return Err(diag(\"native scalars: unsupported local type in function\"));\n543:             }\n544:         }\n545: \n546:         for stmt in body {\n547:             self.emit_stmt(stmt)?;\n548:         }\n549: \n550:         // Ensure terminator.\n551:         if !self.body_ends_with_terminator() {\n552:             writeln!(\n553:                 self.body,\n554:                 \"  ret {} {}\",\n555:                 ret_ty.llvm_ty(),\n556:                 ret_ty.zero_const()\n557:             )\n558:             .ok();\n559:         }\n560: \n561:         writeln!(self.out, \"{sig} {{\").ok();\n562:         writeln!(self.out, \"entry:\").ok();\n563:         write!(self.out, \"{pre}\").ok();\n564:         write!(self.out, \"{}\", self.body).ok();\n565:         writeln!(self.out, \"}}\").ok();\n566:         writeln!(self.out).ok();\n567: \n568:         self.body = saved_body;\n569:         self.tmp = saved_tmp;\n570:         self.label = saved_label;\n571:         self.params = saved_params;\n572:         self.allocas = saved_allocas;\n573:         self.print_order = saved_print;\n574:         Ok(())\n575:     }\n576: \n577:     fn body_ends_with_terminator(&self) -> bool {\n578:         for line in self.body.lines().rev() {\n579:             let t = line.trim();\n580:             if t.is_empty() {\n581:                 continue;\n582:             }\n583:             return t.starts_with(\"ret \") || t.starts_with(\"br \");\n584:         }\n585:         false\n586:     }\n587: \n588:     fn emit_stmt(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n589:         match stmt {\n590:             Stmt::Declare { local, init, .. } => {\n591:                 let ptr = self\n592:                     .allocas\n593:                     .get(local)\n594:                     .cloned()\n595:                     .ok_or_else(|| diag(\"internal: missing alloca for local\"))?;\n596:                 if let Ok(ty) = self.local_scalar(*local) {\n597:                     if let Some(init) = init {\n598:                         let v = self.emit_expr(init, Some(ty))?;\n599:                         writeln!(self.body, \"  store {} {v}, ptr {ptr}\", ty.llvm_ty()).ok();\n600:                     } else {\n601:                         writeln!(\n602:                             self.body,\n603:                             \"  store {} {}, ptr {ptr}\",\n604:                             ty.llvm_ty(),\n605:                             ty.zero_const()\n606:                         )\n607:                         .ok();\n608:                     }\n609:                 } else if self\n610:                     .locals\n611:                     .get(local)\n612:                     .is_some_and(|l| matches!(l.ty, Type::Ptr(_)))\n613:                 {\n614:                     if let Some(init) = init {\n615:                         let v = self.emit_ptr_expr(init)?;\n616:                         writeln!(self.body, \"  store ptr {v}, ptr {ptr}\").ok();\n617:                     } else {\n618:                         writeln!(self.body, \"  store ptr null, ptr {ptr}\").ok();\n619:                     }\n620:                     // Pointers are not printed at end of main.\n621:                     return Ok(());\n622:                 } else if let Some(shape) = self.local_layout(*local).cloned() {\n623:                     let layout_ty = llvm_layout_ty(&shape);\n624:                     let fields: Vec<Scalar> = shape\n625:                         .props\n626:                         .iter()\n627:                         .map(|(_, fty)| {\n628:                             let Type::Native(n) = *fty else {\n629:                                 return Err(diag(\"native layout: non-native field\"));\n630:                             };\n631:                             Ok(Scalar(n))\n632:                         })\n633:                         .collect::<Result<Vec<_>, _>>()?;\n634:                     if let Some(init) = init {\n635:                         self.emit_store_layout(&ptr, &shape, init)?;\n636:                     } else {\n637:                         // Zero-init each field.\n638:                         for (i, sc) in fields.iter().enumerate() {\n639:                             let gep = self.fresh_tmp();\n640:                             writeln!(\n641:                                 self.body,\n642:                                 \"  {gep} = getelementptr inbounds {layout_ty}, ptr {ptr}, i32 0, i32 {i}\"\n643:                             )\n644:                             .ok();\n645:                             writeln!(\n646:                                 self.body,\n647:                                 \"  store {} {}, ptr {gep}\",\n648:                                 sc.llvm_ty(),\n649:                                 sc.zero_const()\n650:                             )\n651:                             .ok();\n652:                         }\n653:                     }\n654:                 } else {\n655:                     return Err(diag(\n656:                         \"native scalars: declare needs scalar, layout, or pointer local\",\n657:                     ));\n658:                 }\n659:                 // Main tracks declares for end-of-program print; function emit uses a\n660:                 // saved empty print_order that is discarded.\n661:                 if !self.print_order.contains(local) {\n662:                     self.print_order.push(*local);\n663:                 }\n664:                 Ok(())\n665:             }\n666:             Stmt::Expr { expr } => {\n667:                 let _ = self.emit_expr(expr, None)?;\n668:                 Ok(())\n669:             }\n670:             Stmt::Block { body } => {\n671:                 for s in body {\n672:                     self.emit_stmt(s)?;\n673:                 }\n674:                 Ok(())\n675:             }\n676:             Stmt::Return { value } => {\n677:                 if let Some(v) = value {\n678:                     let sty = scalar_of_type(v.ty()).ok_or_else(|| {\n679:                         diag(\"native scalars: return value must be a native scalar\")\n680:                     })?;\n681:                     let val = self.emit_expr(v, Some(sty))?;\n682:                     writeln!(self.body, \"  ret {} {val}\", sty.llvm_ty()).ok();\n683:                 } else {\n684:                     writeln!(self.body, \"  ret i32 0\").ok();\n685:                 }\n686:                 // Unreachable padding label so subsequent code is valid if any.\n687:                 let lab = self.fresh_label(\"after_ret\");\n688:                 writeln!(self.body, \"{lab}:\").ok();\n689:                 Ok(())\n690:             }\n691:             Stmt::If {\n692:                 test,\n693:                 consequent,\n694:                 alternate,\n695:             } => {\n696:                 let cond = self.emit_bool(test)?;\n697:                 let then_l = self.fresh_label(\"then\");\n698:                 let else_l = self.fresh_label(\"else\");\n699:                 let end_l = self.fresh_label(\"endif\");\n700:                 if alternate.is_some() {\n701:                     writeln!(\n702:                         self.body,\n703:                         \"  br i1 {cond}, label %{then_l}, label %{else_l}\"\n704:                     )\n705:                     .ok();\n706:                 } else {\n707:                     writeln!(\n708:                         self.body,\n709:                         \"  br i1 {cond}, label %{then_l}, label %{end_l}\"\n710:                     )\n711:                     .ok();\n712:                 }\n713:                 writeln!(self.body, \"{then_l}:\").ok();\n714:                 self.emit_stmt(consequent)?;\n715:                 if !self.body_ends_with_terminator() {\n716:                     writeln!(self.body, \"  br label %{end_l}\").ok();\n717:                 }\n718:                 if let Some(alt) = alternate {\n719:                     writeln!(self.body, \"{else_l}:\").ok();\n720:                     self.emit_stmt(alt)?;\n721:                     if !self.body_ends_with_terminator() {\n722:                         writeln!(self.body, \"  br label %{end_l}\").ok();\n723:                     }\n724:                 }\n725:                 writeln!(self.body, \"{end_l}:\").ok();\n726:                 Ok(())\n727:             }\n728:             Stmt::While { test, body } => {\n729:                 let head = self.fresh_label(\"while_head\");\n730:                 let bod = self.fresh_label(\"while_body\");\n731:                 let end = self.fresh_label(\"while_end\");\n732:                 writeln!(self.body, \"  br label %{head}\").ok();\n733:                 writeln!(self.body, \"{head}:\").ok();\n734:                 let cond = self.emit_bool(test)?;\n735:                 writeln!(self.body, \"  br i1 {cond}, label %{bod}, label %{end}\").ok();\n736:                 writeln!(self.body, \"{bod}:\").ok();\n737:                 self.emit_stmt(body)?;\n738:                 if !self.body_ends_with_terminator() {\n739:                     writeln!(self.body, \"  br label %{head}\").ok();\n740:                 }\n741:                 writeln!(self.body, \"{end}:\").ok();\n742:                 Ok(())\n743:             }\n744:             Stmt::Function { .. } => Ok(()), // emitted separately\n745:             other => Err(diag(&format!(\n746:                 \"native scalars: unsupported statement {other:?}\"\n747:             ))),\n748:         }\n749:     }\n750: \n751:     fn emit_print_local(&mut self, id: LocalId) -> Result<(), Diagnostic> {\n752:         let ptr = self\n753:             .allocas\n754:             .get(&id)\n755:             .cloned()\n756:             .ok_or_else(|| diag(\"internal: print missing alloca\"))?;\n757:         if let Ok(ty) = self.local_scalar(id) {\n758:             let v = self.fresh_tmp();\n759:             writeln!(self.body, \"  {v} = load {}, ptr {ptr}\", ty.llvm_ty()).ok();\n760:             return self.emit_print_scalar_value(ty, &v);\n761:         }\n762:         if let Some(shape) = self.local_layout(id) {\n763:             let layout_ty = llvm_layout_ty(shape);\n764:             let fields: Vec<Scalar> = shape\n765:                 .props\n766:                 .iter()\n767:                 .map(|(_, fty)| {\n768:                     let Type::Native(n) = *fty else {\n769:                         return Err(diag(\"native layout: non-native field\"));\n770:                     };\n771:                     Ok(Scalar(n))\n772:                 })\n773:                 .collect::<Result<Vec<_>, _>>()?;\n774:             for (i, sc) in fields.iter().enumerate() {\n775:                 let gep = self.fresh_tmp();\n776:                 writeln!(\n777:                     self.body,\n778:                     \"  {gep} = getelementptr inbounds {layout_ty}, ptr {ptr}, i32 0, i32 {i}\"\n779:                 )\n780:                 .ok();\n781:                 let v = self.fresh_tmp();\n782:                 writeln!(self.body, \"  {v} = load {}, ptr {gep}\", sc.llvm_ty()).ok();\n783:                 self.emit_print_scalar_value(*sc, &v)?;\n784:             }\n785:             return Ok(());\n786:         }\n787:         Err(diag(\n788:             \"native scalars: print only supports native scalars/layouts\",\n789:         ))\n790:     }\n791: \n792:     fn emit_print_scalar_value(&mut self, ty: Scalar, v: &str) -> Result<(), Diagnostic> {\n793:         let n = ty.native();\n794:         if n.is_bool() {\n795:             let ext = self.fresh_tmp();\n796:             writeln!(self.body, \"  {ext} = zext i1 {v} to i8\").ok();\n797:             writeln!(self.body, \"  {}\", PRINT_BOOL.call(&format!(\"i8 {ext}\"))).ok();\n798:         } else if n.is_float() {\n799:             let d = if n == NativeType::F32 {\n800:                 let t = self.fresh_tmp();\n801:                 writeln!(self.body, \"  {t} = fpext float {v} to double\").ok();\n802:                 t\n803:             } else {\n804:                 v.to_string()\n805:             };\n806:             writeln!(self.body, \"  {}\", PRINT_F64.call(&format!(\"double {d}\"))).ok();\n807:         } else {\n808:             let ext = self.fresh_tmp();\n809:             if n.bit_width() < 64 {\n810:                 if n.is_signed() {\n811:                     writeln!(\n812:                         self.body,\n813:                         \"  {ext} = sext {} {v} to i64\",\n814:                         llvm_ty(n)\n815:                     )\n816:                     .ok();\n817:                 } else {\n818:                     writeln!(\n819:                         self.body,\n820:                         \"  {ext} = zext {} {v} to i64\",\n821:                         llvm_ty(n)\n822:                     )\n823:                     .ok();\n824:                 }\n825:             } else {\n826:                 writeln!(self.body, \"  {ext} = add i64 {v}, 0\").ok();\n827:             }\n828:             if n.is_signed() {\n829:                 writeln!(self.body, \"  {}\", PRINT_I64.call(&format!(\"i64 {ext}\"))).ok();\n830:             } else {\n831:                 writeln!(self.body, \"  {}\", PRINT_U64.call(&format!(\"i64 {ext}\"))).ok();\n832:             }\n833:         }\n834:         Ok(())\n835:     }\n836: \n837:     fn emit_bool(&mut self, expr: &Expr) -> Result<String, Diagnostic> {\n838:         match expr.ty() {\n839:             Type::Boolean | Type::Native(NativeType::Bool) => {\n840:                 self.emit_expr(expr, Some(Scalar(NativeType::Bool)))\n841:             }\n842:             Type::Native(n) if n.is_int() => {\n843:                 let v = self.emit_expr(expr, Some(Scalar(n)))?;\n844:                 let t = self.fresh_tmp();\n845:                 writeln!(\n846:                     self.body,\n847:                     \"  {t} = icmp ne {} {v}, 0\",\n848:                     llvm_ty(n)\n849:                 )\n850:                 .ok();\n851:                 Ok(t)\n852:             }\n853:             Type::Native(n) if n.is_float() => {\n854:                 let v = self.emit_expr(expr, Some(Scalar(n)))?;\n855:                 let t = self.fresh_tmp();\n856:                 writeln!(\n857:                     self.body,\n858:                     \"  {t} = fcmp one {} {v}, 0.000000e+00\",\n859:                     llvm_ty(n)\n860:                 )\n861:                 .ok();\n862:                 Ok(t)\n863:             }\n864:             _ => Err(diag(\n865:                 \"native scalars: condition must be bool or native numeric\",\n866:             )),\n867:         }\n868:     }\n869: \n870:     fn emit_expr(\n871:         &mut self,\n872:         expr: &Expr,\n873:         expect: Option<Scalar>,\n874:     ) -> Result<String, Diagnostic> {\n875:         match expr {\n876:             Expr::Local { id, ty } => {\n877:                 if let Some((pname, _)) = self.params.get(id) {\n878:                     return Ok(pname.clone());\n879:                 }\n880:                 if matches!(ty, Type::Ptr(_)) {\n881:                     return self.emit_ptr_expr(expr);\n882:                 }\n883:                 if let Some(ptr) = self.allocas.get(id).cloned() {\n884:                     let sty = scalar_of_type(*ty).unwrap_or(self.local_scalar(*id)?);\n885:                     let t = self.fresh_tmp();\n886:                     writeln!(self.body, \"  {t} = load {}, ptr {ptr}\", sty.llvm_ty()).ok();\n887:                     return Ok(t);\n888:                 }\n889:                 // Function reference used as value — not supported except as callee.\n890:                 Err(diag(\"native scalars: bare function value not supported\"))\n891:             }\n892:             Expr::Boolean { value, .. } => Ok(if *value { \"1\".into() } else { \"0\".into() }),\n893:             Expr::Number { raw, ty } => {\n894:                 let sty = match (ty, expect) {\n895:                     (Type::Native(n), _) if !n.is_bool() => Scalar(*n),\n896:                     (_, Some(s)) if !s.is_bool() => s,\n897:                     _ => {\n898:                         return Err(diag(\n899:                             \"native scalars: number literal needs native numeric context\",\n900:                         ))\n901:                     }\n902:                 };\n903:                 let nty = sty.native();\n904:                 if nty.is_float() {\n905:                     Ok(format_float_const(raw, nty)?)\n906:                 } else {\n907:                     Ok(format_int_const(raw, nty)?)\n908:                 }\n909:             }\n910:             Expr::Unary { op, arg, ty } => {\n911:                 if matches!(op, UnaryOp::Not) {\n912:                     let a = self.emit_bool(arg)?;\n913:                     let t = self.fresh_tmp();\n914:                     writeln!(self.body, \"  {t} = xor i1 {a}, true\").ok();\n915:                     return Ok(t);\n916:                 }\n917:                 // N03.03: `&x` → pointer value (address of local).\n918:                 if matches!(op, UnaryOp::Ref) {\n919:                     return self.emit_ptr_expr(expr);\n920:                 }\n921:                 // N03.03: `*p` → load pointee scalar.\n922:                 if matches!(op, UnaryOp::Deref) {\n923:                     let ptr_v = self.emit_ptr_expr(arg)?;\n924:                     let sty = match ty {\n925:                         Type::Native(n) => Scalar(*n),\n926:                         Type::Boolean => Scalar(NativeType::Bool),\n927:                         _ => {\n928:                             return Err(diag(\n929:                                 \"native pointers: dereference result must be native scalar\",\n930:                             ))\n931:                         }\n932:                     };\n933:                     let t = self.fresh_tmp();\n934:                     writeln!(self.body, \"  {t} = load {}, ptr {ptr_v}\", sty.llvm_ty()).ok();\n935:                     return Ok(t);\n936:                 }\n937:                 let nty = match ty {\n938:                     Type::Native(n) if !n.is_bool() => *n,\n939:                     _ => {\n940:                         return Err(diag(\"native scalars: unary result must be native numeric\"))\n941:                     }\n942:                 };\n943:                 let a = self.emit_expr(arg, Some(Scalar(nty)))?;\n944:                 let t = self.fresh_tmp();\n945:                 match op {\n946:                     UnaryOp::Minus if nty.is_float() => {\n947:                         writeln!(\n948:                             self.body,\n949:                             \"  {t} = fneg {} {a}\",\n950:                             llvm_ty(nty)\n951:                         )\n952:                         .ok();\n953:                     }\n954:                     UnaryOp::Minus => {\n955:                         writeln!(\n956:                             self.body,\n957:                             \"  {t} = sub {} 0, {a}\",\n958:                             llvm_ty(nty)\n959:                         )\n960:                         .ok();\n961:                     }\n962:                     UnaryOp::BitNot if nty.is_int() => {\n963:                         writeln!(\n964:                             self.body,\n965:                             \"  {t} = xor {} {a}, -1\",\n966:                             llvm_ty(nty)\n967:                         )\n968:                         .ok();\n969:                     }\n970:                     UnaryOp::Plus if nty.is_float() => {\n971:                         writeln!(\n972:                             self.body,\n973:                             \"  {t} = fadd {} {a}, 0.000000e+00\",\n974:                             llvm_ty(nty)\n975:                         )\n976:                         .ok();\n977:                     }\n978:                     UnaryOp::Plus => {\n979:                         writeln!(self.body, \"  {t} = add {} {a}, 0\", llvm_ty(nty)).ok();\n980:                     }\n981:                     _ => {\n982:                         return Err(diag(&format!(\n983:                             \"native scalars: unsupported unary {op}\"\n984:                         )))\n985:                     }\n986:                 }\n987:                 Ok(t)\n988:             }\n989:             Expr::Binary {\n990:                 left,\n991:                 op,\n992:                 right,\n993:                 ty,\n994:             } => self.emit_binary(left, *op, right, ty, expect),\n995:             Expr::Assign {\n996:                 target,\n997:                 op,\n998:                 value,\n999:                 ty,\n1000:             } => self.emit_assign(target, *op, value, ty),\n1001:             Expr::Update {\n1002:                 op,\n1003:                 target,\n1004:                 prefix,\n1005:                 ty,\n1006:             } => self.emit_update(*op, target, *prefix, ty),\n1007:             Expr::Call {\n1008:                 callee,\n1009:                 args,\n1010:                 optional,\n1011:                 ty,\n1012:             } => {\n1013:                 if *optional {\n1014:                     return Err(diag(\"native scalars: optional call not supported\"));\n1015:                 }\n1016:                 let Expr::Local { id, .. } = callee.as_ref() else {\n1017:                     return Err(diag(\"native scalars: only direct function calls supported\"));\n1018:                 };\n1019:                 let fn_name = self\n1020:                     .fn_names\n1021:                     .get(id)\n1022:                     .cloned()\n1023:                     .ok_or_else(|| diag(\"native scalars: call to unknown function\"))?;\n1024:                 // Checker currently types non-generic calls as `Any`; prefer the\n1025:                 // expression type, then expected context, then inferred signature.\n1026:                 let ret_ty = match scalar_of_type(*ty) {\n1027:                     Some(s) => s,\n1028:                     None => match expect {\n1029:                         Some(n) => n,\n1030:                         None => self.function_sig(*id)?.1,\n1031:                     },\n1032:                 };\n1033:                 let (param_tys, _) = self.function_sig(*id)?;\n1034:                 if param_tys.len() != args.len() {\n1035:                     return Err(diag(\"native scalars: arity mismatch\"));\n1036:                 }\n1037:                 let mut arg_parts = Vec::new();\n1038:                 for (arg, pty) in args.iter().zip(param_tys.iter()) {\n1039:                     let Arg::Expr(e) = arg else {\n1040:                         return Err(diag(\"native scalars: spread args not supported\"));\n1041:                     };\n1042:                     let v = self.emit_expr(e, Some(*pty))?;\n1043:                     arg_parts.push(format!(\"{} {v}\", pty.llvm_ty()));\n1044:                 }\n1045:                 let t = self.fresh_tmp();\n1046:                 write!(\n1047:                     self.body,\n1048:                     \"  {t} = call {} @{fn_name}(\",\n1049:                     ret_ty.llvm_ty()\n1050:                 )\n1051:                 .ok();\n1052:                 for (i, p) in arg_parts.iter().enumerate() {\n1053:                     if i > 0 {\n1054:                         self.body.push_str(\", \");\n1055:                     }\n1056:                     self.body.push_str(p);\n1057:                 }\n1058:                 writeln!(self.body, \")\").ok();\n1059:                 Ok(t)\n1060:             }\n1061:             Expr::Conditional {\n1062:                 test,\n1063:                 consequent,\n1064:                 alternate,\n1065:                 ty,\n1066:             } => {\n1067:                 let sty = match scalar_of_type(*ty) {\n1068:                     Some(s) => s,\n1069:                     None => expect.ok_or_else(|| {\n1070:                         diag(\"native scalars: conditional needs native scalar type\")\n1071:                     })?,\n1072:                 };\n1073:                 let cond = self.emit_bool(test)?;\n1074:                 let then_l = self.fresh_label(\"sel_then\");\n1075:                 let else_l = self.fresh_label(\"sel_else\");\n1076:                 let end_l = self.fresh_label(\"sel_end\");\n1077:                 let slot = self.fresh_tmp();\n1078:                 writeln!(\n1079:                     self.body,\n1080:                     \"  {slot} = alloca {}, align {}\",\n1081:                     sty.llvm_ty(),\n1082:                     sty.align()\n1083:                 )\n1084:                 .ok();\n1085:                 writeln!(\n1086:                     self.body,\n1087:                     \"  br i1 {cond}, label %{then_l}, label %{else_l}\"\n1088:                 )\n1089:                 .ok();\n1090:                 writeln!(self.body, \"{then_l}:\").ok();\n1091:                 let c = self.emit_expr(consequent, Some(sty))?;\n1092:                 writeln!(self.body, \"  store {} {c}, ptr {slot}\", sty.llvm_ty()).ok();\n1093:                 writeln!(self.body, \"  br label %{end_l}\").ok();\n1094:                 writeln!(self.body, \"{else_l}:\").ok();\n1095:                 let a = self.emit_expr(alternate, Some(sty))?;\n1096:                 writeln!(self.body, \"  store {} {a}, ptr {slot}\", sty.llvm_ty()).ok();\n1097:                 writeln!(self.body, \"  br label %{end_l}\").ok();\n1098:                 writeln!(self.body, \"{end_l}:\").ok();\n1099:                 let t = self.fresh_tmp();\n1100:                 writeln!(self.body, \"  {t} = load {}, ptr {slot}\", sty.llvm_ty()).ok();\n1101:                 Ok(t)\n1102:             }\n1103:             Expr::Member {\n1104:                 object,\n1105:                 property,\n1106:                 computed,\n1107:                 optional,\n1108:                 ty,\n1109:             } => {\n1110:                 if *optional {\n1111:                     return Err(diag(\"native layout: optional member not supported\"));\n1112:                 }\n1113:                 let key = if *computed {\n1114:                     // Fixed-array index: `a[0]` with constant non-neg integer (N03.02).\n1115:                     const_index_key(property).ok_or_else(|| {\n1116:                         diag(\"native layout: computed member needs constant integer index\")\n1117:                     })?\n1118:                 } else {\n1119:                     match property.as_ref() {\n1120:                         Expr::String { value, .. } => value.to_string_lossy(),\n1121:                         _ => {\n1122:                             return Err(diag(\n1123:                                 \"native layout: member property must be a static string key\",\n1124:                             ))\n1125:                         }\n1126:                     }\n1127:                 };\n1128:                 let (obj_ptr, layout_ty, idx, sc) = {\n1129:                     let (obj_ptr, shape) = self.emit_layout_base(object)?;\n1130:                     let idx = shape\n1131:                         .props\n1132:                         .iter()\n1133:                         .position(|(n, _)| n == &key)\n1134:                         .ok_or_else(|| diag(&format!(\"native layout: unknown field `{key}`\")))?;\n1135:                     let field_ty = shape.props[idx].1;\n1136:                     let sc = scalar_of_type(field_ty)\n1137:                         .or_else(|| scalar_of_type(*ty))\n1138:                         .ok_or_else(|| diag(\"native layout: field must be native scalar\"))?;\n1139:                     (obj_ptr, llvm_layout_ty(shape), idx, sc)\n1140:                 };\n1141:                 let gep = self.fresh_tmp();\n1142:                 writeln!(\n1143:                     self.body,\n1144:                     \"  {gep} = getelementptr inbounds {layout_ty}, ptr {obj_ptr}, i32 0, i32 {idx}\"\n1145:                 )\n1146:                 .ok();\n1147:                 let t = self.fresh_tmp();\n1148:                 writeln!(self.body, \"  {t} = load {}, ptr {gep}\", sc.llvm_ty()).ok();\n1149:                 Ok(t)\n1150:             }\n1151:             Expr::Object { .. } => Err(diag(\n1152:                 \"native layout: object literal only supported as layout init\",\n1153:             )),\n1154:             Expr::Array { .. } => Err(diag(\n1155:                 \"native layout: array literal only supported as layout init\",\n1156:             )),\n1157:             _ => Err(diag(&format!(\n1158:                 \"native scalars: unsupported expression {expr:?}\"\n1159:             ))),\n1160:         }\n1161:     }\n1162: \n1163:     /// Pointer to a layout local + its shape (for field GEP).\n1164:     fn emit_layout_base<'b>(\n1165:         &'b self,\n1166:         expr: &'b Expr,\n1167:     ) -> Result<(String, &'b ObjectShape), Diagnostic> {\n1168:         match expr {\n1169:             Expr::Local { id, ty } => {\n1170:                 let shape = native_layout_of(self.module, *ty)\n1171:                     .or_else(|| self.local_layout(*id))\n1172:                     .ok_or_else(|| diag(\"native layout: member base is not a layout local\"))?;\n1173:                 let ptr = self\n1174:                     .allocas\n1175:                     .get(id)\n1176:                     .cloned()\n1177:                     .ok_or_else(|| diag(\"internal: layout local missing alloca\"))?;\n1178:                 Ok((ptr, shape))\n1179:             }\n1180:             _ => Err(diag(\n1181:                 \"native layout: only direct local field access supported\",\n1182:             )),\n1183:         }\n1184:     }\n1185: \n1186:     fn emit_store_layout(\n1187:         &mut self,\n1188:         dest_ptr: &str,\n1189:         shape: &ObjectShape,\n1190:         init: &Expr,\n1191:     ) -> Result<(), Diagnostic> {\n1192:         let layout_ty = llvm_layout_ty(shape);\n1193:         let field_meta: Vec<(String, Scalar)> = shape\n1194:             .props\n1195:             .iter()\n1196:             .map(|(name, fty)| {\n1197:                 let Type::Native(n) = *fty else {\n1198:                     return Err(diag(\"native layout: non-native field\"));\n1199:                 };\n1200:                 Ok((name.clone(), Scalar(n)))\n1201:             })\n1202:             .collect::<Result<Vec<_>, _>>()?;\n1203:         match init {\n1204:             Expr::Object { properties, .. } => {\n1205:                 let mut by_name: HashMap<String, &Expr> = HashMap::new();\n1206:                 for prop in properties {\n1207:                     match prop {\n1208:                         ObjectProp::Property {\n1209:                             key: ObjectPropKey::Static(k),\n1210:                             value,\n1211:                         } => {\n1212:                             by_name.insert(k.to_string_lossy(), value);\n1213:                         }\n1214:                         _ => {\n1215:                             return Err(diag(\n12