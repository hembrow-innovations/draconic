yOp::Mul => \"fmul\",\n288:                             BinaryOp::Div => \"fdiv\",\n289:                             BinaryOp::Rem => \"frem\",\n290:                             _ => unreachable!(),\n291:                         };\n292:                         let t = self.fresh();\n293:                         writeln!(self.body, \"  {t} = {inst} double {l}, {r}\").ok();\n294:                         Ok(t)\n295:                     }\n296:                     // Value-preserving JS && / || on numbers (ToBoolean via nonzero).\n297:                     BinaryOp::And | BinaryOp::Or => {\n298:                         let truthy = self.fresh();\n299:                         // +0/-0/NaN are falsy; `one` is ordered-and-unequal.\n300:                         writeln!(self.body, \"  {truthy} = fcmp one double {l}, 0.00000000000000000e+00\")\n301:                             .ok();\n302:                         let t = self.fresh();\n303:                         match op {\n304:                             BinaryOp::And => {\n305:                                 writeln!(\n306:                                     self.body,\n307:                                     \"  {t} = select i1 {truthy}, double {r}, double {l}\"\n308:                                 )\n309:                                 .ok();\n310:                             }\n311:                             BinaryOp::Or => {\n312:                                 writeln!(\n313:                                     self.body,\n314:                                     \"  {t} = select i1 {truthy}, double {l}, double {r}\"\n315:                                 )\n316:                                 .ok();\n317:                             }\n318:                             _ => unreachable!(),\n319:                         }\n320:                         Ok(t)\n321:                     }\n322:                     _ => Err(diag(\"internal: non-arithmetic binary in number emit\")),\n323:                 }\n324:  