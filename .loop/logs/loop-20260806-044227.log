  | Stmt::Return { value: Some(e) } => expr_has_direct_eval(e, eval_id),\n46:             Stmt::Function { body, .. } | Stmt::Block { body } => {\n47:                 body.iter().any(|s| walk(s, eval_id))\n48:             }\n49:             _ => false,\n50:         }\n51:     }\n52:     fn expr_has_direct_eval(e: &Expr, eval_id: Option<LocalId>) -> bool {\n53:         match e {\n54:             Expr::Call { callee, .. } => {\n55:                 if let Expr::Local { id, .. } = callee.as_ref() {\n56:                     if Some(*id) == eval_id {\n57:                         return true;\n58:                     }\n59:                 }\n60:                 false\n61:             }\n62:             Expr::Unary { arg, .. } => expr_has_direct_eval(arg, eval_id),\n63:             Expr::Binary { left, right, .. } => {\n64:                 expr_has_direct_eval(left, eval_id) || expr_has_direct_eval(right, eval_id)\n65:             }\n66:             _ => false,\n67:         }\n68:     }\n69:     module.body.iter().any(|s| walk(s, eval_id))\n70: }\n71: \n72: fn module_has_function_ctor(module: &Module) -> bool {\n73:     let function_id = module\n74:         .locals\n75:         .iter()\n76:         .find(|l| l.name == \"Function\")\n77:         .map(|l| l.id);\n78:     fn walk(stmt: &Stmt, function_id: Option<LocalId>) -> bool {\n79:         match stmt {\n80:             Stmt::Declare { init: Some(e), .. } | Stmt::Expr { expr: e } => {\n81:                 expr_has_fn_ctor(e, function_id)\n82:             }\n83:             Stmt::Block { body } | Stmt::Function { body, .. } => {\n84:                 body.iter().any(|s| walk(s, function_id))\n85:             }\n86:             _ => false,\n87:         }\n88:     }\n89:     fn expr_has_fn_ctor(e: &Expr, function_id: Option<LocalId>) -> bool {\n90:         match e {\n91:             Expr::New { callee, .. } | Expr::Call { callee, .. } => {\n92:                 matches!(callee.as_ref(), Expr::Local { id, .. } if Some(*id) == function_id)\n93:             }\n94:             _ => false,\n95:         }\n96:     }\n97:     module.body.iter().any(|s| walk(s, function_id))\n98: }\n99: \n100: fn module_has_indirect(module: &Module) -> bool {\n101:     fn walk(stmt: &Stmt) -> bool {\n102:         match stmt {\n103:             Stmt::Declare { init: Some(e), .. }\n104:             | Stmt::Expr { expr: e }\n105:             | Stmt::Return { value: Some(e) } => expr_indirect(e),\n106:             Stmt::Function { body, .. } | Stmt::Block { body } => body.iter().any(walk),\n107:             _ => false,\n108:         }\n109:     }\n110:     fn expr_indirect(e: &Expr) -> bool {\n111:         match e {\n112:             Expr::Call { callee, .. } => match callee.as_ref() {\n113:                 Expr::Binary {\n114:                     op: BinaryOp::Comma,\n115:                     ..\n116:                 } => true,\n117:                 Expr::Member {\n118:                     object,\n119:                     property,\n120:                     computed,\n121:                     optional,\n122:                     ..\n123:                 } if !*computed && !*optional => {\n124:                     if let (Expr::Local { .. }, Expr::String { value, .. }) =\n125:                         (object.as_ref(), property.as_ref())\n126:                     {\n127:                         value.to_string_lossy() == \"eval\"\n128:                     } else {\n129:                         false\n130:                     }\n131:                 }\n132:                 _ => false,\n133:             },\n134:             Expr::Unary { arg, .. } => expr_indirect(arg),\n135:             Expr::Binary { left, right, .. } => expr_indirect(left) || expr_indirect(right),\n136:             _ => false,\n137:         }\n138:     }\n139:     module.body.iter().any(walk)\n140: }\n141: \n142: fn emit_observations(obs: &[Observation], tag: &str) -> Result<String, Diagnostic> {\n143:     let mut out = String::new();\n144:     let mut body = String::new();\n145:     let mut str_globals: HashMap<String, String> = HashMap::new();\n146:     let mut tmp = 0u32;\n147: \n148:     writeln!(out, \"; Draconic LLVM backend ({tag})\").ok();\n149:     writeln!(out, \"{}\", llvm_declares(ES_EVAL_DECLARES)).ok();\n150:     writeln!(out).ok();\n151: \n152:     for o in obs {\n153:         match o {\n154:             Observation::Number(n) => {\n155:                 if n.fract() != 0.0 || !n.is_finite() || n.abs() >= (i64::MAX as f64) {\n156:                     return Err(diag(format!(\"number not representable as i64: {n}\")));\n157:                 }\n158:                 let v = *n as i64;\n159:                 writeln!(body, \"  {}\", PRINT_I64.call(&format!(\"i64 {v}\"))).ok();\n160:             }\n161:             Observation::Bool(b) => {\n162:                 let v = if *b { 1 } else { 0 };\n163:                 writeln!(body, \"  {}\", PRINT_BOOL.call(&format!(\"i8 {v}\"))).ok();\n164:             }\n165:             Observation::String(s) => {\n166:                 emit_print_str(&mut body, &mut str_globals, &mut tmp, s);\n167:             }\n168:             Observation::Function => {\n169:                 emit_print_str(&mut body, &mut str_globals, &mut tmp, \"function\");\n170:             }\n171:         }\n172:     }\n173: \n174:     for (content, gname) in &str_globals {\n175:         let n = content.len() + 1;\n176:         let esc = escape_llvm_string(content);\n177:         writeln!(\n178:             out,\n179:             \"@{gname} = private unnamed_addr constant [{n} x i8] c\\\"{esc}\\\\00\\\", align 1\"\n180:         )\n181:         .ok();\n182:     }\n183:     if !str_globals.is_empty() {\n184:         writeln!(out).ok();\n185:     }\n186: \n187:     writeln!(out, \"define i32 @main() {{\").ok();\n188:     writeln!(out, \"entry:\").ok();\n189:     writeln!(out, \"  {}\", GC_INIT.call(\"\")).ok();\n190:     out.push_str(&body);\n191:     writeln!(out, \"  ret i32 0\").ok();\n192:    