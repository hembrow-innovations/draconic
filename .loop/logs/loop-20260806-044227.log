rmat!(\"internal: unallocated local %{}\", id.0)))?;\n362:                 if slot != SlotTy::Boolean {\n363:                     return Err(diag(\"internal: expected boolean local\"));\n364:                 }\n365:                 let t = self.fresh();\n366:                 writeln!(self.body, \"  {t} = load i1, ptr {ptr}\").ok();\n367:                 Ok(t)\n368:             }\n369:             Expr::Unary { op, arg, .. } => match op {\n370:                 UnaryOp::Not => {\n371:                     let a = self.emit_bool_expr(arg)?;\n372:                     let t = self.fresh();\n373:                     writeln!(self.body, \"  {t} = xor i1 {a}, true\").ok();\n374:                     Ok(t)\n375:                 }\n376:                 _ => Err(diag(\"internal: non-logical unary in bool emit\")),\n377:             },\n378:             Expr::Binary {\n379:                 left, op, right, ..\n380:             } => match op {\n381:                 BinaryOp::Lt\n382:                 | BinaryOp::LtEq\n383:                 | BinaryOp::Gt\n384:                 | BinaryOp::GtEq\n385:                 | BinaryOp::EqEq\n386:                 | BinaryOp::NotEq\n387:                 | BinaryOp::EqEqEq\n388:                 | BinaryOp::NotEqEq\n389:                     if expr_ty_is_number(left) =>\n390:                 {\n391:                     let l = self.emit_number_expr(left)?;\n392:                     let r = self.emit_number_expr(right)?;\n393:                     let pred = match op {\n394:                         BinaryOp::EqEq | BinaryOp::EqEqEq => \"oeq\",\n395:                         BinaryOp::NotEq | BinaryOp::NotEqEq => \"one\",\n396:                         BinaryOp::Lt => \"olt\",\n397:                         BinaryOp::LtEq => \"ole\",\n398:                         BinaryOp::Gt => \"ogt\",\n399:                         BinaryOp::GtEq => \"oge\",\n400:                         _ => unreachable!(),\n401:                     };\n402:                     let 