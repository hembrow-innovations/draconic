n1196:         // FunctionBody uses TopLevelLexicallyDeclaredNames (not hoistable functions).\n1197:         let lexical = collect_lexically_declared_names(stmts.iter(), true);\n1198:         for (name, span, _) in lexical {\n1199:             if param_names.contains(&name) {\n1200:                 return Err(Diagnostic::new(\n1201:                     format!(\"duplicate declaration of `{name}`\"),\n1202:                     span,\n1203:                 ));\n1204:             }\n1205:         }\n1206:         Ok(())\n1207:     }\n1208: \n1209:     /// Hoistable declarations for one statement-list item (Annex B.3.2 peels labels).\n1210:     fn declare_list_item(&mut self, stmt: &Stmt) -> Result<(), Diagnostic> {\n1211:         match stmt {\n1212:             Stmt::Let {\n1213:                 kind: BindingKind::Var,\n1214:                 binding,\n1215:                 ..\n1216:             } => self.declare_var_binding(binding),\n1217:             Stmt::Let { kind, binding, .. } => self.declare_binding(binding, *kind),\n1218:             Stmt::ClassDeclaration { name, .. } => {\n1219:                 self.declare(name.name.clone(), name.span, BindingKind::Function)?;\n1220:                 Ok(())\n1221:             }\n1222:             Stmt::FunctionDeclaration {\n1223:                 name,\n1224:                 is_async,\n1225:                 is_generator,\n1226:                 ..\n1227:             } => {\n1228:                 // Annex B.3.2: outer var-like binding already hosts this name — do not\n1229:                 // shadow with a block-local binding (IR + uses share the outer symbol).\n1230:                 if let Some(existing) = self.resolve_name(&name.name) {\n1231:                     let in_current = self\n1232:                         .scopes\n1233:                         .last()\n1234:                         .is_some_and(|s| s.contains_key(&name.name));\n1235:                     if !in_current\n1236:                         && matches!(\n12