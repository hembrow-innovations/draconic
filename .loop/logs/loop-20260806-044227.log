{needle:?}\\ngot: {msg}\",\n434:                 target.as_str()\n435:             ));\n436:         }\n437:     };\n438:     let err = match target {\n439:         Target::Js => emit_js(&module).err().map(|d| format!(\"emit_js: {d}\")),\n440:         Target::Native => emit_llvm_ir(&module)\n441:             .err()\n442:             .map(|d| format!(\"emit_llvm_ir: {d}\")),\n443:     };\n444:     match err {\n445:         Some(msg) if msg.contains(needle) => Ok(()),\n446:         Some(msg) => Err(format!(\n447:             \"{} emit error did not contain {needle:?}\\ngot: {msg}\",\n448:             target.as_str()\n449:         )),\n450:         None => Err(format!(\n451:             \"{} expected emit/compile error containing {needle:?}, but succeeded\",\n452:             target.as_str()\n453:         )),\n454:     }\n455: }\n456: \n457: fn temp_bin_path(id: &str) -> PathBuf {\n458:     static N: AtomicU64 = AtomicU64::new(0);\n459:     let safe: String = id\n460:         .chars()\n461:         .map(|c| if c.is_ascii_alphanumeric() { c } else { '_' })\n462:         .collect();\n463:     let mut dir = std::env::temp_dir();\n464:     dir.push(format!(\n465:         \"draconic-conformance-{}-{}-{}-{}\",\n466:         std::process::id(),\n467:         SystemTime::now()\n468:             .duration_since(UNIX_EPOCH)\n469:             .unwrap()\n470:             .as_nanos(),\n471:         N.fetch_add(1, Ordering::Relaxed),\n472:         safe\n473:     ));\n474:     let _ = fs::create_dir_all(&dir);\n475:     dir.join(\"prog\")\n476: }\n477: \n478: #[cfg(test)]\n479: mod tests {\n480:     use super::*;\n481: \n482:     #[test]\n483:     fn parse_meta_smoke() {\n484:         let meta = parse_meta(\n485:             \"\\\n486: id: smoke/let-add\n487: targets: js\n488: js.exit: 0\n489: js.check: if (x !== 3) process.exit(1);\n490: \",\n491:         )\n492:         .unwrap();\n493:         assert_eq!(meta.id.as_deref(), Some(\"smoke/let-add\"));\n494:         assert_eq!(meta.t