&mut self, user: &[LocalId]) -> Result<(), Diagnostic> {\n113:         writeln!(\n114:             self.out,\n115:             \"; Draconic LLVM backend (N08.01.01 numeric arithmetic via Runtime ABI)\"\n116:         )\n117:         .ok();\n118:         writeln!(self.out, \"{}\", llvm_declares(ES_EXPR_DECLARES)).ok();\n119:         writeln!(self.out).ok();\n120: \n121:         for id in user {\n122:             let ptr = format!(\"%l{}\", id.0);\n123:             self.allocas.insert(*id, ptr.clone());\n124:             writeln!(self.body, \"  {ptr} = alloca double, align 8\").ok();\n125:         }\n126: \n127:         for stmt in &self.module.body {\n128:             let Stmt::Declare { local, init, .. } = stmt else {\n129:                 return Err(diag(\"internal: non-declare in es_expr module\"));\n130:             };\n131:             let Some(init) = init else {\n132:                 return Err(diag(\"internal: declare without init in es_expr module\"));\n133:             };\n134:             let ptr = self\n135:                 .allocas\n136:                 .get(local)\n137:                 .cloned()\n138:                 .ok_or_else(|| diag(\"internal: missing alloca\"))?;\n139:             let v = self.emit_expr(init)?;\n140:             writeln!(self.body, \"  store double {v}, ptr {ptr}\").ok();\n141:         }\n142: \n143:         // Print top-level user number locals in declaration order.\n144:         for id in user {\n145:             let ptr = self\n146:                 .allocas\n147:                 .get(id)\n148:                 .cloned()\n149:                 .ok_or_else(|| diag(\"internal: print missing alloca\"))?;\n150:             let v = self.fresh();\n151:             writeln!(self.body, \"  {v} = load double, ptr {ptr}\").ok();\n152:             writeln!(self.body, \"  {}\", PRINT_F64.call(&format!(\"double {v}\"))).ok();\n153:         }\n154: \n155:         writeln!(self.out, \"define i32 @main() {{\").ok();\n156:         writeln!(self.out