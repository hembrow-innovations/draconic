\n51: #[test]\n52: fn let_annotation_sets_binding_type() {\n53:     let program = parse(\"let x: number = 1;\").unwrap();\n54:     let checked = check(program).unwrap();\n55:     assert_eq!(type_of(&checked, \"x\"), Type::Number);\n56: }\n57: \n58: #[test]\n59: fn let_annotation_rejects_mismatched_init() {\n60:     let program = parse(\"let x: number = \\\"no\\\";\").unwrap();\n61:     let err = check(program).unwrap_err();\n62:     assert!(\n63:         err.message.contains(\"not assignable\")\n64:             && err.message.contains(\"string\")\n65:             && err.message.contains(\"number\"),\n66:         \"unexpected: {}\",\n67:         err.message\n68:     );\n69: }\n70: \n71: #[test]\n72: fn let_annotation_rejects_mismatched_assign() {\n73:     let program = parse(\"let x: number = 1; x = \\\"no\\\";\").unwrap();\n74:     let err = check(program).unwrap_err();\n75:     assert!(\n76:         err.message.contains(\"string\") && err.message.contains(\"number\"),\n77:         \"unexpected: {}\",\n78:         err.message\n79:     );\n80: }\n81: \n82: #[test]\n83: fn const_annotation_ok() {\n84:     let program = parse(\"const s: string = \\\"ok\\\";\").unwrap();\n85:     let checked = check(program).unwrap();\n86:     assert_eq!(type_of(&checked, \"s\"), Type::String);\n87: }\n88: \n89: #[test]\n90: fn param_annotation_sets_param_type() {\n91:     let program = parse(\"function f(a: number) { let b: number = a; }\").unwrap();\n92:     let checked = check(program).unwrap();\n93:     assert_eq!(type_of(&checked, \"a\"), Type::Number);\n94:     assert_eq!(type_of(&checked, \"b\"), Type::Number);\n95: }\n96: \n97: #[test]\n98: fn param_default_must_match_annotation() {\n99:     let program = parse(\"function f(a: number = \\\"x\\\") { return a; }\").unwrap();\n100:     let err = check(program).unwrap_err();\n101:     assert!(\n102:         err.message.contains(\"not assignable\"),\n103:         \"unexpected: {}\",\n104:         err.message\n105:     );\n106: }\n107