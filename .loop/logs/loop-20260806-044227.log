iag(\"internal: non-arithmetic binary in es_expr module\")),\n200:                 };\n201:                 let t = self.fresh();\n202:                 writeln!(self.body, \"  {t} = {inst} double {l}, {r}\").ok();\n203:                 Ok(t)\n204:             }\n205:             _ => Err(diag(\"internal: unsupported expr in es_expr module\")),\n206:         }\n207:     }\n208: \n209:     fn finish(self) -> String {\n210:         self.out\n211:     }\n212: }\n213: \n214: /// Format a JS number literal as an LLVM `double` constant (decimal, round-trip safe).\n215: fn format_number_const(raw: &str) -> Result<String, Diagnostic> {\n216:     let cleaned: String = raw.chars().filter(|c| *c != '_').collect();\n217:     let f: f64 = cleaned\n218:         .parse()\n219:         .map_err(|_| diag(format!(\"invalid number literal {raw}\")))?;\n220:     Ok(format!(\"{f:.17e}\"))\n221: }\n222: \n223: fn diag(message: impl Into<String>) -> Diagnostic {\n224:     Diagnostic::new(message, Span::dummy())\n225: }\n\n(End of file - total 225 lines)\n</content>",
