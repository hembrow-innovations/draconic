        "command": "# Check if cargo fmt would change more, and whether diff is mostly formatting\ngit stash push -m temp --keep-index 2>/dev/null; true\n# Compare: are the large diffs only whitespace/format?\npython3 - <<'PY'\nimport subprocess, re\nfiles = subprocess.check_output(['git','diff','--name-only']).decode().split()\nfor f in files:\n    d = subprocess.check_output(['git','diff','-w','--',f]).decode()\n    # strip header\n    body = '\\n'.join(l for l in d.splitlines() if l.startswith('+') or l.startswith('-'))\n    body = '\\n'.join(l for l in body.splitlines() if not l.startswith('+++') and not l.startswith('---'))\n    substantive = [l for l in body.splitlines() if l[1:].strip()]\n    if substantive:\n        print(f\"SUBSTANTIVE ({len(substantive)} lines): {f}\")\n    else:\n        print(f\"whitespace-only: {f}\")\nPY"
