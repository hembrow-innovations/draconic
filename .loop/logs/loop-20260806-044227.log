e}{quote})\");\n1766:         out = out.replace(&from, &to);\n1767:     }\n1768:     out\n1769: }\n1770: \n1771: /// Rough scan: static `import`/`export` declarations (not dynamic `import()`).\n1772: fn source_has_static_module_syntax(body: &str) -> bool {\n1773:     for line in body.lines() {\n1774:         let t = line.trim_start();\n1775:         if t.starts_with(\"//\") || t.starts_with(\"/*\") {\n1776:             continue;\n1777:         }\n1778:         if t.starts_with(\"export \") || t.starts_with(\"export{\") || t.starts_with(\"export*\") {\n1779:             return true;\n1780:         }\n1781:         // `import … from` / `import \"` / `import '` — not `import(`.\n1782:         if let Some(rest) = t.strip_prefix(\"import\") {\n1783:             let rest = rest.trim_start();\n1784:             if rest.starts_with('(') {\n1785:                 continue;\n1786:             }\n1787:             return true;\n1788:         }\n1789:     }\n1790:     false\n1791: }\n1792: \n1793: /// Specifiers of static `from '…'` / `from \"…\"` imports (relative or bare).\n1794: fn static_import_specifiers(body: &str) -> Vec<String> {\n1795:     let mut out = Vec::new();\n1796:     for line in body.lines() {\n1797:         let t = line.trim_start();\n1798:         if t.starts_with(\"//\") {\n1799:             continue;\n1800:         }\n1801:         if let Some(rest) = t.strip_prefix(\"import\") {\n1802:             let rest = rest.trim_start();\n1803:             if rest.starts_with('(') {\n1804:                 continue;\n1805:             }\n1806:         } else if !t.starts_with(\"export\") {\n1807:             continue;\n1808:         }\n1809:         // `from './x'` / `from \"./x\"` (static import or re-export).\n1810:         for quote in ['\\'', '\"'] {\n1811:             let needle = format!(\"from {quote}\");\n1812:             let mut search = t;\n1813:             while let Some(idx) = search.find(&needle) {\n1814:                 let after = &search[idx + needle.len()..];\n1815:                 if let Some(end) = after.find(quote) {\n1816:                     out.push(after[..end].to_string());\n1817:                     search = &after[end + 1..];\n1818:                 } else {\n1819:                     break;\n1820:                 }\n1821:             }\n1822:         }\n1823:     }\n1824:     out\n1825: }\n1826: \n1827: /// Specifiers of dynamic `import('…')` / `import(\"…\")` / `import(\\`…\\`)` with\n1828: /// a string literal argument (no expressions).\n1829: fn dynamic_import_specifiers(body: &str) -> Vec<String> {\n1830:     let mut out = Vec::new();\n1831:     for quote in ['\\'', '\"', '`'] {\n1832:         let open = format!(\"import({quote}\");\n1833:         let mut search = body;\n1834:         while let Some(idx) = search.find(&open) {\n1835:             let after = &search[idx + open.len()..];\n1836:             if let Some(end) = after.find(quote) {\n1837:                 out.push(after[..end].to_string());\n1838:                 search = &after[end + 1..];\n1839:             } else {\n1840:                 break;\n1841:             }\n1842:         }\n1843:     }\n1844:     out\n1845: }\n1846: \n1847: /// Normalize `./foo.js` / `foo.js` for specifier set membership.\n1848: fn normalize_module_specifier(spec: &str) -> &str {\n1849:     spec.strip_prefix(\"./\").unwrap_or(spec)\n1850: }\n1851: \n1852: /// E19.83.03: static `import * as ns from X` and dynamic `import(X)` must share\n1853: /// one Module Namespace object. Linker flatten cannot preserve that identity —\n1854: /// run original ESM under the file-module host instead.\n1855: fn source_needs_static_dynamic_ns_identity(body: &str) -> bool {\n1856:     let static_owned = static_import_specifiers(body);\n1857:     let static_specs: std::collections::HashSet<&str> = static_owned\n1858:         .iter()\n1859:         .map(|s| normalize_module_specifier(s))\n1860:         .collect();\n1861:     if static_specs.is_empty() {\n1862:         return false;\n1863:     }\n1864:     dynamic_import_specifiers(body)\n1865:         .iter()\n1866:         .any(|s| static_specs.contains(normalize_module_specifier(s)))\n1867: }\n1868: \n1869: /// Preload hooks: force ESM for Test262 `.js` under dynamic `import()` (E19.83.03).\n1870: fn force_esm_hooks_path() -> PathBuf {\n1871:     package_root().join(\"src\").join(\"force_esm_hooks.mjs\")\n1872: }\n1873: \n1874: /// Run emitted JS under Node. Exit 0 = pass.\n1875: ///\n1876: /// When `cwd` is set (typically the test file's directory), relative\n1877: /// `import('./fixture.js')` resolves like Test262's host (E19.27).\n1878: pub fn run_js_in_node(js: &str) -> Result<(), String> {\n1879:     run_js_in_node_cwd(js, None, false)\n1880: }\n1881: \n1882: /// Like [`run_js_in_node`], optionally with a working directory and ESM mode.\n1883: ///\n1884: /// E19.28: `as_module` uses `--input-type=module` so top-level `await` is valid.\n1885: pub fn run_js_in_node_cwd(js: &str, cwd: Option<&Path>, as_module: bool) -> Result<(), String> {\n1886:     run_js_in_node_cwd_opts(js, cwd, as_module, false)\n1887: }\n1888: \n1889: /// Like [`run_js_in_node_cwd`], with optional Node `--unhandled-rejections=none`.\n1890: ///\n1891: /// E19.83.01: non-async dynamic-import syntax tests fire `import('')` / nested\n1892: /// `import(import(…))` without awaiting; Node would exit 1 on the rejected\n1893: /// promise. Test262 only requires the syntax to be accepted.\n1894: pub fn run_js_in_node_cwd_opts(\n1895:     js: &str,\n1896:     cwd: Option<&Path>,\n1897:     as_module: bool,\n1898:     ignore_unhandled_rejections: bool,\n1899: ) -> Result<(), String> {\n1900:     run_js_in_node_cwd_opts_file(js, cwd, as_module, ignore_unhandled_rejections, None)\n1901: }\n1902: \n1903: /// E19.83.02: optional on-disk ESM entry so dynamic self-import shares module identity.\n1904: ///\n1905: /// When `file_module_name` is set, writes `js` next to `cwd` and runs that path\n1906: /// (ESM via `.mjs`); otherwise uses `node -e` as before.\n1907: pub fn run_js_in_node_cwd_opts_file(\n1908:     js: &str,\n1909:     cwd: Option<&Path>,\n1910:     as_module: bool,\n1911:     ignore_unhandled_rejections: bool,\n1912:     file_module_name: Option<&str>,\n1913: ) -> Result<(), String> {\n1914:     let mut cmd = Command::new(\"node\");\n1915:     // E19.73: V8 ShadowRealm is experimental; enable for Test262 built-ins/ShadowRealm.\n1916:     cmd.arg(\"--harmony-shadow-realm\");\n1917:     if ignore_unhandled_rejections {\n1918:         cmd.arg(\"--unhandled-rejections=none\");\n1919:     }\n1920:     // E19.83.03: empty / script-shaped fixtures must load as ESM namespaces\n1921:     // (no CJS synthetic `default`), matching Test262 host expectations.\n1922:     let hooks = force_esm_hooks_path();\n1923:     if hooks.is_file() {\n1924:         cmd.arg(\"--import\").arg(hooks);\n1925:     }\n1926:     let tmp_path = if let Some(name) = file_module_name {\n1927:         let dir = cwd.ok_or_else(|| \"file-module host needs cwd\".to_string())?;\n1928:         let path = dir.join(name);\n1929:         fs::write(&path, js).map_err(|e| format!(\"write file-module entry: {e}\"))?;\n1930:         Some(path)\n1931:     } else {\n1932:         None\n1933:     };\n1934:     if let Some(ref path) = tmp_path {\n1935:         cmd.arg(path);\n1936:     } else {\n1937:         if as_module {\n1938:             cmd.arg(\"--input-type=module\");\n1939:         }\n1940:         cmd.arg(\"-e\").arg(js);\n1941:     }\n1942:     cmd.stdin(Stdio::null()).stdout(Stdio::piped()).stderr(Stdio::piped());\n1943:     if let Some(dir) = cwd {\n1944:         cmd.current_dir(dir);\n1945:     }\n1946:     let output = cmd.output().map_err(|e| format!(\"spawn node: {e}\"))?;\n1947:     if let Some(path) = tmp_path {\n1948:         let _ = fs::remove_file(path);\n1949:     }\n1950:     let code = output.status.code().unwrap_or(1);\n1951:     if code == 0 {\n1952:         return Ok(());\n1953:     }\n1954:     let stdout = String::from_utf8_lossy(&output.stdout);\n1955:     let stderr = String::from_utf8_lossy(&output.stderr);\n1956:     Err(format!(\n1957:         \"node exit {code}\\n--- stdout ---\\n{stdout}\\n--- stderr ---\\n{stderr}\"\n1958:     ))\n1959: }\n1960: \n1961: /// Run one allowlisted relative path against `suite_root`.\n1962: ///\n1963: /// Panics from the compiler (e.g. mid-UTF-8 lexer bugs) are caught and reported\n1964: /// as `Fail` so baseline triage stays report-only (ADR 0007 / E19.02).\n1965: pub fn run_case(suite_root: &Path, rel: &str) -> CaseResult {\n1966:     let path = rel.to_string();\n1967:     match std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {\n1968:         run_case_inner(suite_root, rel)\n1969:     })) {\n1970:         Ok(c) => c,\n1971:         Err(_) => CaseResult {\n1972:             path,\n1973:             status: Status::Fail,\n1974:             message: \"panic during compile/run (see E19.03 lexer UTF-8 / related)\".into(),\n1975:         },\n1976:     }\n1977: }\n1978: \n1979: fn run_case_inner(suite_root: &Path, rel: &str) -> CaseResult {\n1980:     let full = suite_root.join(rel);\n1981:     if !full.is_file() {\n1982:         return CaseResult {\n1983:             path: rel.to_string(),\n1984:             status: Status::Fail,\n1985:             message: format!(\"missing file: {}\", full.display()),\n1986:         };\n1987:     }\n1988:     let source = match fs::read_to_string(&full) {\n1989:         Ok(s) => s,\n1990:         Err(e) => {\n1991:             return CaseResult {\n1992:                 path: rel.to_string(),\n1993:                 status: Status::Fail,\n1994:                 message: format!(\"read: {e}\"),\n1995:             };\n1996:         }\n1997:     };\n1998:     let test_path = Some(full.as_path());\n1999:     if is_negative_parse(&source) {\n2000:         // Negative parse/early: pass iff frontend rejects the body.\n2001:         return match compile_test_to_js_at(&source, test_path) {\n2002:             Err(_) => CaseResult {\n2003:                 path: rel.to_string(),\n2004:                 status: Status::Pass,\n2005:                 message: \"ok (negative parse)\".to_string(),\n2006:             },\n2007:             Ok(_) => CaseResult {\n2008:                 path: rel.to_string(),\n2009:                 status: Status::Fail,\n2010:                 message: \"expected compile failure for negative parse test\".to_string(),\n2011:             },\n2012:         };\n2013:     }\n2014:     let js = match compile_test_to_js_at(&source, test_path) {\n2015:         Ok(j) => j,\n2016:         Err(e) => {\n2017:             return CaseResult {\n2018:                 path: rel.to_string(),\n2019:                 status: Status::Fail,\n2020:                 message: e,\n2021:             };\n2022:         }\n2023:     };\n2024:     // E19.27: resolve relative dynamic `import()` against the test file directory.\n2025:     // E19.28: Module-flag tests run as ESM (`--input-type=module`) for top-level await.\n2026:     let cwd = full.parent();\n2027:     let as_module = is_module_flag(&source);\n2028:     let async_flag = is_async_flag(&source);\n2029:     let scan_body = if is_raw_flag(&source) {\n2030:         source.as_str()\n2031:     } else {\n2032:         strip_frontmatter(&source)\n2033:     };\n2034:     let basename = full.file_name().and_then(|s| s.to_str());\n2035:     // E19.83.02 file-module host:\n2036:     // - no static export: rewrite self-import onto the run entry so module\n2037:     //   identity is shared (eval-self-once-module).\n2038:     // - with static export: run original ESM body (live bindings); linker flatten\n2039:     //   cannot preserve export live bindings for self-import (imported-self-update).\n2040:     // E19.83.03: static namespace + dynamic `import` of the same specifier must\n2041:     // share one Module Namespace object — run original ESM (not linker flatten).\n2042:     let needs_static_link = as_module && source_has_static_module_syntax(scan_body);\n2043:     let self_import = basename\n2044:         .map(|b| source_has_dynamic_self_import(scan_body, b))\n2045:         .unwrap_or(false);\n2046:     let ns_identity = as_module && source_needs_static_dynamic_ns_identity(scan_body);\n2047:     let file_module_self = as_module && self_import && !needs_static_link;\n2048:     let file_module_export_self = as_module && self_import && needs_static_link;\n2049:     let file_module_ns_identity = ns_identity && !file_module_self && !file_module_export_self;\n2050:     let use_file_module =\n2051:         file_module_self || file_module_export_self || file_module_ns_identity;\n2052:     static RUN_SEQ: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);\n2053:     let file_module_name = if use_file_module {\n2054:         let seq = RUN_SEQ.fetch_add(1, std::sync::atomic::Ordering::Relaxed);\n2055:         Some(format!(\n2056:             \".draconic-test262-run-{}-{}.mjs\",\n2057:             std::process::id(),\n2058:             seq\n2059:         ))\n2060:     } else {\n2061:         None\n2062:     };\n2063:     // Compile already succeeded above (frontend accepts the test). For export\n2064:     // self-import / static+dynamic ns identity, execute original ESM under Node.\n2065:     let js = if file_module_export_self || file_module_ns_identity {\n2066:         let body = if is_raw_flag(&source) {\n2067:             source.clone()\n2068:         } else {\n2069:             strip_frontmatter(&source).to_string()\n2070:         };\n2071:         format!(\"{HARNESS_SHIM}\\n{body}\")\n2072:     } else {\n2073:         js\n2074:     };\n2075:     // E19.26: async-flag tests need `$DONE` host (Node wrapper around emitted JS).\n2076:     let js = if async_flag {\n2077:         wrap_async_host(&js)\n2078:     } else {\n2079:         js\n2080:     };\n2081:     // E19.61: `$262` host outside so ESM `import` stays first under module goal.\n2082:     // onlyStrict: host must not precede the effective `\"use strict\"` directive.\n2083:     // File-module self-import is always ESM (`.mjs`), so host uses module boot.\n2084:     let host_as_module = as_module || use_file_module;\n2085:     let js = wrap_host_api_mode(&js, host_as_module, is_only_strict(&source));\n2086:     let js = if let (Some(run_name), Some(base)) = (file_module_name.as_deref(), basename) {\n2087:         rewrite_dynamic_self_import(&js, base, run_name)\n2088:     } else {\n2089:         js\n2090:     };\n2091:     // E19.83.01: non-async tests may leave dynamic-import rejections unhandled;\n2092:     // async tests settle via `$DONE` / unhandledRejection → keep default policy.\n2093:     let ignore_unhandled = !async_flag;\n2094:     let run = |js: &str| {\n2095:         run_js_in_node_cwd_opts_file(\n2096:             js,\n2097:             cwd,\n2098:             as_module,\n2099:             ignore_unhandled,\n2100:             file_module_name.as_deref(),\n2101:         )\n2102:     };\n2103:     if is_negative_runtime(&source) {\n2104:         // Negative runtime: pass iff Node throws (exit ≠ 0).\n2105:         return match run(&js) {\n2106:             Err(_) => CaseResult {\n2107:                 path: rel.to_string(),\n2108:                 status: Status::Pass,\n2109:                 message: \"ok (negative runtime)\".to_string(),\n2110:             },\n2111:             Ok(()) => CaseResult {\n2112:                 path: rel.to_string(),\n2113:                 status: Status::Fail,\n2114:                 message: \"expected runtime failure for negative runtime test\".to_string(),\n2115:             },\n2116:         };\n2117:     }\n2118:     match run(&js) {\n2119:         Ok(()) => CaseResult {\n2120:             path: rel.to_string(),\n2121:             status: Status::Pass,\n2122:             message: if use_file_module && async_flag {\n2123:                 \"ok (file-module async $DONE)\".to_string()\n2124:             } else if async_flag && as_module {\n2125:                 \"ok (module async $DONE)\".to_string()\n2126:             } else if async_flag {\n2127:                 \"ok (async $DONE)\".to_string()\n2128:             } else if as_module {\n2129:                 \"ok (module)\".to_string()\n2130:             } else {\n2131:                 \"ok\".to_string()\n2132:             },\n2133:         },\n2134:         Err(e) => CaseResult {\n2135:             path: rel.to_string(),\n2136:             status: Status::Fail,\n2137:             message: e,\n2138:         },\n2139:     }\n2140: }\n2141: \n2142: /// Parallelism for allowlist runs (`DRACONIC_TEST262_JOBS`, default = CPUs).\n2143: pub fn test262_jobs() -> usize {\n2144:     if let Ok(raw) = std::env::var(\"DRACONIC_TEST262_JOBS\") {\n2145:         if let Ok(n) = raw.trim().parse::<usize>() {\n2146:             return n.max(1);\n2147:         }\n2148:     }\n2149:     std::thread::available_parallelism()\n2150:         .map(|n| n.get())\n2151:         .unwrap_or(4)\n2152: }\n2153: \n2154: /// Run the curated allowlist. Suite absent → every case `skip`.\n2155: ///\n2156: /// Cases run in parallel (see [`test262_jobs`]). Order matches the allowlist.\n2157: pub fn run_allowlist(suite_root: &Path, allowlist: &[String]) -> Report {\n2158:     let present = suite_present(suite_root);\n2159:     let cases = if !present {\n2160:         allowlist\n2161:             .iter()\n2162:             .map(|p| CaseResult {\n2163:                 path: p.clone(),\n2164:                 status: Status::Skip,\n2165:                 message: format!(\n2166:                     \"suite not present at {} (run: node scripts/fetch-test262.mjs)\",\n2167:                     suite_root.display()\n2168:                 ),\n2169:             })\n2170:             .collect()\n2171:     } else {\n2172:         let jobs = test262_jobs();\n2173:         let root = suite_root.to_path_buf();\n2174:         let pool = rayon::ThreadPoolBuilder::new()\n2175:             .num_threads(jobs)\n2176:             .stack_size(8 * 1024 * 1024)\n2177:             .build()\n2178:             .expect(\"test262 rayon pool\");\n2179:         pool.install(|| {\n2180:             allowlist\n2181:                 .par_iter()\n2182:                 .map(|p| run_case(&root, p))\n2183:                 .collect()\n2184:         })\n2185:     };\n2186:     Report {\n2187:         suite_root: Some(suite_root.to_path_buf()),\n2188:         suite_present: present,\n2189:         cases,\n2190:     }\n2191: }\n2192: \n2193: /// Default entry: resolve root + package allowlist.\n2194: pub fn run_default() -> Result<Report, String> {\n2195:     let root = resolve_suite_root();\n2196:     let list = load_allowlist(&allowlist_path())?;\n2197:     Ok(run_allowlist(&root, &list))\n2198: }\n2199: \n2200: /// Write markdown report next to the package (or `DRACONIC_TEST262_REPORT` path).\n2201: pub fn write_baseline_report(report: &Report) -> Result<PathBuf, String> {\n2202:     let path = if let Ok(p) = std::env::var(\"DRACONIC_TEST262_REPORT\") {\n2203:         PathBuf::from(p)\n2204:     } else {\n2205:         package_root().join(\"baseline-report.md\")\n2206:     };\n2207:     if let Some(parent) = path.parent() {\n2208:         fs::create_dir_all(parent).map_err(|e| format!(\"mkdir {}: {e}\", parent.display()))?;\n2209:     }\n2210:     fs::write(&path, report.to_markdown())\n2211:         .map_err(|e| format!(\"write {}: {e}\", path.display()))?;\n2212:     // Also stamp under target/ when available (CI artifact friendly).\n2213:     let stamp = workspace_root()\n2214:         .join(\"target\")\n2215:         .join(\"test262-baseline-report.md\");\n2216:     if let Some(parent) = stamp.parent() {\n2217:         let _ = fs::create_dir_all(parent);\n2218:     }\n2219:     let _ = fs::write(&stamp, report.to_markdown());\n2220:     Ok(path)\n2221: }\n2222: \n2223: #[cfg(test)]\n2224: mod tests {\n2225:     use super::*;\n2226: \n2227:     #[test]\n2228:     fn allowlist_loads_and_has_entries() {\n2229:         let list = load_allowlist(&allowlist_path()).expect(\"allowlist\");\n2230:         // E19.02/E19.06/E19.10/E19.15/E19.20/E19.25–E19.68/E19.75/E19.81 expanded curated set.\n2231:         assert!(\n2232:             list.len() >= 45100,\n2233:             \"expected expanded curated allowlist (>=45100), got {}\",\n2234:             list.len()\n2235:         );\n2236:         assert!(list.iter().all(|p| p.starts_with(\"test/\")));\n2237:     }\n2238: \n2239:     #[test]\n2240:     fn strip_frontmatter_removes_yaml_block() {\n2241:         let src = \"/*---\\ndescription: x\\n---*/\\nif (true) {}\\n\";\n2242:         let body = strip_frontmatter(src);\n2243:         assert!(body.starts_with(\"if (true)\"));\n2244:     }\n2245: \n2246:     #[test]\n2247:     fn harness_shim_compiles_and_runs() {\n2248:         let js = compile_test_to_js(\"assert.sameValue(1 + 2, 3);\\n\").expect(\"compile\");\n2249:         run_js_in_node(&js).expect(\"node\");\n2250:     }\n2251: \n2252:     #[test]\n2253:     fn harness_shim_catches_failure() {\n2254:         let js = compile_test_to_js(\"assert.sameValue(1, 2, \\\"nope\\\");\\n\").expect(\"compile\");\n2255:         assert!(run_js_in_node(&js).is_err());\n2256:     }\n2257: \n2258:     #[test]\n2259:     fn harness_shim_throws_typeerror() {\n2260:         let js = compile_test_to_js(\n2261:             r#\"\n2262:             assert.throws(TypeError, function() { 1n + 1; });\n2263:             assert.throws(TypeError, function() { 1 + 1n; });\n2264:             \"#,\n2265:         )\n2266:         .expect(\"compile\");\n2267:         run_js_in_node(&js).expect(\"node\");\n2268:     }\n2269: \n2270:     #[test]\n2271:     fn harness_shim_throws_fails_when_no_throw() {\n2272:         let js = compile_test_to_js(\"assert.throws(TypeError, function() { 1 + 1; });\\n\")\n2273:             .expect(\"compile\");\n2274:         assert!(run_js_in_node(&js).is_err());\n2275:     }\n2276: \n2277:     #[test]\n2278:     fn missing_suite_skips_all() {\n2279:         let root = workspace_root().join(\"third_party\").join(\"test262-does-not-exist\");\n2280:         let list = vec![\n2281:             \"test/language/types/boolean/S8.3_A1_T1.js\".to_string(),\n2282:             \"test/language/types/null/S8.2_A1_T1.js\".to_string(),\n2283:         ];\n2284:         let report = run_allowlist(&root, &list);\n2285:         assert!(!report.suite_present);\n2286:         assert_eq!(report.cases.len(), 2);\n2287:         assert!(report.cases.iter().all(|c| c.status == Status::Skip));\n2288:         let (p, f, s) = report.counts();\n2289:         assert_eq!((p, f, s), (0, 0, 2));\n2290:     }\n2291: \n2292:     #[test]\n2293:     fn markdown_report_mentions_totals() {\n2294:         let report = Report {\n2295:             suite_root: Some(PathBuf::from(\"/tmp/nope\")),\n2296:             suite_present: false,\n2297:             cases: vec![CaseResult {\n2298:                 path: \"test/x.js\".into(),\n2299:                 status: Status::Skip,\n2300:                 message: \"suite not present\".into(),\n2301:             }],\n2302:         };\n2303:         let md = report.to_markdown();\n2304:         assert!(md.contains(\"pass=0\"));\n2305:         assert!(md.contains(\"skip=1\"));\n2306:         assert!(md.contains(\"test/x.js\"));\n2307:     }\n2308: \n2309:     #[test]\n2310:     fn negative_parse_meta_detected() {\n2311:         let src = \"/*---\\nnegative:\\n  phase: parse\\n  type: SyntaxError\\n---*/\\n1_\\n\";\n2312:         assert!(is_negative_parse(src));\n2313:         assert!(!is_negative_parse(\"/*---\\ndescription: x\\n---*/\\n1\\n\"));\n2314:         // E19.71: resolution-phase SyntaxError is compile/link failure.\n2315:         let res = \"/*---\\nnegative:\\n  phase: resolution\\n  type: SyntaxError\\nflags: [module]\\n---*/\\nimport { x } from \\\"./m.js\\\";\\n\";\n2316:         assert!(is_negative_parse(res));\n2317:     }\n2318: \n2319:     #[test]\n2320:     fn only_strict_meta_detected() {\n2321:         let src = \"/*---\\nflags: [onlyStrict]\\ndescription: x\\n---*/\\n1\\n\";\n2322:         assert!(is_only_strict(src));\n2323:         assert!(!is_only_strict(\"/*---\\ndescription: x\\n---*/\\n1\\n\"));\n2324:         assert!(!is_only_strict(\"/*---\\nflags: [noStrict]\\n---*/\\n1\\n\"));\n2325:     }\n2326: \n2327:     #[test]\n2328:     fn async_flag_meta_detected() {\n2329:         // E19.26: flags token `async`, not features like `async-functions`.\n2330:         assert!(is_async_flag(\n2331:             \"/*---\\nflags: [generated, async]\\nfeatures: [async-functions]\\n---*/\\n1\\n\"\n2332:         ));\n2333:         assert!(is_async_flag(\"/*---\\nflags: [async]\\n---*/\\n1\\n\"));\n2334:         assert!(!is_async_flag(\n2335:             \"/*---\\nfeatures: [async-functions, async-iteration]\\n---*/\\n1\\n\"\n2336:         ));\n2337:         assert!(!is_async_flag(\"/*---\\nflags: [generated]\\n---*/\\n1\\n\"));\n2338:     }\n2339: \n2340:     #[test]\n2341:     fn module_flag_meta_detected() {\n2342:         // E19.28: flags token `module`.\n2343:         assert!(is_module_flag(\n2344:             \"/*---\\nflags: [generated, module]\\nfeatures: [top-level-await]\\n---*/\\n1\\n\"\n2345:         ));\n2346:         assert!(is_module_flag(\"/*---\\nflags: [module, async]\\n---*/\\n1\\n\"));\n2347:         assert!(!is_module_flag(\n2348:             \"/*---\\nfeatures: [top-level-await]\\n---*/\\n1\\n\"\n2349:         ));\n2350:         assert!(!is_module_flag(\"/*---\\nflags: [async]\\n---*/\\n1\\n\"));\n2351:         assert!(is_module_flag(\n2352:             \"/*---\\nflags:\\n  - module\\nnegative:\\n  phase: parse\\n---*/\\n1\\n\"\n2353:         ));\n2354:     }\n2355: \n2356:     #[test]\n2357:     fn top_level_await_module_compiles_and_runs() {\n2358:         // E19.28: Module goal + ESM host accepts top-level await.\n2359:         let src = r#\"\n2360: /*---\n2361: description: top-level await basics\n2362: flags: [module, async]\n2363: features: [top-level-await]\n2364: ---*/\n2365: var x = await 42;\n2366: assert.sameValue(x, 42);\n2367: $DONE();\n2368: \"#;\n2369:         let js = compile_test_to_js(src).expect(\"compile module TLA\");\n2370:         assert!(js.contains(\"await\"), \"{js}\");\n2371:         let js = wrap_async_host(&js);\n2372:         run_js_in_node_cwd(&js, None, true).expect(\"node ESM TLA\");\n2373:     }\n2374: \n2375:     #[test]\n2376:     fn top_level_await_script_rejected() {\n2377:         // E19.28 / E19.52: Script [~Await] — `await` is IdentifierReference, so\n2378:         // `await 1` is a syntax error (not AwaitExpression).\n2379:         let src = \"var x = await 1;\\n\";\n2380:         let err = compile_test_to_js(src).expect_err(\"script TLA must fail\");\n2381:         assert!(!err.is_empty(), \"unexpected empty err\");\n2382:     }\n2383: \n2384:     #[test]\n2385:     fn async_done_success_settles() {\n2386:         // E19.26: promise chain + $DONE() → pass (no ReferenceError).\n2387:         let src = r#\"\n2388: /*---\n2389: description: async $DONE success\n2390: flags: [async]\n2391: ---*/\n2392: Promise.resolve(1).then(function (v) {\n2393:   assert.sameValue(v, 1);\n2394: }).then($DONE, $DONE);\n2395: \"#;\n2396:         let js = compile_test_to_js(src).expect(\"compile\");\n2397:         let js = wrap_async_host(&js);\n2398:         run_js_in_node(&js).expect(\"async $DONE success\");\n2399:     }\n2400: \n2401:     #[test]\n2402:     fn async_done_failure_rejects() {\n2403:         // E19.26: $DONE(error) → node non-zero.\n2404:         let src = r#\"\n2405: /*---\n2406: flags: [async]\n2407: ---*/\n2408: Promise.resolve().then(function () {\n2409:   $DONE(new Error(\"boom\"));\n2410: });\n2411: \"#;\n2412:         let js = compile_test_to_js(src).expect(\"compile\");\n2413:         let js = wrap_async_host(&js);\n2414:         assert!(run_js_in_node(&js).is_err());\n2415:     }\n2416: \n2417:     #[test]\n2418:     fn async_done_missing_is_reference_error_without_host() {\n2419:         // Without wrap_async_host, $DONE is unresolved at runtime.\n2420:         let src = r#\"\n2421: /*---\n2422: flags: [async]\n2423: ---*/\n2424: Promise.resolve().then($DONE, $DONE);\n2425: \"#;\n2426:         let js = compile_test_to_js(src).expect(\"compile\");\n2427:         assert!(\n2428:             run_js_in_node(&js).is_err(),\n2429:             \"bare $DONE without host must fail\"\n2430:         );\n2431:     }\n2432: \n2433:     #[test]\n2434:     fn dynamic_import_call_compiles_and_emits() {\n2435:         // E19.27: ImportCall round-trip through frontend → JS.\n2436:         let src = r#\"\n2437: /*---\n2438: features: [dynamic-import]\n2439: ---*/\n2440: let p = import('./m.js');\n2441: assert.sameValue(typeof p.then, \"function\");\n2442: \"#;\n2443:         let js = compile_test_to_js(src).expect(\"compile\");\n2444:         assert!(js.contains(\"import(\\\"./m.js\\\")\"), \"{js}\");\n2445:     }\n2446: \n2447:     #[test]\n2448:     fn import_meta_compiles_and_emits() {\n2449:         // E19.83.01: `import.meta` as ImportCall AssignmentExpression (module).\n2450:         let src = r#\"\n2451: /*---\n2452: features: [dynamic-import, import.meta]\n2453: flags: [module, async]\n2454: ---*/\n2455: const p = import(import.meta);\n2456: assert.sameValue(Promise.resolve(p), p);\n2457: p.catch(function () {}).then($DONE, $DONE);\n2458: \"#;\n2459:         let js = compile_test_to_js(src).expect(\"compile\");\n2460:         assert!(js.contains(\"import.meta\"), \"{js}\");\n2461:         assert!(js.contains(\"import(\"), \"{js}\");\n2462:     }\n2463: \n2464:     #[test]\n2465:     fn async_done_installed_on_global_this() {\n2466:         // E19.83.02: `$DONE` must be a global object property for file-module self-import.\n2467:         let js = wrap_async_host(\n2468:             \"if (typeof globalThis.$DONE !== \\\"function\\\") { throw new Error(\\\"missing $DONE\\\"); }\\n$DONE();\\n\",\n2469:         );\n2470:         run_js_in_node(&js).expect(\"$DONE on globalThis\");\n2471:     }\n2472: \n2473:     #[test]\n2474:     fn harness_installs_assert_on_global_this() {\n2475:         // E19.83.02: module-local harness decls are also copied to globalThis.\n2476:         let js = format!(\n2477:             \"{HARNESS_SHIM}\\nassert.sameValue(typeof globalThis.assert, \\\"function\\\");\\nassert.sameValue(typeof globalThis.fnGlobalObject, \\\"function\\\");\\n\"\n2478:         );\n2479:         run_js_in_node(&js).expect(\"harness globals\");\n2480:     }\n2481: \n2482:     #[test]\n2483:     fn rewrite_dynamic_self_import_rewrites_specifier() {\n2484:         // E19.83.02: file-module host rewrites self-import to the run entry name.\n2485:         let js = r#\"import(\"./eval-self-once-module.js\"); import('./eval-self-once-module.js');\"#;\n2486:         let out = rewrite_dynamic_self_import(js, \"eval-self-once-module.js\", \"run.mjs\");\n2487:         assert!(out.contains(r#\"import(\"./run.mjs\")\"#), \"{out}\");\n2488:         assert!(out.contains(r#\"import('./run.mjs')\"#), \"{out}\");\n2489:         assert!(!out.contains(\"eval-self-once-module.js\"), \"{out}\");\n2490:     }\n2491: \n2492:     #[test]\n2493:     fn source_detects_dynamic_self_import() {\n2494:         assert!(source_has_dynamic_self_import(\n2495:             \"import('./foo.js').then(x => x);\\n\",\n2496:             \"foo.js\"\n2497:         ));\n2498:         assert!(!source_has_dynamic_self_import(\n2499:             \"import('./other.js');\\n\",\n2500:             \"foo.js\"\n2501:         ));\n2502:     }\n2503: \n2504:     #[test]\n2505:     fn source_detects_static_dynamic_ns_identity() {\n2506:         // E19.83.03: reuse-namespace-object-from-import pattern.\n2507:         let body = r#\"\n2508: import * as ns from './module-code_FIXTURE.js';\n2509: Promise.all([\n2510:     import('./module-code_FIXTURE.js'),\n2511:     import('./module-code_FIXTURE.js'),\n2512: ]).then(([a, b]) => {\n2513:     assert.sameValue(a, ns);\n2514: });\n2515: \"#;\n2516:         assert!(source_needs_static_dynamic_ns_identity(body));\n2517:         assert!(!source_needs_static_dynamic_ns_identity(\n2518:             \"import('./only-dynamic.js');\\n\"\n2519:         ));\n2520:         assert!(!source_needs_static_dynamic_ns_identity(\n2521:             \"import * as ns from './only-static.js';\\n\"\n2522:         ));\n2523:     }\n2524: \n2525:     #[test]\n2526:     fn force_esm_empty_fixture_has_no_default() {\n2527:         // E19.83.03: empty module namespace must not own `default` (CJS interop).\n2528:         let suite = resolve_suite_root();\n2529:         if !suite_present(&suite) {\n2530:             return;\n2531:         }\n2532:         let cwd = suite.join(\"test/language/expressions/dynamic-import/namespace\");\n2533:         if !cwd.join(\"empty_FIXTURE.js\").is_file() {\n2534:             return;\n2535:         }\n2536:         let js = r#\"\n2537: const ns = await import('./empty_FIXTURE.js');\n2538: if (Object.prototype.hasOwnProperty.call(ns, 'default')) {\n2539:   throw new Error('empty fixture must not own default');\n2540: }\n2541: if (!delete ns.undef) throw new Error('delete undef');\n2542: if (!delete ns.default) throw new Error('delete default');\n2543: \"#;\n2544:         run_js_in_node_cwd(js, Some(&cwd), true).expect(\"empty fixture ESM namespace\");\n2545:     }\n2546: \n2547:     #[test]\n2548:     fn async_gen_dynamic_import_script_code_target_syntax_error() {\n2549:         // E19.83.04: dynamic import always loads Module Record; script-valid\n2550:         // `var`/`function` smoosh is a Module early SyntaxError. Async-gen\n2551:         // `.next()` promise must reject with that error (catch residual path).\n2552:         let suite = resolve_suite_root();\n2553:         if !suite_present(&suite) {\n2554:             return;\n2555:         }\n2556:         let cwd = suite.join(\"test/language/expressions/dynamic-im