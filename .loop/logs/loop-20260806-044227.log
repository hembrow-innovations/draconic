ert.throws(TypeError, () => Reflect.construct(ns, [], ns), \"Deferred namespaces are not constructable\");\n39: \n40: assert.compareArray(\n41:   Reflect.ownKeys(ns),\n42:   [\"bar\", \"foo\", Symbol.toStringTag],\n43:   \"Deferred namespaces' keys are the exports sorted alphabetically, followed by @@toStringTag\"\n44: );\n45: \n46: // We cannot use `verifyProperty` because the property _looks_ writable, but it's actually not\n47: const desc = Reflect.getOwnPropertyDescriptor(ns, \"foo\");\n48: assert.sameValue(desc.value, 1, \"The value of the 'foo' property is 1\");\n49: assert.sameValue(desc.writable, true, \"The 'foo' property is writable\");\n50: assert.sameValue(desc.enumerable, true, \"The 'foo' property is enumerable\");\n51: assert.sameValue(desc.configurable, false, \"The 'foo' property is not configurable\");\n52: \n53: assert.sameValue(Reflect.getOwnPropertyDescriptor(ns, \"non-existent\"), undefined, \"No descriptors for non-exports\");\n\n(End of file - total 53 lines)\n</content>",
      "metadata": {
        "preview": "// Copyright (C) 2024 Igalia, S.L. All rights reserved.\n// This code is governed by the BSD license found in the LICENSE file.\n\n/*---\nesid: sec-modulenamespacecreate\ndescription: >\n  Deferred namespace objects have the correct MOP implementation\ninfo: |\n  ModuleNamespaceCreate ( _module_, _exports_, _phase_ )\n    1. Let _internalSlotsList_ be the internal slots listed in <emu-xref href=\"#table-internal-slots-of-module-namespace-exotic-objects\"></emu-xref>.\n    1. Let _M_ be MakeBasicObject(_internalSlotsList_).\n    1. Set _M_'s essential internal methods to the definitions specified in <emu-xref href=\"#sec-module-namespace-exotic-objects\"></emu-xref>.\n    1. ...\n\n  [[GetPrototypeOf]] ( )\n    1. Return null.\n\n  [[IsExtensible]] ( )\n    1. Return false.\n",
