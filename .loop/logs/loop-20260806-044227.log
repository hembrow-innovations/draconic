      "output": "<path>/Users/jaredhembrow/Projects/draconic/draconic/crates/draconic-backend-llvm/src/es_expr.rs</path>\n<type>file</type>\n<content>\n1: //! N08.01: emit native observations for ES expression Programs\n2: //! (E01.01 arithmetic, E01.02 comparison, E01.03 logical, E01.04.01 bitwise, E01.04.02 `**`).\n3: \n4: use std::collections::HashMap;\n5: use std::fmt::Write as _;\n6: \n7: use draconic_ast::{BinaryOp, UnaryOp};\n8: use draconic_diagnostics::{Diagnostic, Span};\n9: use draconic_ir::{Expr, IrType as Type, Local, LocalId, Module, Stmt};\n10: use draconic_runtime::abi::{llvm_declares, ES_EXPR_DECLARES, PRINT_BOOL, PRINT_F64};\n11: \n12: /// True when this module is a supported ES expression subset (E01.01–E01.04.02 / N08.01.*):\n13: /// top-level `let` declares over JS numbers and/or booleans with arithmetic, unary `+`/`-`/`!`/`~`,\n14: /// comparison (`<` `<=` `>` `>=`), equality (`==` `!=` `===` `!==`), logical (`&&` `||`),\n15: /// bitwise (`&` `|` `^` `<<` `>>` `>>>`), exponentiation (`**`), grouping, and local refs.\n16: /// Value-preserving `&&`/`||` on numbers is included.\n17: pub(crate) fn is_es_expr_module(module: &Module) -> bool {\n18:     classify(module).is_some()\n19: }\n20: \n21: pub(crate) fn emit_es_expr(module: &Module) -> Result<String, Diagnostic> {\n22:     let user = classify(module).ok_or_else(|| diag(\"internal: not an es_expr module\"))?;\n23:     let mut em = Emitter::new(module);\n24:     em.emit_module(&user.user_locals)?;\n25:     Ok(em.finish())\n26: }\n27: \n28: #[derive(Clone, Copy, PartialEq, Eq)]\n29: enum SlotTy {\n30:     Number,\n31:     Boolean,\n32: }\n33: \n34: /// Top-level user locals in declaration order (observation order).\n35: struct ModuleInfo {\n36:     user_locals: Vec<(LocalId, SlotTy)>,\n37: }\n38: \n39: fn classify(module: &Module) -> Option<ModuleInfo> {\n40:     let by_id: HashMap<LocalId, &Local> = module.locals.iter().map(|l| (l.id, l)).collect();\n41:     let mut user_locals = Vec::new();\n42:     for stmt in &module.body {\n43:         let Stmt::Declare {\n44:             local,\n45:             init: Some(init),\n46:             ..\n47:         } = stmt\n48:         else {\n49:             return None;\n50:         };\n51:         let loc = by_id.get(local)?;\n52:         let slot = match loc.ty {\n53:             Type::Number => {\n54:                 if !expr_is_number_subset(init, &by_id) {\n55:                     return None;\n56:                 }\n57:                 SlotTy::Number\n58:             }\n59:             Type::Boolean => {\n60:                 if !expr_is_boolean_subset(init, &by_id) {\n61:                     return None;\n62:                 }\n63:                 SlotTy::Boolean\n64:             }\n65:             _ => return None,\n66:         };\n67:         user_locals.push((*local, slot));\n68:     }\n69:     if user_locals.is_empty() {\n70:         return None;\n71:     }\n72:     Some(ModuleInfo { user_locals })\n73: }\n74: \n75: fn expr_is_number_subset(expr: &Expr, by_id: &HashMap<LocalId, &Local>) -> bool {\n76:     match expr {\n77:         Expr::Number { ty, .. } => *ty == Type::Number,\n78:         Expr::Local { id, ty } => {\n79:             *ty == Type::Number && by_id.get(id).is_some_and(|l| l.ty == Type::Number)\n80:         }\n81:         Expr::Unary { op, arg, ty } => {\n82:             *ty == Type::Number\n83:                 && matches!(op, UnaryOp::Minus | UnaryOp::Plus | UnaryOp::BitNot)\n84:                 && expr_is_number_subset(arg, by_id)\n85:         }\n86:         Expr::Binary {\n87:             left,\n88:             op,\n89:             right,\n90:             ty,\n91:         } => {\n92:             *ty == Type::Number\n93:                 && matches!(\n94:                     op,\n95:                     BinaryOp::Add\n96:                         | BinaryOp::Sub\n97:                         | BinaryOp::Mul\n98:                         | BinaryOp::Div\n99:                         | BinaryOp::Rem\n100:                         | BinaryOp::And\n101:                         | BinaryOp::Or\n102:                         | BinaryOp::BitAnd\n103:                         | BinaryOp::BitOr\n104:                         | BinaryOp::BitXor\n105:                         | BinaryOp::Shl\n106:                         | BinaryOp::Shr\n107:                         | BinaryOp::UShr\n108:                         | BinaryOp::Pow\n109:                 )\n110:                 && expr_is_number_subset(left, by_id)\n111:                 && expr_is_number_subset(right, by_id)\n112:         }\n113:         _ => false,\n114:     }\n115: }\n116: \n117: fn expr_is_boolean_subset(expr: &Expr, by_id: &HashMap<LocalId, &Local>) -> bool {\n118:     match expr {\n119:         Expr::Boolean { ty, .. } => *ty == Type::Boolean,\n120:         Expr::Local { id, ty } => {\n121:             *ty == Type::Boolean && by_id.get(id).is_some_and(|l| l.ty == Type::Boolean)\n122:         }\n123:         Expr::Unary { op, arg, ty } => {\n124:             *ty == Type::Boolean && matches!(op, UnaryOp::Not) && expr_is_boolean_subset(arg, by_id)\n125:         }\n126:         Expr::Binary {\n127:             left,\n128:             op,\n129:             right,\n130:             ty,\n131:         } => {\n132:             if *ty != Type::Boolean {\n133:                 return false;\n134:             }\n135:             match op {\n136:                 BinaryOp::Lt | BinaryOp::LtEq | BinaryOp::Gt | BinaryOp::GtEq => {\n137:                     expr_is_number_subset(left, by_id) && expr_is_number_subset(right, by_id)\n138:                 }\n139:                 BinaryOp::EqEq | BinaryOp::NotEq | BinaryOp::EqEqEq | BinaryOp::NotEqEq => {\n140:                     (expr_is_number_subset(left, by_id) && expr_is_number_subset(right, by_id))\n141:                         || (expr_is_boolean_subset(left, by_id)\n142:                             && expr_is_boolean_subset(right, by_id))\n143:                 }\n144:                 BinaryOp::And | BinaryOp::Or => {\n145:                     expr_is_boolean_subset(left, by_id) && expr_is_boolean_subset(right, by_id)\n146:                 }\n147:                 _ => false,\n148:             }\n149:         }\n150:         _ => false,\n151:     }\n152: }\n153: \n154: struct Emitter<'a> {\n155:     module: &'a Module,\n156:     /// local id → (alloca ptr name, slot type)\n157:     allocas: HashMap<LocalId, (String, SlotTy)>,\n158:     out: String,\n159:     body: String,\n160:     tmp: u32,\n161: }\n162: \n163: impl<'a> Emitter<'a> {\n164:     fn new(module: &'a Module) -> Self {\n165:         Self {\n166:             module,\n167:             allocas: HashMap::new(),\n168:             out: String::new(),\n169:             body: String::new(),\n170:             tmp: 0,\n171:         }\n172:     }\n173: \n174:     fn fresh(&mut self) -> String {\n175:         let n = self.tmp;\n176:         self.tmp += 1;\n177:         format!(\"%t{n}\")\n178:     }\n179: \n180:     fn emit_module(&mut self, user: &[(LocalId, SlotTy)]) -> Result<(), Diagnostic> {\n181:         writeln!(\n182:             self.out,\n183:             \"; Draconic LLVM backend (N08.01 ES expressions via Runtime ABI)\"\n184:         )\n185:         .ok();\n186:         writeln!(self.out, \"{}\", llvm_declares(ES_EXPR_DECLARES)).ok();\n187:         // JS `**` → IEEE pow (Math.pow); intrinsic available without libm link flags.\n188:         writeln!(self.out, \"declare double @llvm.pow.f64(double, double)\").ok();\n189:         writeln!(self.out).ok();\n190: \n191:         for (id, slot) in user {\n192:             let ptr = format!(\"%l{}\", id.0);\n193:             self.allocas.insert(*id, (ptr.clone(), *slot));\n194:             match slot {\n195:                 SlotTy::Number => {\n196:                     writeln!(self.body, \"  {ptr} = alloca double, align 8\").ok();\n197:                 }\n198:                 SlotTy::Boolean => {\n199:                     writeln!(self.body, \"  {ptr} = alloca i1, align 1\").ok();\n200:                 }\n201:             }\n202:         }\n203: \n204:         for stmt in &self.module.body {\n205:             let Stmt::Declare { local, init, .. } = stmt else {\n206:                 return Err(diag(\"internal: non-declare in es_expr module\"));\n207:             };\n208:             let Some(init) = init else {\n209:                 return Err(diag(\"internal: declare without init in es_expr module\"));\n210:             };\n211:             let (ptr, slot) = self\n212:                 .allocas\n213:                 .get(local)\n214:                 .cloned()\n215:                 .ok_or_else(|| diag(\"internal: missing alloca\"))?;\n216:             match slot {\n217:                 SlotTy::Number => {\n218:                     let v = self.emit_number_expr(init)?;\n219:                     writeln!(self.body, \"  store double {v}, ptr {ptr}\").ok();\n220:                 }\n221:                 SlotTy::Boolean => {\n222:                     let v = self.emit_bool_expr(init)?;\n223:                     writeln!(self.body, \"  store i1 {v}, ptr {ptr}\").ok();\n224:                 }\n225:             }\n226:         }\n227: \n228:         // Print top-level user locals in declaration order.\n229:         for (id, slot) in user {\n230:             let (ptr, _) = self\n231:                 .allocas\n232:                 .get(id)\n233:                 .cloned()\n234:                 .ok_or_else(|| diag(\"internal: print missing alloca\"))?;\n235:             match slot {\n236:                 SlotTy::Number => {\n237:                     let v = self.fresh();\n238:                     writeln!(self.body, \"  {v} = load double, ptr {ptr}\").ok();\n239:                     writeln!(self.body, \"  {}\", PRINT_F64.call(&format!(\"double {v}\"))).ok();\n240:                 }\n241:                 SlotTy::Boolean => {\n242:                     let v = self.fresh();\n243:                     writeln!(self.body, \"  {v} = load i1, ptr {ptr}\").ok();\n244:                     let ext = self.fresh();\n245:                     writeln!(self.body, \"  {ext} = zext i1 {v} to i8\").ok();\n246:                     writeln!(self.body, \"  {}\", PRINT_BOOL.call(&format!(\"i8 {ext}\"))).ok();\n247:                 }\n248:             }\n249:         }\n250: \n251:         writeln!(self.out, \"define i32 @main() {{\").ok();\n252:         writeln!(self.out, \"entry:\").ok();\n253:         write!(self.out, \"{}\", self.body).ok();\n254:         writeln!(self.out, \"  ret i32 0\").ok();\n255:         writeln!(self.out, \"}}\").ok();\n256:         Ok(())\n257:     }\n258: \n259:     fn emit_number_expr(&mut self, expr: &Expr) -> Result<String, Diagnostic> {\n260:         match expr {\n261:             Expr::Number { raw, .. } => Ok(format_number_const(raw)?),\n262:             Expr::Local { id, .. } => {\n263:                 let (ptr, slot) = self\n264:                     .allocas\n265:                     .get(id)\n266:                     .cloned()\n267:                     .ok_or_else(|| diag(format!(\"internal: unallocated local %{}\", id.0)))?;\n268:                 if slot != SlotTy::Number {\n269:                     return Err(diag(\"internal: expected number local\"));\n270:                 }\n271:                 let t = self.fresh();\n272:                 writeln!(self.body, \"  {t} = load double, ptr {ptr}\").ok();\n273:                 Ok(t)\n274:             }\n275:             Expr::Unary { op, arg, .. } => {\n276:                 let a = self.emit_number_expr(arg)?;\n277:                 match op {\n278:                     UnaryOp::Plus => Ok(a),\n279:                     UnaryOp::Minus => {\n280:                         let t = self.fresh();\n281:                         writeln!(self.body, \"  {t} = fneg double {a}\").ok();\n282:                         Ok(t)\n283:                     }\n284:                     // JS `~`: ToInt32 then bitwise not; result as Number.\n285:                     UnaryOp::BitNot => {\n286:                         let i = self.fresh();\n287:                         writeln!(self.body, \"  {i} = fptosi double {a} to i32\").ok();\n288:                         let n = self.fresh();\n289:                         writeln!(self.body, \"  {n} = xor i32 {i}, -1\").ok();\n290:                         let t = self.fresh();\n291:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n292:                         Ok(t)\n293:                     }\n294:                     _ => Err(diag(\"internal: non-arithmetic unary in es_expr module\")),\n295:                 }\n296:             }\n297:             Expr::Binary {\n298:                 left, op, right, ..\n299:             } => {\n300:                 let l = self.emit_number_expr(left)?;\n301:                 let r = self.emit_number_expr(right)?;\n302:                 match op {\n303:                     BinaryOp::Add | BinaryOp::Sub | BinaryOp::Mul | BinaryOp::Div | BinaryOp::Rem => {\n304:                         let inst = match op {\n305:                             BinaryOp::Add => \"fadd\",\n306:                             BinaryOp::Sub => \"fsub\",\n307:                             BinaryOp::Mul => \"fmul\",\n308:                             BinaryOp::Div => \"fdiv\",\n309:                             BinaryOp::Rem => \"frem\",\n310:                             _ => unreachable!(),\n311:                         };\n312:                         let t = self.fresh();\n313:                         writeln!(self.body, \"  {t} = {inst} double {l}, {r}\").ok();\n314:                         Ok(t)\n315:                     }\n316:                     // Value-preserving JS && / || on numbers (ToBoolean via nonzero).\n317:                     BinaryOp::And | BinaryOp::Or => {\n318:                         let truthy = self.fresh();\n319:                         // +0/-0/NaN are falsy; `one` is ordered-and-unequal.\n320:                         writeln!(self.body, \"  {truthy} = fcmp one double {l}, 0.00000000000000000e+00\")\n321:                             .ok();\n322:                         let t = self.fresh();\n323:                         match op {\n324:                             BinaryOp::And => {\n325:                                 writeln!(\n326:                                     self.body,\n327:                                     \"  {t} = select i1 {truthy}, double {r}, double {l}\"\n328:                                 )\n329:                                 .ok();\n330:                             }\n331:                             BinaryOp::Or => {\n332:                                 writeln!(\n333:                                     self.body,\n334:                                     \"  {t} = select i1 {truthy}, double {l}, double {r}\"\n335:                                 )\n336:                                 .ok();\n337:                             }\n338:                             _ => unreachable!(),\n339:                         }\n340:                         Ok(t)\n341:                     }\n342:                     // JS bitwise on Numbers: ToInt32 (or ToUint32 for >>>), then int op.\n343:                     BinaryOp::BitAnd\n344:                     | BinaryOp::BitOr\n345:                     | BinaryOp::BitXor\n346:                     | BinaryOp::Shl\n347:                     | BinaryOp::Shr\n348:                     | BinaryOp::UShr => self.emit_bitwise_number(op, &l, &r),\n349:                     // JS `**` (Math.pow): IEEE floating pow on Number doubles.\n350:                     BinaryOp::Pow => {\n351:                         let t = self.fresh();\n352:                         writeln!(\n353:                             self.body,\n354:                             \"  {t} = call double @llvm.pow.f64(double {l}, double {r})\"\n355:                         )\n356:                         .ok();\n357:                         Ok(t)\n358:                     }\n359:                     _ => Err(diag(\"internal: non-arithmetic binary in number emit\")),\n360:                 }\n361:             }\n362:             _ => Err(diag(\"internal: unsupported number expr in es_expr module\")),\n363:         }\n364:     }\n365: \n366:     fn emit_bool_expr(&mut self, expr: &Expr) -> Result<String, Diagnostic> {\n367:         match expr {\n368:             Expr::Boolean { value, .. } => Ok(if *value { \"true\".into() } else { \"false\".into() }),\n369:             Expr::Local { id, .. } => {\n370:                 let (ptr, slot) = self\n371:                     .allocas\n372:                     .get(id)\n373:                     .cloned()\n374:                     .ok_or_else(|| diag(format!(\"internal: unallocated local %{}\", id.0)))?;\n375:                 if slot != SlotTy::Boolean {\n376:                     return Err(diag(\"internal: expected boolean local\"));\n377:                 }\n378:                 let t = self.fresh();\n379:                 writeln!(self.body, \"  {t} = load i1, ptr {ptr}\").ok();\n380:                 Ok(t)\n381:             }\n382:             Expr::Unary { op, arg, .. } => match op {\n383:                 UnaryOp::Not => {\n384:                     let a = self.emit_bool_expr(arg)?;\n385:                     let t = self.fresh();\n386:                     writeln!(self.body, \"  {t} = xor i1 {a}, true\").ok();\n387:                     Ok(t)\n388:                 }\n389:                 _ => Err(diag(\"internal: non-logical unary in bool emit\")),\n390:             },\n391:             Expr::Binary {\n392:                 left, op, right, ..\n393:             } => match op {\n394:                 BinaryOp::Lt\n395:                 | BinaryOp::LtEq\n396:                 | BinaryOp::Gt\n397:                 | BinaryOp::GtEq\n398:                 | BinaryOp::EqEq\n399:                 | BinaryOp::NotEq\n400:                 | BinaryOp::EqEqEq\n401:                 | BinaryOp::NotEqEq\n402:                     if expr_ty_is_number(left) =>\n403:                 {\n404:                     let l = self.emit_number_expr(left)?;\n405:                     let r = self.emit_number_expr(right)?;\n406:                     let pred = match op {\n407:                         BinaryOp::EqEq | BinaryOp::EqEqEq => \"oeq\",\n408:                         BinaryOp::NotEq | BinaryOp::NotEqEq => \"one\",\n409:                         BinaryOp::Lt => \"olt\",\n410:                         BinaryOp::LtEq => \"ole\",\n411:                         BinaryOp::Gt => \"ogt\",\n412:                         BinaryOp::GtEq => \"oge\",\n413:                         _ => unreachable!(),\n414:                     };\n415:                     let t = self.fresh();\n416:                     writeln!(self.body, \"  {t} = fcmp {pred} double {l}, {r}\").ok();\n417:                     Ok(t)\n418:                 }\n419:                 BinaryOp::EqEq | BinaryOp::NotEq | BinaryOp::EqEqEq | BinaryOp::NotEqEq => {\n420:                     let l = self.emit_bool_expr(left)?;\n421:                     let r = self.emit_bool_expr(right)?;\n422:                     let pred = match op {\n423:                         BinaryOp::EqEq | BinaryOp::EqEqEq => \"eq\",\n424:                         BinaryOp::NotEq | BinaryOp::NotEqEq => \"ne\",\n425:                         _ => unreachable!(),\n426:                     };\n427:                     let t = self.fresh();\n428:                     writeln!(self.body, \"  {t} = icmp {pred} i1 {l}, {r}\").ok();\n429:                     Ok(t)\n430:                 }\n431:                 BinaryOp::And | BinaryOp::Or => {\n432:                     let l = self.emit_bool_expr(left)?;\n433:                     let r = self.emit_bool_expr(right)?;\n434:                     let inst = match op {\n435:                         BinaryOp::And => \"and\",\n436:                         BinaryOp::Or => \"or\",\n437:                         _ => unreachable!(),\n438:                     };\n439:                     let t = self.fresh();\n440:                     writeln!(self.body, \"  {t} = {inst} i1 {l}, {r}\").ok();\n441:                     Ok(t)\n442:                 }\n443:                 _ => Err(diag(\"internal: non-comparison binary in bool emit\")),\n444:             },\n445:             _ => Err(diag(\"internal: unsupported bool expr in es_expr module\")),\n446:         }\n447:     }\n448: \n449:     /// Emit JS bitwise op on two number SSA values (doubles). Shift count masked to 5 bits.\n450:     fn emit_bitwise_number(\n451:         &mut self,\n452:         op: &BinaryOp,\n453:         l: &str,\n454:         r: &str,\n455:     ) -> Result<String, Diagnostic> {\n456:         let li = self.fresh();\n457:         writeln!(self.body, \"  {li} = fptosi double {l} to i32\").ok();\n458:         let ri = self.fresh();\n459:         writeln!(self.body, \"  {ri} = fptosi double {r} to i32\").ok();\n460:         match op {\n461:             BinaryOp::BitAnd | BinaryOp::BitOr | BinaryOp::BitXor => {\n462:                 let inst = match op {\n463:                     BinaryOp::BitAnd => \"and\",\n464:                     BinaryOp::BitOr => \"or\",\n465:                     BinaryOp::BitXor => \"xor\",\n466:                     _ => unreachable!(),\n467:                 };\n468:                 let n = self.fresh();\n469:                 writeln!(self.body, \"  {n} = {inst} i32 {li}, {ri}\").ok();\n470:                 let t = self.fresh();\n471:                 writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n472:                 Ok(t)\n473:             }\n474:             BinaryOp::Shl | BinaryOp::Shr | BinaryOp::UShr => {\n475:                 let shift = self.fresh();\n476:                 writeln!(self.body, \"  {shift} = and i32 {ri}, 31\").ok();\n477:                 let n = self.fresh();\n478:                 match op {\n479:                     BinaryOp::Shl => {\n480:                         writeln!(self.body, \"  {n} = shl i32 {li}, {shift}\").ok();\n481:                         let t = self.fresh();\n482:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n483:                         Ok(t)\n484:                     }\n485:                     BinaryOp::Shr => {\n486:                         writeln!(self.body, \"  {n} = ashr i32 {li}, {shift}\").ok();\n487:                         let t = self.fresh();\n488:                         writeln!(self.body, \"  {t} = sitofp i32 {n} to double\").ok();\n489:                         Ok(t)\n490:                     }\n491:                     BinaryOp::UShr => {\n492:                         writeln!(self.body, \"  {n} = lshr i32 {li}, {shift}\").ok();\n493:                         let t = self.fresh();\n494:                         writeln!(self.body, \"  {t} = uitofp i32 {n} to double\").ok();\n495:                         Ok(t)\n496:                     }\n497:                     _ => unreachable!(),\n498:                 }\n499:             }\n500:             _ => Err(diag(\"internal: not a bitwise op\")),\n501:         }\n502:     }\n503: \n504:     fn finish(self) -> String {\n505:         self.out\n506:     }\n507: }\n508: \n509: fn expr_ty_is_number(expr: &Expr) -> bool {\n510:     matches!(expr.ty(), Type::Number)\n511: }\n512: \n513: /// Format a JS number literal as an LLVM `double` constant (decimal, round-trip safe).\n514: fn format_number_const(raw: &str) -> Result<String, Diagnostic> {\n515:     let cleaned: String = raw.chars().filter(|c| *c != '_').collect();\n516:     let f: f64 = cleaned\n517:         .parse()\n518:         .map_err(|_| diag(format!(\"invalid number literal {raw}\")))?;\n519:     Ok(format!(\"{f:.17e}\"))\n520: }\n521: \n522: fn diag(message: impl Into<String>) -> Diagnostic {\n523:     Diagnostic::new(message, Span::dummy())\n524: }\n\n(End of file - total 524 lines)\n</content>",
