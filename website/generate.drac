let page = 0;
let mdPath = "";
let htmlPath = "";
let title = "";
let src = "";
let i = 0;
let n = 0;
let ch = "";
let line = "";
let body = "";
let status = "";
let inFront = 0;
let inFence = 0;
let inList = 0;
let seenFm = 0;
let j = 0;
let h = 0;
let hashing = 0;
let rest = "";
let rendered = "";
let k = 0;
let linkText = "";
let linkHref = "";
let collecting = 0;
let foundParen = 0;
let kind = 0;
let isClose = 0;
let isFence = 0;
let isHead = 0;
let isItem = 0;
let header = "";
let nav = "<nav><a href=\"learn.html\">Learn</a> <a href=\"reference.html\">Reference</a> <a href=\"https://github.com/hembrow-innovations/draconic\">GitHub</a></nav>\n";
let learnNav = "<nav class=\"learn\"><a href=\"install.html\">Install</a> <a href=\"from-javascript.html\">from JavaScript</a> <a href=\"from-systems.html\">from systems</a> <a href=\"dual-worlds.html\">Dual worlds</a> <a href=\"modules.html\">modules</a> <a href=\"native-types.html\">native types</a> <a href=\"host-io.html\">host I/O</a> <a href=\"packages.html\">packages</a></nav>\n";
let referenceNav = "<nav class=\"reference\"><a href=\"cli.html\">CLI</a> <a href=\"types.html\">types</a> <a href=\"dual-world-rules.html\">Dual-world rules</a> <a href=\"reference-host-io.html\">host I/O</a> <a href=\"reference-packages.html\">packages</a></nav>\n";
let css = "";
let slug = "";
let section = "";
let badge = "";

css = css + "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">";
css = css + "<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin=\"anonymous\">";
css = css + "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Source+Serif+4:wght@600;700&amp;family=Source+Sans+3:wght@400;600&amp;family=IBM+Plex+Sans:wght@500;700&amp;family=JetBrains+Mono:wght@400&amp;display=swap\">";
css = css + "<style>";
css = css + ":root{--canvas:#F7F5F0;--paper:#FBF9F4;--ink:#1B1C19;--muted:#57534E;--nav:#625E59;--line:#E7E5E4;--ember:#9A3412;--ember-strong:#842503;--ship-bg:#ECFDF3;--ship-ink:#166534;--code:#F4F1EA}";
css = css + "*{box-sizing:border-box}";
css = css + "html{font-size:100%}";
css = css + "body{margin:0;background:var(--canvas);color:var(--ink);font-family:'Source Sans 3','Segoe UI',sans-serif;font-size:1rem;line-height:1.625}";
css = css + ".skip{position:absolute;left:-999px;top:auto}";
css = css + ".skip:focus{left:1rem;top:1rem;z-index:2;background:var(--paper);color:var(--ink);padding:0.5rem 0.75rem}";
css = css + "header.site{display:flex;align-items:center;justify-content:space-between;gap:1rem;min-height:4rem;padding:0 2rem;background:var(--paper);border-bottom:1px solid var(--line)}";
css = css + "a.wordmark{font-family:'Source Serif 4',Georgia,serif;font-size:1.5rem;font-weight:600;color:var(--ink);text-decoration:none}";
css = css + "header.site nav{display:flex;gap:1.25rem;align-items:center}";
css = css + "header.site nav a{font-family:'IBM Plex Sans','Segoe UI',sans-serif;font-size:0.875rem;font-weight:500;color:var(--nav);text-decoration:none;min-height:2.75rem;display:inline-flex;align-items:center}";
css = css + "header.site nav a:hover,header.site nav a:focus-visible{color:var(--ember-strong)}";
css = css + "a:focus-visible{outline:2px solid var(--ember-strong);outline-offset:3px}";
css = css + ".shell{display:flex;gap:2rem;width:90%;max-width:72rem;margin:0 auto;padding:2rem 0 4rem}";
css = css + "aside{width:16rem;flex-shrink:0;border-right:1px solid var(--line);padding-right:1.5rem}";
css = css + "nav.learn,nav.reference{display:flex;flex-direction:column;gap:0.15rem}";
css = css + "nav.learn a,nav.reference a{color:var(--muted);text-decoration:none;font-family:'IBM Plex Sans','Segoe UI',sans-serif;font-size:0.875rem;font-weight:500;min-height:2.75rem;display:flex;align-items:center}";
css = css + "nav.learn a:hover,nav.reference a:hover{color:var(--ember)}";
css = css + "main{flex:1;min-width:0}";
css = css + "h1,h2,h3,h4{font-family:'Source Serif 4',Georgia,serif;font-weight:600;line-height:1.2;color:var(--ink)}";
css = css + "h1{font-size:3rem;font-weight:700;letter-spacing:-0.02em;margin:0.5rem 0 1rem}";
css = css + "h2{font-size:1.5rem;margin:2rem 0 0.75rem}";
css = css + "h3,h4{font-size:1.25rem;margin:1.5rem 0 0.5rem}";
css = css + "p{margin:0 0 1rem;max-width:42rem}";
css = css + "a{color:var(--ember)}";
css = css + "a:hover{color:var(--ember-strong)}";
css = css + "ul{margin:0 0 1rem;padding-left:1.25rem;max-width:42rem}";
css = css + "li{margin:0.35rem 0}";
css = css + "pre{background:var(--code);color:var(--ink);font-family:'JetBrains Mono',ui-monospace,monospace;font-size:0.875rem;line-height:1.7;padding:1rem 1.25rem;border-radius:2px;overflow:auto;max-width:48rem}";
css = css + "code{font-family:'JetBrains Mono',ui-monospace,monospace}";
css = css + "p.status{display:inline-block;font-family:'IBM Plex Sans','Segoe UI',sans-serif;font-size:0.75rem;font-weight:500;letter-spacing:0.08em;text-transform:uppercase;padding:0.2rem 0.6rem;border-radius:999px;margin:0 0 0.75rem}";
css = css + ".badge-shipped p.status{background:var(--ship-bg);color:var(--ship-ink)}";
css = css + ".badge-not-yet p.status{background:#F5F5F4;color:var(--muted)}";
css = css + "footer{border-top:1px solid var(--line);padding:1.5rem 2rem 2.5rem;color:var(--muted);font-size:0.875rem}";
css = css + "@media (max-width:48rem){.shell{flex-direction:column;width:92%}aside{width:auto;border-right:0;border-bottom:1px solid var(--line);padding:0 0 1rem}h1{font-size:2rem}}";
css = css + "</style>";

while (page < 15) {
  slug = "learn";
  title = "Learn";
  if (page === 1) {
    slug = "reference";
    title = "Reference";
  }
  if (page === 2) {
    slug = "install";
    title = "Install";
  }
  if (page === 3) {
    slug = "from-javascript";
    title = "from JavaScript";
  }
  if (page === 4) {
    slug = "from-systems";
    title = "from systems";
  }
  if (page === 5) {
    slug = "dual-worlds";
    title = "Dual worlds";
  }
  if (page === 6) {
    slug = "modules";
    title = "modules";
  }
  if (page === 7) {
    slug = "native-types";
    title = "native types";
  }
  if (page === 8) {
    slug = "host-io";
    title = "host I/O";
  }
  if (page === 9) {
    slug = "packages";
    title = "packages";
  }
  if (page === 10) {
    slug = "cli";
    title = "CLI";
  }
  if (page === 11) {
    slug = "types";
    title = "types";
  }
  if (page === 12) {
    slug = "dual-world-rules";
    title = "Dual-world rules";
  }
  if (page === 13) {
    slug = "reference-host-io";
    title = "host I/O";
  }
  if (page === 14) {
    slug = "reference-packages";
    title = "packages";
  }
  mdPath = "website/" + slug + ".md";
  htmlPath = "website/" + slug + ".html";
  src = readFileText(mdPath);
  src = src + "\n";
  i = 0;
  n = src.length;
  line = "";
  body = "";
  status = "";
  section = "";
  inFront = 0;
  inFence = 0;
  inList = 0;
  seenFm = 0;
  while (i < n) {
    ch = src[i];
    if (ch === "\n") {
      kind = 0;
      rest = "";
      h = 0;
      if (inFront === 1) {
        if (line === "---") {
          inFront = 0;
        } else {
          if (line === "status: shipped") {
            status = "shipped";
          }
          if (line === "status: not-yet") {
            status = "not-yet";
          }
          if (line === "section: learn") {
            section = "learn";
          }
          if (line === "section: reference") {
            section = "reference";
          }
        }
      } else {
        if (inFence === 1) {
          isClose = 0;
          if (line.length > 2) {
            if (line[0] === "`") {
              if (line[1] === "`") {
                if (line[2] === "`") {
                  isClose = 1;
                }
              }
            }
          }
          if (isClose === 1) {
            body = body + "</code></pre>\n";
            inFence = 0;
          } else {
            body = body + line + "\n";
          }
        } else {
          if (line === "---") {
            if (seenFm === 0) {
              inFront = 1;
              seenFm = 1;
            } else {
              rest = line;
              kind = 3;
            }
          } else {
            isFence = 0;
            if (line.length > 2) {
              if (line[0] === "`") {
                if (line[1] === "`") {
                  if (line[2] === "`") {
                    isFence = 1;
                  }
                }
              }
            }
            if (isFence === 1) {
              if (inList === 1) {
                body = body + "</ul>\n";
                inList = 0;
              }
              body = body + "<pre><code>";
              inFence = 1;
            } else {
              if (line === "") {
                if (inList === 1) {
                  body = body + "</ul>\n";
                  inList = 0;
                }
              } else {
                isHead = 0;
                if (line.length > 1) {
                  if (line[0] === "#") {
                    isHead = 1;
                  }
                }
                if (isHead === 1) {
                  if (inList === 1) {
                    body = body + "</ul>\n";
                    inList = 0;
                  }
                  h = 0;
                  j = 0;
                  hashing = 1;
                  while (hashing === 1) {
                    if (j < line.length) {
                      ch = line[j];
                      if (ch === "#") {
                        h = h + 1;
                        j = j + 1;
                      } else {
                        hashing = 0;
                      }
                    } else {
                      hashing = 0;
                    }
                  }
                  if (j < line.length) {
                    ch = line[j];
                    if (ch === " ") {
                      j = j + 1;
                    }
                  }
                  rest = "";
                  while (j < line.length) {
                    rest = rest + line[j];
                    j = j + 1;
                  }
                  kind = 1;
                } else {
                  isItem = 0;
                  if (line.length > 1) {
                    if (line[0] === "-") {
                      ch = line[1];
                      if (ch === " ") {
                        isItem = 1;
                      }
                    }
                  }
                  if (isItem === 1) {
                    if (inList === 0) {
                      body = body + "<ul>\n";
                      inList = 1;
                    }
                    j = 2;
                    rest = "";
                    while (j < line.length) {
                      rest = rest + line[j];
                      j = j + 1;
                    }
                    kind = 2;
                  } else {
                    if (inList === 1) {
                      body = body + "</ul>\n";
                      inList = 0;
                    }
                    rest = line;
                    kind = 3;
                  }
                }
              }
            }
          }
        }
      }
      if (kind > 0) {
        k = 0;
        rendered = "";
        while (k < rest.length) {
          ch = rest[k];
          if (ch === "[") {
            k = k + 1;
            linkText = "";
            collecting = 1;
            while (collecting === 1) {
              if (k < rest.length) {
                ch = rest[k];
                if (ch === "]") {
                  collecting = 0;
                  k = k + 1;
                } else {
                  linkText = linkText + ch;
                  k = k + 1;
                }
              } else {
                collecting = 0;
              }
            }
            foundParen = 0;
            if (k < rest.length) {
              ch = rest[k];
              if (ch === "(") {
                foundParen = 1;
                k = k + 1;
              }
            }
            if (foundParen === 1) {
              linkHref = "";
              collecting = 1;
              while (collecting === 1) {
                if (k < rest.length) {
                  ch = rest[k];
                  if (ch === ")") {
                    collecting = 0;
                    k = k + 1;
                  } else {
                    linkHref = linkHref + ch;
                    k = k + 1;
                  }
                } else {
                  collecting = 0;
                }
              }
              rendered = rendered + "<a href=\"" + linkHref + "\">" + linkText + "</a>";
            } else {
              rendered = rendered + "[" + linkText + "]";
            }
          } else {
            rendered = rendered + ch;
            k = k + 1;
          }
        }
        if (kind === 1) {
          if (h === 1) {
            body = body + "<h1>" + rendered + "</h1>\n";
          } else {
            if (h === 2) {
              body = body + "<h2>" + rendered + "</h2>\n";
            } else {
              if (h === 3) {
                body = body + "<h3>" + rendered + "</h3>\n";
              } else {
                body = body + "<h4>" + rendered + "</h4>\n";
              }
            }
          }
        }
        if (kind === 2) {
          body = body + "<li>" + rendered + "</li>\n";
        }
        if (kind === 3) {
          body = body + "<p>" + rendered + "</p>\n";
        }
      }
      line = "";
      i = i + 1;
    } else {
      line = line + ch;
      i = i + 1;
    }
  }
  if (inList === 1) {
    body = body + "</ul>\n";
    inList = 0;
  }
  if (inFence === 1) {
    body = body + "</code></pre>\n";
    inFence = 0;
  }
  header = "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>" + title + " · Draconic</title>" + css + "</head><body>\n";
  header = header + "<a class=\"skip\" href=\"#main\">Skip to content</a>\n";
  header = header + "<header class=\"site\"><a class=\"wordmark\" href=\"learn.html\">Draconic</a>" + nav + "</header>\n";
  header = header + "<div class=\"shell\">";
  if (section === "learn") {
    header = header + "<aside>" + learnNav + "</aside>";
  }
  if (section === "reference") {
    header = header + "<aside>" + referenceNav + "</aside>";
  }
  header = header + "<main id=\"main\">";
  writeFileText(htmlPath, header);
  badge = "badge-" + status;
  appendFileText(htmlPath, "<div class=\"" + badge + "\"><p class=\"status\">" + status + "</p></div>\n");
  appendFileText(htmlPath, body);
  appendFileText(htmlPath, "</main></div><footer><p>Draconic</p></footer></body></html>\n");
  page = page + 1;
}
