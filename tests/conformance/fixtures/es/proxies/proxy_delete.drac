let deletes = 0;
let lastKey = "";
let p = new Proxy(
  { m: 1, n: 2 },
  {
    deleteProperty: function (t, key) {
      deletes = deletes + 1;
      lastKey = key;
      if (key === "m") {
        return true;
      }
      if (key === "keep") {
        return false;
      }
      return delete t[key];
    },
  }
);
let dm = delete p.m;
let pm = p.m;
let dn = delete p["n"];
let pn = p.n;
let tn = "n" in p;
p.keep = 3;
