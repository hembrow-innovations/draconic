id: es/numbers/math_basics
targets: js
js.exit: 0
js.check: if (a !== 3) process.exit(1); if (b !== 3) process.exit(2); if (c !== 4) process.exit(3); if (d !== 4) process.exit(4); if (e !== 1) process.exit(5); if (f !== 3) process.exit(6); if (g !== 1024) process.exit(7); if (h !== 3) process.exit(8); if (i !== -1) process.exit(9); if (j !== true) process.exit(10); if (k !== true) process.exit(11); if (t !== "object") process.exit(12); if (m !== 4) process.exit(13); if (n !== true) process.exit(14); if (o !== true) process.exit(15); if (typeof a !== "number") process.exit(16);
