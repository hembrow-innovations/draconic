function* g(a) {
  yield a + 1;
  yield a * 2;
  yield;
  return a;
}
let it = g(10);
let r1 = it.next();
let r2 = it.next();
let r3 = it.next();
let r4 = it.next();
let v1 = r1.value;
let d1 = r1.done;
let v2 = r2.value;
let d2 = r2.done;
let v3 = r3.value;
let d3 = r3.done;
let v4 = r4.value;
let d4 = r4.done;
