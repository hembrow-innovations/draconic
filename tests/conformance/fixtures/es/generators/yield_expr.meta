id: es/generators/yield_expr
targets: js
js.exit: 0
js.check: if (v1 !== 11) process.exit(1); if (d1 !== false) process.exit(2); if (v2 !== 20) process.exit(3); if (d2 !== false) process.exit(4); if (v3 !== undefined) process.exit(5); if (d3 !== false) process.exit(6); if (v4 !== 10) process.exit(7); if (d4 !== true) process.exit(8);
