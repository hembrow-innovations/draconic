let obj = {
  *g(a) {
    yield a;
    yield a + 1;
    return a + 2;
  },
  *h() {
    yield 10;
  }
};
let it = obj.g(5);
let r1 = it.next();
let r2 = it.next();
let r3 = it.next();
let v1 = r1.value;
let d1 = r1.done;
let v2 = r2.value;
let d2 = r2.done;
let v3 = r3.value;
let d3 = r3.done;
let it2 = obj.h();
let h1 = it2.next();
let hv1 = h1.value;
let hd1 = h1.done;
let h2 = it2.next();
let hd2 = h2.done;

class C {
  constructor(n) {
    this.n = n;
  }
  *gen() {
    yield this.n;
    yield this.n * 2;
    return this.n * 3;
  }
  static *sgen(x) {
    yield x;
    return x + 1;
  }
}
let c = new C(7);
let it3 = c.gen();
let c1 = it3.next();
let c2 = it3.next();
let c3 = it3.next();
let cv1 = c1.value;
let cd1 = c1.done;
let cv2 = c2.value;
let cd2 = c2.done;
let cv3 = c3.value;
let cd3 = c3.done;
let it4 = C.sgen(3);
let s1 = it4.next();
let s2 = it4.next();
let sv1 = s1.value;
let sd1 = s1.done;
let sv2 = s2.value;
let sd2 = s2.done;
