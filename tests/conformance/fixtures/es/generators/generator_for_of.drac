function* g() {
  yield 1;
  yield 2;
  yield 3;
}
let sum = 0;
for (let x of g()) {
  sum = sum + x;
}

function* empty() {}
let n = 0;
for (let x of empty()) {
  n = n + 1;
}

function* letters() {
  yield "a";
  yield "b";
}
let chars = "";
for (let c of letters()) {
  chars = chars + c;
}

function* nested() {
  yield [10, 20];
  yield [30];
}
let flat = 0;
for (let row of nested()) {
  for (let v of row) {
    flat = flat + v;
  }
}

function* nums() {
  yield 7;
  yield 8;
}
let acc = 0;
let y;
for (y of nums()) {
  acc = acc + y;
}

function* seq() {
  yield 1;
  yield 2;
  yield 3;
  yield 4;
}
let partial = 0;
let count = 0;
for (let x of seq()) {
  count = count + 1;
  if (count === 1) continue;
  partial = partial + x;
  if (count === 3) break;
}

function* one() {
  yield 5;
}
let once = 0;
for (const z of one()) {
  once = once + z;
}

function* gen_params(a, b) {
  yield a;
  yield b;
  yield a + b;
}
let psum = 0;
for (let x of gen_params(10, 20)) {
  psum = psum + x;
}
