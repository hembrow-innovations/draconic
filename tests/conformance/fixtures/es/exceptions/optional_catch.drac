// E10.03 — optional catch binding: `catch { … }`
let a = 0;
try {
  throw 1;
} catch {
  a = 2;
}

let b = 0;
try {
  b = 1;
} catch {
  b = 99;
}

let c = 0;
try {
  throw "x";
} catch {
  c = 3;
} finally {
  c = c + 10;
}

let d = 0;
try {
  try {
    throw 1;
  } catch {
    throw 2;
  }
} catch {
  d = 4;
}

let e = 0;
function f() {
  try {
    throw 1;
  } catch {
    return 5;
  }
}
e = f();
