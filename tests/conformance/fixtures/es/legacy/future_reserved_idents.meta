id: es/legacy/future_reserved_idents
targets: js
js.exit: 0
js.check: if (a !== 1) process.exit(1); if (b !== 2) process.exit(2); if (c !== 3) process.exit(3); if (d !== 4) process.exit(4); if (e !== 5) process.exit(5); if (f !== 6) process.exit(6); if (g !== 7) process.exit(7); if (h !== 8) process.exit(8); if (i !== 9) process.exit(9); if (j !== 10) process.exit(10); if (k !== 11) process.exit(11); if (l !== 12) process.exit(12); if (m !== 13) process.exit(13); if (n !== 14) process.exit(14); if (o !== 15) process.exit(15); if (p !== 33) process.exit(16); if (r !== true) process.exit(17); if (s !== true) process.exit(18); if (t !== true) process.exit(19); if (u !== true) process.exit(20); if (v !== true) process.exit(21);
