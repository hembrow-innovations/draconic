id: es/legacy/arguments_callee_residual
targets: js
js.exit: 0
js.check: if (a !== true) process.exit(1); if (b !== true) process.exit(2); if (c !== null) process.exit(3); if (d !== true) process.exit(4); if (e !== true) process.exit(5); if (f !== true) process.exit(6); if (g !== true) process.exit(7); if (h !== true) process.exit(8); if (i !== true) process.exit(9); if (j !== true) process.exit(10);
