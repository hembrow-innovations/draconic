}
let j = forInMissesObjectUsesOuter();

function forOfAssignsObject() {
  let obj = { v: 0 };
  with (obj) {
    for (v of [7, 8]) {
    }
  }
  return obj.v === 8;
}
let k = forOfAssignsObject();

function forOfMissesObjectUsesOuter() {
  let v = 0;
  let obj = {};
  with (obj) {
    for (v of [3, 4]) {
    }
  }
  return (
    v === 4 && Object.prototype.hasOwnProperty.call(obj, "v") === false
  );
}
let l = forOfMissesObjectUsesOuter();

function forLetInDoesNotWriteObject() {
  let obj = { k: 0 };
  let n = 0;
  with (obj) {
    for (let k in { a: 1, b: 2 }) {
      n = n + 1;
    }
  }
  return obj.k === 0 && n === 2;
}
let m = forLetInDoesNotWriteObject();

function forLetOfDoesNotWriteObject() {
  let obj = { v: 0 };
  let n = 0;
  with (obj) {
    for (let v of [3, 4]) {
      n = n + v;
    }
  }
  return obj.v === 0 && n === 7;
