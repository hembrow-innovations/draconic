let n = forLetOfDoesNotWriteObject();

function nestedInnerWinsUpdate() {
  let inner = { x: 1 };
  let outer = { x: 10 };
  with (outer) {
    with (inner) {
      x += 2;
    }
  }
  return inner.x === 3 && outer.x === 10;
}
let p = nestedInnerWinsUpdate();

function forInCountAndLast() {
  let obj = { k: "" };
  let n = 0;
  let src = { a: 1, b: 2 };
  with (obj) {
    for (k in src) {
      n = n + 1;
    }
  }
  return n === 2 && src[obj.k] === (obj.k === "a" ? 1 : 2);
}
let q = forInCountAndLast();
