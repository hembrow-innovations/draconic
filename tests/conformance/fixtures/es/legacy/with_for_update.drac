// E17.02.32: with + for-in/for-of + update/compound (non-strict).
// ++/--/+= hit object props (else outer); for (k in/of) assign binding on
// object (else outer); for (let …) does not write the object.

function postfixIncObject() {
  let obj = { x: 5 };
  let old = 0;
  with (obj) {
    old = x++;
  }
  return old === 5 && obj.x === 6;
}
let a = postfixIncObject();

function prefixIncObject() {
  let obj = { x: 5 };
  let neu = 0;
  with (obj) {
    neu = ++x;
  }
  return neu === 6 && obj.x === 6;
}
let b = prefixIncObject();

function postfixDecObject() {
  let obj = { x: 5 };
  let old = 0;
  with (obj) {
    old = x--;
  }
  return old === 5 && obj.x === 4;
}
let c = postfixDecObject();

function prefixDecObject() {
  let obj = { x: 5 };
  let neu = 0;
  with (obj) {
    neu = --x;
  }
  return neu === 4 && obj.x === 4;
}
let d = prefixDecObject();

function compoundAddObject() {
  let obj = { x: 2 };
  let r = 0;
  with (obj) {
    r = x += 3;
  }
  return r === 5 && obj.x === 5;
}
let e = compoundAddObject();

function compoundMulObject() {
  let obj = { x: 3 };
  with (obj) {
    x *= 4;
  }
  return obj.x === 12;
}
let f = compoundMulObject();

function updateMissesObjectUsesOuter() {
  let x = 10;
  let obj = {};
  with (obj) {
    x++;
  }
  return (
    x === 11 && Object.prototype.hasOwnProperty.call(obj, "x") === false
  );
}
let g = updateMissesObjectUsesOuter();

function compoundMissesObjectUsesOuter() {
  let x = 10;
  let obj = {};
  with (obj) {
    x += 2;
  }
  return (
    x === 12 && Object.prototype.hasOwnProperty.call(obj, "x") === false
  );
}
let h = compoundMissesObjectUsesOuter();

function forInAssignsObject() {
  let obj = { k: 0 };
  let src = { alpha: 1 };
  with (obj) {
    for (k in src) {
    }
  }
  return obj.k === "alpha";
}
let i = forInAssignsObject();

function forInMissesObjectUsesOuter() {
  let k = "outer";
  let obj = {};
  let src = { beta: 1 };
  with (obj) {
    for (k in src) {
    }
  }
  return (
    k === "beta" && Object.prototype.hasOwnProperty.call(obj, "k") === false
