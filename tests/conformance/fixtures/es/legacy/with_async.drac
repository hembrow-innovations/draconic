// E17.02.41: with + async functions / await through object environment
// (non-strict). async function / await ident hits object (else outer); resume
// after await still sees with (live); params shadow object; nested async; async
// expression/arrow/method; with inside async body; block async function is not
// Annex B hoisted.

function asyncAwaitHitsObject() {
  let obj = { x: 1 };
  with (obj) {
    async function f() {
      return (await x) === 1;
    }
    return f();
  }
}
let a = false;
asyncAwaitHitsObject().then(function (v) {
  a = v;
});

function asyncLiveClose() {
  let obj = { x: 1 };
  let f;
  with (obj) {
    f = async function () {
      return x;
    };
  }
  obj.x = 9;
  return f().then(function (v) {
    return v === 9;
  });
}
let b = false;
asyncLiveClose().then(function (v) {
  b = v;
});

function asyncResumeLive() {
  let obj = { x: 1 };
  let p;
  with (obj) {
    async function f() {
      let first = x;
      await Promise.resolve(0);
      return first === 1 && x === 5;
    }
    p = f();
  }
  obj.x = 5;
  return p;
}
let c = false;
asyncResumeLive().then(function (v) {
  c = v;
});

