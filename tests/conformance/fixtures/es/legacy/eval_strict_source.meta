js.check: if (a !== "undefined") process.exit(1); if (b !== "undefined") process.exit(2); if (c !== true) process.exit(3); if (d !== true) process.exit(4); if (e !== true) process.exit(5); if (f !== 7) process.exit(6); if (g !== true) process.exit(7); if (h !== 9) process.exit(8); if (i !== true) process.exit(9); if (j !== true) process.exit(10); if (k !== true) process.exit(11);
