// E17.02.20: Array.prototype mutators on mapped arguments (non-strict simple params).
// reverse/sort/push/pop/splice/unshift keep formal↔index alias; slice non-mutating;
// named function expression + object method.

function rev(a, b) {
  Array.prototype.reverse.call(arguments);
  return a === 2 && b === 1 && arguments[0] === 2 && arguments[1] === 1;
}
let a = rev(1, 2);

function srt(a, b, c) {
  Array.prototype.sort.call(arguments);
  return a === 1 && b === 2 && c === 3 && arguments[0] === 1 && arguments[1] === 2 && arguments[2] === 3;
}
let b = srt(3, 1, 2);

function push(a) {
  let n = Array.prototype.push.call(arguments, 9);
  return (
    n === 2 &&
    a === 1 &&
    arguments[0] === 1 &&
    arguments[1] === 9 &&
    arguments.length === 2
  );
}
let c = push(1);

function pop(a, b) {
  let v = Array.prototype.pop.call(arguments);
  return (
    v === 2 &&
    a === 1 &&
    b === 2 &&
    arguments[0] === 1 &&
    arguments[1] === undefined &&
    arguments.length === 1
  );
}
let d = pop(1, 2);

function sp(a, b, c) {
  let r = Array.prototype.splice.call(arguments, 1, 1, 9);
  return (
    r.length === 1 &&
    r[0] === 2 &&
    a === 1 &&
    b === 9 &&
    c === 3 &&
    arguments.length === 3 &&
    arguments[1] === 9
  );
}
let e = sp(1, 2, 3);

function us(a, b) {
  let n = Array.prototype.unshift.call(arguments, 0);
  return (
    n === 3 &&
    a === 0 &&
    b === 1 &&
    arguments[0] === 0 &&
    arguments[1] === 1 &&
    arguments[2] === 2 &&
    arguments.length === 3
  );
}
let f = us(1, 2);

function sl(a, b, c) {
  let s = Array.prototype.slice.call(arguments, 1);
  return (
    s.length === 2 &&
    s[0] === 2 &&
    s[1] === 3 &&
    a === 1 &&
    b === 2 &&
    c === 3 &&
    Array.isArray(s) === true
  );
}
let g = sl(1, 2, 3);

// Named function expression: reverse keeps mapped alias.
let named = function (x, y) {
  Array.prototype.reverse.call(arguments);
  return x === 20 && y === 10 && arguments[0] === 20 && arguments[1] === 10;
};
let h = named(10, 20);

// Object method (non-arrow): sort keeps mapped alias.
let o = {
  m: function (p, q) {
    Array.prototype.sort.call(arguments);
    return p === 1 && q === 2 && arguments[0] === 1 && arguments[1] === 2;
  },
};
let i = o.m(2, 1);

// push then formal write still maps index 0; new index stays unmapped to formals.
function pushThenWrite(a) {
  Array.prototype.push.call(arguments, 8);
  a = 5;
  return a === 5 && arguments[0] === 5 && arguments[1] === 8 && arguments.length === 2;
}
let j = pushThenWrite(1);
