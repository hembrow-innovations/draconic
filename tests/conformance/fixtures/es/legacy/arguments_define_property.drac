// E17.02.18: Mapped arguments + Object.defineProperty residual (non-strict simple params).
// Redefine index as data/accessor; non-writable assign silent; mapping breaks per ES.

// Writable data redefine: mapping can remain (param write updates args[0]).
function dataWritable(a) {
  Object.defineProperty(arguments, "0", {
    value: 7,
    writable: true,
    enumerable: true,
    configurable: true,
  });
  a = 3;
  return a === 3 && arguments[0] === 3;
}
let a = dataWritable(1);

// Non-writable data redefine: param write does not update args[0]; no throw.
function dataNonWritable(a) {
  Object.defineProperty(arguments, "0", {
    value: 7,
    writable: false,
    enumerable: true,
    configurable: true,
  });
  let threw = false;
  try {
    a = 3;
  } catch (e) {
    threw = true;
  }
  // Engine may sync formal once on redefine; pin args[0] stays 7 and no throw.
  return threw === false && arguments[0] === 7 && a === 3;
}
let b = dataNonWritable(1);

// Non-writable: direct arguments[0] = silent fail (value unchanged).
function argsWriteNonWritable(a) {
  Object.defineProperty(arguments, "0", {
