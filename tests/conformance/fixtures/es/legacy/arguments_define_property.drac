let i = o.m(3);

// Strict body: no mapping; defineProperty still shapes arguments object.
function strictDef(a) {
  "use strict";
  Object.defineProperty(arguments, "0", {
    value: 7,
    writable: true,
    enumerable: true,
    configurable: true,
  });
  a = 3;
  return a === 3 && arguments[0] === 7;
}
let j = strictDef(1);

// Contrast: plain mapped baseline still holds without defineProperty.
function plainMapped(a) {
  arguments[0] = 77;
  return a === 77;
