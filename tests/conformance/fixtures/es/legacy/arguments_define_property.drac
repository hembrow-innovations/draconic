// Accessor redefine: breaks mapping; param write does not invoke setter side on read.
function accessorBreak(a) {
  let sets = 0;
  Object.defineProperty(arguments, "0", {
    get: function () {
      return 100;
    },
    set: function (_v) {
      sets = sets + 1;
    },
    enumerable: true,
    configurable: true,
  });
  a = 2;
  return a === 2 && arguments[0] === 100 && sets === 0;
}
let d = accessorBreak(1);

// Accessor: writing arguments[0] invokes setter; get still returns getter value.
function accessorSet(a) {
  let last = undefined;
  Object.defineProperty(arguments, "0", {
    get: function () {
      return 50;
    },
    set: function (v) {
      last = v;
    },
    enumerable: true,
    configurable: true,
  });
  arguments[0] = 9;
  return last === 9 && arguments[0] === 50 && a === 1;
}
let e = accessorSet(1);

// Non-configurable non-writable after redefine: param assign silent; args stay.
function nonConfig(a) {
  Object.defineProperty(arguments, "0", {
    value: 4,
    writable: false,
    enumerable: true,
    configurable: false,
  });
  a = 8;
  arguments[0] = 9;
  return a === 8 && arguments[0] === 4;
}
let f = nonConfig(1);

// Multi-param: redefine only index 1; index 0 stays mapped.
function oneIndex(x, y) {
  Object.defineProperty(arguments, "1", {
    value: 70,
    writable: false,
    enumerable: true,
    configurable: true,
  });
  x = 10;
  y = 20;
  return arguments[0] === 10 && arguments[1] === 70 && x === 10 && y === 20;
}
let g = oneIndex(1, 2);

// Named function expression: same non-writable redefine semantics.
let named = function (z) {
  Object.defineProperty(arguments, "0", {
    value: 5,
    writable: false,
    enumerable: true,
    configurable: true,
  });
  z = 6;
  return z === 6 && arguments[0] === 5;
