let h = named(2);

// Object method (non-arrow): accessor redefine breaks mapping.
let o = {
  m: function (p) {
    Object.defineProperty(arguments, "0", {
      get: function () {
        return 11;
      },
      set: function () {},
      enumerable: true,
      configurable: true,
    });
    p = 12;
    return p === 12 && arguments[0] === 11;
  },
