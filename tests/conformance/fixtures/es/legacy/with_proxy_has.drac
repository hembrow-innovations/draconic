    with ({ box: { b: 1 } }) {
      return ("b" in box) === true && ("a" in box) === false;
    }
  }
}
let cf = nestedInInnerWins();

function hasTrapThrowTypeError() {
  let obj = { Proxy: Proxy };
  with (obj) {
    let p = new Proxy(
      {},
      {
        has: function (t, key) {
          throw new TypeError("has-boom");
        }
      }
    );
    try {
      "x" in p;
      return false;
    } catch (err) {
      return err instanceof TypeError && err.message === "has-boom";
    }
  }
}
let cg = hasTrapThrowTypeError();

function emptyHandlerPassThroughStringKeyIdent() {
  let obj = { Proxy: Proxy, key: "a" };
  with (obj) {
    let p = new Proxy({ a: 1, b: 2 }, {});
    return (key in p) === true && ("c" in p) === false;
  }
}
let ch = emptyHandlerPassThroughStringKeyIdent();
