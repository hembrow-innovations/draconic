id: es/legacy/eval_arguments
targets: js
js.exit: 0
js.check: if (a !== true) process.exit(1); if (b !== 99) process.exit(2); if (c !== 42) process.exit(3); if (d !== true) process.exit(4); if (e !== 1) process.exit(5); if (f !== 10) process.exit(6); if (g !== 8) process.exit(7); if (h !== 77) process.exit(8); if (i !== true) process.exit(9); if (j !== 5) process.exit(10); if (k !== "undefined") process.exit(11); if (l !== "undefined") process.exit(12); if (m !== 8) process.exit(13);
