  let lastThis = 0;
  let obj = { Proxy: Proxy };
  with (obj) {
    let p = new Proxy(
      function () {
        return 0;
      },
      {
        apply: function (t, thisArg, args) {
          lastThis = thisArg;
          return 1;
        }
      }
    );
    let r = p();
    return r === 1 && lastThis === undefined;
  }
}
let cc = applyTrapThisArgLetBound();

function nestedApplyInnerWinsCall() {
  with ({
    f: function () {
      return 1;
    }
  }) {
    with ({
      f: function () {
        return 2;
      }
    }) {
      return f() === 2;
    }
  }
}
let cd = nestedApplyInnerWinsCall();

function applyTrapReturnsWithoutCallingTarget() {
  let obj = { Proxy: Proxy };
  let called = false;
  with (obj) {
    let p = new Proxy(
      function () {
        called = true;
        return 0;
      },
      {
        apply: function (t, thisArg, args) {
          return 99;
        }
      }
    );
    let r = p();
    return r === 99 && called === false;
  }
}
let ce = applyTrapReturnsWithoutCallingTarget();

function applyTrapCallCount() {
  let obj = { Proxy: Proxy };
  let calls = 0;
  with (obj) {
    let p = new Proxy(
      function (a, b) {
        return a + b;
      },
      {
        apply: function (t, thisArg, args) {
          calls = calls + 1;
          return t.apply(thisArg, args);
        }
      }
    );
    let rec = { m: p };
    let r1 = p(1, 2);
    let r2 = rec.m(3, 4);
    return r1 === 3 && r2 === 7 && calls === 2;
  }
}
let cf = applyTrapCallCount();

function liveCloseApplyTarget() {
  let obj = {
    box: function (n) {
      return n + 1;
    }
  };
  let run;
  with (obj) {
    run = function (n) {
      return box(n);
    };
  }
  obj.box = function (n) {
    return n + 10;
  };
  return run(1) === 11;
}
let cg = liveCloseApplyTarget();

function unscopablesArgIdent() {
  let obj = {
    Proxy: Proxy,
    k: 0
  };
  obj[Symbol.unscopables] = { k: true };
  let k = 5;
  with (obj) {
    let p = new Proxy(function (n) {
      return n;
    }, {});
    return p(k) === 5;
  }
}
let ch = unscopablesArgIdent();
