  let wm = new WeakMap();
  with (wm) {
    try {
      set(1, 2);
      return false;
    } catch (err) {
      return err instanceof TypeError;
    }
  }
}
let cn = primitiveKeyTypeError();

function weakSetPrimitiveTypeError() {
  let ws = new WeakSet();
  with (ws) {
    try {
      add(1);
      return false;
    } catch (err) {
      return err instanceof TypeError;
    }
  }
}
let cp = weakSetPrimitiveTypeError();

function hasIdentHitsObject() {
  let obj = {
    has: function (key) {
      return "hit";
    }
  };
  with (obj) {
    return has({}) === "hit";
  }
}
let cq = hasIdentHitsObject();

function identityDelete() {
  let obj = { WeakMap: WeakMap };
  with (obj) {
    return WeakMap.prototype.delete === globalThis.WeakMap.prototype.delete;
  }
}
let cr = identityDelete();

function identityAdd() {
  let obj = { WeakSet: WeakSet };
  with (obj) {
    return WeakSet.prototype.add === globalThis.WeakSet.prototype.add;
  }
}
let cs = identityAdd();

function withWeakMapHasTypeof() {
  let wm = new WeakMap();
  with (wm) {
    return typeof has === "function";
  }
}
let ct = withWeakMapHasTypeof();

function withWeakSetAddTypeof() {
  let ws = new WeakSet();
  with (ws) {
    return typeof add === "function";
  }
}
let cu = withWeakSetAddTypeof();

function getMissUndefined() {
  let k1 = {};
  let wm = new WeakMap();
  with (wm) {
    set(k1, 1);
    return get({}) === undefined && get(k1) === 1;
  }
}
let cv = getMissUndefined();

function deleteMissingReturnsFalse() {
  let wm = new WeakMap();
  let key = {};
  with (wm) {
    return wm.delete(key) === false && has(key) === false;
  }
}
let cw = deleteMissingReturnsFalse();
