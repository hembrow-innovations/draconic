id: es/legacy/eval_in_with
targets: js
js.exit: 0
js.check: if (a !== 7) process.exit(1); if (b !== 2) process.exit(2); if (c !== true) process.exit(3); if (d !== true) process.exit(4); if (e !== 5) process.exit(5); if (f !== 6) process.exit(6); if (g !== 20) process.exit(7); if (h !== "undefined") process.exit(8); if (i !== true) process.exit(9); if (j !== 9) process.exit(10); if (k !== true) process.exit(11);
