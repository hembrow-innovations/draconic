let id = function (a) {
  return a;
};
let add = function (x, y) {
  return x + y;
};
let a = id(42);
let b = add(1, 2);
let c = (function (n) {
  return n + 1;
})(41);
let fact = function f(n) {
  if (n <= 1) {
    return 1;
  }
  return n * f(n - 1);
};
let d = fact(5);
let make = function (base) {
  return function (x) {
    return base + x;
  };
};
let e = make(10)(7);
