id: es/annex-b/legacy_octal_numeric
targets: js
js.exit: 0
js.check: if (a !== 8) process.exit(1); if (b !== 63) process.exit(2); if (c !== 0) process.exit(3); if (d !== 8) process.exit(4); if (e !== 8) process.exit(5); if (f !== 9) process.exit(6); if (g !== 89) process.exit(7); if (h !== 8) process.exit(8); if (i !== 8.5) process.exit(9); if (j !== 800) process.exit(10); if (k !== 0) process.exit(11); if (m !== 83) process.exit(12); if (typeof a !== "number") process.exit(13);
