class Point {
  #x = 1;
  #y = 2;
  #sum() {
    return this.#x + this.#y;
  }
  total() {
    return this.#sum();
  }
  #setX(v) {
    this.#x = v;
  }
  bump(v) {
    this.#setX(v);
  }
  getX() {
    return this.#x;
  }
}
let p = new Point();
let a = p.total();
p.bump(10);
let b = p.getX();
let c = p.total();
let d = typeof p.sum;
let e = typeof p.setX;

class Greeter {
  #hi(name) {
    return "hi " + name;
  }
  greet(name) {
    return this.#hi(name);
  }
}
let f = new Greeter().greet("world");

class Nested {
  #inner(n) {
    return n + 1;
  }
  #outer(n) {
    return this.#inner(n) + this.#inner(n);
  }
  run(n) {
    return this.#outer(n);
  }
}
let g = new Nested().run(3);

class Parent {
  #base() {
    return 100;
  }
  base() {
    return this.#base();
  }
}
class Child extends Parent {
  #extra() {
    return 1;
  }
  total() {
    return this.base() + this.#extra();
  }
}
let ch = new Child();
let h = ch.total();
let i = ch.base();

class WithThis {
  #n = 0;
  #inc() {
    this.#n = this.#n + 1;
    return this.#n;
  }
  twice() {
    this.#inc();
    return this.#inc();
  }
}
let j = new WithThis().twice();

// E19.82: private method `.name` is "#description" (SetFunctionName with PrivateName).
class Named {
  #m() {
    return 1;
  }
  *#g() {
    yield 1;
  }
  async #a() {
    return 2;
  }
  async *#ag() {
    yield 3;
  }
  refM() {
    return this.#m;
  }
  refG() {
    return this.#g;
  }
  refA() {
    return this.#a;
  }
  refAg() {
    return this.#ag;
  }
}
let named = new Named();
let k = named.refM().name;
let l = named.refG().name;
let mName = named.refA().name;
let o = named.refAg().name;

class StaticNamed {
  static #sm() {
    return 1;
  }
  static *#sg() {
    yield 1;
  }
  static async #sa() {
    return 2;
  }
  static async *#sag() {
    yield 3;
  }
  static refSm() {
    return this.#sm;
  }
  static refSg() {
    return this.#sg;
  }
  static refSa() {
    return this.#sa;
  }
  static refSag() {
    return this.#sag;
  }
}
let nmSm = StaticNamed.refSm().name;
let nmSg = StaticNamed.refSg().name;
let nmSa = StaticNamed.refSa().name;
let nmSag = StaticNamed.refSag().name;
