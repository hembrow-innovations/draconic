id: es/expressions/comma
targets: js,native
js.exit: 0
native.exit: 0
native.stdout: 2\n3\n2\n3\n4\n2\n2\n
js.check: if (a !== 2) process.exit(1); if (b !== 3) process.exit(2); if (c !== 2) process.exit(3); if (d !== 3) process.exit(4); if (e !== 4) process.exit(5); if (f !== 2) process.exit(6); if (side !== 2) process.exit(7);
