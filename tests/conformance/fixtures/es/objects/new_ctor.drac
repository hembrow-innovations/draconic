function Point(x, y) {
  this.x = x;
  this.y = y;
}
let p = new Point(1, 2);
let a = p.x;
let b = p.y;
function Box(v) {
  this.v = v;
  this.get = function () {
    return this.v;
  };
}
let box = new Box(10);
let c = box.v;
let d = box.get();
function Empty() {}
let e = new Empty();
e.n = 3;
let f = e.n;
function Counter(start) {
  this.n = start;
}
let c1 = new Counter(5);
c1.n = c1.n + 1;
let g = c1.n;
let h = new Point(3, 4).x;
