function Point(x, y) {
  this.x = x;
  this.y = y;
}
Point.prototype.sum = function () {
  return this.x + this.y;
};
Point.prototype.scale = function (n) {
  this.x = this.x * n;
  this.y = this.y * n;
};
let p = new Point(1, 2);
let a = p.sum();
p.scale(3);
let b = p.x;
let c = p.y;
let d = p.sum();
function Animal(id) {
  this.id = id;
}
Animal.prototype.greet = function () {
  return this.id;
};
function Dog(id) {
  this.id = id;
}
Dog.prototype = new Animal(0);
Dog.prototype.bark = function () {
  return this.id;
};
let dog = new Dog(7);
let e = dog.bark();
let f = dog.greet();
