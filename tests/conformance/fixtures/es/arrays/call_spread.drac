function sum(a, b, c) {
  return a + b + c;
}
let nums = [1, 2, 3];
let a = sum(...nums);
let b = sum(10, ...[20, 30]);
let c = sum(...[1], 2, ...[3]);
let d = sum(1, 2, 3);
let empty = [];
let e = sum(1, ...empty, 2, ...empty, 3);
let chars = ["x", "y"];
function join3(x, y, z) {
  return x + y + z;
}
let f = join3(...chars, "z");
function C(x, y) {
  this.x = x;
  this.y = y;
}
let args = [7, 8];
let inst = new C(...args);
let ix = inst.x;
let iy = inst.y;
let g = new C(1, ...[2]);
let gx = g.x;
let gy = g.y;
let nested = [[4, 5, 6]];
let h = sum(...nested[0]);
