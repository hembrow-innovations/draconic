// E19.82.08: private names visible to direct eval (methods + field inits)

// 1) instance private field via eval in method
class C1 {
  #m = 44;
  getWithEval() {
    return eval("this.#m");
  }
}
class D1 {
  #m = 99;
}
let c1 = new C1();
let v1 = c1.getWithEval();
let err1 = "";
try {
  c1.getWithEval.call(new D1());
} catch (e) {
  err1 = e.name;
}

// 2) instance private method via eval
class C2 {
  #m() {
    return "Test262";
  }
  getWithEval() {
    return eval("this.#m()");
  }
}
class D2 {
  #m() {
    return "nope";
  }
}
let v2 = new C2().getWithEval();
let err2 = "";
try {
  new C2().getWithEval.call(new D2());
} catch (e) {
  err2 = e.name;
}

// 3) instance private getter via eval
class C3 {
  get #m() {
    return "g";
  }
  getWithEval() {
    return eval("this.#m");
  }
}
let v3 = new C3().getWithEval();

// 4) instance private setter via eval (free var `v` from param)
class C4 {
  set #m(v) {
    this._v = v;
  }
  setWithEval(v) {
    eval("this.#m = v");
  }
}
let c4 = new C4();
c4.setWithEval("ok");
let v4 = c4._v;

// 5) private field visible in field-init direct eval
class C5 {
  #m = 44;
  v = eval("this.#m");
}
let v5 = new C5().v;

// 6) private method visible in field-init direct eval
class C6 {
  #m() {
    return 7;
  }
  v = eval("this.#m()");
}
let v6 = new C6().v;

// 7) static private field via eval
class C7 {
  static #m = 11;
  static getWithEval() {
    return eval("this.#m");
  }
}
class D7 {
  static #m = 0;
}
let v7 = C7.getWithEval();
let err7 = "";
try {
  C7.getWithEval.call(D7);
} catch (e) {
  err7 = e.name;
}

// 8) static private method via eval
class C8 {
  static #m() {
    return "S";
  }
  static accessWithEval() {
    return eval("this.#m()");
  }
}
let v8 = C8.accessWithEval();

// 9) static private getter/setter via eval
class C9 {
  static get #m() {
    return this._g;
  }
  static set #m(v) {
    this._g = v;
  }
  static setWithEval() {
    eval('this.#m = "Z"');
  }
  static getWithEval() {
    return eval("this.#m");
  }
}
C9.setWithEval();
let v9 = C9.getWithEval();
