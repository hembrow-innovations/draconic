class MathUtil {
  constructor() {
    this.tag = 7;
  }
  static add(a, b) {
    return a + b;
  }
  static id() {
    return 42;
  }
  tagValue() {
    return this.tag;
  }
}
let a = MathUtil.add(2, 3);
let b = MathUtil.id();
let m = new MathUtil();
let c = m.tagValue();
class Greeter {
  static hello(n) {
    return n;
  }
}
let d = Greeter.hello(9);
