class Animal {
  constructor(id) {
    this.id = id;
  }
  greet() {
    return this.id;
  }
  tag() {
    return 7;
  }
  scaled(n) {
    return this.id * n;
  }
}
class Dog extends Animal {
  constructor(id) {
    super(id);
  }
  greet() {
    return super.greet();
  }
  both() {
    return super.tag();
  }
  parentScaled() {
    return super.scaled(3);
  }
}
let d = new Dog(5);
let a = d.greet();
let b = d.both();
let c = d.parentScaled();
class Cat extends Animal {
  constructor(id) {
    super(id);
  }
  loud() {
    return super.greet();
  }
}
let cat = new Cat(9);
let e = cat.loud();
