class Animal {
  constructor(name) {
    this.name = name;
  }
  greet() {
    return this.name;
  }
}
class Dog extends Animal {
  constructor(name, age) {
    super(name);
    this.age = age;
  }
  info() {
    return this.name;
  }
}
let d = new Dog("rex", 3);
let a = d.name;
let b = d.age;
let c = d.greet();
let e = d.info();
class Cat extends Animal {
  constructor(name) {
    super(name);
  }
}
let cat = new Cat("mia");
let f = cat.greet();
