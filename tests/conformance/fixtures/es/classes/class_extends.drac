class Animal {
  constructor(id) {
    this.id = id;
  }
  greet() {
    return this.id;
  }
}
class Dog extends Animal {
  constructor(id, age) {
    super(id);
    this.age = age;
  }
  info() {
    return this.id;
  }
}
let d = new Dog(1, 3);
let a = d.id;
let b = d.age;
let c = d.greet();
let e = d.info();
class Cat extends Animal {
  constructor(id) {
    super(id);
  }
}
let cat = new Cat(2);
let f = cat.greet();
