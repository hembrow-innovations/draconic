// E19.82.10: private fields as destructuring assignment targets.

// 1) array dstr PrivateFieldSet TypeError on wrong receiver
class C1 {
  #field;
  m() {
    [this.#field] = [1];
  }
  get() {
    return this.#field;
  }
}
let c1 = new C1();
c1.m();
let v1 = c1.get();
let e1 = false;
try {
  C1.prototype.m.call({});
} catch (err) {
  e1 = err instanceof TypeError;
}

// 2) object dstr PrivateFieldSet TypeError on wrong receiver
class C2 {
  #field;
  m() {
    ({ a: this.#field } = { a: 0 });
  }
  get() {
    return this.#field;
  }
}
let c2 = new C2();
c2.m();
let v2 = c2.get();
let e2 = false;
try {
  C2.prototype.m.call({});
} catch (err) {
  e2 = err instanceof TypeError;
}

// 3) array rest to private field
class C3 {
  #field;
  m() {
    [...this.#field] = [1, 2, 3];
  }
  get() {
    return this.#field;
  }
}
let c3 = new C3();
c3.m();
let v3 = c3.get();
let e3 = false;
try {
  C3.prototype.m.call({});
} catch (err) {
  e3 = err instanceof TypeError;
}

// 4) object rest to private field
class C4 {
  #field;
  m() {
    ({ ...this.#field } = { x: 1, y: 2 });
  }
  get() {
    return this.#field;
  }
}
let c4 = new C4();
c4.m();
let v4 = c4.get();
let e4 = false;
try {
  C4.prototype.m.call({});
} catch (err) {
  e4 = err instanceof TypeError;
}

// 5) evaluation order: this TDZ before getter
class C5 extends class {} {
  #field;
  constructor() {
    var init = () => super();
    var object = {
      get a() {
        init();
        return 1;
      },
    };
    ({ a: this.#field } = object);
  }
}
let e5 = false;
try {
  new C5();
} catch (err) {
  e5 = err instanceof ReferenceError;
}

// 6) evaluation order: getter before PrivateFieldSet brand check
class C6 {
  #field;
  m() {
    var object = {
      get a() {
        throw new Error("getter");
      },
    };
    ({ a: this.#field } = object);
  }
}
let e6 = false;
try {
  C6.prototype.m.call({});
} catch (err) {
  e6 = err instanceof Error && err.message === "getter";
}

// 7) evaluation order: getter can install brand via return-override before set
class Base7 {
  constructor(o) {
    return o;
  }
}
class C7 extends Base7 {
  #field;
  m() {
    var self = this;
    var object = {
      get a() {
        new C7(self);
        return "pass";
      },
    };
    ({ a: this.#field } = object);
    return this.#field;
  }
}
let v7 = C7.prototype.m.call({});
