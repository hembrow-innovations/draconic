let a = 0;
outer: while (true) {
  a = a + 1;
  break outer;
}
let b = 0;
let c = 0;
outer2: for (let i = 0; i < 5; i = i + 1) {
  b = b + 1;
  if (i === 1) continue outer2;
  c = c + 1;
}
let d = 0;
let e = 0;
outer3: while (d < 3) {
  d = d + 1;
  inner: while (true) {
    e = e + 1;
    break outer3;
  }
}
let f = 0;
loop: do {
  f = f + 1;
  if (f === 2) break loop;
} while (true);
let g = 0;
lbl: {
  g = 1;
  break lbl;
  g = 99;
}
