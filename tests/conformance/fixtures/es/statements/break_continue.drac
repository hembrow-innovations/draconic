let a = 0;
while (true) {
  a = a + 1;
  if (a === 3) break;
}
let b = 0;
let c = 0;
while (b < 5) {
  b = b + 1;
  if (b === 2) continue;
  c = c + 1;
}
let d = 0;
for (let i = 0; i < 10; i = i + 1) {
  d = d + 1;
  if (i === 2) break;
}
let e = 0;
for (let j = 0; j < 5; j = j + 1) {
  if (j === 2) continue;
  e = e + 1;
}
let f = 0;
do {
  f = f + 1;
  if (f === 2) break;
} while (true);
let g = 0;
let h = 0;
do {
  g = g + 1;
  if (g === 2) continue;
  h = h + 1;
} while (g < 4);
let outer = 0;
let inner = 0;
while (outer < 3) {
  outer = outer + 1;
  while (true) {
    inner = inner + 1;
    break;
  }
}
