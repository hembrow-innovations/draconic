// H10.06: httpParseRequest decodes Transfer-Encoding: chunked body.
let req = httpParseRequest("POST /up HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n");
let m = req.method;
let p = req.path;
let b = req.body;
let te = httpRequestHeader(req, "transfer-encoding");
