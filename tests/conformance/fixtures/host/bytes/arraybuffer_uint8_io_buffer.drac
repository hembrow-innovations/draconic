// H00.03: ArrayBuffer / Uint8Array are the language-level OS I/O buffer types.
// Binary-safe shared storage (embedded 0x00 is data, not a C-string terminator).
let buf = new ArrayBuffer(6);
let u8 = new Uint8Array(buf);
u8[0] = 0;
u8[1] = 255;
u8[2] = 1;
u8[3] = 2;
u8[4] = 127;
u8[5] = 128;
// Second view over the same ArrayBuffer — host read/write mutates shared bytes.
let view = new Uint8Array(buf);
let blen = buf.byteLength;
let ulen = u8.length;
let a0 = u8[0];
let a1 = u8[1];
let a5 = u8[5];
// Mutate through one view; observe through the other (OS fill / drain model).
view[0] = 42;
view[1] = 0;
let b0 = u8[0];
let b1 = u8[1];
let b2 = u8[2];
// DataView is also a byte-oriented window over the same storage.
let dv = new DataView(buf);
dv.setUint8(2, 99);
let c2 = u8[2];
let d2 = dv.getUint8(2);
