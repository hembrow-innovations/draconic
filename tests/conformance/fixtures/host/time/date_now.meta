id: host/time/date_now
targets: js,native
js.exit: 0
js.check: if (t !== "number") process.exit(1); if (ok_range !== true) process.exit(2); if (ok_future !== true) process.exit(3); if (ok_order !== true) process.exit(4); var n = Date.now(); if (!(n > 1600000000000 && n < 4000000000000)) process.exit(5);
