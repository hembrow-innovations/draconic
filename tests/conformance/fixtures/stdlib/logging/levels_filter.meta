id: stdlib/logging/levels_filter
targets: js,native
js.exit: 0
native.exit: 0
native.stdout: true\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\ntrue\n1\n1\n
js.check: if (a !== true) process.exit(1); if (b !== true) process.exit(2); if (c !== true) process.exit(3); if (d !== true) process.exit(4); if (e !== true) process.exit(5); if (f !== true) process.exit(6); if (g !== true) process.exit(7); if (h !== true) process.exit(8); if (i !== true) process.exit(9); if (j !== true) process.exit(10); if (k !== 1) process.exit(11); if (l !== 1) process.exit(12);
