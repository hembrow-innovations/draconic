id: stdlib/compression/gzip_roundtrip
targets: js,native
js.exit: 0
native.exit: 0
native.stdout: function\ntrue\ntrue\ntrue\ntrue\ntrue\nhello\n
js.check: if (tp !== "function") process.exit(1); if (gp !== true) process.exit(2); if (m0 !== true) process.exit(3); if (m1 !== true) process.exit(4); if (round !== true) process.exit(5); if (empty !== true) process.exit(6); if (known !== "hello") process.exit(7);
